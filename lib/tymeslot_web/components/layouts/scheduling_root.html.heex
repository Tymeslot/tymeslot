<!DOCTYPE html>
<html
  lang={assigns[:locale] || "en"}
  class={"scheduling-app theme-#{assigns[:theme_id] || "1"} #{theme_class(assigns[:theme_id] || "1")}"}
  data-embed-layout={to_string(assigns[:embed_layout] || :default)}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Tymeslot">
      {assigns[:page_title] || "Schedule a Meeting"}
    </.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/images/brand/favicon.svg"} />
    <link rel="alternate icon" href={~p"/images/brand/favicon.ico"} />

    <%!-- Theme-specific CSS --%>
    {render_theme_css(assigns[:theme_id] || "1")}

    <%!-- Additional CSS from external layers (e.g., SaaS branding) --%>
    <%= for css_path <- Application.get_env(:tymeslot, :scheduling_additional_css, []) do %>
      <link phx-track-static rel="stylesheet" href={css_path} />
    <% end %>

    <%!-- Core bundle + Public booking bundle for scheduling pages --%>
    <script phx-track-static type="module" src={~p"/assets/app.js"}>
    </script>
    <script phx-track-static type="module" src={~p"/assets/bundles/public.js"}>
    </script>
    <script phx-track-static type="module" src={~p"/assets/iframe_embed.js"}>
    </script>
    <.nomodule_fallback context={:scheduling_page} />
    <.analytics_scripts />
  </head>
  <body class={"theme-#{assigns[:theme_id] || "1"} #{theme_class(assigns[:theme_id] || "1")}"}>
    <.noscript_warning message="This scheduling page requires JavaScript to book meetings. Please enable it to continue." />
    <.flash_group flash={@flash} id="scheduling-flash-group" />
    <main>
      {@inner_content}
    </main>
  </body>
</html>
