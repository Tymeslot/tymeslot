<!DOCTYPE html>
<html lang={assigns[:locale] || "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="csp-nonce" content={assigns[:csp_nonce]} />
    <link rel="canonical" href={TymeslotWeb.Layouts.current_url(assigns)} />
    <%= if assigns[:meta_description] do %>
      <meta name="description" content={@meta_description} />
    <% end %>
    <.live_title suffix=" · Tymeslot">
      {assigns[:page_title] || dgettext("common", "Schedule a Meeting")}
    </.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/images/brand/favicon.svg"} />
    <link rel="alternate icon" href={~p"/images/brand/favicon.ico"} />
    <%!-- Default app styles --%>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <%!-- Core bundle: always loaded (LiveSocket + utilities) --%>
    <script phx-track-static type="module" src={~p"/assets/app.js"}>
    </script>
    <%!-- Route-specific bundle: loaded conditionally based on assigns[:route_bundle] --%>
    <%= if assigns[:route_bundle] do %>
      <script phx-track-static type="module" src={TymeslotWeb.Endpoint.static_path("/assets/bundles/#{@route_bundle}.js")}>
      </script>
    <% else %>
      <%!-- Fallback: connect LiveSocket with core-only hooks for pages without route bundles --%>
      <script type="module" nonce={assigns[:csp_nonce]}>
        // Wait for core bundle to load, then connect LiveSocket
        (async function() {
          let retries = 0;
          const maxRetries = 100;
          const interval = 100;

          while (!window.liveSocket && retries < maxRetries) {
            await new Promise(resolve => setTimeout(resolve, interval));
            retries++;
          }

          if (window.liveSocket && !window.liveSocket.isConnected()) {
            window.liveSocket.connect();
          }
        })();
      </script>
    <% end %>
    <.nomodule_fallback nonce={assigns[:csp_nonce]} />
    <.analytics_scripts />
  </head>
  <body>
    <.noscript_warning message={
      dgettext(
        "common",
        "This app requires JavaScript to function. Please enable it in your browser settings."
      )
    } />
    {@inner_content}
  </body>
</html>
