# Tymeslot Environment Configuration
# Copy this file to .env and fill in your values
#
# Legend:
#   REQUIRED  — must be set; the application will not start without it
#   OPTIONAL  — has a sensible default; override only when needed
#   REQUIRED* — required only when a specific feature or adapter is enabled

# ====================
# REQUIRED SETTINGS
# ====================

# REQUIRED: Must be at least 64 characters. Generate with: openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=

# OPTIONAL (recommended): Dedicated key for encrypting credentials at rest,
# independent of SECRET_KEY_BASE. Setting it lets you rotate SECRET_KEY_BASE
# without making stored credentials undecryptable. Generate with:
#   openssl rand -base64 48 | tr -d '\n'
# Once set it MUST stay stable across restarts. After setting it on an existing
# install, migrate existing rows (see README, "Data-at-rest encryption").
# When unset, credentials are encrypted with a key derived from SECRET_KEY_BASE.
# DATA_ENCRYPTION_KEY=

# REQUIRED: Your domain name (e.g., tymeslot.yourdomain.com)
# Sets the host of every generated link, including the ones in password reset
# and verification emails. A development server (mix phx.server) reads it too,
# defaulting to localhost when it is unset.
PHX_HOST=

# REQUIRED: PostgreSQL password
POSTGRES_PASSWORD=

# ====================
# APPLICATION SETTINGS
# ====================

# OPTIONAL: HTTP listen port (default: 4000)
# PORT=4000

# OPTIONAL: Listen IP address (default: "::" — all IPv4 and IPv6 interfaces)
# Common values:
#   ::        - All interfaces, IPv4 and IPv6 (default)
#   0.0.0.0   - All IPv4 interfaces only
#   127.0.0.1 - Localhost only (useful behind a reverse proxy)
# LISTEN_IP=::

# OPTIONAL: URL scheme for generated links (default: "https")
# Set to "http" only for local or internal deployments without TLS.
# In a development server (mix phx.server) the default is "http" instead, so
# set this to "https" when a dev instance sits behind a TLS-terminating proxy.
# URL_SCHEME=https

# OPTIONAL: Comma-separated WebSocket allowed origins (default: derived from PHX_HOST)
# Override when you serve the app under multiple hostnames.
# WS_ALLOWED_ORIGINS=https://yourdomain.com

# OPTIONAL: Set to false to disable new user registration (default: true)
# Applies to all auth methods including SSO.
# REGISTRATION_ENABLED=true

# OPTIONAL: DNS query for distributed (multi-node) clustering (default: unset — single node)
# DNS_CLUSTER_QUERY=

# OPTIONAL: Base URL for docs hub links shown in the dashboard (default: the
# hosted Tymeslot docs site). Set this if you run your own documentation and
# want dashboard help links to point there instead.
# DOCS_ARTICLE_BASE_URL=https://docs.yourdomain.com

# OPTIONAL: Default language for visitors who express no preference (default: en)
# Applies when there is no ?locale= parameter, no session locale and no
# Accept-Language match — so it is what a visitor sees on a first, cold visit,
# and what the server renders before the LiveView socket connects.
# Must be one of the supported locales: en, de, fr, it, uk, cs
# An unrecognised value stops the application at boot rather than silently
# serving the wrong language.
# DEFAULT_LOCALE=en

# ====================
# DATABASE SETTINGS
# ====================

# OPTIONAL: Full PostgreSQL connection string (default: unset — use the
# discrete variables below, or the database bundled in the default image).
# When set, its host, port, database, user and password take precedence over
# every discrete variable below. This is what managed providers hand you.
# A URL naming a remote host switches the default image to that database and
# leaves its bundled PostgreSQL unused; a URL pointing at localhost means the
# bundled one, so a stale value cannot take it out of service by accident.
# DATABASE_URL=postgres://user:password@db.example.com:5432/tymeslot

# OPTIONAL: TLS for the database connection (default: unset — no TLS).
# Values:
#   true / verify-full  encrypt and verify the server certificate and hostname
#   verify-none         encrypt without verifying (self-signed certs only)
#   false / disable     no TLS
# Managed providers (RDS, Neon, Supabase) generally require this.
# An sslmode query parameter inside DATABASE_URL is honoured when this is
# unset (require = encrypt without verifying, verify-ca/verify-full = verify);
# an explicit DATABASE_SSL always wins over the URL parameter.
# DATABASE_SSL=true

# OPTIONAL: Path to a CA bundle for verifying the database certificate
# (default: unset — use the system trust store). Only read when DATABASE_SSL
# enables verification. Put the file on the /app/data volume so it survives
# upgrades.
# DATABASE_SSL_CACERT_FILE=/app/data/rds-ca-bundle.pem

# OPTIONAL: PostgreSQL hostname (default: "localhost")
# DATABASE_HOST=localhost

# OPTIONAL: PostgreSQL port (default: 5432)
# DATABASE_PORT=5432

# OPTIONAL: PostgreSQL database name (default: "tymeslot")
# POSTGRES_DB=tymeslot

# OPTIONAL: PostgreSQL username (default: "tymeslot")
# POSTGRES_USER=tymeslot

# OPTIONAL: Database connection pool size (Docker default: 10)
# The container entrypoint and docker-compose.yml default this to 10. Raise it
# for higher concurrency, and ensure PostgreSQL max_connections stays above it.
# DATABASE_POOL_SIZE=10

# ====================
# EMAIL CONFIGURATION
# ====================

# OPTIONAL: Email delivery adapter (default: "test" — silently discards all mail)
# Values: "smtp" (works with any provider), "postmark", "sendgrid", "mailgun",
# "ahasend", "test" (no-op). An unrecognised value stops the app at boot rather
# than quietly dropping every email.
# A provider without its own entry below still works over "smtp": point
# SMTP_HOST at the relay it gives you.
EMAIL_ADAPTER=test

# OPTIONAL: Sender display name (default: "Tymeslot")
# EMAIL_FROM_NAME="Tymeslot"

# OPTIONAL: Sender email address (default: "hello@tymeslot.app")
EMAIL_FROM_ADDRESS="hello@yourdomain.com"

# OPTIONAL: Support contact address shown in emails (default: EMAIL_FROM_ADDRESS)
# EMAIL_SUPPORT_ADDRESS="support@yourdomain.com"

# OPTIONAL: Recipient for contact-form submissions (default: EMAIL_FROM_ADDRESS)
# EMAIL_CONTACT_RECIPIENT="info@yourdomain.com"

# REQUIRED* when EMAIL_ADAPTER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# REQUIRED* when EMAIL_ADAPTER=postmark — sign up at https://postmarkapp.com/
# POSTMARK_API_KEY=

# REQUIRED* when EMAIL_ADAPTER=sendgrid — https://app.sendgrid.com/settings/api_keys
# The key needs the "Mail Send" permission; nothing else is used.
# SENDGRID_API_KEY=

# REQUIRED* when EMAIL_ADAPTER=mailgun — https://app.mailgun.com/settings/api_security
# MAILGUN_DOMAIN is the sending domain you verified with Mailgun.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.yourdomain.com
# OPTIONAL: EU-hosted Mailgun accounts answer on a different host
# MAILGUN_BASE_URL=https://api.eu.mailgun.net/v3

# REQUIRED* when EMAIL_ADAPTER=ahasend — https://dash.ahasend.com/
# AHASEND_ACCOUNT_ID is the account UUID the API key belongs to.
# AHASEND_API_KEY=
# AHASEND_ACCOUNT_ID=

# ====================
# OAUTH INTEGRATIONS
# (Calendar & Video Conferencing)
# ====================

# These credentials are REQUIRED* only when users connect the corresponding
# calendar or video integration. Leave unset to disable those integrations.
# For detailed setup instructions, see README-Docker.md (OAuth Provider Setup section).

# Google OAuth — Google Calendar + Google Meet
# Setup: https://console.cloud.google.com/
# 1. Create a project and enable the Google Calendar API
# 2. Create OAuth 2.0 credentials (Web application type)
# 3. Add redirect URI: https://yourdomain.com/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_STATE_SECRET=     # Random string; generate with: openssl rand -base64 32

# Microsoft OAuth — Outlook Calendar + Microsoft Teams
# IMPORTANT: One OAuth app covers both Outlook Calendar and Teams video.
# Setup: https://portal.azure.com/ (Microsoft Entra ID → App registrations)
# 1. Register a new application (Accounts in any organizational directory + personal accounts)
# 2. Add both redirect URIs under Authentication → Web platform:
#    - https://yourdomain.com/auth/outlook/calendar/callback
#    - https://yourdomain.com/auth/teams/video/callback
# 3. Add Microsoft Graph delegated permissions:
#    Calendars.ReadWrite, User.Read, offline_access, openid, profile
# 4. Create a Client Secret under Certificates & secrets
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_STATE_SECRET=    # Random string; generate with: openssl rand -base64 32

# ====================
# CALENDAR SYNC (REAL-TIME PUSH)
# ====================

# OPTIONAL: Public HTTPS base URL that Google and Microsoft call back to for
# real-time calendar change notifications (Google push channels + Outlook Graph
# subscriptions). Usually identical to your PHX_HOST, with the https:// prefix.
# Scheme + host only — no trailing slash, no path (the app appends /webhooks/...).
#
# When unset, calendar sync falls back to polling every 15 minutes — fully
# functional, just not real-time. Set this only when the host is reachable from
# the public internet over HTTPS; providers perform a validation handshake against
# it during registration, so localhost/private/NAT hosts must leave it unset.
# WEBHOOK_BASE_URL=https://tymeslot.yourdomain.com

# OPTIONAL: Allow calendar (CalDAV) and self-hosted video integrations whose
# hostname resolves to a private/loopback/link-local address (default: false).
# In production, outbound requests to such hosts are blocked as SSRF protection.
# If you self-host your CalDAV server on a private network, set this to true to
# permit it. Webhooks have a separate switch (ALLOW_PRIVATE_IPS_FOR_WEBHOOKS
# below) — this one does not affect them. It does still permit private video
# hosts, which it originally covered, but ALLOW_PRIVATE_IPS_FOR_VIDEO is the
# switch to use for those.
# ALLOW_PRIVATE_IPS_FOR_CALENDAR=false

# OPTIONAL: Allow video integrations to reach hosts whose hostname resolves to a
# private/loopback/link-local address (default: false). Covers self-hosted
# MiroTalk and the custom video link's "test" button. Set this to true if your
# meeting server runs on an internal network. Separate from
# ALLOW_PRIVATE_IPS_FOR_CALENDAR so relaxing video does not also open calendar.
# ALLOW_PRIVATE_IPS_FOR_VIDEO=false

# OPTIONAL: Allow outbound webhook deliveries to URLs whose hostname resolves to
# a private/loopback/link-local address (default: false). In production these are
# blocked as SSRF protection. Set this to true only if you deliberately point
# webhooks at internal services on a private network. Separate from the calendar
# and video switches so relaxing those does not also open webhooks.
# ALLOW_PRIVATE_IPS_FOR_WEBHOOKS=false

# ====================
# SOCIAL AUTHENTICATION
# ====================

# OPTIONAL: Enable social login/signup (default: false)
# Setting these to false still allows the OAuth integrations above to work for
# calendar and video — users can connect Google Calendar even when ENABLE_GOOGLE_AUTH=false.
ENABLE_GOOGLE_AUTH=false
ENABLE_GITHUB_AUTH=false

# REQUIRED* when ENABLE_GITHUB_AUTH=true
# Setup: https://github.com/settings/developers → New OAuth App
# Set Authorization callback URL: https://yourdomain.com/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Generic OAuth 2.0 / OIDC Provider — for SSO with Keycloak, Authentik, Lemonldap::NG, etc.
ENABLE_OAUTH_AUTH=false

# REQUIRED when ENABLE_OAUTH_AUTH=true
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_PROVIDER_URL=      # Base URL of your identity provider (e.g. https://keycloak.example.com)
# OAUTH_AUTHORIZE_URL=     # Authorization endpoint (must be HTTPS)
# OAUTH_TOKEN_URL=         # Token endpoint (must be HTTPS)
# OAUTH_USERINFO_URL=      # Userinfo endpoint (must be HTTPS)

# OPTIONAL: Space-separated OAuth scopes (default: "openid email profile")
# OAUTH_SCOPE=openid email profile

# OPTIONAL: Accept "id" or "user_id" as subject claim when the IdP omits "sub" (default: false)
# Only enable for non-OIDC providers that do not return a "sub" claim.
# OAUTH_ALLOW_ID_FALLBACK=false

# ====================
# RECAPTCHA v3
# ====================

# OPTIONAL: Google reCAPTCHA v3 — sign up at https://www.google.com/recaptcha/admin
# Required only when RECAPTCHA_SIGNUP_ENABLED=true or RECAPTCHA_BOOKING_ENABLED=true.
# RECAPTCHA_SITE_KEY=      # Public key used in the browser
# RECAPTCHA_SECRET_KEY=    # Private key used server-side for verification

# OPTIONAL: Enable reCAPTCHA protection on signup and/or booking forms (default: false)
# RECAPTCHA_SIGNUP_ENABLED=false
# RECAPTCHA_BOOKING_ENABLED=false

# OPTIONAL: Minimum score to treat as human (0.0 = likely bot, 1.0 = likely human; default: 0.3)
# RECAPTCHA_SIGNUP_MIN_SCORE=0.3
# RECAPTCHA_BOOKING_MIN_SCORE=0.3

# OPTIONAL: reCAPTCHA action names for verification (defaults shown)
# RECAPTCHA_SIGNUP_ACTION=signup_form
# RECAPTCHA_BOOKING_ACTION=booking_form

# OPTIONAL: Comma-separated expected hostnames for reCAPTCHA response validation
# Leave unset to skip hostname validation.
# RECAPTCHA_EXPECTED_HOSTNAMES=

# ====================
# HTTP/HTTPS PROXY
# ====================

# OPTIONAL: Outbound proxy for all external requests (calendar APIs, webhooks, etc.)
# Format: http://[user:password@]host:port
# Both uppercase and lowercase variants are supported; uppercase takes precedence.
# HTTP_PROXY=
# HTTPS_PROXY=

# OPTIONAL: Comma-separated hosts/CIDRs to bypass the proxy
# Supports wildcards (*.internal.com) and CIDR notation (10.0.0.0/8).
# NO_PROXY=

# ====================
# TELEGRAM NOTIFICATIONS
# ====================

# OPTIONAL: Enable Telegram notification integration (default: false)
# When enabled, users can connect their personal Telegram bot to receive
# booking notifications. Each user configures their own bot token.
# TELEGRAM_ENABLED=false

# ====================
# SLACK NOTIFICATIONS
# ====================

# OPTIONAL: Enable Slack notification integration in webhook-URL mode (default: false)
# When set to true and no SLACK_CLIENT_ID is provided, users can paste an
# Incoming Webhook URL from their own Slack app to receive booking notifications.
# SLACK_ENABLED=false

# OPTIONAL: Slack App credentials for OAuth mode (recommended for team deployments)
# Create a Slack App at https://api.slack.com/apps with bot scopes
# chat:write, chat:write.public, channels:read, groups:read, team:read
# and redirect URL <your-domain>/api/slack/oauth/callback.
# Setting SLACK_CLIENT_ID alone enables Slack notifications; setting both
# activates OAuth mode and the "Add to Slack" button in the dashboard.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# ====================
# ADMIN ALERTS
# ====================

# OPTIONAL: Enable operational admin alerts delivered by email (default: false)
# When enabled, Tymeslot emails ADMIN_ALERT_EMAIL on events such as webhook
# processing failures, integration health issues, and background job errors.
# Both ADMIN_ALERTS_ENABLED and ADMIN_ALERT_EMAIL must be set for delivery.
# ADMIN_ALERTS_ENABLED=false

# REQUIRED* when ADMIN_ALERTS_ENABLED=true: Recipient address for admin alerts.
# ADMIN_ALERT_EMAIL=admin@yourdomain.com

# ====================
# BOOKING ANALYTICS
# ====================

# Booking analytics (page-view tracking, cookie-less visitor counting, the
# attribution dashboard) is DISABLED by default on self-hosted instances.
# Enable it with `config :tymeslot, :booking_analytics_enabled, true`.
#
# REQUIRED* when booking analytics is enabled: keys the cookie-less daily
# visitor fingerprint. The app fails fast at boot if analytics is enabled and
# this is unset. Generate it ONCE and keep it constant across deployments —
# changing it re-hashes the same visitor and double-counts uniques.
#   Generate with: openssl rand -base64 48
# ANALYTICS_SALT_SECRET=

# ====================
# MEETING PAYMENTS (STRIPE CONNECT)
# ====================

# Paid bookings are DISABLED by default. Enabling them makes your instance a
# Stripe platform: hosts connect their own Stripe account, attendees pay them
# directly, and the charge never touches your balance. You must register as a
# platform in the Stripe dashboard and enable Connect before this will work.
# Accepted truthy values: true, 1, yes.
# MEETING_PAYMENTS_ENABLED=false

# REQUIRED* when MEETING_PAYMENTS_ENABLED=true: your Stripe secret key.
# Use a test key (sk_test_...) until you have verified the flow end to end.
#   Stripe dashboard → Developers → API keys
# STRIPE_SECRET_KEY=

# REQUIRED* when MEETING_PAYMENTS_ENABLED=true: signing secret for the Connect
# webhook endpoint. This is SEPARATE from the platform webhook secret below —
# Connect events are delivered to /webhooks/stripe/connect and verified against
# their own secret. Without it that endpoint answers every delivery with a 503
# and payments go unrecorded.
#   Stripe dashboard → Developers → Webhooks → add endpoint
#     <your-domain>/webhooks/stripe/connect, listening to "Connected accounts"
# STRIPE_CONNECT_WEBHOOK_SECRET=

# OPTIONAL: signing secret for the platform webhook endpoint at
# /webhooks/stripe, used for events on your own account rather than on hosts'
# connected accounts.
# STRIPE_WEBHOOK_SECRET=

# OPTIONAL: two-letter country code used when onboarding a host who has not
# specified one (default: ch).
# MEETING_PAYMENTS_DEFAULT_COUNTRY=ch

# OPTIONAL: your platform's cut of each charge, in basis points (100 = 1%).
# Valid range 0–10000; defaults to 0, so no fee is taken unless you set one.
# Boot fails if this is set to anything that is not an integer in range.
# MEETING_PAYMENTS_APPLICATION_FEE_BP=0
