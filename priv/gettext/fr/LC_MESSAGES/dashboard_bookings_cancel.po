#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "%{count} participant paid for this session (%{amount} still held)."
msgid_plural "%{count} participants paid for this session (%{amount} still held)."
msgstr[0] "%{count} participant a payé cette séance (vous détenez encore %{amount})."
msgstr[1] "%{count} participants ont payé cette séance (vous détenez encore %{amount})."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "A refund of %{amount} is already being processed."
msgstr "Un remboursement de %{amount} est déjà en cours."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Are you sure you want to cancel the meeting with %{name} scheduled for %{when}?"
msgstr "Voulez-vous vraiment annuler la réunion avec %{name} prévue pour %{when} ?"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Are you sure you want to cancel this group meeting with %{count} participant scheduled for %{when}?"
msgid_plural "Are you sure you want to cancel this group meeting with %{count} participants scheduled for %{when}?"
msgstr[0] "Voulez-vous vraiment annuler cette réunion de groupe avec %{count} participant prévue le %{when} ?"
msgstr[1] "Voulez-vous vraiment annuler cette réunion de groupe avec %{count} participants prévue le %{when} ?"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Are you sure you want to cancel “%{title}” scheduled for %{when}? Every guest is told."
msgstr "Voulez-vous vraiment annuler « %{title} » prévue pour %{when} ? Tous les invités seront prévenus."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel Meeting"
msgstr "Annuler la réunion"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel meeting"
msgstr "Annuler la réunion"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel without refund."
msgstr "Annuler sans remboursement."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Cancelled without a refund: the booking was not paid."
msgstr "Annulée sans remboursement, car la réservation n'a pas été payée."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Cancelled without a refund: the payment is older than the 60-day refund window. You can refund it from Stripe."
msgstr "Annulée sans remboursement, car le paiement date de plus de 60 jours et dépasse le délai de remboursement. Vous pouvez le rembourser depuis Stripe."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Cancelled without a refund: the payment is under dispute. Settle the dispute in Stripe first."
msgstr "Annulée sans remboursement, car le paiement fait l'objet d'un litige. Réglez d'abord le litige dans Stripe."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Cancelled without a refund: the payment's refundable balance changed meanwhile. Check it on the payments page."
msgstr "Annulée sans remboursement, car le solde remboursable du paiement a changé entre-temps. Vérifiez-le sur la page Paiements."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancelling won't refund %{count} participant (%{amount}): their payment is older than the 60-day refund window. You can refund it from Stripe."
msgid_plural "Cancelling won't refund %{count} participants (%{amount}): their payments are older than the 60-day refund window. You can refund them from Stripe."
msgstr[0] "L'annulation ne remboursera pas %{count} participant (%{amount}), car son paiement date de plus de 60 jours et dépasse le délai de remboursement. Vous pouvez le rembourser depuis Stripe."
msgstr[1] "L'annulation ne remboursera pas %{count} participants (%{amount}), car leurs paiements datent de plus de 60 jours et dépassent le délai de remboursement. Vous pouvez les rembourser depuis Stripe."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancelling won't refund the attendee: the booking was not paid."
msgstr "L'annulation ne remboursera pas le participant, car la réservation n'a pas été payée."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancelling won't refund the attendee: the payment is older than the 60-day refund window. You can refund it from Stripe."
msgstr "L'annulation ne remboursera pas le participant, car le paiement date de plus de 60 jours et dépasse le délai de remboursement. Vous pouvez le rembourser depuis Stripe."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancelling won't refund the attendee: the payment is under dispute. Settle the dispute in Stripe first."
msgstr "L'annulation ne remboursera pas le participant, car le paiement fait l'objet d'un litige. Réglez d'abord le litige dans Stripe."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancelling..."
msgstr "Annulation..."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Confirm cancellation"
msgstr "Confirmer l’annulation"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Don't refund anyone."
msgstr "Ne rembourser personne."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Each participant gets back what they paid, and an email once their refund is issued."
msgstr "Chaque participant récupère ce qu’il a payé et reçoit un e-mail dès que son remboursement est effectué."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Each participant's payment stays with you until you refund it from Payments."
msgstr "Vous conservez le paiement de chaque participant jusqu’à ce que vous le remboursiez depuis la page Paiements."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Enter a valid partial refund amount."
msgstr "Saisissez un montant de remboursement partiel valide."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Failed to cancel meeting. Please try again."
msgstr "Échec de l’annulation de la réunion. Veuillez réessayer."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Full refund."
msgstr "Remboursement intégral."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "I understand the attendee will not receive a refund."
msgstr "Je comprends que le participant ne recevra aucun remboursement."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "I understand the participants get nothing back unless I refund them later from Payments."
msgstr "Je comprends que les participants ne récupèrent rien, sauf si je les rembourse plus tard depuis la page Paiements."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Keep Meeting"
msgstr "Conserver la réunion"

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Meeting cancelled and refund issued."
msgstr "Réunion annulée et remboursement effectué."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Meeting cancelled successfully"
msgstr "Réunion annulée avec succès"

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Meeting cancelled, but Stripe declined the refund. Check the payment in your Stripe dashboard."
msgstr "Réunion annulée, mais Stripe a refusé le remboursement. Vérifiez le paiement dans votre tableau de bord Stripe."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Meeting cancelled. The refund is being processed and the attendee will be emailed when it goes through."
msgstr "Réunion annulée. Le remboursement est en cours ; le participant sera prévenu par e-mail dès qu’il aura abouti."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "No refund can be made: the booking was not paid."
msgstr "Aucun remboursement n'est possible, car la réservation n'a pas été payée."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "No refund can be made: the payment is older than the 60-day refund window. You can refund it from Stripe."
msgstr "Aucun remboursement n'est possible, car le paiement date de plus de 60 jours et dépasse le délai de remboursement. Vous pouvez le rembourser depuis Stripe."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "No refund can be made: the payment is under dispute. Settle the dispute in Stripe first."
msgstr "Aucun remboursement n'est possible, car le paiement fait l'objet d'un litige. Réglez d'abord le litige dans Stripe."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Partial amount"
msgstr "Montant partiel"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Partial refund."
msgstr "Remboursement partiel."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Refund amount exceeds the remaining refundable balance."
msgstr "Le montant du remboursement dépasse le solde remboursable restant."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Refund everyone in full."
msgstr "Rembourser intégralement tout le monde."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Refund only part of the booking amount."
msgstr "Ne rembourser qu’une partie du montant de la réservation."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Refund this session."
msgstr "Rembourser cette séance."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Refunds one session's share of the series payment (%{amount})."
msgstr "Rembourse la part d'une séance dans le paiement de la série (%{amount})."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Refunds the remaining balance (%{amount})."
msgstr "Rembourse le solde restant (%{amount})."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Session cancelled. Refunds are on their way."
msgstr "Séance annulée. Les remboursements sont en cours."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "The attendee keeps no money. Use only if the attendee already agreed."
msgstr "Le participant ne récupère aucune somme. À utiliser uniquement s’il a déjà donné son accord."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "This action cannot be undone. Every participant will be notified of the cancellation."
msgstr "Cette action est irréversible. Chaque participant sera informé de l'annulation."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "This action cannot be undone. The attendee will be notified of the cancellation."
msgstr "Cette action est irréversible. Le participant sera informé de l’annulation."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "This booking was already cancelled, so no refund was issued."
msgstr "Cette réservation a déjà été annulée, aucun remboursement n'a donc été effectué."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "This booking was already cancelled."
msgstr "Cette réservation a déjà été annulée."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "This booking was paid. Choose how to handle the refund - the attendee always receives the full amount you refund."
msgstr "Cette réservation a été payée. Choisissez comment gérer le remboursement : le participant reçoit toujours l’intégralité du montant que vous remboursez."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Tick the acknowledgement to cancel without refunding the attendee."
msgstr "Cochez la case de confirmation pour annuler sans rembourser le participant."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Tick the acknowledgement to cancel without refunding the participants."
msgstr "Cochez la case de confirmation pour annuler sans rembourser les participants."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "The payments for this meeting changed while this was open. Check them and choose again."
msgstr "Les paiements de cette réunion ont changé pendant que cette fenêtre était ouverte. Vérifiez-les et choisissez à nouveau."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Session cancelled. No payment could be refunded automatically: they are older than the 60-day refund window. You can refund them from Stripe."
msgstr "Séance annulée. Aucun paiement n'a pu être remboursé automatiquement, car ils datent de plus de 60 jours et dépassent le délai de remboursement. Vous pouvez les rembourser depuis Stripe."
