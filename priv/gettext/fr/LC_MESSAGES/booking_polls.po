#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "If need be"
msgstr "Si nécessaire"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "No"
msgstr "Non"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "One of the selected times is no longer available. Please refresh and try again."
msgstr "L'un des horaires sélectionnés n'est plus disponible. Veuillez actualiser la page et réessayer."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "One of your responses wasn't recognised. Please refresh and try again."
msgstr "L'une de vos réponses n'a pas été reconnue. Veuillez actualiser la page et réessayer."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please check your name and email, then try again."
msgstr "Veuillez vérifier votre nom et votre adresse e-mail, puis réessayer."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Save my responses"
msgstr "Enregistrer mes réponses"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Scheduled for %{time}"
msgstr "Planifié pour %{time}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Security verification failed. Please try again."
msgstr "La vérification de sécurité a échoué. Veuillez réessayer."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Security verification is currently unavailable. This may be caused by JavaScript being disabled, browser privacy extensions (Privacy Badger, uBlock Origin, etc.), or network security policies. Please adjust your settings or contact support if the problem persists."
msgstr "La vérification de sécurité est actuellement indisponible. Cela peut être dû à la désactivation de JavaScript, à des extensions de confidentialité du navigateur (Privacy Badger, uBlock Origin, etc.) ou à des politiques de sécurité réseau. Veuillez ajuster vos paramètres ou contacter le support si le problème persiste."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This poll has been cancelled and is no longer accepting responses."
msgstr "Ce sondage a été annulé et n'accepte plus de réponses."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This poll has been scheduled."
msgstr "Ce sondage a été planifié."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "This poll has reached its participant limit."
msgstr "Ce sondage a atteint sa limite de participants."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Times shown in %{timezone}"
msgstr "Horaires affichés en %{timezone}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Too many attempts. Please wait a moment and try again."
msgstr "Trop de tentatives. Veuillez patienter un instant et réessayer."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting as %{name}"
msgstr "Vote en tant que %{name}"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting closes %{deadline}"
msgstr "Le vote se termine %{deadline}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Voting has closed for this poll."
msgstr "Le vote est clos pour ce sondage."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting has closed. Here are the final responses."
msgstr "Le vote est clos. Voici les réponses finales."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Yes"
msgstr "Oui"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Your email"
msgstr "Votre e-mail"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Your name"
msgstr "Votre nom"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Your responses have been saved."
msgstr "Vos réponses ont été enregistrées."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Email me my voting link"
msgstr "M'envoyer mon lien de vote"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Enter your name and email and we'll send you a personal link to vote with. Voted before? Enter the same email to get your link again."
msgstr "Saisissez votre nom et votre e-mail : nous vous enverrons un lien personnel pour voter. Vous avez déjà voté ? Saisissez le même e-mail pour recevoir à nouveau votre lien."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Nothing there after a few minutes? Check your spam folder."
msgstr "Rien reçu après quelques minutes ? Vérifiez votre dossier de spam."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please open the personal voting link we emailed you to vote."
msgstr "Pour voter, ouvrez le lien de vote personnel que nous vous avons envoyé par e-mail."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Save your responses to confirm your email address. They count from then on."
msgstr "Enregistrez vos réponses pour confirmer votre adresse e-mail. Elles comptent à partir de ce moment."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Thanks, your responses count now. We've emailed you a copy with your personal link."
msgstr "Merci, vos réponses comptent désormais. Nous vous avons envoyé par e-mail une copie avec votre lien personnel."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This is your personal link. Please don't share it: anyone who has it can change your responses."
msgstr "Ceci est votre lien personnel. Ne le partagez pas : toute personne qui le possède peut modifier vos réponses."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "This poll is receiving a lot of requests right now. Please try again later."
msgstr "Ce sondage reçoit beaucoup de demandes en ce moment. Veuillez réessayer plus tard."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "This voting link is no longer valid. Please ask for a new one on the poll's page."
msgstr "Ce lien de vote n'est plus valide. Demandez-en un nouveau sur la page du sondage."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please enter your name, then save your responses again."
msgstr "Veuillez saisir votre nom, puis enregistrer à nouveau vos réponses."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "New"
msgstr "Nouveau"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This address is already on the poll, and its voting link was sent a few minutes ago. Please check that inbox, including the spam folder."
msgstr "Cette adresse est déjà inscrite au sondage, et son lien de vote lui a été envoyé il y a quelques minutes. Veuillez vérifier cette boîte de réception, y compris le dossier des spams."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This address is already on the poll; we've sent its voting link again."
msgstr "Cette adresse est déjà inscrite au sondage ; nous lui avons renvoyé son lien de vote."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "We've sent a personal voting link to the address you entered. Open it to vote; your responses count once you save them there."
msgstr "Nous avons envoyé un lien de vote personnel à l'adresse saisie. Ouvrez-le pour voter ; vos réponses sont prises en compte dès que vous les y enregistrez."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "You're voting with your personal link."
msgstr "Vous votez via votre lien personnel."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please enter your email address."
msgstr "Veuillez saisir votre adresse e-mail."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please enter your name."
msgstr "Veuillez saisir votre nom."
