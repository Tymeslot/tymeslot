#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "1 event could not be imported."
msgid_plural "%{count} events could not be imported."
msgstr[0] "1 événement n’a pas pu être importé."
msgstr[1] "%{count} événements n’ont pas pu être importés."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "1 event repeats in a way Outlook can't store, so it was not imported."
msgid_plural "%{count} events repeat in a way Outlook can't store, so they were not imported."
msgstr[0] "1 événement se répète d’une manière qu’Outlook ne peut pas enregistrer ; il n’a donc pas été importé."
msgstr[1] "%{count} événements se répètent d’une manière qu’Outlook ne peut pas enregistrer ; ils n’ont donc pas été importés."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats on a day some months don't have, which Outlook would move to the month's last day."
msgid_plural "%{count} of them repeat on a day some months don't have, which Outlook would move to the month's last day."
msgstr[0] ""
"1 d’entre eux se répète un jour que certains mois n’ont pas, et Outlook le déplacerait au dernier jour du mois."
msgstr[1] ""
"%{count} d’entre eux se répètent un jour que certains mois n’ont pas, et Outlook les déplacerait au dernier jour du mois."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats."
msgid_plural "%{count} of them repeat."
msgstr[0] "1 d’entre eux se répète."
msgstr[1] "%{count} d’entre eux se répètent."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "An import is still running. Please wait for it to finish before importing another file."
msgstr "Une importation est toujours en cours. Veuillez attendre qu’elle se termine avant d’importer un autre fichier."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel"
msgstr "Annuler"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Choose or drop an .ics file"
msgstr "Choisir ou déposer un fichier .ics"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Close"
msgstr "Fermer"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Connect a calendar Tymeslot can write to before importing events."
msgstr "Connectez un calendrier dans lequel Tymeslot peut écrire avant d’importer des événements."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Copy the events of an .ics file into one of your calendars."
msgstr "Copiez les événements d’un fichier .ics dans l’un de vos calendriers."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Exported from Google Calendar, Outlook, Apple Calendar or any other calendar app."
msgstr "Exporté depuis Google Calendar, Outlook, Apple Calendar ou toute autre application de calendrier."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Found 1 event."
msgid_plural "Found %{count} events."
msgstr[0] "1 événement trouvé."
msgstr[1] "%{count} événements trouvés."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Guests are not imported, and nobody is sent an invitation."
msgstr "Les invités ne sont pas importés et aucune invitation n’est envoyée."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Import"
msgstr "Importer"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Import events"
msgstr "Importer des événements"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Import into"
msgstr "Importer dans"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Imported 1 event."
msgid_plural "Imported %{count} events."
msgstr[0] "1 événement importé."
msgstr[1] "%{count} événements importés."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Importing %{done} of %{total} events..."
msgstr "Importation de %{done} événements sur %{total}..."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Invalid calendar selected"
msgstr "Calendrier sélectionné invalide"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Only .ics calendar files can be imported."
msgstr "Seuls les fichiers de calendrier .ics peuvent être importés."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Outlook could not take the skipped dates of 1 recurring event, so it may show extra occurrences."
msgid_plural "Outlook could not take the skipped dates of %{count} recurring events, so they may show extra occurrences."
msgstr[0] "Outlook n’a pas pu prendre en compte les dates ignorées de 1 événement récurrent ; des occurrences supplémentaires peuvent donc apparaître."
msgstr[1] "Outlook n’a pas pu prendre en compte les dates ignorées de %{count} événements récurrents ; des occurrences supplémentaires peuvent donc apparaître."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Reading the file..."
msgstr "Lecture du fichier..."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The file could not be uploaded. Please try again."
msgstr "Le fichier n’a pas pu être téléversé. Veuillez réessayer."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The file is too large. Files up to %{size} MB can be imported."
msgstr "Le fichier est trop volumineux. Les fichiers jusqu’à %{size} Mo peuvent être importés."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import could not be finished. Some of its events may already be in your calendar."
msgstr "L’importation n’a pas pu être terminée. Certains de ses événements se trouvent peut-être déjà dans votre calendrier."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because the calendar could not be written to."
msgstr "L’importation s’est arrêtée, car il n’a pas été possible d’écrire dans le calendrier."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar is not responding. Please try again later."
msgstr "L’importation s’est arrêtée car votre calendrier ne répond pas. Veuillez réessayer plus tard."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar needs to be reconnected."
msgstr "L’importation s’est arrêtée, car votre calendrier doit être reconnecté."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "This file contains more than %{count} events. Please split it into smaller files."
msgstr "Ce fichier contient plus de %{count} événements. Veuillez le diviser en fichiers plus petits."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "This file contains no events to import."
msgstr "Ce fichier ne contient aucun événement à importer."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "This file could not be read as a calendar. Please choose an .ics file."
msgstr "Ce fichier n’a pas pu être lu comme un calendrier. Veuillez choisir un fichier .ics."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Too many imports. Please wait a while before importing another file."
msgstr "Trop d’importations. Veuillez patienter un moment avant d’importer un autre fichier."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "You can close this window; the import carries on."
msgstr "Vous pouvez fermer cette fenêtre ; l’importation se poursuit."
