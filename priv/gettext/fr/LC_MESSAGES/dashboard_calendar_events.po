#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Failed to delete event"
msgstr "Échec de la suppression de l’événement"

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Meeting created and invitation sent"
msgstr "Réunion créée et invitation envoyée"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The recurrence end date must be on or after the event start."
msgstr "La date de fin de récurrence doit être identique ou postérieure au début de l’événement."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many edits. Please wait a moment."
msgstr "Trop de modifications. Veuillez patienter un instant."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many moves. Please wait a moment."
msgstr "Trop de déplacements. Veuillez patienter un instant."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "You don't have permission to modify this event"
msgstr "Vous n’avez pas la permission de modifier cet événement"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Delete failed - queued to retry on next sync"
msgstr "Échec de la suppression - nouvelle tentative programmée à la prochaine synchronisation"

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Failed to update event - changes reverted"
msgstr "Échec de la mise à jour de l’événement - modifications annulées"

#: lib/tymeslot/calendar_grid/event_creation.ex
#, elixir-autogen, elixir-format
msgid "Google Calendar saved the event but didn't return a Meet link — please try again or add it manually."
msgstr "Google Calendar a enregistré l’événement, mais n’a pas renvoyé de lien Meet ; réessayez ou ajoutez-le manuellement."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Guest name is required"
msgstr "Le nom de l’invité est requis"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Meeting with %{name}"
msgstr "Réunion avec %{name}"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This calendar is read-only. Events on it can't be changed from Tymeslot."
msgstr "Ce calendrier est en lecture seule. Les événements qu’il contient ne peuvent pas être modifiés depuis Tymeslot."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Could not change the video link - changes reverted"
msgstr "Impossible de modifier le lien vidéo - modifications annulées"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Could not move the event. It is still on its original calendar."
msgstr "Impossible de déplacer l’événement. Il se trouve toujours dans son calendrier d’origine."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar, but the original could not be removed. Please delete it from its original calendar."
msgstr "Événement copié dans le nouveau calendrier, mais l’original n’a pas pu être supprimé. Veuillez le supprimer de son calendrier d’origine."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar. The original will be removed on the next sync."
msgstr "Événement copié dans le nouveau calendrier. L’original sera supprimé lors de la prochaine synchronisation."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event moved to the new calendar."
msgstr "Événement déplacé vers le nouveau calendrier."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "The video provider did not return a meeting link, so the video link was not changed."
msgstr "Le fournisseur vidéo n’a pas renvoyé de lien de réunion ; le lien vidéo n’a donc pas été modifié."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Video link removed."
msgstr "Lien vidéo supprimé."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Video room created."
msgstr "Salle de réunion créée."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Your calendar could not be reached. The change is saved and will sync on the next attempt."
msgstr "Votre calendrier est injoignable. La modification est enregistrée et sera synchronisée lors de la prochaine tentative."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar, but the move did not finish. Please check its original calendar and delete the original if it is still there."
msgstr "Événement copié dans le nouveau calendrier, mais le déplacement n’a pas abouti. Veuillez vérifier son calendrier d’origine et supprimer l’original s’il s’y trouve encore."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event is a booking, so its video link belongs to the booking. Reschedule or cancel the booking to change it."
msgstr "Cet événement est une réservation : son lien vidéo appartient donc à la réservation. Replanifiez ou annulez la réservation pour le modifier."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Google Calendar added Google Meet to the event but has not returned its link yet. Choose Google Meet again to fetch it."
msgstr "Google Agenda a ajouté Google Meet à l’événement mais n’a pas encore renvoyé son lien. Choisissez à nouveau Google Meet pour le récupérer."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Recurring Exchange events cannot be deleted here yet. Please delete this one in your calendar app."
msgstr "Les événements Exchange récurrents ne peuvent pas encore être supprimés ici. Veuillez supprimer celui-ci dans votre application de calendrier."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event could not be deleted here. Please delete it in your calendar app."
msgstr "Cet événement n’a pas pu être supprimé ici. Veuillez le supprimer dans votre application de calendrier."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Events of a repeating series cannot be switched between all-day and timed here. Please make this change in your calendar app."
msgstr "Les événements d’une série ne peuvent pas passer ici de « toute la journée » à un horaire, ni l’inverse. Veuillez effectuer cette modification dans votre application de calendrier."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "That change cannot be made to the events you chose. A repeat rule can only be changed for all events, or this and following events, and cannot be removed here."
msgstr "Cette modification ne peut pas être appliquée aux événements choisis. Une règle de répétition ne peut être modifiée que pour tous les événements, ou pour cet événement et les suivants, et ne peut pas être supprimée ici."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was updated, but a change you made while it was saving was not applied. Please make it again."
msgid_plural "The series was updated, but %{count} changes you made while it was saving were not applied. Please make them again."
msgstr[0] "La série a été mise à jour, mais une modification faite pendant l’enregistrement n’a pas été appliquée. Veuillez la refaire."
msgstr[1] "La série a été mise à jour, mais %{count} modifications faites pendant l’enregistrement n’ont pas été appliquées. Veuillez les refaire."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event could not be matched to its series. Refresh your calendars and try again."
msgstr "Cet événement n’a pas pu être rattaché à sa série. Actualisez vos calendriers et réessayez."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series repeats on fixed days, such as the second Monday of the month, so it cannot be moved like this. Please make this change in your calendar app."
msgstr "Cette série se répète à des jours fixes, par exemple le deuxième lundi du mois, et ne peut donc pas être déplacée ainsi. Veuillez effectuer cette modification dans votre application de calendrier."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series' repeat rule cannot be split here. Please make this change in your calendar app."
msgstr "La règle de répétition de cette série ne peut pas être scindée ici. Veuillez effectuer cette modification dans votre application de calendrier."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "A Teams meeting on the series is not carried over."
msgstr "Une réunion Teams de la série n’est pas reprise."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "A recurring event can only be moved to a calendar of the same kind of account: Google to Google, Outlook to Outlook, or CalDAV to CalDAV."
msgstr "Un événement récurrent ne peut être déplacé que vers un calendrier du même type de compte : de Google vers Google, d’Outlook vers Outlook ou de CalDAV vers CalDAV."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Could not move the series. It is still on its original calendar."
msgstr "Impossible de déplacer la série. Elle se trouve toujours dans son calendrier d’origine."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Events in the series that were changed on their own go back to the series' usual pattern."
msgstr "Les événements de la série modifiés individuellement reprennent le modèle habituel de la série."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Events in the series that were changed or cancelled on their own go back to the series' usual pattern."
msgstr "Les événements de la série modifiés ou annulés individuellement reprennent le modèle habituel de la série."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Guests are sent a cancellation for the original series and an invitation to the moved one."
msgstr "Les invités reçoivent une annulation de la série d’origine et une invitation à la série déplacée."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Recurring events on this calendar cannot be moved to another calendar. Only single events can be moved."
msgstr "Les événements récurrents de ce calendrier ne peuvent pas être déplacés vers un autre calendrier. Seuls les événements uniques peuvent être déplacés."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "That calendar cannot be written to. Please choose another calendar."
msgstr "Impossible d’écrire dans ce calendrier. Veuillez choisir un autre calendrier."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series is already on that calendar."
msgstr "La série se trouve déjà dans ce calendrier."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was copied to %{calendar}, but the original series could not be removed. Please delete it from its original calendar."
msgstr "La série a été copiée vers %{calendar}, mais la série d’origine n’a pas pu être supprimée. Veuillez la supprimer de son calendrier d’origine."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was moved to %{calendar}."
msgstr "La série a été déplacée vers %{calendar}."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was moved, but a change you made while it was moving was not applied. Please make it again."
msgid_plural "The series was moved, but %{count} changes you made while it was moving were not applied. Please make them again."
msgstr[0] "La série a été déplacée, mais une modification faite pendant le déplacement n’a pas été appliquée. Veuillez la refaire."
msgstr[1] "La série a été déplacée, mais %{count} modifications faites pendant le déplacement n’ont pas été appliquées. Veuillez les refaire."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "A change to this series is still saving. Please make this change once it has saved."
msgstr "Une modification de cette série est encore en cours d’enregistrement. Veuillez refaire cette modification une fois l’enregistrement terminé."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Delete failed - queued to retry on next sync. Attendees have not been notified."
msgstr "Échec de la suppression - nouvelle tentative programmée à la prochaine synchronisation. Les participants n'ont pas été informés."

#: lib/tymeslot_web/live/dashboard/calendar/panel_group_event.ex
#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Too many new meetings. Please wait a moment."
msgstr "Trop de nouvelles réunions. Veuillez patienter un instant."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Someone else organises this meeting, so Tymeslot can't move or split a series you were only invited to."
msgstr "Cette réunion est organisée par quelqu'un d'autre : Tymeslot ne peut pas déplacer ni scinder une série à laquelle vous êtes seulement invité."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This is a group booking. Move it, cancel it or change who attends from the meeting instead."
msgstr "Il s'agit d'une réservation de groupe. Déplacez-la, annulez-la ou modifiez les participants depuis la réunion."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "You already have a meeting at this time. Please choose a different time."
msgstr "Vous avez déjà une réunion à cette heure-là. Veuillez choisir un autre horaire."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This repeat pattern can't be saved to Outlook."
msgstr "Ce mode de répétition ne peut pas être enregistré dans Outlook."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Outlook can't skip the months that don't have this series' day, and would move those events to the month's last day. Please start the series on the 28th or earlier, or save it to another calendar."
msgstr ""
"Outlook ne peut pas ignorer les mois qui n’ont pas le jour de cette série et déplacerait ces événements au dernier jour du mois. Veuillez faire commencer la série le 28 au plus tard, ou l’enregistrer dans un autre calendrier."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series changed while you were editing it, and nothing is left of it from this event on. Nothing was saved."
msgstr "Cette série a changé pendant que vous la modifiiez, et il n’en reste plus rien à partir de cet événement. Rien n’a été enregistré."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series changed while you were editing it, so the events left in it can no longer be counted. Nothing was saved. Refresh the calendar and try again."
msgstr "Cette série a changé pendant que vous la modifiiez, les événements restants ne peuvent donc plus être comptés. Rien n’a été enregistré. Actualisez le calendrier et réessayez."

#: lib/tymeslot_web/live/dashboard/calendar/panel_guests.ex
#, elixir-autogen, elixir-format
msgid "Attendee added, but their invitation could not be sent."
msgstr "Participant ajouté, mais son invitation n'a pas pu être envoyée."

#: lib/tymeslot_web/live/dashboard/calendar/panel_guests.ex
#, elixir-autogen, elixir-format
msgid "Attendee removed, but they could not be notified."
msgstr "Participant supprimé, mais il n'a pas pu être notifié."

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
msgid "%{count} hour before"
msgid_plural "%{count} hours before"
msgstr[0] "%{count} heure avant"
msgstr[1] "%{count} heures avant"

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
msgid "%{count} minute before"
msgid_plural "%{count} minutes before"
msgstr[0] "%{count} minute avant"
msgstr[1] "%{count} minutes avant"

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
msgid "%{method} %{minutes}"
msgstr "%{method} %{minutes}"

