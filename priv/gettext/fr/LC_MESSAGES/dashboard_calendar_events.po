msgstr "1 jour avant"

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
msgid "1 hour before"
msgstr "1 heure avant"

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
msgid "Email"
msgstr "E-mail"

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
msgid "Notification"
msgstr "Notification"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Ada Lovelace"
msgstr "Ada Lovelace"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Books the slot, emails the guest an invitation, and adds it to your calendar."
msgstr "Réserve le créneau, envoie une invitation par e-mail à l’invité et l’ajoute à votre calendrier."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Guest name"
msgstr "Nom de l’invité"

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
msgid "before the event"
msgstr "avant l'événement"

#: lib/tymeslot_web/live/dashboard/calendar/panel_new_form.ex
#, elixir-autogen, elixir-format
msgid "An agenda, or anything to bring or prepare"
msgstr "Un ordre du jour, ou ce qu’il faut apporter ou préparer"

#: lib/tymeslot_web/live/dashboard/calendar/panel_new_form.ex
#, elixir-autogen, elixir-format
msgid "Included in the invitation and on the calendar entry."
msgstr "Incluse dans l’invitation et dans l’entrée du calendrier."

#: lib/tymeslot_web/live/dashboard/calendar/panel_new_form.ex
#, elixir-autogen, elixir-format
msgid "Note to the guest"
msgstr "Note pour l’invité"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Language of the invitation"
msgstr "Langue de l’invitation"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "The language every email about this meeting is written in, for the guest and anyone else invited."
msgstr "La langue de tous les e-mails concernant cette réunion, pour l’invité comme pour les autres personnes conviées."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Add up to %{count} reminder email for this meeting. The guest and anyone else invited receive it."
msgid_plural "Add up to %{count} reminder emails for this meeting. The guest and anyone else invited receive it."
msgstr[0] "Ajoutez jusqu’à %{count} e-mail de rappel pour cette réunion. L’invité et toutes les autres personnes conviées le reçoivent."
msgstr[1] "Ajoutez jusqu’à %{count} e-mails de rappel pour cette réunion. L’invité et toutes les autres personnes conviées les reçoivent."

#: lib/tymeslot_web/live/dashboard/calendar/undelivered_notice.ex
#, elixir-autogen, elixir-format
msgid "Dismiss"
msgstr "Ignorer"

#: lib/tymeslot_web/live/dashboard/calendar/undelivered_notice.ex
#, elixir-autogen, elixir-format
msgid "The latest update could not be emailed to this guest. Let them know another way."
msgid_plural "The latest update could not be emailed to these guests. Let them know another way."
msgstr[0] "La dernière modification n’a pas pu être envoyée par e-mail à cet invité. Prévenez-le autrement."
msgstr[1] "La dernière modification n’a pas pu être envoyée par e-mail à ces invités. Prévenez-les autrement."
