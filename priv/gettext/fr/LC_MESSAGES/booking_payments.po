#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking cancelled"
msgstr "Réservation annulée"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking confirmed"
msgstr "Réservation confirmée"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking not accepted"
msgstr "Réservation non acceptée"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking request expired"
msgstr "Demande de réservation expirée"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Confirming your payment…"
msgstr "Confirmation de votre paiement…"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "If there's no answer by %{by_deadline}, the request lapses and you're refunded automatically."
msgstr "Si personne ne répond avant le %{by_deadline}, la demande expire et votre paiement vous est remboursé automatiquement."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "If there's no answer by %{by_deadline}, the request lapses."
msgstr "Si personne ne répond avant le %{by_deadline}, la demande expire."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Nobody responded to this request in time, so it has lapsed."
msgstr "Personne n’a répondu à temps, la demande a donc expiré."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Nobody responded to this request in time, so it has lapsed. Your payment is being refunded."
msgstr "Personne n’a répondu à temps, la demande a donc expiré. Votre paiement est en cours de remboursement."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment cancelled"
msgstr "Paiement annulé"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment not completed"
msgstr "Paiement non finalisé"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment received"
msgstr "Paiement reçu"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Please wait while we confirm your booking."
msgstr "Veuillez patienter pendant la confirmation de votre réservation."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Return to booking"
msgstr "Retour à la réservation"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thank you, your booking is confirmed for %{for_date}."
msgstr "Merci, votre réservation est confirmée pour le %{for_date}."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thanks, your payment went through. Your booking is not confirmed yet though:"
msgstr "Merci, votre paiement a bien été effectué. Votre réservation n’est cependant pas encore confirmée :"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking has been cancelled, so it won't be going ahead."
msgstr "Cette réservation a été annulée et n’aura donc pas lieu."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking wasn't accepted, so it won't be going ahead."
msgstr "Cette réservation n’a pas été acceptée et n’aura donc pas lieu."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking wasn't accepted, so it won't be going ahead. Your payment is being refunded."
msgstr "Cette réservation n’a pas été acceptée et n’aura donc pas lieu. Votre paiement est en cours de remboursement."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. You can return and try again at any time."
msgstr "Votre réservation n’a pas été confirmée. Vous pouvez revenir et réessayer à tout moment."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Paid: %{amount}"
msgstr "Payé : %{amount}"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. Your invitation stays reserved for it until the unfinished checkout expires, and a link to book again will appear here as soon as it does."
msgstr "Votre réservation n’a pas été confirmée. Votre invitation lui reste réservée jusqu’à l’expiration du paiement inachevé ; un lien pour réserver à nouveau apparaîtra ici dès que ce sera le cas."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. To try again, open the invitation link you were sent."
msgstr "Votre réservation n'est pas confirmée. Pour réessayer, ouvrez le lien d'invitation qui vous a été envoyé."

#: lib/tymeslot/meeting_payments/checkout_sessions.ex
#, elixir-autogen, elixir-format
msgid "%{name}, %{count} session"
msgid_plural "%{name}, %{count} sessions"
msgstr[0] "%{name}, %{count} séance"
msgstr[1] "%{name}, %{count} séances"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thank you, your %{count} session is confirmed, the first on %{on_date}."
msgid_plural "Thank you, your %{count} sessions are confirmed, the first on %{on_date}."
msgstr[0] "Merci, votre %{count} séance est confirmée, la première le %{on_date}."
msgstr[1] "Merci, vos %{count} séances sont confirmées, la première le %{on_date}."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "The payment wasn't completed in time, so the seat held for you was released. You can return and book again."
msgid_plural "The payment wasn't completed in time, so the seats held for you were released. You can return and book again."
msgstr[0] "Le paiement n’a pas été finalisé à temps, la place qui vous était réservée a donc été libérée. Vous pouvez revenir et réserver à nouveau."
msgstr[1] "Le paiement n’a pas été finalisé à temps, les places qui vous étaient réservées ont donc été libérées. Vous pouvez revenir et réserver à nouveau."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your payment arrived after the seat held for you was released, and the session had no room left. Your payment is being refunded."
msgid_plural "Your payment arrived after the seats held for you were released, and the session had no room left. Your payment is being refunded."
msgstr[0] "Votre paiement est arrivé après la libération de la place qui vous était réservée, et la session était déjà complète. Votre paiement est en cours de remboursement."
msgstr[1] "Votre paiement est arrivé après la libération des places qui vous étaient réservées, et la session était déjà complète. Votre paiement est en cours de remboursement."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your seat was released"
msgid_plural "Your seats were released"
msgstr[0] "Votre place a été libérée"
msgstr[1] "Vos places ont été libérées"
