msgstr "Ouvrir dans le tableau de bord"

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "Reschedule"
msgstr "Reporter"

#: lib/tymeslot/emails/shared/series_sessions.ex
