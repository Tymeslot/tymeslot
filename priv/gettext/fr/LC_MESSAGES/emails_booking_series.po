msgstr "Séance %{position} sur %{count}"

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "The attached calendar file adds every session to your calendar."
msgstr "Le fichier de calendrier joint ajoute toutes les séances à votre calendrier."

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "The join link will be in your reminder."
msgstr "Le lien de connexion figurera dans votre rappel."

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "Total paid: %{amount}"
msgstr "Total payé : %{amount}"

#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "Would you like to book another time?"
msgstr "Souhaitez-vous réserver un autre créneau ?"

#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "You cancelled %{count} session with %{attendee}"
msgid_plural "You cancelled %{count} sessions with %{attendee}"
msgstr[0] "Vous avez annulé %{count} séance avec %{attendee}"
msgstr[1] "Vous avez annulé %{count} séances avec %{attendee}"

#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "You cancelled the sessions below. %{attendee} has been told."
msgstr "Vous avez annulé les séances ci-dessous. Nous en avons informé %{attendee}."

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "Your %{count} session with %{host} is booked"
msgid_plural "Your %{count} sessions with %{host} are booked"
msgstr[0] "Vous avez réservé %{count} séance avec %{host}"
msgstr[1] "Vous avez réservé %{count} séances avec %{host}"

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "This session has been cancelled."
msgstr "Cette séance a été annulée."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "%{attendee} requests %{count} session"
msgid_plural "%{attendee} requests %{count} sessions"
msgstr[0] "%{attendee} demande %{count} séance"
msgstr[1] "%{attendee} demande %{count} séances"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Approve all sessions"
msgstr "Accepter toutes les séances"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Both buttons open the request for you to confirm. Your answer applies to every session, and nothing is decided until you choose there."
msgstr "Les deux boutons ouvrent la demande, où vous confirmez votre choix. Votre réponse s’applique à toutes les séances, et rien n’est décidé tant que vous n’avez pas choisi sur cette page."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Decline all sessions"
msgstr "Refuser toutes les séances"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Every session is held until you answer. If you haven't replied by %{deadline}, the request lapses and %{name} is told the times are free again."
msgstr "Toutes les séances restent réservées jusqu’à votre réponse. Sans réponse avant le %{deadline}, la demande expire et %{name} est informé que les créneaux sont de nouveau libres."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Every session stays held for %{name} until you answer."
msgstr "Toutes les séances restent réservées pour %{name} jusqu’à votre réponse."

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, %{host} can't make the sessions below, so none of them is booked."
msgstr "Bonjour %{name}, %{host} n’est pas disponible pour les séances ci-dessous, aucune d’elles n’est donc réservée."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, %{host} has your request for the sessions below. They are held for you but not booked until %{host} approves them, and you'll hear either way by %{deadline}."
msgstr "Bonjour %{name}, %{host} a bien reçu votre demande pour les séances ci-dessous. Elles sont retenues pour vous, mais ne seront réservées qu’une fois acceptées par %{host}. Vous recevrez une réponse dans tous les cas d’ici le %{deadline}."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, %{host} has your request for the sessions below. They are held for you but not booked until %{host} approves them."
msgstr "Bonjour %{name}, %{host} a bien reçu votre demande pour les séances ci-dessous. Elles sont retenues pour vous, mais ne seront réservées qu’une fois acceptées par %{host}."

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, your request wasn't answered in time, so the sessions below are no longer held for you."
msgstr "Bonjour %{name}, votre demande n’a pas reçu de réponse à temps, les séances ci-dessous ne sont donc plus retenues pour vous."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Needs your answer"
msgstr "Votre réponse est attendue"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "No longer held"
msgstr "Créneaux libérés"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Not confirmed"
msgstr "Non confirmé"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Request sent"
msgstr "Demande envoyée"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "These times are available for booking again."
msgstr "Ces créneaux sont de nouveau disponibles à la réservation."

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "They added:"
msgstr "Message ajouté :"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Your request for %{count} session expired"
msgid_plural "Your request for %{count} sessions expired"
msgstr[0] "Votre demande pour %{count} séance a expiré"
msgstr[1] "Votre demande pour %{count} séances a expiré"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Your request for %{count} session was declined"
msgid_plural "Your request for %{count} sessions was declined"
msgstr[0] "Votre demande pour %{count} séance a été refusée"
msgstr[1] "Votre demande pour %{count} séances a été refusée"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Your request for %{count} session was sent"
msgid_plural "Your request for %{count} sessions was sent"
msgstr[0] "Votre demande pour %{count} séance a été envoyée"
msgstr[1] "Votre demande pour %{count} séances a été envoyée"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Reminder: %{attendee} requests %{count} session"
msgid_plural "Reminder: %{attendee} requests %{count} sessions"
msgstr[0] "Rappel : %{attendee} demande %{count} séance"
msgstr[1] "Rappel : %{attendee} demande %{count} séances"

#: lib/tymeslot/emails/templates/series_request.ex
