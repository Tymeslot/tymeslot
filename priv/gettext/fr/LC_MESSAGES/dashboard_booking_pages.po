#: lib/tymeslot_web/components/dashboard/booking_pages/delete_page_modal.ex
#, elixir-autogen, elixir-format
msgid "Bookings made through it keep working and show your main page's look. Its colours and uploaded backgrounds are removed."
msgstr "Les réservations déjà effectuées via cette page restent valables et s'affichent avec l'apparence de votre page principale. Ses couleurs et ses arrière-plans importés sont supprimés."

#: lib/tymeslot_web/components/dashboard/booking_pages/delete_page_modal.ex
#, elixir-autogen, elixir-format
msgid "Delete %{address}? Its address will lead to your main page at %{main}, and websites that embed it will show your main page."
msgstr "Supprimer %{address} ? Son adresse redirigera vers votre page principale, %{main}, et les sites qui l'intègrent afficheront votre page principale."

#: lib/tymeslot_web/live/dashboard/theme_settings/page_settings_component.ex
#: lib/tymeslot_web/live/dashboard/theme_settings/pages_component.ex
