#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "A test message is sent only to your current verified account email."
msgstr "Le message de test est envoyé uniquement à l’adresse e-mail actuelle et vérifiée de votre compte."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Check the email settings and try again."
msgstr "Vérifiez les paramètres de messagerie et réessayez."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Choose a public SMTP hostname. Private and local mail servers are not supported."
msgstr "Choisissez un nom d’hôte SMTP public. Les serveurs de messagerie privés et locaux ne sont pas pris en charge."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Credentials are saved securely. Leave the username and password blank to keep them."
msgstr "Les identifiants sont enregistrés en toute sécurité. Laissez le nom d’utilisateur et le mot de passe vides pour les conserver."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP is disabled"
msgstr "Le SMTP personnalisé est désactivé"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP is enabled"
msgstr "Le SMTP personnalisé est activé"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Delete identity and credentials"
msgstr "Supprimer l’identité et les identifiants"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Delete saved identity"
msgstr "Supprimer l’identité enregistrée"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Delete this SMTP identity?"
msgstr "Supprimer cette identité SMTP ?"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Email sending"
msgstr "Envoi d’e-mails"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Email sending settings are unavailable. Reload the page to continue."
msgstr "Les paramètres d’envoi d’e-mails sont indisponibles. Rechargez la page pour continuer."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Email settings need attention"
msgstr "Les paramètres de messagerie nécessitent votre attention"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Email testing is temporarily unavailable. Try again shortly."
msgstr "Les tests d’e-mail sont temporairement indisponibles. Réessayez dans un instant."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "From address"
msgstr "Adresse d’expéditeur"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "From display name"
msgstr "Nom affiché de l’expéditeur"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Implicit TLS (port 465)"
msgstr "TLS implicite (port 465)"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Keep identity"
msgstr "Conserver l’identité"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Required STARTTLS (port 587)"
msgstr "STARTTLS obligatoire (port 587)"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP hostname"
msgstr "Nom d’hôte SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP password or app password"
msgstr "Mot de passe SMTP ou mot de passe d’application"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP settings"
msgstr "Paramètres SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP username"
msgstr "Nom d’utilisateur SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Connection security"
msgstr "Sécurité de la connexion"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Test and save"
msgstr "Tester et enregistrer"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Test and save your SMTP settings to activate this sending identity."
msgstr "Testez et enregistrez vos paramètres SMTP pour activer cette identité d’envoi."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Test and save these settings before enabling them."
msgstr "Testez et enregistrez ces paramètres avant de les activer."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Testing SMTP settings"
msgstr "Test des paramètres SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Testing and saving…"
msgstr "Test et enregistrement en cours…"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP hostname could not be resolved. Check it and try again."
msgstr "Le nom d’hôte SMTP n’a pas pu être résolu. Vérifiez-le et réessayez."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP operation could not be completed. Check the settings and try again."
msgstr "L’opération SMTP n’a pas pu être effectuée. Vérifiez les paramètres et réessayez."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server accepted the test and your sending identity is now active. Acceptance does not confirm inbox delivery."
msgstr "Le serveur SMTP a accepté le message de test et votre identité d’envoi est maintenant active. Cette acceptation ne confirme pas la remise dans la boîte de réception."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server did not respond in time. Try again shortly."
msgstr "Le serveur SMTP n’a pas répondu à temps. Réessayez dans un instant."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server refused the credentials. Check the username and password, or use an app password."
msgstr "Le serveur SMTP a refusé les identifiants. Vérifiez le nom d’utilisateur et le mot de passe, ou utilisez un mot de passe d’application."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server timed out. It may have accepted the message; check before trying again."
msgstr "Le délai d’attente du serveur SMTP a expiré. Il a peut-être accepté le message ; vérifiez avant de réessayer."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The required TLS connection failed. Check the SMTP hostname and connection security."
msgstr "La connexion TLS requise a échoué. Vérifiez le nom du serveur SMTP et la sécurité de la connexion."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "The saved SMTP identity and credentials were deleted."
msgstr "L’identité SMTP enregistrée et les identifiants ont été supprimés."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The saved credentials could not be read. Enter them again and test the connection."
msgstr "Les identifiants enregistrés n’ont pas pu être lus. Saisissez-les à nouveau et testez la connexion."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "The server is being tested. Existing email settings stay unchanged if the test fails."
msgstr "Le serveur est en cours de test. Les paramètres de messagerie existants restent inchangés si le test échoue."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many SMTP tests or connections. Wait a few minutes and try again."
msgstr "Trop de tests ou de connexions SMTP. Patientez quelques minutes et réessayez."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Use a public SMTP server with authenticated TLS. Your provider must authorize the From address and manage SPF, DKIM, and DMARC for its domain."
msgstr "Utilisez un serveur SMTP public avec authentification et TLS. Votre fournisseur doit autoriser l’adresse d’expéditeur et gérer SPF, DKIM et DMARC pour son domaine."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Use custom sending email"
msgstr "Utiliser une adresse e-mail d’envoi personnalisée"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Verify your account email before testing or enabling custom SMTP."
msgstr "Vérifiez l’adresse e-mail de votre compte avant de tester ou d’activer le SMTP personnalisé."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Your SMTP identity sends booking confirmations, reminders, cancellations, rescheduling, approvals, and guest/group notices. Account and security emails use the platform sender."
msgstr "Votre identité SMTP envoie les confirmations de réservation, rappels, annulations, reports, approbations et notifications aux invités et groupes. Les e-mails de compte et de sécurité utilisent l’expéditeur de la plateforme."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Your current sending identity has not changed. Review the error and test again."
msgstr "Votre identité d’expéditeur actuelle n’a pas changé. Vérifiez l’erreur et relancez le test."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Your email settings changed. Review the current settings and try again."
msgstr "Vos paramètres de messagerie ont changé. Vérifiez les paramètres actuels et réessayez."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP remains selected. Failed scheduling emails are retried without switching to the platform sender."
msgstr "Le SMTP personnalisé reste sélectionné. Les e-mails de planification ayant échoué sont réessayés sans passer à l’expéditeur de la plateforme."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Poll emails, dashboard calendar invitations, updates and cancellations, and booking refund notices also use your SMTP identity. Integration health, dispute and payout notices use the platform sender."
msgstr "Les e-mails de sondage, les invitations, mises à jour et annulations du calendrier du tableau de bord ainsi que les avis de remboursement de réservations utilisent aussi votre identité SMTP. Les avis sur l’état des intégrations, les litiges et les versements utilisent l’expéditeur de la plateforme."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Scheduling emails currently use the platform sender."
msgstr "Les e-mails de planification utilisent actuellement l’expéditeur de la plateforme."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "Scheduling emails now use the platform sender."
msgstr "Les e-mails de planification utilisent désormais l’expéditeur de la plateforme."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Scheduling emails use this SMTP identity."
msgstr "Les e-mails de planification utilisent cette identité SMTP."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "This removes the saved credentials. Scheduling emails will use the platform sender."
msgstr "Cette action supprime les identifiants enregistrés. Les e-mails de planification utiliseront l’expéditeur de la plateforme."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "SMTP connection healthy. Settings saved and active."
msgstr "La connexion SMTP fonctionne. Paramètres enregistrés et actifs."
