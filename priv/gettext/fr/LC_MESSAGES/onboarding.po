msgstr "Bienvenue sur votre tableau de bord Tymeslot"

#: lib/tymeslot/onboarding/dashboard_tour.ex
#, elixir-autogen, elixir-format
msgid "You're set"
msgstr "Tout est prêt"

#: lib/tymeslot/onboarding/dashboard_tour.ex
