#: lib/tymeslot_web/controllers/auth/invitation_controller.ex
#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Accept your invitation"
msgstr "Acceptez votre invitation"

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Choose how you'll sign in as %{email} to finish setting up your account."
msgstr "Choisissez comment vous connecter en tant que %{email} pour finaliser la configuration de votre compte."

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Confirm password"
msgstr "Confirmer le mot de passe"

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "No sign-in method is switched on, so this invitation can't be accepted. Please contact your administrator."
msgstr "Aucune méthode de connexion n’est activée : cette invitation ne peut donc pas être acceptée. Veuillez contacter votre administrateur."

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Or sign in with"
msgstr "Ou se connecter avec"

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Password"
msgstr "Mot de passe"

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Password sign-in is turned off. Please choose another way to sign in."
msgstr "La connexion par mot de passe est désactivée. Veuillez choisir une autre méthode de connexion."

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Set password and sign in"
msgstr "Définir le mot de passe et se connecter"

#: lib/tymeslot/auth/invitations.ex
#, elixir-autogen, elixir-format
msgid "The password couldn't be set. Please try again with a different one."
msgstr "Le mot de passe n’a pas pu être défini. Veuillez réessayer avec un autre mot de passe."

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "This invitation has expired. Ask your administrator to send you a new one."
msgstr "Cette invitation a expiré. Demandez à votre administrateur de vous en envoyer une nouvelle."

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "This invitation link is no longer valid. It may have been used already, or replaced by a newer invitation."
msgstr "Ce lien d’invitation n’est plus valide. Il a peut-être déjà été utilisé ou remplacé par une invitation plus récente."

#: lib/tymeslot_web/controllers/auth/invitation_controller.ex
#, elixir-autogen, elixir-format
msgid "This sign-in option is not available."
msgstr "Cette option de connexion n’est pas disponible."

#: lib/tymeslot_web/controllers/auth/invitation_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many OAuth attempts. Please try again later."
msgstr "Trop de tentatives OAuth. Veuillez réessayer plus tard."

#: lib/tymeslot_web/controllers/auth/invitation_controller.ex
#, elixir-autogen, elixir-format
msgid "Welcome to Tymeslot! Your password is set."
msgstr "Bienvenue sur Tymeslot ! Votre mot de passe est défini."

#: lib/tymeslot_web/controllers/auth/invitation_controller.ex
#, elixir-autogen, elixir-format
msgid "Your password is set. Please log in to continue."
msgstr "Votre mot de passe est défini. Veuillez vous connecter pour continuer."
