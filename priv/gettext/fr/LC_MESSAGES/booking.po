msgid "This booking wasn't accepted, so it won't be going ahead. Your payment is being refunded."
msgstr "Cette réservation n’a pas été acceptée et n’aura donc pas lieu. Votre paiement est en cours de remboursement."

#: lib/tymeslot_web/themes/quill/scheduling/components/confirmation_component.ex
#: lib/tymeslot_web/themes/rhythm/scheduling/components/confirmation_component.ex
#, elixir-autogen, elixir-format
msgid "%{name}, your request has been sent."
msgstr "%{name}, votre demande a été envoyée."

#: lib/tymeslot_web/themes/quill/scheduling/components/confirmation_component.ex
#: lib/tymeslot_web/themes/rhythm/scheduling/components/confirmation_component.ex
#, elixir-autogen, elixir-format
msgid "%{name}, your request to %{organizer_name} has been sent."
msgstr "%{name}, votre demande à %{organizer_name} a été envoyée."

#: lib/tymeslot_web/themes/shared/components/approval_notice.ex
#, elixir-autogen, elixir-format
msgid "%{organizer} confirms each booking personally, so submitting this sends a request rather than booking the time outright. You'll pay now to hold the slot; if %{organizer} declines or doesn't answer in time, you're refunded in full."
msgstr "%{organizer} valide chaque réservation personnellement : en envoyant ce formulaire, vous faites une demande plutôt que de réserver directement. Vous payez maintenant pour réserver le créneau ; si %{organizer} refuse ou ne répond pas à temps, vous êtes intégralement remboursé."

#: lib/tymeslot_web/themes/quill/scheduling/components/confirmation_component.ex
#: lib/tymeslot_web/themes/rhythm/scheduling/components/confirmation_component.ex
#, elixir-autogen, elixir-format
msgid "Add tentative hold to calendar"
msgstr "Ajouter la réservation provisoire au calendrier"

#: lib/tymeslot_web/themes/quill/scheduling/components/confirmation_component.ex
#: lib/tymeslot_web/themes/rhythm/scheduling/components/confirmation_component.ex
#, elixir-autogen, elixir-format
msgid "Changed your mind? Your request email has a link to withdraw it."
msgstr "Vous avez changé d’avis ? L’e-mail de votre demande contient un lien pour la retirer."

#: lib/tymeslot_web/themes/shared/booking_labels.ex
#, elixir-autogen, elixir-format
