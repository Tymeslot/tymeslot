msgstr "Modifier l’événement récurrent"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/recurrence_prompt_modal.ex
#, elixir-autogen, elixir-format
msgid "This and following events"
msgstr "Cet événement et les suivants"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/recurrence_prompt_modal.ex
#, elixir-autogen, elixir-format
msgid "This event"
msgstr "Cet événement"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/recurrence_prompt_modal.ex
#, elixir-autogen, elixir-format
msgid "This event is part of a repeating series. Which events should your change apply to?"
msgstr ""
"Cet événement fait partie d’une série. À quels événements votre modification"
" doit-elle s’appliquer ?"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/recurrence_prompt_modal.ex
#, elixir-autogen, elixir-format
msgid "every occurrence in the series changes, earlier ones included."
msgstr ""
"toutes les occurrences de la série changent, y compris les précédentes."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/recurrence_prompt_modal.ex
#, elixir-autogen, elixir-format
msgid "only this occurrence changes, and the rest of the series stays as it is."
msgstr "seule cette occurrence change, le reste de la série reste inchangé."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/recurrence_prompt_modal.ex
#, elixir-autogen, elixir-format
msgid "this occurrence and every later one change, and the earlier ones stay as they are."
msgstr ""
"cette occurrence et toutes les suivantes changent, les précédentes restent "
"inchangées."

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "Change a repeating event"
msgstr "Modifier un événement récurrent"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "Delete a repeating event"
msgstr "Supprimer un événement récurrent"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "Only “This event” can be undone."
msgstr "Seule l’option « Cet événement » peut être annulée."

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” repeats. Should the new pattern apply to this and the following events, or to all of them?"
msgstr ""
"« %{title} » se répète. Le nouveau modèle doit-il s’appliquer à cet "
"événement et aux suivants, ou à tous ?"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” repeats. Which events should be deleted?"
msgstr "« %{title} » se répète. Quels événements voulez-vous supprimer ?"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” repeats. Which events should change?"
msgstr "« %{title} » se répète. Quels événements voulez-vous modifier ?"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” repeats. Which events should your changes apply to? Your answer holds until you close the details."
msgstr ""
"« %{title} » se répète. À quels événements vos modifications doivent-elles "
"s’appliquer ? Votre réponse reste valable jusqu’à la fermeture des détails."
