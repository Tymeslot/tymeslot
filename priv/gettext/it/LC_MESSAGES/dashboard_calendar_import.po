#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "1 event could not be imported."
msgid_plural "%{count} events could not be imported."
msgstr[0] "1 evento non è stato importato."
msgstr[1] "%{count} eventi non sono stati importati."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "1 event repeats in a way Outlook can't store, so it was not imported."
msgid_plural "%{count} events repeat in a way Outlook can't store, so they were not imported."
msgstr[0] "1 evento si ripete in un modo che Outlook non può salvare, quindi non è stato importato."
msgstr[1] "%{count} eventi si ripetono in un modo che Outlook non può salvare, quindi non sono stati importati."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats on a day some months don't have, which Outlook would move to the month's last day."
msgid_plural "%{count} of them repeat on a day some months don't have, which Outlook would move to the month's last day."
msgstr[0] ""
"1 si ripete in un giorno che alcuni mesi non hanno e Outlook lo sposterebbe all’ultimo giorno del mese."
msgstr[1] ""
"%{count} si ripetono in un giorno che alcuni mesi non hanno e Outlook li sposterebbe all’ultimo giorno del mese."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats."
msgid_plural "%{count} of them repeat."
msgstr[0] "1 di questi si ripete."
msgstr[1] "%{count} di questi si ripetono."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "An import is still running. Please wait for it to finish before importing another file."
msgstr "Un’importazione è ancora in corso. Attendi che termini prima di importare un altro file."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel"
msgstr "Annulla"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Choose or drop an .ics file"
msgstr "Scegli o rilascia un file .ics"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Close"
msgstr "Chiudi"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Connect a calendar Tymeslot can write to before importing events."
msgstr "Collega un calendario in cui Tymeslot possa scrivere prima di importare gli eventi."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Copy the events of an .ics file into one of your calendars."
msgstr "Copia gli eventi di un file .ics in uno dei tuoi calendari."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Exported from Google Calendar, Outlook, Apple Calendar or any other calendar app."
msgstr "Esportato da Google Calendar, Outlook, Apple Calendar o qualsiasi altra app di calendario."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Found 1 event."
msgid_plural "Found %{count} events."
msgstr[0] "Trovato 1 evento."
msgstr[1] "Trovati %{count} eventi."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Guests are not imported, and nobody is sent an invitation."
msgstr "Gli ospiti non vengono importati e a nessuno viene inviato un invito."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Import"
msgstr "Importa"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Import events"
msgstr "Importa eventi"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Import into"
msgstr "Importa in"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Imported 1 event."
msgid_plural "Imported %{count} events."
msgstr[0] "Importato 1 evento."
msgstr[1] "Importati %{count} eventi."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Importing %{done} of %{total} events..."
msgstr "Importazione di %{done} eventi su %{total}..."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Invalid calendar selected"
msgstr "Calendario selezionato non valido"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Only .ics calendar files can be imported."
msgstr "È possibile importare solo file di calendario .ics."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Outlook could not take the skipped dates of 1 recurring event, so it may show extra occurrences."
msgid_plural "Outlook could not take the skipped dates of %{count} recurring events, so they may show extra occurrences."
msgstr[0] "Outlook non ha potuto accettare le date saltate di 1 evento ricorrente, quindi potrebbe mostrare occorrenze in più."
msgstr[1] "Outlook non ha potuto accettare le date saltate di %{count} eventi ricorrenti, quindi potrebbe mostrare occorrenze in più."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Reading the file..."
msgstr "Lettura del file..."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The file could not be uploaded. Please try again."
msgstr "Impossibile caricare il file. Riprova."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The file is too large. Files up to %{size} MB can be imported."
msgstr "Il file è troppo grande. Si possono importare file fino a %{size} MB."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import could not be finished. Some of its events may already be in your calendar."
msgstr "Non è stato possibile completare l’importazione. Alcuni dei suoi eventi potrebbero essere già nel tuo calendario."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because the calendar could not be written to."
msgstr "L’importazione si è interrotta perché non è stato possibile scrivere nel calendario."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar is not responding. Please try again later."
msgstr "L’importazione si è interrotta perché il tuo calendario non risponde. Riprova più tardi."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar needs to be reconnected."
msgstr "L’importazione si è interrotta perché il tuo calendario deve essere ricollegato."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "This file contains more than %{count} events. Please split it into smaller files."
msgstr "Questo file contiene più di %{count} eventi. Dividilo in file più piccoli."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "This file contains no events to import."
msgstr "Questo file non contiene eventi da importare."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "This file could not be read as a calendar. Please choose an .ics file."
msgstr "Impossibile leggere questo file come calendario. Scegli un file .ics."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Too many imports. Please wait a while before importing another file."
msgstr "Troppe importazioni. Attendi un po’ prima di importare un altro file."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "You can close this window; the import carries on."
msgstr "Puoi chiudere questa finestra; l’importazione continua."
