#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Bookers book several sessions in one go, with one confirmation."
msgstr "Chi prenota prende più sessioni in una volta, con un'unica conferma."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Bookers can also book a single session"
msgstr "Chi prenota può prenotare anche una sola sessione"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Bookers pay %{price} × the number of sessions upfront."
msgstr "Chi prenota paga subito %{price} × il numero di sessioni."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Bookers pick each session from your available times."
msgstr "Chi prenota sceglie ogni sessione tra i tuoi orari disponibili."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Each session in a series takes one seat."
msgstr "Ogni sessione di una serie occupa un posto."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Every day"
msgid_plural "Every %{count} days"
msgstr[0] "Ogni giorno"
msgstr[1] "Ogni %{count} giorni"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Every month"
msgid_plural "Every %{count} months"
msgstr[0] "Ogni mese"
msgstr[1] "Ogni %{count} mesi"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Every series has %{count} session."
msgid_plural "Every series has %{count} sessions."
msgstr[0] "Ogni serie ha %{count} sessione."
msgstr[1] "Ogni serie ha %{count} sessioni."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Every series has the same number of sessions, like a course."
msgstr "Tutte le serie hanno lo stesso numero di sessioni, come un corso."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Every session at the same time, for example every Thursday at 17:00."
msgstr "Tutte le sessioni allo stesso orario, per esempio ogni giovedì alle 17:00."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Every week"
msgid_plural "Every %{count} weeks"
msgstr[0] "Ogni settimana"
msgstr[1] "Ogni %{count} settimane"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Fixed number"
msgstr "Numero fisso"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "From"
msgstr "Da"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "From %{min} to %{max} sessions, as the booker chooses."
msgstr "Da %{min} a %{max} sessioni, a scelta di chi prenota."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "How the sessions are timed"
msgstr "Come sono programmate le sessioni"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Let people book a series"
msgstr "Consenti di prenotare una serie"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Number of sessions"
msgstr "Numero di sessioni"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "On the same weekday of the month, for example the second Thursday."
msgstr "Nello stesso giorno della settimana del mese, per esempio il secondo giovedì."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Repeats"
msgstr "Si ripete"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Same time, repeating"
msgstr "Stesso orario, ripetuto"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Series"
msgstr "Serie"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Series booking is paused: this meeting type books single sessions until you upgrade."
msgstr "La prenotazione di serie è in pausa: finché non passi a un piano superiore, questo tipo di riunione prenota solo sessioni singole."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Sessions at different times"
msgstr "Sessioni a orari diversi"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "To"
msgstr "A"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/scheduling_rules_section.ex
#, elixir-autogen, elixir-format
msgid "With series booking on, this applies to the first session only."
msgstr "Con la prenotazione di serie attiva, questo vale solo per la prima sessione."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Your booking window (%{days} days) applies to the first session only. Later sessions can be booked up to 12 months ahead."
msgstr "La tua finestra di prenotazione (%{days} giorni) vale solo per la prima sessione. Le sessioni successive si possono prenotare fino a 12 mesi in anticipo."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_handlers.ex
#, elixir-autogen, elixir-format
msgid "Your limit of %{limit} bookings per month is lower than the %{needed} sessions a series can book in one month, so some series won't fit."
msgstr "Il tuo limite di %{limit} prenotazioni al mese è inferiore alle %{needed} sessioni che una serie può prenotare in un mese, quindi alcune serie non ci stanno."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_handlers.ex
#, elixir-autogen, elixir-format
msgid "Your limit of %{limit} bookings per week is lower than the %{needed} sessions a series can book in one week, so some series won't fit."
msgstr "Il tuo limite di %{limit} prenotazioni a settimana è inferiore alle %{needed} sessioni che una serie può prenotare in una settimana, quindi alcune serie non ci stanno."
