#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Bookers book several sessions in one go, with one confirmation."
msgstr "Chi prenota prende più sessioni in una volta, con un'unica conferma."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
