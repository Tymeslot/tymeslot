#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Failed to delete event"
msgstr "Eliminazione dell'evento non riuscita"

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Meeting created and invitation sent"
msgstr "Riunione creata e invito inviato"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The recurrence end date must be on or after the event start."
msgstr "La data di fine della ricorrenza deve coincidere con l'inizio dell'evento o essere successiva."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many edits. Please wait a moment."
msgstr "Troppe modifiche. Attendi un momento."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many moves. Please wait a moment."
msgstr "Troppi spostamenti. Attendi un momento."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "You don't have permission to modify this event"
msgstr "Non hai l'autorizzazione per modificare questo evento"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Delete failed - queued to retry on next sync"
msgstr "Eliminazione non riuscita - in coda per un nuovo tentativo alla prossima sincronizzazione"

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Failed to update event - changes reverted"
msgstr "Aggiornamento dell'evento non riuscito - modifiche ripristinate"

#: lib/tymeslot/calendar_grid/event_creation.ex
#, elixir-autogen, elixir-format
msgid "Google Calendar saved the event but didn't return a Meet link — please try again or add it manually."
msgstr "Google Calendar ha salvato l'evento ma non ha restituito un link Meet. Riprova oppure aggiungilo manualmente."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Guest name is required"
msgstr "Il nome dell'ospite è obbligatorio"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Meeting with %{name}"
msgstr "Riunione con %{name}"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This calendar is read-only. Events on it can't be changed from Tymeslot."
msgstr "Questo calendario è in sola lettura. I suoi eventi non possono essere modificati da Tymeslot."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Could not change the video link - changes reverted"
msgstr "Impossibile modificare il link video - modifiche ripristinate"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Could not move the event. It is still on its original calendar."
msgstr "Impossibile spostare l'evento. Si trova ancora nel suo calendario di origine."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar, but the original could not be removed. Please delete it from its original calendar."
msgstr "Evento copiato nel nuovo calendario, ma non è stato possibile rimuovere l'originale. Eliminalo dal suo calendario di origine."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar. The original will be removed on the next sync."
msgstr "Evento copiato nel nuovo calendario. L'originale verrà rimosso alla prossima sincronizzazione."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event moved to the new calendar."
msgstr "Evento spostato nel nuovo calendario."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "The video provider did not return a meeting link, so the video link was not changed."
msgstr "Il provider video non ha restituito un link alla riunione, quindi il link video non è stato modificato."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Video link removed."
msgstr "Link video rimosso."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Video room created."
msgstr "Stanza della riunione creata."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Your calendar could not be reached. The change is saved and will sync on the next attempt."
msgstr "Il tuo calendario non è raggiungibile. La modifica è salvata e verrà sincronizzata al prossimo tentativo."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar, but the move did not finish. Please check its original calendar and delete the original if it is still there."
msgstr "Evento copiato nel nuovo calendario, ma lo spostamento non è stato completato. Controlla il suo calendario di origine ed elimina l'originale se è ancora presente."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event is a booking, so its video link belongs to the booking. Reschedule or cancel the booking to change it."
msgstr "Questo evento è una prenotazione, quindi il suo link video appartiene alla prenotazione. Riprogramma o annulla la prenotazione per modificarlo."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Google Calendar added Google Meet to the event but has not returned its link yet. Choose Google Meet again to fetch it."
msgstr "Google Calendar ha aggiunto Google Meet all'evento ma non ha ancora restituito il link. Scegli di nuovo Google Meet per recuperarlo."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Recurring Exchange events cannot be deleted here yet. Please delete this one in your calendar app."
msgstr "Gli eventi ricorrenti di Exchange non possono ancora essere eliminati qui. Eliminalo nella tua app di calendario."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event could not be deleted here. Please delete it in your calendar app."
msgstr "Non è stato possibile eliminare questo evento qui. Eliminalo nella tua app di calendario."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Events of a repeating series cannot be switched between all-day and timed here. Please make this change in your calendar app."
msgstr "Gli eventi di una serie non possono essere trasformati qui da giornata intera a orario o viceversa. Apporta questa modifica nella tua app di calendario."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "That change cannot be made to the events you chose. A repeat rule can only be changed for all events, or this and following events, and cannot be removed here."
msgstr "Questa modifica non può essere applicata agli eventi scelti. Una regola di ripetizione può essere cambiata solo per tutti gli eventi, o per questo evento e i successivi, e non può essere rimossa qui."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was updated, but a change you made while it was saving was not applied. Please make it again."
msgid_plural "The series was updated, but %{count} changes you made while it was saving were not applied. Please make them again."
msgstr[0] "La serie è stata aggiornata, ma una modifica fatta durante il salvataggio non è stata applicata. Rifalla."
msgstr[1] "La serie è stata aggiornata, ma %{count} modifiche fatte durante il salvataggio non sono state applicate. Rifalle."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event could not be matched to its series. Refresh your calendars and try again."
msgstr "Non è stato possibile collegare questo evento alla sua serie. Aggiorna i tuoi calendari e riprova."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series repeats on fixed days, such as the second Monday of the month, so it cannot be moved like this. Please make this change in your calendar app."
msgstr "Questa serie si ripete in giorni fissi, ad esempio il secondo lunedì del mese, quindi non può essere spostata così. Apporta questa modifica nella tua app di calendario."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series' repeat rule cannot be split here. Please make this change in your calendar app."
msgstr "La regola di ripetizione di questa serie non può essere divisa qui. Apporta questa modifica nella tua app di calendario."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "A Teams meeting on the series is not carried over."
msgstr "Un'eventuale riunione Teams della serie non viene trasferita."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "A recurring event can only be moved to a calendar of the same kind of account: Google to Google, Outlook to Outlook, or CalDAV to CalDAV."
msgstr "Un evento ricorrente può essere spostato solo in un calendario dello stesso tipo di account: da Google a Google, da Outlook a Outlook o da CalDAV a CalDAV."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Could not move the series. It is still on its original calendar."
msgstr "Impossibile spostare la serie. Si trova ancora nel suo calendario di origine."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Events in the series that were changed on their own go back to the series' usual pattern."
msgstr "Gli eventi della serie modificati singolarmente tornano allo schema abituale della serie."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Events in the series that were changed or cancelled on their own go back to the series' usual pattern."
msgstr "Gli eventi della serie modificati o annullati singolarmente tornano allo schema abituale della serie."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Guests are sent a cancellation for the original series and an invitation to the moved one."
msgstr "Gli invitati ricevono un annullamento della serie originale e un invito a quella spostata."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Recurring events on this calendar cannot be moved to another calendar. Only single events can be moved."
msgstr "Gli eventi ricorrenti di questo calendario non possono essere spostati in un altro calendario. Si possono spostare solo gli eventi singoli."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "That calendar cannot be written to. Please choose another calendar."
msgstr "Non è possibile scrivere in questo calendario. Scegli un altro calendario."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series is already on that calendar."
msgstr "La serie si trova già in questo calendario."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was copied to %{calendar}, but the original series could not be removed. Please delete it from its original calendar."
msgstr "La serie è stata copiata in %{calendar}, ma non è stato possibile rimuovere la serie originale. Eliminala dal suo calendario di origine."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was moved to %{calendar}."
msgstr "La serie è stata spostata in %{calendar}."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was moved, but a change you made while it was moving was not applied. Please make it again."
msgid_plural "The series was moved, but %{count} changes you made while it was moving were not applied. Please make them again."
msgstr[0] "La serie è stata spostata, ma una modifica fatta durante lo spostamento non è stata applicata. Rifalla."
msgstr[1] "La serie è stata spostata, ma %{count} modifiche fatte durante lo spostamento non sono state applicate. Rifalle."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "A change to this series is still saving. Please make this change once it has saved."
msgstr "Una modifica a questa serie è ancora in fase di salvataggio. Ripeti questa modifica quando il salvataggio è terminato."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Delete failed - queued to retry on next sync. Attendees have not been notified."
msgstr "Eliminazione non riuscita - in coda per un nuovo tentativo alla prossima sincronizzazione. I partecipanti non sono stati avvisati."

#: lib/tymeslot_web/live/dashboard/calendar/panel_group_event.ex
#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Too many new meetings. Please wait a moment."
msgstr "Troppe nuove riunioni. Attendi un momento."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Someone else organises this meeting, so Tymeslot can't move or split a series you were only invited to."
msgstr "Questa riunione è organizzata da un'altra persona, quindi Tymeslot non può spostare né dividere una serie a cui sei stato solo invitato."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This is a group booking. Move it, cancel it or change who attends from the meeting instead."
msgstr "Questa è una prenotazione di gruppo. Spostala, annullala o modifica i partecipanti dalla riunione."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This repeat pattern can't be saved to Outlook."
msgstr "Questo schema di ripetizione non può essere salvato in Outlook."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Outlook can't skip the months that don't have this series' day, and would move those events to the month's last day. Please start the series on the 28th or earlier, or save it to another calendar."
msgstr ""
"Outlook non può saltare i mesi che non hanno il giorno di questa serie e sposterebbe quegli eventi all'ultimo giorno del mese. Fai iniziare la serie il 28 o prima, oppure salvala in un altro calendario."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series changed while you were editing it, and nothing is left of it from this event on. Nothing was saved."
msgstr "Questa serie è cambiata mentre la stavi modificando e, a partire da questo evento, non ne rimane più nulla. Non è stato salvato nulla."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series changed while you were editing it, so the events left in it can no longer be counted. Nothing was saved. Refresh the calendar and try again."
msgstr "Questa serie è cambiata mentre la stavi modificando, quindi non è più possibile contare gli eventi rimanenti. Non è stato salvato nulla. Aggiorna il calendario e riprova."

#: lib/tymeslot_web/live/dashboard/calendar/panel_guests.ex
#, elixir-autogen, elixir-format
msgid "Attendee added, but their invitation could not be sent."
msgstr "Partecipante aggiunto, ma non è stato possibile inviare l'invito."

#: lib/tymeslot_web/live/dashboard/calendar/panel_guests.ex
#, elixir-autogen, elixir-format
msgid "Attendee removed, but they could not be notified."
msgstr "Partecipante rimosso, ma non è stato possibile avvisarlo."

