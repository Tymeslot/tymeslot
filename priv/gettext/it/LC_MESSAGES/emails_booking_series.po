#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, I'm sorry, but I've had to cancel the sessions below."
msgstr "Ciao %{name}, mi dispiace, ma ho dovuto annullare le sessioni qui sotto."

#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, the sessions below are cancelled, as you asked. There is nothing more you need to do."
msgstr "Ciao %{name}, come richiesto, le sessioni qui sotto sono state annullate. Non devi fare nient'altro."

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, your sessions are booked. Each one has its own links below, in case one of them needs to move."
msgstr "Ciao %{name}, le tue sessioni sono prenotate. Qui sotto trovi i link di ciascuna, nel caso in cui una vada spostata."

#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "If you added these sessions to your calendar, the attached file removes them there."
msgstr "Se hai aggiunto queste sessioni al tuo calendario, il file allegato le rimuove."

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "Join the video call"
msgstr "Partecipa alla videochiamata"

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "Manage all sessions"
msgstr "Gestisci tutte le sessioni"

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "New series"
msgstr "Nuova serie"

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "Open in dashboard"
msgstr "Apri nella dashboard"

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "Reschedule"
msgstr "Riprogramma"

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
