#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Continue to vote"
msgstr "Continua a votare"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "If need be"
msgstr "Se necessario"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "No"
msgstr "No"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "One of the selected times is no longer available. Please refresh and try again."
msgstr "Uno degli orari selezionati non è più disponibile. Aggiorna la pagina e riprova."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "One of your responses wasn't recognised. Please refresh and try again."
msgstr "Una delle tue risposte non è stata riconosciuta. Aggiorna la pagina e riprova."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please check your name and email, then try again."
msgstr "Controlla il tuo nome e la tua email, poi riprova."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please register before voting."
msgstr "Registrati prima di votare."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Save my responses"
msgstr "Salva le mie risposte"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Scheduled for %{time}"
msgstr "Programmato per %{time}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Security verification failed. Please try again."
msgstr "Verifica di sicurezza non riuscita. Riprova."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Security verification is currently unavailable. This may be caused by JavaScript being disabled, browser privacy extensions (Privacy Badger, uBlock Origin, etc.), or network security policies. Please adjust your settings or contact support if the problem persists."
msgstr "La verifica di sicurezza non è al momento disponibile. La causa potrebbe essere JavaScript disattivato, estensioni per la privacy del browser (Privacy Badger, uBlock Origin, ecc.) o criteri di sicurezza della rete. Modifica le impostazioni o contatta l'assistenza se il problema persiste."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This poll has been cancelled and is no longer accepting responses."
msgstr "Questo sondaggio è stato annullato e non accetta più risposte."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This poll has been scheduled."
msgstr "Questo sondaggio è stato programmato."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "This poll has reached its participant limit."
msgstr "Questo sondaggio ha raggiunto il limite di partecipanti."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Times shown in %{timezone}"
msgstr "Orari mostrati in %{timezone}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Too many attempts. Please wait a moment and try again."
msgstr "Troppi tentativi. Attendi un momento e riprova."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting as %{name}"
msgstr "Voti come %{name}"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting closes %{deadline}"
msgstr "Le votazioni si chiudono %{deadline}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Voting has closed for this poll."
msgstr "Le votazioni per questo sondaggio sono chiuse."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting has closed. Here are the final responses."
msgstr "Le votazioni sono chiuse. Ecco le risposte finali."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "We couldn't find your registration. Please register again."
msgstr "Non abbiamo trovato la tua registrazione. Registrati di nuovo."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Yes"
msgstr "Sì"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "You're registered. Your responses are saved as you vote."
msgstr "Sei registrato. Le tue risposte vengono salvate mentre voti."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Your email"
msgstr "La tua email"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Your name"
msgstr "Il tuo nome"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Your responses have been saved."
msgstr "Le tue risposte sono state salvate."
