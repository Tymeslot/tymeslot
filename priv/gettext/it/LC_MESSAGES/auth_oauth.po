#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "%{provider} authentication failed - missing authorisation code or security token."
msgstr "Autenticazione %{provider} non riuscita: codice di autorizzazione o token di sicurezza mancante."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "%{provider} authentication is not available"
msgstr "L'autenticazione %{provider} non è disponibile"

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "%{provider} authentication succeeded but session creation failed."
msgstr "Autenticazione %{provider} riuscita ma la creazione della sessione non è riuscita."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "An error occurred during %{provider} authentication."
msgstr "Si è verificato un errore durante l'autenticazione %{provider}."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Check your email: we've sent a link to finish signing up with %{provider}."
msgstr "Controlla la tua email: ti abbiamo inviato un link per completare la registrazione con %{provider}."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Create my account"
msgstr "Crea il mio account"

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "Failed to authenticate with %{provider}."
msgstr "Autenticazione con %{provider} non riuscita."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Failed to create session. Please try again."
msgstr "Creazione della sessione non riuscita. Riprova."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Finish signing up"
msgstr "Completa la registrazione"

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Missing OAuth provider information. Please try again."
msgstr "Informazioni sul provider OAuth mancanti. Riprova."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "OAuth authentication failed - missing provider."
msgstr "Autenticazione OAuth non riuscita: provider mancante."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Please verify your email address before signing in. We could not send a new verification link; please try again later."
msgstr "Verifica il tuo indirizzo email prima di accedere. Non è stato possibile inviare un nuovo link di verifica; riprova più tardi."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Please verify your email address before signing in. We've sent you a new verification link."
msgstr "Verifica il tuo indirizzo email prima di accedere. Ti abbiamo inviato un nuovo link di verifica."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Press the button below to confirm your email address and create your account."
msgstr "Premi il pulsante qui sotto per confermare il tuo indirizzo email e creare il tuo account."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "Security validation failed. Please try again."
msgstr "Convalida di sicurezza non riuscita. Riprova."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Successfully signed in with %{provider}."
msgstr "Accesso effettuato con successo con %{provider}."

#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "This %{provider} account already signs in to another Tymeslot account. Use a different one, or choose another way to sign in."
msgstr "Questo account %{provider} è già usato per accedere a un altro account Tymeslot. Usane un altro o scegli un altro metodo di accesso."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "This link is no longer valid. Please sign in to continue."
msgstr "Questo link non è più valido. Accedi per continuare."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many OAuth attempts. Please try again later."
msgstr "Troppi tentativi OAuth. Riprova più tardi."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many authentication attempts. Please try again later."
msgstr "Troppi tentativi di autenticazione. Riprova più tardi."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many registration attempts. Please try again later."
msgstr "Troppi tentativi di registrazione. Riprova più tardi."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many verification attempts. Please try again later."
msgstr "Troppi tentativi di verifica. Riprova più tardi."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Unsupported OAuth provider."
msgstr "Provider OAuth non supportato."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Unsupported OAuth provider: %{provider}"
msgstr "Provider OAuth non supportato: %{provider}"

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "We couldn't send the link to finish signing up just now. Please try again later."
msgstr "Al momento non siamo riusciti a inviare il link per completare la registrazione. Riprova più tardi."

#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "Welcome to Tymeslot! You'll sign in with %{provider}."
msgstr "Ti diamo il benvenuto su Tymeslot! Accederai con %{provider}."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Welcome! You've successfully signed up with %{provider}."
msgstr "Benvenuto! Ti sei registrato con successo con %{provider}."

#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "Your account is ready. Please sign in with %{provider} to continue."
msgstr "Il tuo account è pronto. Accedi con %{provider} per continuare."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Your sign-up session has expired. Please sign in again."
msgstr "La sessione di registrazione è scaduta. Accedi di nuovo."
