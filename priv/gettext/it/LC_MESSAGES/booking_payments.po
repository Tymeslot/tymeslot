#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking cancelled"
msgstr "Prenotazione annullata"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking confirmed"
msgstr "Prenotazione confermata"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking not accepted"
msgstr "Prenotazione non accettata"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking request expired"
msgstr "Richiesta di prenotazione scaduta"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Confirming your payment…"
msgstr "Conferma del pagamento in corso…"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "If there's no answer by %{by_deadline}, the request lapses and you're refunded automatically."
msgstr "Se non arriva risposta entro %{by_deadline}, la richiesta decade e il pagamento verrà rimborsato automaticamente."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "If there's no answer by %{by_deadline}, the request lapses."
msgstr "Se non arriva risposta entro %{by_deadline}, la richiesta decade."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Nobody responded to this request in time, so it has lapsed."
msgstr "Nessuno ha risposto in tempo, quindi la richiesta è scaduta."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Nobody responded to this request in time, so it has lapsed. Your payment is being refunded."
msgstr "Nessuno ha risposto in tempo, quindi la richiesta è scaduta. Il pagamento è in fase di rimborso."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment cancelled"
msgstr "Pagamento annullato"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment not completed"
msgstr "Pagamento non completato"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment received"
msgstr "Pagamento ricevuto"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Please wait while we confirm your booking."
msgstr "Attendi mentre confermiamo la tua prenotazione."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Return to booking"
msgstr "Torna alla prenotazione"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thank you, your booking is confirmed for %{for_date}."
msgstr "Grazie, la tua prenotazione è confermata per %{for_date}."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thanks, your payment went through. Your booking is not confirmed yet though:"
msgstr "Grazie, il pagamento è andato a buon fine. La tua prenotazione però non è ancora confermata:"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking has been cancelled, so it won't be going ahead."
msgstr "Questa prenotazione è stata annullata e quindi non avrà luogo."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking wasn't accepted, so it won't be going ahead."
msgstr "Questa prenotazione non è stata accettata e quindi non avrà luogo."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking wasn't accepted, so it won't be going ahead. Your payment is being refunded."
msgstr "Questa prenotazione non è stata accettata e quindi non avrà luogo. Il pagamento è in fase di rimborso."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. You can return and try again at any time."
msgstr "La tua prenotazione non è confermata. Puoi tornare e riprovare in qualsiasi momento."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Paid: %{amount}"
msgstr "Pagato: %{amount}"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. Your invitation stays reserved for it until the unfinished checkout expires, and a link to book again will appear here as soon as it does."
msgstr "La tua prenotazione non è confermata. Il tuo invito resta riservato a questa prenotazione finché il pagamento non completato non scade; appena succede, qui comparirà un link per prenotare di nuovo."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. To try again, open the invitation link you were sent."
msgstr "La tua prenotazione non è confermata. Per riprovare, apri il link di invito che hai ricevuto."

#: lib/tymeslot/meeting_payments/checkout_sessions.ex
#, elixir-autogen, elixir-format
msgid "%{name}, %{count} session"
msgid_plural "%{name}, %{count} sessions"
msgstr[0] "%{name}, %{count} sessione"
msgstr[1] "%{name}, %{count} sessioni"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thank you, your %{count} session is confirmed, the first on %{on_date}."
msgid_plural "Thank you, your %{count} sessions are confirmed, the first on %{on_date}."
msgstr[0] "Grazie, la tua %{count} sessione è confermata, la prima %{on_date}."
msgstr[1] "Grazie, le tue %{count} sessioni sono confermate, la prima %{on_date}."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "The payment wasn't completed in time, so the seat held for you was released. You can return and book again."
msgid_plural "The payment wasn't completed in time, so the seats held for you were released. You can return and book again."
msgstr[0] "Il pagamento non è stato completato in tempo, quindi il posto riservato per te è stato liberato. Puoi tornare e prenotare di nuovo."
msgstr[1] "Il pagamento non è stato completato in tempo, quindi i posti riservati per te sono stati liberati. Puoi tornare e prenotare di nuovo."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your payment arrived after the seat held for you was released, and the session had no room left. Your payment is being refunded."
msgid_plural "Your payment arrived after the seats held for you were released, and the session had no room left. Your payment is being refunded."
msgstr[0] "Il pagamento è arrivato dopo che il posto riservato per te era stato liberato e nella sessione non c'erano più posti disponibili. Il pagamento è in fase di rimborso."
msgstr[1] "Il pagamento è arrivato dopo che i posti riservati per te erano stati liberati e nella sessione non c'erano più posti disponibili. Il pagamento è in fase di rimborso."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your seat was released"
msgid_plural "Your seats were released"
msgstr[0] "Il tuo posto è stato liberato"
msgstr[1] "I tuoi posti sono stati liberati"
