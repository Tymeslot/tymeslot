msgstr "Abbonamento in corso..."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "That URL did not return a calendar feed. Make sure it points at an .ics file."
msgstr "Questo URL non ha restituito un feed di calendario. Assicurati che punti a un file .ics."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "That URL points at a blocked address and cannot be reached."
msgstr "Questo URL punta a un indirizzo bloccato e non può essere raggiunto."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "That calendar feed is too large to process."
msgstr "Questo feed di calendario è troppo grande per essere elaborato."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed URL returned 404. Check that the link is complete and still published."
msgstr "L’URL del feed di calendario ha restituito 404. Controlla che il link sia completo e ancora pubblicato."

#: lib/tymeslot/workers/sync_ics_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed came back empty, but the cache still holds previously synced events. Keeping the cache in place and retrying rather than emptying your diary."
msgstr "Il feed del calendario è risultato vuoto, ma la cache contiene ancora eventi sincronizzati in precedenza. La cache viene mantenuta e il tentativo verrà ripetuto invece di svuotare la tua agenda."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed redirected too many times."
msgstr "Il feed del calendario ha eseguito troppi reindirizzamenti."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed rejected the link. It may have been revoked or reset."
msgstr "Il feed del calendario ha rifiutato il link. Potrebbe essere stato revocato o reimpostato."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed returned HTTP %{status}."
msgstr "Il feed del calendario ha restituito HTTP %{status}."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "This calendar stays read-only: it blocks the times you're already busy, and bookings are never written to it. Choose another calendar as your booking destination."
msgstr "Questo calendario resta di sola lettura: blocca gli orari in cui sei già occupato e le prenotazioni non ci vengono mai scritte. Scegli un altro calendario come destinazione delle prenotazioni."

