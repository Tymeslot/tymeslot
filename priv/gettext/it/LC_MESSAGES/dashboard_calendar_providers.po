msgstr "Solo orari occupati"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Choose which calendars Tymeslot uses, and which of them block times on your booking page."
msgstr "Scegli quali calendari usa Tymeslot e quali di questi bloccano gli orari sulla tua pagina di prenotazione."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Don't block"
msgstr "Non bloccare"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Exchange reports busy times for your main calendar only."
msgstr "Exchange segnala gli orari occupati solo per il tuo calendario principale."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Exchange reports busy times for your whole mailbox from your main calendar, so this choice works whether or not the calendar is shown."
msgstr "Exchange segnala gli orari occupati di tutta la tua casella di posta tramite il calendario principale, quindi questa impostazione funziona che il calendario sia mostrato o meno."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Off"
msgstr "Disattivato"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "On"
msgstr "Attivato"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Read-only"
msgstr "Sola lettura"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Shared with you as busy times only. Tymeslot can block these times but cannot show the events."
msgstr "Condiviso con te solo come orari occupati. Tymeslot può bloccare questi orari ma non mostrare gli eventi."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Show and block"
msgstr "Mostra e blocca"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Show only"
msgstr "Mostra soltanto"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "This calendar stays read-only: bookings are never written to it. Choose another calendar as your booking destination."
msgstr "Questo calendario resta di sola lettura: le prenotazioni non vengono mai scritte qui. Scegli un altro calendario come destinazione delle prenotazioni."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/caldav_reconnect_modal.ex
#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Your booking calendar always blocks your availability."
msgstr "Il tuo calendario di prenotazione blocca sempre la tua disponibilità."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "%{used} of %{count} calendar in use, %{blocking} blocking your availability"
msgid_plural "%{used} of %{count} calendars in use, %{blocking} blocking your availability"
msgstr[0] "%{used} su %{count} calendario in uso, che bloccano la tua disponibilità: %{blocking}"
msgstr[1] "%{used} su %{count} calendari in uso, che bloccano la tua disponibilità: %{blocking}"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Busy times block"
msgstr "Blocca gli orari occupati"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Busy times of %{calendar}"
msgstr "Orari occupati di %{calendar}"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Exchange reports busy times for your whole mailbox, and they block your booking page. Refresh this connection to list your main calendar and choose there whether they do."
msgstr "Exchange segnala gli orari occupati di tutta la tua casella di posta, e questi bloccano la tua pagina di prenotazione. Aggiorna questa connessione per vedere il calendario principale nell'elenco e scegliere lì se devono bloccarla."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Show %{calendar} on your calendar"
msgstr "Mostra %{calendar} nel tuo calendario"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "This folder's events are shown only; busy times come from your whole mailbox."
msgstr "Gli eventi di questa cartella vengono soltanto mostrati; gli orari occupati provengono da tutta la tua casella di posta."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Use of %{calendar}"
msgstr "Uso di %{calendar}"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Whole mailbox"
msgstr "Tutta la casella di posta"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "Count every event as busy"
msgstr "Considera ogni evento come occupato"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "Holiday and school-holiday calendars mark their events as free, so they would block nothing. With this on, every event in the feed blocks the time, however it is marked."
msgstr ""
"I calendari delle festività e delle vacanze scolastiche segnano i loro eventi come liberi, quindi non bloccherebbero nulla. Con questa opzione attiva, ogni evento del feed blocca l'orario, comunque sia segnato."
