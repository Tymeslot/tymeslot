#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "%{provider} authentication failed - missing authorisation code or security token."
msgstr "%{provider}-Authentifizierung fehlgeschlagen – Autorisierungscode oder Sicherheitstoken fehlt."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "%{provider} authentication is not available"
msgstr "%{provider}-Authentifizierung ist nicht verfügbar"

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "%{provider} authentication succeeded but session creation failed."
msgstr "%{provider}-Authentifizierung erfolgreich, aber die Sitzung konnte nicht erstellt werden."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "An error occurred during %{provider} authentication."
msgstr "Bei der %{provider}-Authentifizierung ist ein Fehler aufgetreten."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Check your email: we've sent a link to finish signing up with %{provider}."
msgstr "Prüfen Sie Ihre E-Mails: Wir haben Ihnen einen Link gesendet, um die Registrierung mit %{provider} abzuschließen."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Create my account"
msgstr "Mein Konto erstellen"

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "Failed to authenticate with %{provider}."
msgstr "Authentifizierung mit %{provider} fehlgeschlagen."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Failed to create session. Please try again."
msgstr "Sitzung konnte nicht erstellt werden. Bitte versuchen Sie es erneut."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Finish signing up"
msgstr "Registrierung abschließen"

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Missing OAuth provider information. Please try again."
msgstr "OAuth-Anbieterinformationen fehlen. Bitte versuchen Sie es erneut."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "OAuth authentication failed - missing provider."
msgstr "OAuth-Authentifizierung fehlgeschlagen – Anbieter fehlt."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Please verify your email address before signing in. We could not send a new verification link; please try again later."
msgstr "Bitte bestätigen Sie Ihre E-Mail-Adresse, bevor Sie sich anmelden. Wir konnten keinen neuen Bestätigungslink senden; bitte versuchen Sie es später erneut."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Please verify your email address before signing in. We've sent you a new verification link."
msgstr "Bitte bestätigen Sie Ihre E-Mail-Adresse, bevor Sie sich anmelden. Wir haben Ihnen einen neuen Bestätigungslink gesendet."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Press the button below to confirm your email address and create your account."
msgstr "Klicken Sie auf die Schaltfläche unten, um Ihre E-Mail-Adresse zu bestätigen und Ihr Konto zu erstellen."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "Security validation failed. Please try again."
msgstr "Sicherheitsprüfung fehlgeschlagen. Bitte versuchen Sie es erneut."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Successfully signed in with %{provider}."
msgstr "Erfolgreich mit %{provider} angemeldet."

#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "This %{provider} account already signs in to another Tymeslot account. Use a different one, or choose another way to sign in."
msgstr "Dieses %{provider}-Konto wird bereits für die Anmeldung bei einem anderen Tymeslot-Konto verwendet. Verwenden Sie ein anderes oder wählen Sie eine andere Anmeldemethode."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "This link is no longer valid. Please sign in to continue."
msgstr "Dieser Link ist nicht mehr gültig. Bitte melden Sie sich an, um fortzufahren."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many OAuth attempts. Please try again later."
msgstr "Zu viele OAuth-Versuche. Bitte versuchen Sie es später erneut."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many authentication attempts. Please try again later."
msgstr "Zu viele Authentifizierungsversuche. Bitte versuchen Sie es später erneut."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many registration attempts. Please try again later."
msgstr "Zu viele Registrierungsversuche. Bitte versuchen Sie es später erneut."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many verification attempts. Please try again later."
msgstr "Zu viele Verifizierungsversuche. Bitte versuchen Sie es später erneut."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Unsupported OAuth provider."
msgstr "Nicht unterstützter OAuth-Anbieter."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Unsupported OAuth provider: %{provider}"
msgstr "Nicht unterstützter OAuth-Anbieter: %{provider}"

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "We couldn't send the link to finish signing up just now. Please try again later."
msgstr "Wir konnten den Link zum Abschließen der Registrierung gerade nicht senden. Bitte versuchen Sie es später erneut."

#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "Welcome to Tymeslot! You'll sign in with %{provider}."
msgstr "Willkommen bei Tymeslot! Sie melden sich künftig mit %{provider} an."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Welcome! You've successfully signed up with %{provider}."
msgstr "Willkommen! Sie haben sich erfolgreich mit %{provider} registriert."

#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "Your account is ready. Please sign in with %{provider} to continue."
msgstr "Ihr Konto ist bereit. Bitte melden Sie sich mit %{provider} an, um fortzufahren."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Your sign-up session has expired. Please sign in again."
msgstr "Ihre Registrierungssitzung ist abgelaufen. Bitte melden Sie sich erneut an."
