#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "A test message is sent only to your current verified account email."
msgstr "Eine Testnachricht wird nur an die aktuelle verifizierte E-Mail-Adresse Ihres Kontos gesendet."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Booking emails currently use the platform sender."
msgstr "Buchungs-E-Mails verwenden derzeit den Plattform-Absender."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "Booking emails now use the platform sender."
msgstr "Buchungs-E-Mails verwenden jetzt den Plattform-Absender."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Booking emails use this SMTP identity."
msgstr "Buchungs-E-Mails verwenden diese SMTP-Identität."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Check the email settings and try again."
msgstr "Prüfen Sie die E-Mail-Einstellungen und versuchen Sie es erneut."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Choose a public SMTP hostname. Private and local mail servers are not supported."
msgstr "Wählen Sie einen öffentlichen SMTP-Hostnamen. Private und lokale Mailserver werden nicht unterstützt."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Credentials are saved securely. Leave the username and password blank to keep them."
msgstr "Die Zugangsdaten sind sicher gespeichert. Lassen Sie Nutzername und Passwort leer, um sie beizubehalten."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP is disabled"
msgstr "Eigenes SMTP ist deaktiviert"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP is enabled"
msgstr "Eigenes SMTP ist aktiviert"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP is enabled for booking emails."
msgstr "Eigenes SMTP ist für Buchungs-E-Mails aktiviert."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP remains selected. Failed booking emails are retried without switching to the platform sender."
msgstr "Eigenes SMTP bleibt ausgewählt. Fehlgeschlagene Buchungs-E-Mails werden erneut gesendet, ohne zum Plattform-Absender zu wechseln."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Delete identity and credentials"
msgstr "Identität und Zugangsdaten löschen"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Delete saved identity"
msgstr "Gespeicherte Identität löschen"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Delete this SMTP identity?"
msgstr "Diese SMTP-Identität löschen?"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Email sending"
msgstr "E-Mail-Versand"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Email sending settings are unavailable. Reload the page to continue."
msgstr "Die Einstellungen für den E-Mail-Versand sind nicht verfügbar. Laden Sie die Seite neu, um fortzufahren."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Email settings need attention"
msgstr "E-Mail-Einstellungen erfordern Ihre Aufmerksamkeit"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Email testing is temporarily unavailable. Try again shortly."
msgstr "E-Mail-Tests sind vorübergehend nicht verfügbar. Versuchen Sie es in Kürze erneut."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Enable tested identity"
msgstr "Getestete Identität aktivieren"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "From address"
msgstr "Absenderadresse"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "From display name"
msgstr "Anzeigename des Absenders"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Implicit TLS (port 465)"
msgstr "Implizites TLS (Port 465)"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Keep identity"
msgstr "Identität beibehalten"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Polls, calendar invitations from the dashboard, and payment notices still use the platform sender."
msgstr "Umfragen, Kalendereinladungen aus dem Dashboard und Zahlungsmitteilungen verwenden weiterhin den Plattform-Absender."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Refresh status"
msgstr "Status aktualisieren"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Required STARTTLS (port 587)"
msgstr "STARTTLS erforderlich (Port 587)"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP hostname"
msgstr "SMTP-Hostname"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP password or app password"
msgstr "SMTP-Passwort oder App-Passwort"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP port"
msgstr "SMTP-Port"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP settings"
msgstr "SMTP-Einstellungen"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP username"
msgstr "SMTP-Nutzername"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "TLS mode"
msgstr "TLS-Modus"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Test and save"
msgstr "Testen und speichern"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Test and save these settings before enabling them."
msgstr "Testen und speichern Sie diese Einstellungen, bevor Sie sie aktivieren."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Testing SMTP settings"
msgstr "SMTP-Einstellungen werden getestet"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Testing and saving…"
msgstr "Wird getestet und gespeichert…"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP hostname could not be resolved. Check it and try again."
msgstr "Der SMTP-Hostname konnte nicht aufgelöst werden. Prüfen Sie ihn und versuchen Sie es erneut."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP operation could not be completed. Check the settings and try again."
msgstr "Der SMTP-Vorgang konnte nicht abgeschlossen werden. Prüfen Sie die Einstellungen und versuchen Sie es erneut."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server accepted the test and the settings were saved. Acceptance does not confirm inbox delivery."
msgstr "Der SMTP-Server hat die Testnachricht angenommen und die Einstellungen wurden gespeichert. Die Annahme bestätigt keine Zustellung im Posteingang."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server did not respond in time. Try again shortly."
msgstr "Der SMTP-Server hat nicht rechtzeitig geantwortet. Versuchen Sie es in Kürze erneut."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server refused the credentials. Check the username and password, or use an app password."
msgstr "Der SMTP-Server hat die Zugangsdaten abgelehnt. Prüfen Sie Nutzername und Passwort oder verwenden Sie ein App-Passwort."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server timed out. It may have accepted the message; check before trying again."
msgstr "Beim SMTP-Server ist eine Zeitüberschreitung aufgetreten. Er hat die Nachricht möglicherweise angenommen. Prüfen Sie dies vor einem erneuten Versuch."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The required TLS connection failed. Check the SMTP host, port, and TLS mode."
msgstr "Die erforderliche TLS-Verbindung ist fehlgeschlagen. Prüfen Sie SMTP-Host, Port und TLS-Modus."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "The saved SMTP identity and credentials were deleted."
msgstr "Die gespeicherte SMTP-Identität und die Zugangsdaten wurden gelöscht."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The saved credentials could not be read. Enter them again and test the connection."
msgstr "Die gespeicherten Zugangsdaten konnten nicht gelesen werden. Geben Sie sie erneut ein und testen Sie die Verbindung."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "The server is being tested. Existing email settings stay unchanged if the test fails."
msgstr "Der Server wird getestet. Wenn der Test fehlschlägt, bleiben die bisherigen E-Mail-Einstellungen unverändert."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "This removes the saved credentials. Booking emails will use the platform sender."
msgstr "Dadurch werden die gespeicherten Zugangsdaten entfernt. Buchungs-E-Mails verwenden anschließend den Plattform-Absender."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many SMTP tests or connections. Wait a few minutes and try again."
msgstr "Zu viele SMTP-Tests oder Verbindungen. Warten Sie einige Minuten und versuchen Sie es erneut."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Use a public SMTP server with authenticated TLS. Your provider must authorize the From address and manage SPF, DKIM, and DMARC for its domain."
msgstr "Verwenden Sie einen öffentlichen SMTP-Server mit Authentifizierung und TLS. Ihr Anbieter muss die Absenderadresse autorisieren und SPF, DKIM und DMARC für deren Domain verwalten."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Use platform sender"
msgstr "Plattform-Absender verwenden"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Using platform sender"
msgstr "Plattform-Absender wird verwendet"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Verify your account email before testing or enabling custom SMTP."
msgstr "Verifizieren Sie die E-Mail-Adresse Ihres Kontos, bevor Sie eigenes SMTP testen oder aktivieren."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Your SMTP identity sends booking confirmations, reminders, cancellations, rescheduling, approvals, and guest/group notices. Account and security emails use the platform sender."
msgstr "Ihre SMTP-Identität sendet Buchungsbestätigungen, Erinnerungen, Absagen, Terminverschiebungen, Genehmigungen sowie Gast- und Gruppenmitteilungen. Konto- und Sicherheits-E-Mails verwenden den Plattform-Absender."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Your current sending identity has not changed. Review the error and test again."
msgstr "Ihre aktuelle Absenderidentität wurde nicht geändert. Prüfen Sie den Fehler und testen Sie erneut."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Your email settings changed. Review the current settings and try again."
msgstr "Ihre E-Mail-Einstellungen wurden geändert. Prüfen Sie die aktuellen Einstellungen und versuchen Sie es erneut."
