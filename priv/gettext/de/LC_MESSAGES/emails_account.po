msgid "You're signing up for Tymeslot with %{provider}. Confirm this email address to create your account and sign in."
msgstr "Sie registrieren sich bei Tymeslot über %{provider}. Bestätigen Sie diese E-Mail-Adresse, um Ihr Konto zu erstellen und sich anzumelden."

#: lib/tymeslot/emails/templates/email_change_confirmed.ex
#, elixir-autogen, elixir-format
msgid "Your Tymeslot account email address has been successfully changed."
msgstr "die E-Mail-Adresse Ihres Tymeslot-Kontos wurde erfolgreich geändert."

#: lib/tymeslot/emails/templates/email_change_confirmed.ex
#, elixir-autogen, elixir-format
msgid "Your Tymeslot account email address has been successfully changed. This confirmation is being sent to your previous address so you know the switch happened."
msgstr "die E-Mail-Adresse Ihres Tymeslot-Kontos wurde erfolgreich geändert. Diese Bestätigung wird an Ihre bisherige Adresse gesendet, damit Sie wissen, dass die Umstellung erfolgt ist."

#: lib/tymeslot/emails/templates/no_password_to_reset.ex
#, elixir-autogen, elixir-format
msgid "Your Tymeslot account has no password to reset."
msgstr "Ihr Tymeslot-Konto hat kein Passwort, das zurückgesetzt werden könnte."

#: lib/tymeslot/emails/templates/email_change_confirmed.ex
#, elixir-autogen, elixir-format
msgid "Your Tymeslot email address has been changed."
msgstr "Die E-Mail-Adresse Ihres Tymeslot-Kontos wurde geändert."

#: lib/tymeslot/emails/templates/email_change_confirmed.ex
#, elixir-autogen, elixir-format
msgid "Your account is now using the new address."
msgstr "Ihr Konto verwendet nun die neue Adresse."

#: lib/tymeslot/emails/templates/email_change_notification.ex
#, elixir-autogen, elixir-format
msgid "Your current email remains active until the change is confirmed"
msgstr "Ihre aktuelle E-Mail-Adresse bleibt aktiv, bis die Änderung bestätigt wird"

#: lib/tymeslot/emails/templates/email_change_confirmed.ex
#, elixir-autogen, elixir-format
msgid "Your meetings and settings remain unchanged"
msgstr "Ihre Termine und Einstellungen bleiben unverändert"
