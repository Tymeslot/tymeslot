#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats."
msgid_plural "%{number} of them repeat."
msgstr[0] "1 davon wiederholt sich."
msgstr[1] "%{number} davon wiederholen sich."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel"
msgstr "Abbrechen"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Choose or drop an .ics file"
msgstr "Eine .ics-Datei auswählen oder hier ablegen"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Close"
msgstr "Schließen"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Connect a calendar Tymeslot can write to before importing events."
msgstr "Verbinden Sie einen Kalender, in den Tymeslot schreiben kann, bevor Sie Ereignisse importieren."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Copy the events of an .ics file into one of your calendars."
msgstr "Kopieren Sie die Ereignisse einer .ics-Datei in einen Ihrer Kalender."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Exported from Google Calendar, Outlook, Apple Calendar or any other calendar app."
msgstr "Exportiert aus Google Calendar, Outlook, Apple Calendar oder einer anderen Kalender-App."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Found 1 event."
msgid_plural "Found %{number} events."
msgstr[0] "1 Ereignis gefunden."
msgstr[1] "%{number} Ereignisse gefunden."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Guests are not imported, and nobody is sent an invitation."
msgstr "Gäste werden nicht importiert, und es wird keine Einladung versendet."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Import"
msgstr "Importieren"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Import events"
msgstr "Ereignisse importieren"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Import into"
msgstr "Importieren in"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Reading the file..."
msgstr "Datei wird gelesen…"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "You can close this window; the import carries on."
msgstr "Sie können dieses Fenster schließen; der Import läuft weiter."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "1 event could not be imported."
msgid_plural "%{number} events could not be imported."
msgstr[0] "1 Ereignis konnte nicht importiert werden."
msgstr[1] "%{number} Ereignisse konnten nicht importiert werden."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "1 event repeats in a way Outlook can't store, so it was not imported."
msgid_plural "%{number} events repeat in a way Outlook can't store, so they were not imported."
msgstr[0] "1 Ereignis wiederholt sich auf eine Weise, die Outlook nicht speichern kann, und wurde daher nicht importiert."
msgstr[1] "%{number} Ereignisse wiederholen sich auf eine Weise, die Outlook nicht speichern kann, und wurden daher nicht importiert."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats on a day some months don't have, which Outlook would move to the month's last day."
msgid_plural "%{number} of them repeat on a day some months don't have, which Outlook would move to the month's last day."
msgstr[0] ""
"1 davon wiederholt sich an einem Tag, den manche Monate nicht haben; Outlook würde es auf den letzten Tag des Monats verschieben."
msgstr[1] ""
"%{number} davon wiederholen sich an einem Tag, den manche Monate nicht haben; Outlook würde sie auf den letzten Tag des Monats verschieben."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "An import is still running. Please wait for it to finish before importing another file."
msgstr "Ein Import läuft noch. Bitte warten Sie, bis er abgeschlossen ist, bevor Sie eine weitere Datei importieren."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Imported 1 event."
msgid_plural "Imported %{number} events."
msgstr[0] "1 Ereignis importiert."
msgstr[1] "%{number} Ereignisse importiert."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Invalid calendar selected"
msgstr "Ungültiger Kalender ausgewählt"

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Only .ics calendar files can be imported."
msgstr "Es können nur .ics-Kalenderdateien importiert werden."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Outlook could not take the skipped dates of 1 recurring event, so it may show extra occurrences."
msgid_plural "Outlook could not take the skipped dates of %{number} recurring events, so they may show extra occurrences."
msgstr[0] "Outlook konnte die ausgelassenen Datumsangaben von 1 wiederkehrenden Ereignis nicht übernehmen und zeigt daher möglicherweise zusätzliche Wiederholungen an."
msgstr[1] "Outlook konnte die ausgelassenen Datumsangaben von %{number} wiederkehrenden Ereignissen nicht übernehmen und zeigt daher möglicherweise zusätzliche Wiederholungen an."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The file could not be uploaded. Please try again."
msgstr "Die Datei konnte nicht hochgeladen werden. Bitte versuchen Sie es erneut."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The import could not be finished. Some of its events may already be in your calendar."
msgstr "Der Import konnte nicht abgeschlossen werden. Einige seiner Ereignisse sind möglicherweise bereits in Ihrem Kalender."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because the calendar could not be written to."
msgstr "Der Import wurde angehalten, weil nicht in den Kalender geschrieben werden konnte."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar is not responding. Please try again later."
msgstr "Der Import wurde angehalten, weil Ihr Kalender nicht antwortet. Bitte versuchen Sie es später erneut."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar needs to be reconnected."
msgstr "Der Import wurde angehalten, weil Ihr Kalender erneut verbunden werden muss."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "This file contains no events to import."
msgstr "Diese Datei enthält keine Ereignisse zum Importieren."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "This file could not be read as a calendar. Please choose an .ics file."
msgstr "Diese Datei konnte nicht als Kalender gelesen werden. Bitte wählen Sie eine .ics-Datei aus."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Too many imports. Please wait a while before importing another file."
msgstr "Zu viele Importe. Bitte warten Sie eine Weile, bevor Sie eine weitere Datei importieren."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "%{from_date} onwards"
msgstr "Ab %{from_date}"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "1 event"
msgid_plural "%{number} events"
msgstr[0] "1 Ereignis"
msgstr[1] "%{number} Ereignisse"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "1 event before %{before_date} is left out."
msgid_plural "%{number} events before %{before_date} are left out."
msgstr[0] "1 Ereignis vor dem %{before_date} wird ausgelassen."
msgstr[1] "%{number} Ereignisse vor dem %{before_date} werden ausgelassen."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "1 event, more than %{max}"
msgid_plural "%{number} events, more than %{max}"
msgstr[0] "1 Ereignis, mehr als %{max}"
msgstr[1] "%{number} Ereignisse, mehr als %{max}"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Add a calendar subscription"
msgstr "Kalenderabonnement hinzufügen"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Continue"
msgstr "Fortfahren"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Even the events from today onwards are more than one import can copy. Export a shorter date range from your calendar app and import it in parts."
msgstr "Selbst die Ereignisse ab heute sind mehr, als ein Import kopieren kann. Exportieren Sie kürzere Zeiträume aus Ihrer Kalender-App und importieren Sie diese einzeln."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Import events from"
msgstr "Ereignisse importieren ab"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "No events from this date on"
msgstr "Ab diesem Datum keine Ereignisse"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Past events are rarely needed for scheduling, so you can leave them out. A repeating event counts once, however often it repeats."
msgstr "Vergangene Ereignisse werden für die Terminplanung selten gebraucht, Sie können sie also weglassen. Ein wiederkehrendes Ereignis zählt einmal, egal wie oft es sich wiederholt."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The file is too large. Files up to %{size} MB can be imported. Export a shorter date range from your calendar app and try again."
msgstr "Die Datei ist zu groß. Dateien bis zu %{size} MB können importiert werden. Exportieren Sie einen kürzeren Zeitraum aus Ihrer Kalender-App und versuchen Sie es erneut."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "To keep a whole calendar, with no limit and in step with its changes, subscribe to it by URL instead."
msgstr "Wenn Sie einen ganzen Kalender ohne Obergrenze übernehmen und mit seinen Änderungen synchron halten möchten, abonnieren Sie ihn stattdessen per URL."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "This file contains more than 1 event, too many to read. Export a shorter date range from your calendar app, or subscribe to the calendar by URL instead."
msgid_plural "This file contains more than %{number} events, too many to read. Export a shorter date range from your calendar app, or subscribe to the calendar by URL instead."
msgstr[0] "Diese Datei enthält mehr als ein Ereignis, zu viele zum Einlesen. Exportieren Sie einen kürzeren Zeitraum aus Ihrer Kalender-App oder abonnieren Sie den Kalender stattdessen per URL."
msgstr[1] "Diese Datei enthält mehr als %{number} Ereignisse, zu viele zum Einlesen. Exportieren Sie einen kürzeren Zeitraum aus Ihrer Kalender-App oder abonnieren Sie den Kalender stattdessen per URL."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "This file holds 1 event, from %{from_date} to %{to_date}. One import can copy up to %{max}."
msgid_plural "This file holds %{number} events, from %{from_date} to %{to_date}. One import can copy up to %{max}."
msgstr[0] "Diese Datei enthält ein Ereignis vom %{from_date} bis zum %{to_date}. Mit einem Import lassen sich bis zu %{max} kopieren."
msgstr[1] "Diese Datei enthält %{number} Ereignisse vom %{from_date} bis zum %{to_date}. Mit einem Import lassen sich bis zu %{max} kopieren."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Importing %{done} of 1 event..."
msgid_plural "Importing %{done} of %{number} events..."
msgstr[0] "%{done} von 1 Ereignis importiert…"
msgstr[1] "%{done} von %{number} Ereignissen importiert…"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "From each of these dates, this file holds either more events than one import can copy or none at all. Export a shorter date range from your calendar app and import it in parts."
msgstr "Ab jedem dieser Daten enthält diese Datei entweder mehr Ereignisse, als ein Import kopieren kann, oder gar keine. Exportieren Sie kürzere Zeiträume aus Ihrer Kalender-App und importieren Sie diese einzeln."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "None of the events in this file fall within these dates: they all ended before the earliest one. Export a shorter date range from your calendar app and import it in parts."
msgstr "Keines der Ereignisse in dieser Datei fällt in den Bereich dieser Daten: Alle endeten vor dem frühesten davon. Exportieren Sie kürzere Zeiträume aus Ihrer Kalender-App und importieren Sie diese einzeln."
