#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/recurrence_prompt_modal.ex
#, elixir-autogen, elixir-format
msgid "This and following events"
msgstr "Dieses und folgende Ereignisse"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/recurrence_prompt_modal.ex
#, elixir-autogen, elixir-format
msgid "This event"
msgstr "Dieses Ereignis"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/recurrence_prompt_modal.ex
#, elixir-autogen, elixir-format
msgid "This event is part of a repeating series. Which events should your change apply to?"
msgstr ""
"Dieses Ereignis gehört zu einer Serie. Für welche Ereignisse soll Ihre "
"Änderung gelten?"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/recurrence_prompt_modal.ex
#, elixir-autogen, elixir-format
msgid "every occurrence in the series changes, earlier ones included."
msgstr "Alle Termine der Serie ändern sich, auch die früheren."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/recurrence_prompt_modal.ex
#, elixir-autogen, elixir-format
msgid "only this occurrence changes, and the rest of the series stays as it is."
msgstr "Nur dieser Termin ändert sich, der Rest der Serie bleibt unverändert."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/recurrence_prompt_modal.ex
#, elixir-autogen, elixir-format
msgid "this occurrence and every later one change, and the earlier ones stay as they are."
msgstr ""
"Dieser und alle späteren Termine ändern sich, die früheren bleiben "
"unverändert."

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "Change a repeating event"
msgstr "Wiederkehrendes Ereignis ändern"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "Delete a repeating event"
msgstr "Wiederkehrendes Ereignis löschen"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "Only “This event” can be undone."
msgstr "Nur „Dieses Ereignis“ lässt sich rückgängig machen."

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” repeats. Should the new pattern apply to this and the following events, or to all of them?"
msgstr ""
"„%{title}“ wiederholt sich. Soll das neue Muster für dieses und alle "
"folgenden Ereignisse gelten oder für alle?"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” repeats. Which events should be deleted?"
msgstr "„%{title}“ wiederholt sich. Welche Ereignisse sollen gelöscht werden?"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” repeats. Which events should change?"
msgstr "„%{title}“ wiederholt sich. Welche Ereignisse sollen geändert werden?"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” repeats. Which events should your changes apply to? Your answer holds until you close the details."
msgstr ""
"„%{title}“ wiederholt sich. Für welche Ereignisse sollen Ihre Änderungen "
"gelten? Ihre Antwort gilt, bis Sie die Details schließen."
