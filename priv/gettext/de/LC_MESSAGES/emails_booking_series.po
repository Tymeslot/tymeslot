#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "Cancel"
msgstr "Absagen"

#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "Cancelled"
msgstr "Abgesagt"

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "Confirmed"
msgstr "Bestätigt"

#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, I'm sorry, but I've had to cancel the sessions below."
msgstr "Hallo %{name}, es tut mir leid, aber ich musste die folgenden Termine absagen."

#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, the sessions below are cancelled, as you asked. There is nothing more you need to do."
msgstr "Hallo %{name}, wie gewünscht sind die folgenden Termine abgesagt. Sie müssen nichts weiter tun."

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, your sessions are booked. Each one has its own links below, in case one of them needs to move."
msgstr "Hallo %{name}, Ihre Termine sind gebucht. Unten hat jeder Termin eigene Links, falls einer davon verschoben werden muss."

#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "If you added these sessions to your calendar, the attached file removes them there."
msgstr "Falls Sie diese Termine in Ihren Kalender eingetragen haben, entfernt die angehängte Datei sie dort."

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "Join the video call"
msgstr "Videoanruf beitreten"

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "Manage all sessions"
msgstr "Alle Termine verwalten"

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "New series"
msgstr "Neue Serie"

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "Open in dashboard"
msgstr "Im Dashboard öffnen"

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "Reschedule"
msgstr "Verschieben"

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "Session %{position} of %{count}"
msgstr "Termin %{position} von %{count}"

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "The attached calendar file adds every session to your calendar."
msgstr "Die angehängte Kalenderdatei trägt alle Termine in Ihren Kalender ein."

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "The join link will be in your reminder."
msgstr "Den Beitrittslink erhalten Sie mit Ihrer Erinnerung."

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "Total paid: %{amount}"
msgstr "Insgesamt bezahlt: %{amount}"

#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "Would you like to book another time?"
msgstr "Möchten Sie einen anderen Termin buchen?"

#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "You cancelled %{count} session with %{attendee}"
msgid_plural "You cancelled %{count} sessions with %{attendee}"
msgstr[0] "Sie haben %{count} Termin mit %{attendee} abgesagt"
msgstr[1] "Sie haben %{count} Termine mit %{attendee} abgesagt"

#: lib/tymeslot/emails/templates/series_cancellation.ex
#, elixir-autogen, elixir-format
msgid "You cancelled the sessions below. %{attendee} has been told."
msgstr "Sie haben die folgenden Termine abgesagt. %{attendee} wurde darüber informiert."

#: lib/tymeslot/emails/templates/series_confirmation.ex
#, elixir-autogen, elixir-format
msgid "Your %{count} session with %{host} is booked"
msgid_plural "Your %{count} sessions with %{host} are booked"
msgstr[0] "%{count} Termin mit %{host} ist gebucht"
msgstr[1] "Ihre %{count} Termine mit %{host} sind gebucht"

#: lib/tymeslot/emails/shared/series_sessions.ex
#, elixir-autogen, elixir-format
msgid "This session has been cancelled."
msgstr "Dieser Termin wurde abgesagt."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "%{attendee} requests %{count} session"
msgid_plural "%{attendee} requests %{count} sessions"
msgstr[0] "%{attendee} fragt %{count} Termin an"
msgstr[1] "%{attendee} fragt %{count} Termine an"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Approve all sessions"
msgstr "Alle Termine bestätigen"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Both buttons open the request for you to confirm. Your answer applies to every session, and nothing is decided until you choose there."
msgstr "Beide Schaltflächen öffnen zunächst die Anfrage, wo Sie Ihre Wahl bestätigen. Ihre Antwort gilt für alle Termine, und entschieden ist erst etwas, wenn Sie dort auswählen."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Decline all sessions"
msgstr "Alle Termine ablehnen"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Every session is held until you answer. If you haven't replied by %{deadline}, the request lapses and %{name} is told the times are free again."
msgstr "Alle Termine bleiben reserviert, bis Sie antworten. Ohne Antwort bis %{deadline} verfällt die Anfrage und %{name} erfährt, dass die Zeiten wieder frei sind."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Every session stays held for %{name} until you answer."
msgstr "Alle Termine bleiben für %{name} reserviert, bis Sie antworten."

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, %{host} can't make the sessions below, so none of them is booked."
msgstr "Hallo %{name}, %{host} kann die folgenden Termine nicht wahrnehmen, daher ist keiner davon gebucht."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, %{host} has your request for the sessions below. They are held for you but not booked until %{host} approves them, and you'll hear either way by %{deadline}."
msgstr "Hallo %{name}, %{host} hat Ihre Anfrage für die folgenden Termine erhalten. Die Termine sind für Sie reserviert, aber erst gebucht, wenn %{host} sie bestätigt. Bis %{deadline} erhalten Sie in jedem Fall Bescheid."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, %{host} has your request for the sessions below. They are held for you but not booked until %{host} approves them."
msgstr "Hallo %{name}, %{host} hat Ihre Anfrage für die folgenden Termine erhalten. Die Termine sind für Sie reserviert, aber erst gebucht, wenn %{host} sie bestätigt."

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, your request wasn't answered in time, so the sessions below are no longer held for you."
msgstr "Hallo %{name}, Ihre Anfrage wurde nicht rechtzeitig beantwortet, daher sind die folgenden Termine nicht mehr für Sie reserviert."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Needs your answer"
msgstr "Ihre Antwort wird benötigt"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "No longer held"
msgstr "Nicht mehr reserviert"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Not confirmed"
msgstr "Nicht bestätigt"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Request sent"
msgstr "Anfrage gesendet"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "These times are available for booking again."
msgstr "Diese Zeiten sind wieder buchbar."

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "They added:"
msgstr "Anmerkung:"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Your request for %{count} session expired"
msgid_plural "Your request for %{count} sessions expired"
msgstr[0] "Ihre Anfrage für %{count} Termin ist abgelaufen"
msgstr[1] "Ihre Anfrage für %{count} Termine ist abgelaufen"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Your request for %{count} session was declined"
msgid_plural "Your request for %{count} sessions was declined"
msgstr[0] "Ihre Anfrage für %{count} Termin wurde abgelehnt"
msgstr[1] "Ihre Anfrage für %{count} Termine wurde abgelehnt"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Your request for %{count} session was sent"
msgid_plural "Your request for %{count} sessions was sent"
msgstr[0] "Ihre Anfrage für %{count} Termin wurde gesendet"
msgstr[1] "Ihre Anfrage für %{count} Termine wurde gesendet"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Reminder: %{attendee} requests %{count} session"
msgid_plural "Reminder: %{attendee} requests %{count} sessions"
msgstr[0] "Erinnerung: %{attendee} fragt %{count} Termin an"
msgstr[1] "Erinnerung: %{attendee} fragt %{count} Termine an"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Still waiting"
msgstr "Noch offen"
