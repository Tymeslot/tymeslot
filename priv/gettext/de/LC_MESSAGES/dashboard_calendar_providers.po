msgstr "Geben Sie Ihren EWS-Endpunkt und Ihre Anmeldedaten ein, um die Kalender des Postfachs zu finden."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/exchange_config.ex
#, elixir-autogen, elixir-format
msgid "Leave this on unless your server presents a self-signed certificate. Turning it off means the connection can no longer prove which server it reached."
msgstr "Lassen Sie diese Option aktiviert, sofern Ihr Server kein selbstsigniertes Zertifikat verwendet. Wenn Sie sie deaktivieren, kann die Verbindung nicht mehr nachweisen, welchen Server sie erreicht hat."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/exchange_config.ex
#, elixir-autogen, elixir-format
msgid "Mailbox address"
msgstr "Postfachadresse"

#: lib/tymeslot/integrations/calendar/credential_fields.ex
#, elixir-autogen, elixir-format
msgid "Mailbox address must be 255 characters or less"
msgstr "Die Postfachadresse darf höchstens 255 Zeichen lang sein"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/exchange_config.ex
#, elixir-autogen, elixir-format
msgid "Microsoft Exchange"
msgstr "Microsoft Exchange"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/exchange_config.ex
#, elixir-autogen, elixir-format
