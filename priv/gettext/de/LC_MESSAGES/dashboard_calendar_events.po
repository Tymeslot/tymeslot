#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Failed to delete event"
msgstr "Ereignis konnte nicht gelöscht werden"

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Meeting created and invitation sent"
msgstr "Termin erstellt und Einladung versendet"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The recurrence end date must be on or after the event start."
msgstr "Das Enddatum der Wiederholung muss am oder nach dem Ereignisbeginn liegen."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many edits. Please wait a moment."
msgstr "Zu viele Bearbeitungen. Bitte warten Sie einen Moment."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many moves. Please wait a moment."
msgstr "Zu viele Verschiebungen. Bitte warten Sie einen Moment."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "You don't have permission to modify this event"
msgstr "Sie haben keine Berechtigung, dieses Ereignis zu bearbeiten"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Delete failed - queued to retry on next sync"
msgstr "Löschen fehlgeschlagen - wird bei der nächsten Synchronisierung erneut versucht"

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Failed to update event - changes reverted"
msgstr "Ereignis konnte nicht aktualisiert werden - Änderungen zurückgesetzt"

#: lib/tymeslot/calendar_grid/event_creation.ex
#, elixir-autogen, elixir-format
msgid "Google Calendar saved the event but didn't return a Meet link — please try again or add it manually."
msgstr "Google Calendar hat das Ereignis gespeichert, aber keinen Meet-Link zurückgegeben – bitte versuchen Sie es erneut oder fügen Sie ihn manuell hinzu."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Guest name is required"
msgstr "Der Name des Gastes ist erforderlich"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Meeting with %{name}"
msgstr "Termin mit %{name}"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This calendar is read-only. Events on it can't be changed from Tymeslot."
msgstr "Dieser Kalender ist schreibgeschützt. Ereignisse darin können nicht über Tymeslot geändert werden."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Could not change the video link - changes reverted"
msgstr "Videolink konnte nicht geändert werden - Änderungen zurückgesetzt"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Could not move the event. It is still on its original calendar."
msgstr "Das Ereignis konnte nicht verschoben werden. Es befindet sich weiterhin in seinem ursprünglichen Kalender."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar, but the original could not be removed. Please delete it from its original calendar."
msgstr "Ereignis in den neuen Kalender kopiert, aber das Original konnte nicht entfernt werden. Bitte löschen Sie es aus seinem ursprünglichen Kalender."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar. The original will be removed on the next sync."
msgstr "Ereignis in den neuen Kalender kopiert. Das Original wird bei der nächsten Synchronisierung entfernt."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event moved to the new calendar."
msgstr "Ereignis in den neuen Kalender verschoben."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "The video provider did not return a meeting link, so the video link was not changed."
msgstr "Der Videoanbieter hat keinen Meeting-Link zurückgegeben, daher wurde der Videolink nicht geändert."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Video link removed."
msgstr "Videolink entfernt."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Video room created."
msgstr "Meetingraum erstellt."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Your calendar could not be reached. The change is saved and will sync on the next attempt."
msgstr "Ihr Kalender war nicht erreichbar. Die Änderung ist gespeichert und wird beim nächsten Versuch synchronisiert."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar, but the move did not finish. Please check its original calendar and delete the original if it is still there."
msgstr "Ereignis in den neuen Kalender kopiert, aber das Verschieben wurde nicht abgeschlossen. Bitte prüfen Sie den ursprünglichen Kalender und löschen Sie das Original, falls es noch dort ist."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event is a booking, so its video link belongs to the booking. Reschedule or cancel the booking to change it."
msgstr "Dieses Ereignis ist eine Buchung, daher gehört sein Videolink zur Buchung. Verschieben oder stornieren Sie die Buchung, um ihn zu ändern."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Google Calendar added Google Meet to the event but has not returned its link yet. Choose Google Meet again to fetch it."
msgstr "Google Kalender hat dem Ereignis Google Meet hinzugefügt, den Link aber noch nicht zurückgegeben. Wählen Sie Google Meet erneut, um ihn abzurufen."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Recurring Exchange events cannot be deleted here yet. Please delete this one in your calendar app."
msgstr "Wiederkehrende Exchange-Ereignisse können hier noch nicht gelöscht werden. Bitte löschen Sie dieses Ereignis in Ihrer Kalender-App."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event could not be deleted here. Please delete it in your calendar app."
msgstr "Dieses Ereignis konnte hier nicht gelöscht werden. Bitte löschen Sie es in Ihrer Kalender-App."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Events of a repeating series cannot be switched between all-day and timed here. Please make this change in your calendar app."
msgstr "Ereignisse einer Serie können hier nicht zwischen ganztägig und zeitgebunden umgestellt werden. Bitte nehmen Sie diese Änderung in Ihrer Kalender-App vor."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "That change cannot be made to the events you chose. A repeat rule can only be changed for all events, or this and following events, and cannot be removed here."
msgstr "Diese Änderung ist für die gewählten Ereignisse nicht möglich. Eine Wiederholungsregel kann nur für alle Ereignisse oder für dieses und alle folgenden geändert und hier nicht entfernt werden."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was updated, but a change you made while it was saving was not applied. Please make it again."
msgid_plural "The series was updated, but %{count} changes you made while it was saving were not applied. Please make them again."
msgstr[0] "Die Serie wurde aktualisiert, aber eine Änderung, die Sie während des Speicherns vorgenommen haben, wurde nicht übernommen. Bitte nehmen Sie sie erneut vor."
msgstr[1] "Die Serie wurde aktualisiert, aber %{count} Änderungen, die Sie während des Speicherns vorgenommen haben, wurden nicht übernommen. Bitte nehmen Sie sie erneut vor."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event could not be matched to its series. Refresh your calendars and try again."
msgstr "Dieses Ereignis konnte seiner Serie nicht zugeordnet werden. Aktualisieren Sie Ihre Kalender und versuchen Sie es erneut."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series repeats on fixed days, such as the second Monday of the month, so it cannot be moved like this. Please make this change in your calendar app."
msgstr "Diese Serie wiederholt sich an festen Tagen, etwa am zweiten Montag des Monats, und kann daher nicht so verschoben werden. Bitte nehmen Sie diese Änderung in Ihrer Kalender-App vor."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series' repeat rule cannot be split here. Please make this change in your calendar app."
msgstr "Die Wiederholungsregel dieser Serie kann hier nicht aufgeteilt werden. Bitte nehmen Sie diese Änderung in Ihrer Kalender-App vor."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "A Teams meeting on the series is not carried over."
msgstr "Ein Teams-Meeting der Serie wird nicht übernommen."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "A recurring event can only be moved to a calendar of the same kind of account: Google to Google, Outlook to Outlook, or CalDAV to CalDAV."
msgstr "Ein wiederkehrendes Ereignis kann nur in einen Kalender derselben Kontoart verschoben werden: von Google zu Google, von Outlook zu Outlook oder von CalDAV zu CalDAV."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Could not move the series. It is still on its original calendar."
msgstr "Die Serie konnte nicht verschoben werden. Sie befindet sich weiterhin in ihrem ursprünglichen Kalender."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Events in the series that were changed on their own go back to the series' usual pattern."
msgstr "Einzeln geänderte Ereignisse der Serie folgen wieder dem üblichen Muster der Serie."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Events in the series that were changed or cancelled on their own go back to the series' usual pattern."
msgstr "Einzeln geänderte oder abgesagte Ereignisse der Serie folgen wieder dem üblichen Muster der Serie."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Guests are sent a cancellation for the original series and an invitation to the moved one."
msgstr "Gäste erhalten eine Absage für die ursprüngliche Serie und eine Einladung zur verschobenen."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Recurring events on this calendar cannot be moved to another calendar. Only single events can be moved."
msgstr "Wiederkehrende Ereignisse in diesem Kalender können nicht in einen anderen Kalender verschoben werden. Nur einzelne Ereignisse lassen sich verschieben."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "That calendar cannot be written to. Please choose another calendar."
msgstr "In diesen Kalender kann nicht geschrieben werden. Bitte wählen Sie einen anderen Kalender."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series is already on that calendar."
msgstr "Die Serie befindet sich bereits in diesem Kalender."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was copied to %{calendar}, but the original series could not be removed. Please delete it from its original calendar."
msgstr "Die Serie wurde nach %{calendar} kopiert, aber die ursprüngliche Serie konnte nicht entfernt werden. Bitte löschen Sie sie aus ihrem ursprünglichen Kalender."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was moved to %{calendar}."
msgstr "Die Serie wurde nach %{calendar} verschoben."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was moved, but a change you made while it was moving was not applied. Please make it again."
msgid_plural "The series was moved, but %{count} changes you made while it was moving were not applied. Please make them again."
msgstr[0] "Die Serie wurde verschoben, aber eine Änderung, die Sie währenddessen vorgenommen haben, wurde nicht übernommen. Bitte nehmen Sie sie erneut vor."
msgstr[1] "Die Serie wurde verschoben, aber %{count} Änderungen, die Sie währenddessen vorgenommen haben, wurden nicht übernommen. Bitte nehmen Sie sie erneut vor."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "A change to this series is still saving. Please make this change once it has saved."
msgstr "Eine Änderung an dieser Serie wird noch gespeichert. Bitte nehmen Sie diese Änderung vor, sobald sie gespeichert ist."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Delete failed - queued to retry on next sync. Attendees have not been notified."
msgstr "Löschen fehlgeschlagen - wird bei der nächsten Synchronisierung erneut versucht. Die Teilnehmer wurden nicht benachrichtigt."

#: lib/tymeslot_web/live/dashboard/calendar/panel_group_event.ex
#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Too many new meetings. Please wait a moment."
msgstr "Zu viele neue Termine. Bitte warten Sie einen Moment."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Someone else organises this meeting, so Tymeslot can't move or split a series you were only invited to."
msgstr "Diese Besprechung wird von jemand anderem organisiert. Tymeslot kann eine Serie, zu der Sie nur eingeladen wurden, nicht verschieben oder aufteilen."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This is a group booking. Move it, cancel it or change who attends from the meeting instead."
msgstr "Dies ist eine Gruppenbuchung. Verschieben, absagen oder ändern Sie die Teilnehmenden stattdessen über das Meeting."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This repeat pattern can't be saved to Outlook."
msgstr "Dieses Wiederholungsmuster kann nicht in Outlook gespeichert werden."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Outlook can't skip the months that don't have this series' day, and would move those events to the month's last day. Please start the series on the 28th or earlier, or save it to another calendar."
msgstr ""
"Outlook kann Monate, die den Tag dieser Serie nicht haben, nicht überspringen und würde diese Ereignisse auf den letzten Tag des Monats verschieben. Bitte beginnen Sie die Serie am 28. oder früher oder speichern Sie sie in einem anderen Kalender."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series changed while you were editing it, and nothing is left of it from this event on. Nothing was saved."
msgstr "Diese Serie wurde geändert, während Sie sie bearbeitet haben, und ab diesem Ereignis ist nichts mehr von ihr übrig. Es wurde nichts gespeichert."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series changed while you were editing it, so the events left in it can no longer be counted. Nothing was saved. Refresh the calendar and try again."
msgstr "Diese Serie wurde geändert, während Sie sie bearbeitet haben, deshalb lassen sich die verbleibenden Ereignisse nicht mehr zählen. Es wurde nichts gespeichert. Aktualisieren Sie den Kalender und versuchen Sie es erneut."

#: lib/tymeslot_web/live/dashboard/calendar/panel_guests.ex
#, elixir-autogen, elixir-format
msgid "Attendee added, but their invitation could not be sent."
msgstr "Teilnehmer hinzugefügt, aber die Einladung konnte nicht versendet werden."

#: lib/tymeslot_web/live/dashboard/calendar/panel_guests.ex
#, elixir-autogen, elixir-format
msgid "Attendee removed, but they could not be notified."
msgstr "Teilnehmer entfernt, aber die Benachrichtigung konnte nicht versendet werden."

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
msgid "%{count} hour before"
msgid_plural "%{count} hours before"
msgstr[0] "%{count} Stunde vorher"
msgstr[1] "%{count} Stunden vorher"

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
