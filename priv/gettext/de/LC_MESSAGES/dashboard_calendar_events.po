msgstr "E-Mail"

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#: lib/tymeslot_web/live/dashboard/calendar/panel_new_reminders.ex
#, elixir-autogen, elixir-format
msgid "Notification"
msgstr "Benachrichtigung"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Ada Lovelace"
msgstr "Ada Lovelace"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Books the slot, emails the guest an invitation, and adds it to your calendar."
msgstr "Bucht den Zeitraum, sendet dem Gast eine Einladung per E-Mail und trägt den Termin in Ihren Kalender ein."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Guest name"
msgstr "Name des Gastes"

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
msgid "before the event"
msgstr "vor dem Termin"

#: lib/tymeslot_web/live/dashboard/calendar/panel_new_form.ex
#, elixir-autogen, elixir-format
msgid "An agenda, or anything to bring or prepare"
msgstr "Eine Agenda oder was mitzubringen oder vorzubereiten ist"

#: lib/tymeslot_web/live/dashboard/calendar/panel_new_form.ex
#, elixir-autogen, elixir-format
msgid "Included in the invitation and on the calendar entry."
msgstr "Wird in die Einladung und den Kalendereintrag übernommen."

#: lib/tymeslot_web/live/dashboard/calendar/panel_new_form.ex
#, elixir-autogen, elixir-format
msgid "Note to the guest"
msgstr "Notiz an den Gast"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Language of the invitation"
msgstr "Sprache der Einladung"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "The language every email about this meeting is written in, for the guest and anyone else invited."
msgstr "Die Sprache aller E-Mails zu diesem Termin – für den Gast und alle weiteren Eingeladenen."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Add up to %{count} reminder email for this meeting. The guest and anyone else invited receive it."
msgid_plural "Add up to %{count} reminder emails for this meeting. The guest and anyone else invited receive it."
msgstr[0] "Fügen Sie bis zu %{count} Erinnerungs-E-Mail für diesen Termin hinzu. Der Gast und alle weiteren Eingeladenen erhalten sie."
msgstr[1] "Fügen Sie bis zu %{count} Erinnerungs-E-Mails für diesen Termin hinzu. Der Gast und alle weiteren Eingeladenen erhalten sie."

#: lib/tymeslot_web/live/dashboard/calendar/undelivered_notice.ex
#, elixir-autogen, elixir-format
msgid "Dismiss"
msgstr "Ausblenden"

#: lib/tymeslot_web/live/dashboard/calendar/undelivered_notice.ex
#, elixir-autogen, elixir-format
msgid "The latest update could not be emailed to this guest. Let them know another way."
msgid_plural "The latest update could not be emailed to these guests. Let them know another way."
msgstr[0] "Die letzte Änderung konnte diesem Gast nicht per E-Mail zugestellt werden. Informieren Sie ihn auf anderem Weg."
msgstr[1] "Die letzte Änderung konnte diesen Gästen nicht per E-Mail zugestellt werden. Informieren Sie sie auf anderem Weg."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Add a title. A meeting without a main participant is known by its title."
msgstr "Geben Sie einen Titel ein. Ein Termin ohne Hauptteilnehmer wird an seinem Titel erkannt."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "An address, a room or a meeting point"
msgstr "Eine Adresse, ein Raum oder ein Treffpunkt"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Custom location"
msgstr "Eigener Ort"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Custom location…"
msgstr "Eigener Ort…"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Everyone is an equal guest who can accept or decline. Only you can move or cancel the meeting."
msgstr "Alle sind gleichberechtigte Gäste und können zu- oder absagen. Nur Sie können den Termin verschieben oder absagen."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Location (optional)"
msgstr "Ort (optional)"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Main participant"
msgstr "Hauptteilnehmer"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "No location"
msgstr "Kein Ort"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Saved locations"
msgstr "Gespeicherte Orte"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Shown on the calendar entry and in every invitation."
msgstr "Erscheint im Kalendereintrag und in jeder Einladung."

#: lib/tymeslot_web/live/dashboard/calendar/creation.ex
#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "That location can no longer be used. Please choose another one."
msgstr "Dieser Ort kann nicht mehr verwendet werden. Bitte wählen Sie einen anderen."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "The main participant can move or cancel the meeting. Turn this off to invite everyone as an equal guest."
msgstr "Der Hauptteilnehmer kann den Termin verschieben oder absagen. Schalten Sie dies aus, um alle als gleichberechtigte Gäste einzuladen."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
