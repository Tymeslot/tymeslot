#: lib/tymeslot_web/controllers/auth/invitation_controller.ex
#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Accept your invitation"
msgstr "Einladung annehmen"

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Choose how you'll sign in as %{email} to finish setting up your account."
msgstr "Wählen Sie, wie Sie sich als %{email} anmelden möchten, um die Einrichtung Ihres Kontos abzuschließen."

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Confirm password"
msgstr "Passwort bestätigen"

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "No sign-in method is switched on, so this invitation can't be accepted. Please contact your administrator."
msgstr "Es ist keine Anmeldemethode aktiviert, daher kann diese Einladung nicht angenommen werden. Bitte wenden Sie sich an Ihren Administrator."

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Or sign in with"
msgstr "Oder anmelden mit"

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Password"
msgstr "Passwort"

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Password sign-in is turned off. Please choose another way to sign in."
msgstr "Die Anmeldung per Passwort ist deaktiviert. Bitte wählen Sie eine andere Anmeldemethode."

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "Set password and sign in"
msgstr "Passwort festlegen und anmelden"

#: lib/tymeslot/auth/invitations.ex
#, elixir-autogen, elixir-format
msgid "The password couldn't be set. Please try again with a different one."
msgstr "Das Passwort konnte nicht festgelegt werden. Bitte versuchen Sie es mit einem anderen Passwort erneut."

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "This invitation has expired. Ask your administrator to send you a new one."
msgstr "Diese Einladung ist abgelaufen. Bitten Sie Ihren Administrator, Ihnen eine neue zu senden."

#: lib/tymeslot_web/controllers/invitation_html.ex
#, elixir-autogen, elixir-format
msgid "This invitation link is no longer valid. It may have been used already, or replaced by a newer invitation."
msgstr "Dieser Einladungslink ist nicht mehr gültig. Möglicherweise wurde er bereits verwendet oder durch eine neuere Einladung ersetzt."

#: lib/tymeslot_web/controllers/auth/invitation_controller.ex
#, elixir-autogen, elixir-format
msgid "This sign-in option is not available."
msgstr "Diese Anmeldeoption ist nicht verfügbar."

#: lib/tymeslot_web/controllers/auth/invitation_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many OAuth attempts. Please try again later."
msgstr "Zu viele OAuth-Versuche. Bitte versuchen Sie es später erneut."

#: lib/tymeslot_web/controllers/auth/invitation_controller.ex
#, elixir-autogen, elixir-format
msgid "Welcome to Tymeslot! Your password is set."
msgstr "Willkommen bei Tymeslot! Ihr Passwort ist festgelegt."

#: lib/tymeslot_web/controllers/auth/invitation_controller.ex
#, elixir-autogen, elixir-format
msgid "Your password is set. Please log in to continue."
msgstr "Ihr Passwort ist festgelegt. Bitte melden Sie sich an, um fortzufahren."
