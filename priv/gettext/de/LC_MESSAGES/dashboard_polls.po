msgstr "Wer abstimmen darf"

#: lib/tymeslot_web/live/dashboard/polls/poll_invite.ex
#, elixir-autogen, elixir-format
msgid "%{count} address has had too many emails recently and was not invited."
msgid_plural "%{count} addresses have had too many emails recently and were not invited."
msgstr[0] "%{count} Adresse hat in letzter Zeit zu viele E-Mails erhalten und wurde nicht eingeladen."
msgstr[1] "%{count} Adressen haben in letzter Zeit zu viele E-Mails erhalten und wurden nicht eingeladen."

#: lib/tymeslot_web/live/dashboard/polls/poll_invite.ex
#, elixir-autogen, elixir-format
