msgstr "Abstimmungslink erneut senden"

#: lib/tymeslot_web/live/dashboard/polls/poll_participant_list.ex
#, elixir-autogen, elixir-format
msgid "Sent %{name} their link again."
msgstr "Link erneut an %{name} gesendet."

#: lib/tymeslot_web/live/dashboard/polls/poll_participant_list.ex
#, elixir-autogen, elixir-format
