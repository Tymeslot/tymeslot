msgid_plural "%{used} of %{count} times"
msgstr[0] "%{used} von %{count} Zeit"
msgstr[1] "%{used} von %{count} Zeiten"

#: lib/tymeslot_web/live/dashboard/polls/poll_list.ex
#, elixir-autogen, elixir-format
msgid "Connect a calendar"
msgstr "Kalender verbinden"

#: lib/tymeslot_web/live/dashboard/polls/poll_invite.ex
#, elixir-autogen, elixir-format
msgid "Connect a calendar first: guests vote on a page that opens once you have."
msgstr "Verbinden Sie zuerst einen Kalender: Gäste stimmen auf einer Seite ab, die erst danach verfügbar ist."

