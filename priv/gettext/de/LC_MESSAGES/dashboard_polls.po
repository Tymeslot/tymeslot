msgid_plural "Poll created. %{count} addresses have had too many emails recently and were not invited."
msgstr[0] "Umfrage erstellt. %{count} Adresse hat in letzter Zeit zu viele E-Mails erhalten und wurde nicht eingeladen."
msgstr[1] "Umfrage erstellt. %{count} Adressen haben in letzter Zeit zu viele E-Mails erhalten und wurden nicht eingeladen."

#: lib/tymeslot_web/live/dashboard/polls/poll_invite.ex
#, elixir-autogen, elixir-format
msgid "You can invite up to %{count} more person right now."
msgid_plural "You can invite up to %{count} more people right now."
msgstr[0] "Sie können derzeit noch bis zu %{count} weitere Person einladen."
msgstr[1] "Sie können derzeit noch bis zu %{count} weitere Personen einladen."

#: lib/tymeslot_web/live/dashboard/polls/poll_invite.ex
#, elixir-autogen, elixir-format
msgid "You can't invite anyone else right now. Please try again later."
msgstr "Sie können derzeit niemanden mehr einladen. Bitte versuchen Sie es später noch einmal."

#: lib/tymeslot_web/live/dashboard/polls/poll_editor.ex
#, elixir-autogen, elixir-format
msgid "%{name} (unavailable for new polls)"
msgstr "%{name} (für neue Umfragen nicht verfügbar)"

#: lib/tymeslot_web/live/dashboard/polls/poll_editor.ex
#, elixir-autogen, elixir-format
msgid "%{name} is switched off or takes payment, so new polls can't use it. This poll keeps it until you choose another."
msgstr "%{name} ist deaktiviert oder kostenpflichtig, daher können neue Umfragen diesen Termintyp nicht verwenden. Diese Umfrage behält ihn, bis Sie einen anderen wählen."

#: lib/tymeslot_web/live/dashboard/polls/remove_participant_modal.ex
