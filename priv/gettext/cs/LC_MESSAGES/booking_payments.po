#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking cancelled"
msgstr "Rezervace byla zrušena"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking confirmed"
msgstr "Rezervace byla potvrzena"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking not accepted"
msgstr "Rezervace nebyla přijata"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking request expired"
msgstr "Žádost o rezervaci vypršela"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Confirming your payment…"
msgstr "Potvrzování platby…"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "If there's no answer by %{by_deadline}, the request lapses and you're refunded automatically."
msgstr "Pokud do %{by_deadline} nepřijde odpověď, žádost propadne a platba vám bude vrácena automaticky."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "If there's no answer by %{by_deadline}, the request lapses."
msgstr "Pokud do %{by_deadline} nepřijde odpověď, žádost propadne."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Nobody responded to this request in time, so it has lapsed."
msgstr "Nikdo neodpověděl včas, žádost tedy propadla."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Nobody responded to this request in time, so it has lapsed. Your payment is being refunded."
msgstr "Nikdo neodpověděl včas, žádost tedy propadla. Vaše platba se vrací."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment cancelled"
msgstr "Platba byla zrušena"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment not completed"
msgstr "Platba nebyla dokončena"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment received"
msgstr "Platba přijata"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Please wait while we confirm your booking."
msgstr "Počkejte prosím, než vaši rezervaci potvrdíme."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Return to booking"
msgstr "Zpět na rezervaci"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thank you, your booking is confirmed for %{for_date}."
msgstr "Děkujeme, vaše rezervace je potvrzena na termín %{for_date}."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thanks, your payment went through. Your booking is not confirmed yet though:"
msgstr "Děkujeme, platba proběhla úspěšně. Vaše rezervace ale zatím není potvrzena:"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking has been cancelled, so it won't be going ahead."
msgstr "Tato rezervace byla zrušena, a proto se neuskuteční."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking wasn't accepted, so it won't be going ahead."
msgstr "Tato rezervace nebyla přijata, a proto se neuskuteční."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking wasn't accepted, so it won't be going ahead. Your payment is being refunded."
msgstr "Tato rezervace nebyla přijata, a proto se neuskuteční. Vaše platba se vrací."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. You can return and try again at any time."
msgstr "Vaše rezervace nebyla potvrzena. Kdykoli se můžete vrátit a zkusit to znovu."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Paid: %{amount}"
msgstr "Zaplaceno: %{amount}"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. Your invitation stays reserved for it until the unfinished checkout expires, and a link to book again will appear here as soon as it does."
msgstr "Vaše rezervace nebyla potvrzena. Pozvánka zůstává pro tuto rezervaci blokovaná, dokud nevyprší nedokončená platba. Jakmile se tak stane, objeví se zde odkaz pro novou rezervaci."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. To try again, open the invitation link you were sent."
msgstr "Vaše rezervace není potvrzena. Chcete-li to zkusit znovu, otevřete odkaz s pozvánkou, který jste dostali."

#: lib/tymeslot/meeting_payments/checkout_sessions.ex
#, elixir-autogen, elixir-format
msgid "%{name}, %{count} session"
msgid_plural "%{name}, %{count} sessions"
msgstr[0] "%{name}, %{count} termín"
msgstr[1] "%{name}, %{count} termíny"
msgstr[2] "%{name}, %{count} termínů"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thank you, your %{count} session is confirmed, the first on %{on_date}."
msgid_plural "Thank you, your %{count} sessions are confirmed, the first on %{on_date}."
msgstr[0] "Děkujeme, váš %{count} termín je potvrzen, první %{on_date}."
msgstr[1] "Děkujeme, vaše %{count} termíny jsou potvrzeny, první %{on_date}."
msgstr[2] "Děkujeme, vašich %{count} termínů je potvrzeno, první %{on_date}."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "The payment wasn't completed in time, so the seat held for you was released. You can return and book again."
msgid_plural "The payment wasn't completed in time, so the seats held for you were released. You can return and book again."
msgstr[0] "Platba nebyla včas dokončena, místo držené pro vás proto bylo uvolněno. Můžete se vrátit a rezervovat znovu."
msgstr[1] "Platba nebyla včas dokončena, místa držená pro vás proto byla uvolněna. Můžete se vrátit a rezervovat znovu."
msgstr[2] "Platba nebyla včas dokončena, místa držená pro vás proto byla uvolněna. Můžete se vrátit a rezervovat znovu."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your payment arrived after the seat held for you was released, and the session had no room left. Your payment is being refunded."
msgid_plural "Your payment arrived after the seats held for you were released, and the session had no room left. Your payment is being refunded."
msgstr[0] "Vaše platba dorazila až po uvolnění místa, které pro vás bylo drženo, a setkání už bylo plně obsazené. Platba se vám vrací."
msgstr[1] "Vaše platba dorazila až po uvolnění míst, která pro vás byla držena, a setkání už bylo plně obsazené. Platba se vám vrací."
msgstr[2] "Vaše platba dorazila až po uvolnění míst, která pro vás byla držena, a setkání už bylo plně obsazené. Platba se vám vrací."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your seat was released"
msgid_plural "Your seats were released"
msgstr[0] "Vaše místo bylo uvolněno"
msgstr[1] "Vaše místa byla uvolněna"
msgstr[2] "Vaše místa byla uvolněna"
