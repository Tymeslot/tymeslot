#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Meeting created and invitation sent"
msgstr "Schůzka byla vytvořena a pozvánka odeslána"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The recurrence end date must be on or after the event start."
msgstr "Datum konce opakování nesmí předcházet začátku události."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many edits. Please wait a moment."
msgstr "Příliš mnoho úprav. Počkejte prosím chvíli."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many moves. Please wait a moment."
msgstr "Příliš mnoho přesunů. Počkejte prosím chvíli."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "You don't have permission to modify this event"
msgstr "Nemáte oprávnění tuto událost upravit"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Delete failed - queued to retry on next sync"
msgstr "Smazání se nezdařilo – zkusíme to znovu při příští synchronizaci"

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Failed to update event - changes reverted"
msgstr "Událost se nepodařilo aktualizovat – změny byly vráceny zpět"

#: lib/tymeslot/calendar_grid/event_creation.ex
#, elixir-autogen, elixir-format
msgid "Google Calendar saved the event but didn't return a Meet link — please try again or add it manually."
msgstr "Google Calendar událost uložil, ale nevrátil odkaz na Meet – zkuste to prosím znovu nebo jej přidejte ručně."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Guest name is required"
msgstr "Jméno hosta je povinné"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Meeting with %{name}"
msgstr "Schůzka s %{name}"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This calendar is read-only. Events on it can't be changed from Tymeslot."
msgstr "Tento kalendář je jen pro čtení. Události v něm nelze měnit z Tymeslotu."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Could not change the video link - changes reverted"
msgstr "Odkaz na videoschůzku se nepodařilo změnit – změny byly vráceny zpět"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Could not move the event. It is still on its original calendar."
msgstr "Událost se nepodařilo přesunout. Zůstává v původním kalendáři."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar, but the original could not be removed. Please delete it from its original calendar."
msgstr "Událost byla zkopírována do nového kalendáře, ale původní událost se nepodařilo odstranit. Smažte ji prosím z původního kalendáře."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar. The original will be removed on the next sync."
msgstr "Událost byla zkopírována do nového kalendáře. Původní událost bude odstraněna při příští synchronizaci."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event moved to the new calendar."
msgstr "Událost byla přesunuta do nového kalendáře."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "The video provider did not return a meeting link, so the video link was not changed."
msgstr "Poskytovatel videa nevrátil odkaz na schůzku, takže odkaz na videoschůzku nebyl změněn."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Video link removed."
msgstr "Odkaz na videoschůzku byl odebrán."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Video room created."
msgstr "Místnost pro videoschůzku byla vytvořena."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Your calendar could not be reached. The change is saved and will sync on the next attempt."
msgstr "K vašemu kalendáři se nepodařilo připojit. Změna je uložena a synchronizuje se při příštím pokusu."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar, but the move did not finish. Please check its original calendar and delete the original if it is still there."
msgstr "Událost byla zkopírována do nového kalendáře, ale přesun se nedokončil. Zkontrolujte prosím původní kalendář a smažte původní událost, pokud tam stále je."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event is a booking, so its video link belongs to the booking. Reschedule or cancel the booking to change it."
msgstr "Tato událost je rezervace, takže její odkaz na video patří k rezervaci. Chcete-li jej změnit, přeplánujte nebo zrušte rezervaci."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Google Calendar added Google Meet to the event but has not returned its link yet. Choose Google Meet again to fetch it."
msgstr "Kalendář Google přidal k události Google Meet, ale zatím nevrátil jeho odkaz. Vyberte Google Meet znovu, abyste jej získali."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Recurring Exchange events cannot be deleted here yet. Please delete this one in your calendar app."
msgstr "Opakující se události Exchange zatím nelze smazat zde. Smažte prosím tuto událost ve své kalendářové aplikaci."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event could not be deleted here. Please delete it in your calendar app."
msgstr "Tuto událost se zde nepodařilo smazat. Smažte ji prosím ve své kalendářové aplikaci."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Events of a repeating series cannot be switched between all-day and timed here. Please make this change in your calendar app."
msgstr "Události opakující se série zde nelze přepnout mezi celodenní a časovanou. Proveďte prosím tuto změnu ve své kalendářové aplikaci."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "That change cannot be made to the events you chose. A repeat rule can only be changed for all events, or this and following events, and cannot be removed here."
msgstr "Tuto změnu nelze u zvolených událostí provést. Pravidlo opakování lze změnit jen pro všechny události, nebo pro tuto a následující, a zde jej nelze odstranit."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was updated, but a change you made while it was saving was not applied. Please make it again."
msgid_plural "The series was updated, but %{count} changes you made while it was saving were not applied. Please make them again."
msgstr[0] "Série byla aktualizována, ale změna provedená během ukládání nebyla použita. Proveďte ji prosím znovu."
msgstr[1] "Série byla aktualizována, ale %{count} změny provedené během ukládání nebyly použity. Proveďte je prosím znovu."
msgstr[2] "Série byla aktualizována, ale %{count} změn provedených během ukládání nebylo použito. Proveďte je prosím znovu."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event could not be matched to its series. Refresh your calendars and try again."
msgstr "Tuto událost se nepodařilo přiřadit k její sérii. Obnovte své kalendáře a zkuste to znovu."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series repeats on fixed days, such as the second Monday of the month, so it cannot be moved like this. Please make this change in your calendar app."
msgstr "Tato série se opakuje v pevné dny, například druhé pondělí v měsíci, a proto ji nelze takto přesunout. Proveďte prosím tuto změnu ve své kalendářové aplikaci."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series' repeat rule cannot be split here. Please make this change in your calendar app."
msgstr "Pravidlo opakování této série zde nelze rozdělit. Proveďte prosím tuto změnu ve své kalendářové aplikaci."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "A Teams meeting on the series is not carried over."
msgstr "Schůzka Teams v sérii se nepřenáší."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "A recurring event can only be moved to a calendar of the same kind of account: Google to Google, Outlook to Outlook, or CalDAV to CalDAV."
msgstr "Opakující se událost lze přesunout jen do kalendáře stejného druhu účtu: z Googlu do Googlu, z Outlooku do Outlooku nebo z CalDAV do CalDAV."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Could not move the series. It is still on its original calendar."
msgstr "Sérii se nepodařilo přesunout. Zůstává v původním kalendáři."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Events in the series that were changed on their own go back to the series' usual pattern."
msgstr "Jednotlivě změněné události série se vrátí k obvyklému vzoru série."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Events in the series that were changed or cancelled on their own go back to the series' usual pattern."
msgstr "Jednotlivě změněné nebo zrušené události série se vrátí k obvyklému vzoru série."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Guests are sent a cancellation for the original series and an invitation to the moved one."
msgstr "Hosté obdrží zrušení původní série a pozvánku do přesunuté."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Recurring events on this calendar cannot be moved to another calendar. Only single events can be moved."
msgstr "Opakující se události v tomto kalendáři nelze přesunout do jiného kalendáře. Přesunout lze jen jednotlivé události."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "That calendar cannot be written to. Please choose another calendar."
msgstr "Do tohoto kalendáře nelze zapisovat. Vyberte prosím jiný kalendář."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series is already on that calendar."
msgstr "Série už v tomto kalendáři je."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was copied to %{calendar}, but the original series could not be removed. Please delete it from its original calendar."
msgstr "Série byla zkopírována do %{calendar}, ale původní sérii se nepodařilo odstranit. Smažte ji prosím z původního kalendáře."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was moved to %{calendar}."
msgstr "Série byla přesunuta do %{calendar}."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was moved, but a change you made while it was moving was not applied. Please make it again."
msgid_plural "The series was moved, but %{count} changes you made while it was moving were not applied. Please make them again."
msgstr[0] "Série byla přesunuta, ale změna provedená během přesunu nebyla použita. Proveďte ji prosím znovu."
msgstr[1] "Série byla přesunuta, ale %{count} změny provedené během přesunu nebyly použity. Proveďte je prosím znovu."
msgstr[2] "Série byla přesunuta, ale %{count} změn provedených během přesunu nebylo použito. Proveďte je prosím znovu."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "A change to this series is still saving. Please make this change once it has saved."
msgstr "Změna této série se ještě ukládá. Proveďte prosím tuto změnu, až bude uložena."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Delete failed - queued to retry on next sync. Attendees have not been notified."
msgstr "Smazání se nezdařilo – zkusíme to znovu při příští synchronizaci. Účastníci nebyli informováni."

#: lib/tymeslot_web/live/dashboard/calendar/panel_group_event.ex
#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Too many new meetings. Please wait a moment."
msgstr "Příliš mnoho nových schůzek. Počkejte prosím chvíli."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Someone else organises this meeting, so Tymeslot can't move or split a series you were only invited to."
msgstr "Tuto schůzku organizuje někdo jiný, takže Tymeslot nemůže přesunout ani rozdělit sérii, na kterou jste byli jen pozváni."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This is a group booking. Move it, cancel it or change who attends from the meeting instead."
msgstr "Toto je skupinová rezervace. Přesunout, zrušit nebo změnit účastníky můžete ve schůzce."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "You already have a meeting at this time. Please choose a different time."
msgstr "V tuto dobu už máte schůzku. Vyberte prosím jiný čas."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This repeat pattern can't be saved to Outlook."
msgstr "Tento způsob opakování nelze uložit do Outlooku."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Outlook can't skip the months that don't have this series' day, and would move those events to the month's last day. Please start the series on the 28th or earlier, or save it to another calendar."
msgstr ""
"Outlook neumí přeskočit měsíce, které nemají den této série, a takové události by přesunul na poslední den měsíce. Začněte prosím sérii nejpozději 28. dne nebo ji uložte do jiného kalendáře."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series changed while you were editing it, and nothing is left of it from this event on. Nothing was saved."
msgstr "Tato série se během vašich úprav změnila a od této události z ní už nic nezbývá. Nic se neuložilo."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series changed while you were editing it, so the events left in it can no longer be counted. Nothing was saved. Refresh the calendar and try again."
msgstr "Tato série se během vašich úprav změnila, takže už nelze spočítat, kolik událostí v ní zbývá. Nic se neuložilo. Obnovte kalendář a zkuste to znovu."

#: lib/tymeslot_web/live/dashboard/calendar/panel_guests.ex
#, elixir-autogen, elixir-format
msgid "Attendee added, but their invitation could not be sent."
msgstr "Účastník byl přidán, ale pozvánku se nepodařilo odeslat."

#: lib/tymeslot_web/live/dashboard/calendar/panel_guests.ex
#, elixir-autogen, elixir-format
msgid "Attendee removed, but they could not be notified."
msgstr "Účastník byl odebrán, ale nepodařilo se ho informovat."

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
