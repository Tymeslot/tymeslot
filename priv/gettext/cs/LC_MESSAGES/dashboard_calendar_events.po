msgstr "E-mail"

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
msgid "Notification"
msgstr "Oznámení"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Ada Lovelace"
msgstr "Ada Lovelace"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Books the slot, emails the guest an invitation, and adds it to your calendar."
msgstr "Zarezervuje termín, pošle hostovi e-mailem pozvánku a přidá schůzku do vašeho kalendáře."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Guest name"
msgstr "Jméno hosta"

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
msgid "before the event"
msgstr "před událostí"

#: lib/tymeslot_web/live/dashboard/calendar/panel_new_form.ex
#, elixir-autogen, elixir-format
msgid "An agenda, or anything to bring or prepare"
msgstr "Program schůzky nebo co si přinést či připravit"

#: lib/tymeslot_web/live/dashboard/calendar/panel_new_form.ex
#, elixir-autogen, elixir-format
msgid "Included in the invitation and on the calendar entry."
msgstr "Bude součástí pozvánky i záznamu v kalendáři."

#: lib/tymeslot_web/live/dashboard/calendar/panel_new_form.ex
#, elixir-autogen, elixir-format
msgid "Note to the guest"
msgstr "Poznámka pro hosta"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Language of the invitation"
msgstr "Jazyk pozvánky"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "The language every email about this meeting is written in, for the guest and anyone else invited."
msgstr "Jazyk všech e-mailů o této schůzce – pro hosta i pro všechny další pozvané."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Add up to %{count} reminder email for this meeting. The guest and anyone else invited receive it."
msgid_plural "Add up to %{count} reminder emails for this meeting. The guest and anyone else invited receive it."
msgstr[0] "Pro tuto schůzku můžete přidat až %{count} e-mail s připomínkou. Dostane jej host i všichni další pozvaní."
msgstr[1] "Pro tuto schůzku můžete přidat až %{count} e-maily s připomínkou. Dostane je host i všichni další pozvaní."
msgstr[2] "Pro tuto schůzku můžete přidat až %{count} e-mailů s připomínkou. Dostane je host i všichni další pozvaní."

#: lib/tymeslot_web/live/dashboard/calendar/undelivered_notice.ex
#, elixir-autogen, elixir-format
msgid "Dismiss"
msgstr "Skrýt"

#: lib/tymeslot_web/live/dashboard/calendar/undelivered_notice.ex
#, elixir-autogen, elixir-format
msgid "The latest update could not be emailed to this guest. Let them know another way."
msgid_plural "The latest update could not be emailed to these guests. Let them know another way."
msgstr[0] "Nejnovější změnu se tomuto hostovi nepodařilo odeslat e-mailem. Dejte mu vědět jinak."
msgstr[1] "Nejnovější změnu se těmto hostům nepodařilo odeslat e-mailem. Dejte jim vědět jinak."
msgstr[2] "Nejnovější změnu se těmto hostům nepodařilo odeslat e-mailem. Dejte jim vědět jinak."
