msgstr "Rezervační kalendář vždy blokuje vaši dostupnost."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "%{used} of %{count} calendar in use, %{blocking} blocking your availability"
msgid_plural "%{used} of %{count} calendars in use, %{blocking} blocking your availability"
msgstr[0] "Používané kalendáře: %{used} z %{count}, z toho blokující vaši dostupnost: %{blocking}"
msgstr[1] "Používané kalendáře: %{used} z %{count}, z toho blokující vaši dostupnost: %{blocking}"
msgstr[2] "Používané kalendáře: %{used} z %{count}, z toho blokující vaši dostupnost: %{blocking}"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Busy times block"
msgstr "Blokuje obsazené časy"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Busy times of %{calendar}"
msgstr "Obsazené časy kalendáře %{calendar}"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Exchange reports busy times for your whole mailbox, and they block your booking page. Refresh this connection to list your main calendar and choose there whether they do."
msgstr "Exchange hlásí obsazené časy celé vaší poštovní schránky a ty blokují vaši rezervační stránku. Obnovte toto připojení, aby se v seznamu objevil váš hlavní kalendář, a tam zvolte, zda mají blokovat."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Show %{calendar} on your calendar"
msgstr "Zobrazit kalendář %{calendar} ve vašem kalendáři"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "This folder's events are shown only; busy times come from your whole mailbox."
msgstr "Události této složky se jen zobrazují; obsazené časy pocházejí z celé vaší poštovní schránky."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Use of %{calendar}"
msgstr "Použití kalendáře %{calendar}"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Whole mailbox"
msgstr "Celá poštovní schránka"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "Count every event as busy"
msgstr "Počítat každou událost jako obsazenou"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "Holiday and school-holiday calendars mark their events as free, so they would block nothing. With this on, every event in the feed blocks the time, however it is marked."
msgstr ""
"Kalendáře svátků a prázdnin označují své události jako volné, takže by nic neblokovaly. Když je tato volba zapnutá, každá událost ve zdroji blokuje čas bez ohledu na to, jak je označená."
