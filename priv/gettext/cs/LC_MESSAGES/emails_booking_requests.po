msgstr "Stáhnout žádost:"

#: lib/tymeslot/emails/templates/reschedule_request_expired.ex
#, elixir-autogen, elixir-format
msgid "Your booking with %{name} has been cancelled."
msgstr "Vaše rezervace s %{name} byla zrušena."

#: lib/tymeslot/emails/templates/booking_approval_request.ex
#, elixir-autogen, elixir-format
msgid "a meeting"
msgstr "schůzku"

#: lib/tymeslot/emails/templates/booking_request_received.ex
#, elixir-autogen, elixir-format
msgid "withdraw your request"
msgstr "stáhnout žádost"

#: lib/tymeslot/emails/templates/booking_email_verification.ex
#, elixir-autogen, elixir-format
msgid "Confirm booking"
msgstr "Potvrdit rezervaci"

#: lib/tymeslot/emails/templates/booking_email_verification.ex
#, elixir-autogen, elixir-format
msgid "Confirm your booking with %{organizer}"
msgstr "%{organizer}: potvrďte prosím svou rezervaci"

#: lib/tymeslot/emails/templates/booking_email_verification.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, your booking is not confirmed yet."
msgstr "Dobrý den, %{name}, vaše rezervace zatím není potvrzena."

#: lib/tymeslot/emails/templates/booking_email_verification.ex
#, elixir-autogen, elixir-format
msgid "If you did not make this booking, ignore this email. Nothing will be booked."
msgstr "Pokud tato rezervace není od vás, tento e-mail ignorujte. Nic nebude zarezervováno."

#: lib/tymeslot/emails/templates/booking_email_verification.ex
#, elixir-autogen, elixir-format
msgid "Please confirm your booking"
msgstr "Potvrďte prosím svou rezervaci"

#: lib/tymeslot/emails/templates/booking_email_verification.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed yet. Click the button below by %{by_deadline} to confirm it, and we will hold the time for you until then."
msgstr "Vaše rezervace ještě není potvrzená. Potvrďte ji kliknutím na tlačítko níže do %{by_deadline}. Do té doby vám termín podržíme."

#: lib/tymeslot/emails/templates/reschedule_request_unanswered.ex
#, elixir-autogen, elixir-format
msgid "%{name} didn't pick a new time, so your meeting has expired."
msgstr "Nový termín nebyl vybrán, proto vaše schůzka s účastníkem %{name} vypršela."

#: lib/tymeslot/emails/templates/reschedule_request_lapsed.ex
#, elixir-autogen, elixir-format
msgid "%{organizer} asked you to pick a new time for this meeting, and that request has now lapsed. The original time had already been cancelled, so nothing is booked. If you'd still like to meet, you can book a new time from the booking page."
msgstr "Žádost ze strany %{organizer}, abyste pro tuto schůzku vybrali nový termín, nyní propadla. Původní termín už byl zrušen, takže teď není nic rezervováno. Pokud se stále chcete sejít, můžete si na rezervační stránce zarezervovat nový termín."

#: lib/tymeslot/emails/templates/reschedule_request_lapsed.ex
#, elixir-autogen, elixir-format
msgid "Book a new time"
msgstr "Zarezervovat nový termín"

#: lib/tymeslot/emails/templates/reschedule_request_lapsed.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, the request to pick a new time has lapsed."
msgstr "Dobrý den, %{name}, žádost o výběr nového termínu propadla."

#: lib/tymeslot/emails/templates/reschedule_request_unanswered.ex
#, elixir-autogen, elixir-format
msgid "Meeting expired"
msgstr "Schůzka vypršela"

#: lib/tymeslot/emails/templates/reschedule_request_unanswered.ex
#, elixir-autogen, elixir-format
msgid "No New Time Picked"
msgstr "Nový termín nebyl vybrán"

#: lib/tymeslot/emails/templates/reschedule_request_unanswered.ex
#, elixir-autogen, elixir-format
msgid "No new time picked: %{title} - %{date}"
msgstr "Nový termín nebyl vybrán: %{title} - %{date}"

#: lib/tymeslot/emails/templates/reschedule_request_unanswered.ex
#, elixir-autogen, elixir-format
msgid "Nobody picked a new time for %{title}, so it has expired."
msgstr "Pro schůzku %{title} nikdo nevybral nový termín, proto vypršela."

#: lib/tymeslot/emails/templates/reschedule_request_lapsed.ex
#: lib/tymeslot/emails/templates/reschedule_request_unanswered.ex
#, elixir-autogen, elixir-format
msgid "ORIGINAL TIME:"
msgstr "PŮVODNÍ TERMÍN:"

#: lib/tymeslot/emails/templates/reschedule_request_lapsed.ex
#: lib/tymeslot/emails/templates/reschedule_request_unanswered.ex
#, elixir-autogen, elixir-format
msgid "Original Time"
msgstr "Původní termín"

#: lib/tymeslot/emails/templates/reschedule_request_lapsed.ex
#, elixir-autogen, elixir-format
msgid "Reschedule Request Lapsed"
msgstr "Žádost o přesunutí propadla"

#: lib/tymeslot/emails/templates/reschedule_request_lapsed.ex
#, elixir-autogen, elixir-format
msgid "Reschedule request lapsed: %{title} - %{date}"
msgstr "Žádost o přesunutí propadla: %{title} - %{date}"

#: lib/tymeslot/emails/templates/reschedule_request_unanswered.ex
#, elixir-autogen, elixir-format
msgid "You asked %{name} to pick a new time for this meeting, and the request lapsed before they did. Its original time had already been given up, so the meeting has expired. %{name} has been told and can book again from your booking page."
msgstr "Vaše žádost o výběr nového termínu této schůzky, adresovaná účastníkovi %{name}, propadla dřív, než byl nový termín vybrán. Původní termín schůzky už byl uvolněn, a proto schůzka vypršela. Účastníkovi %{name} jsme to oznámili a může si znovu zarezervovat schůzku na vaší rezervační stránce."

#: lib/tymeslot/emails/templates/reschedule_request_unanswered.ex
#, elixir-autogen, elixir-format
msgid "You asked for this meeting to be moved, and the request lapsed before anyone still on it picked a new time. Its original time had already been given up, so the meeting has expired. The participants have been told and can book again from your booking page."
msgstr "Vaše žádost o přesunutí této schůzky propadla dřív, než nový termín vybral kdokoli ze zbývajících účastníků. Původní termín schůzky už byl uvolněn, a proto schůzka vypršela. Účastníkům jsme to oznámili a mohou si znovu zarezervovat schůzku na vaší rezervační stránce."

#: lib/tymeslot/emails/templates/booking_email_verification.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed yet. Click the button below by %{by_deadline} to confirm it, and we will hold your place until then."
msgstr "Vaše rezervace ještě není potvrzená. Potvrďte ji kliknutím na tlačítko níže do %{by_deadline}. Do té doby vám místo podržíme."
