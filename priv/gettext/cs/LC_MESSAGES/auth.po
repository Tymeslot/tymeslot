#: lib/tymeslot_web/controllers/auth/helpers/controller_helpers.ex
#, elixir-autogen, elixir-format
msgid "Email address is required to complete registration."
msgstr "K dokončení registrace je potřeba e-mailová adresa."

#: lib/tymeslot_web/controllers/auth/helpers/controller_helpers.ex
#, elixir-autogen, elixir-format
msgid "Email address is required to complete registration. Please provide your email address."
msgstr "K dokončení registrace je potřeba e-mailová adresa. Zadejte prosím svou e-mailovou adresu."

#: lib/tymeslot_web/live/auth_live/page_meta_helper.ex
#, elixir-autogen, elixir-format
msgid "Enter your email to receive a password reset link for your Tymeslot account."
msgstr "Zadejte svůj e-mail a pošleme vám odkaz pro obnovení hesla k účtu Tymeslot."

#: lib/tymeslot_web/controllers/auth/helpers/controller_helpers.ex
#, elixir-autogen, elixir-format
msgid "Failed to create user account. Please try again."
msgstr "Uživatelský účet se nepodařilo vytvořit. Zkuste to prosím znovu."

#: lib/tymeslot_web/controllers/auth/helpers/controller_helpers.ex
#, elixir-autogen, elixir-format
msgid "Invalid OAuth data received. Please try again."
msgstr "Přijatá data OAuth jsou neplatná. Zkuste to prosím znovu."

#: lib/tymeslot_web/live/auth_live/state_helper.ex
#, elixir-autogen, elixir-format
msgid "No pending registration found. Please sign in again."
msgstr "Nebyla nalezena žádná rozpracovaná registrace. Přihlaste se prosím znovu."

#: lib/tymeslot_web/controllers/auth/helpers/controller_helpers.ex
#, elixir-autogen, elixir-format
msgid "Please correct the errors in the form."
msgstr "Opravte prosím chyby ve formuláři."

#: lib/tymeslot_web/controllers/auth/helpers/controller_helpers.ex
#, elixir-autogen, elixir-format
msgid "Please provide a valid email address."
msgstr "Zadejte prosím platnou e-mailovou adresu."

#: lib/tymeslot_web/controllers/auth/helpers/controller_helpers.ex
#, elixir-autogen, elixir-format
msgid "Registration failed due to validation errors. Please check your information and try again."
msgstr "Registrace se nezdařila kvůli chybám ve formuláři. Zkontrolujte prosím zadané údaje a zkuste to znovu."

#: lib/tymeslot_web/live/auth_live/page_meta_helper.ex
#, elixir-autogen, elixir-format
msgid "Sign in to your Tymeslot account to manage scheduling links, availability, and bookings."
msgstr "Přihlaste se ke svému účtu Tymeslot a spravujte rezervační odkazy, dostupnost a rezervace."

#: lib/tymeslot_web/controllers/auth/helpers/controller_helpers.ex
#, elixir-autogen, elixir-format
msgid "This email address is already associated with another account. Please use a different email or sign in to your existing account."
msgstr "Tato e-mailová adresa už patří k jinému účtu. Použijte prosím jiný e-mail nebo se přihlaste ke stávajícímu účtu."

#: lib/tymeslot/auth/auth_actions.ex
#: lib/tymeslot_web/controllers/auth/helpers/controller_helpers.ex
#, elixir-autogen, elixir-format
msgid "Too many attempts. Please try again later."
msgstr "Příliš mnoho pokusů. Zkuste to prosím později."

#: lib/tymeslot_web/controllers/auth/helpers/controller_helpers.ex
#, elixir-autogen, elixir-format
msgid "You must accept the terms to continue."
msgstr "Pro pokračování je nutné přijmout podmínky."

#: lib/tymeslot_web/components/auth/registration/complete_registration_component.ex
#, elixir-autogen, elixir-format
msgid "your.email@example.com"
msgstr "your.email@example.com"

#: lib/tymeslot_web/hooks/auth_live_session_hook.ex
#, elixir-autogen, elixir-format
msgid "You are already logged in."
msgstr "Již máte aktivní přihlášení."

#: lib/tymeslot_web/hooks/auth_live_session_hook.ex
#: lib/tymeslot_web/plugs/require_auth.ex
#, elixir-autogen, elixir-format
msgid "You must be logged in to access this page."
msgstr "Pro přístup na tuto stránku se musíte přihlásit."

#: lib/tymeslot_web/hooks/auth_live_session_hook.ex
#, elixir-autogen, elixir-format
msgid "Your session has expired. Please log in again."
msgstr "Platnost vaší relace vypršela. Přihlaste se prosím znovu."

#: lib/tymeslot_web/components/auth/shared/auth_form_components.ex
#, elixir-autogen, elixir-format
msgid "I accept the %{terms} and %{privacy_policy}"
msgstr "Přijímám %{terms} a %{privacy_policy}"

#: lib/tymeslot_web/components/auth/registration/signup_component.ex
#, elixir-autogen, elixir-format
msgid "This site is protected by reCAPTCHA and the Google %{privacy_policy} and %{terms} apply."
msgstr "Tento web je chráněn službou reCAPTCHA a platí %{privacy_policy} a %{terms} společnosti Google."

#: lib/tymeslot_web/controllers/auth/helpers/controller_helpers.ex
#, elixir-autogen, elixir-format
msgid "An account with that email address already exists. Please log in instead."
msgstr "Účet s touto e-mailovou adresou už existuje. Přihlaste se prosím."

#: lib/tymeslot_web/controllers/auth/helpers/controller_helpers.ex
#, elixir-autogen, elixir-format
msgid "The email address from your login provider is not valid. Please try a different account."
msgstr "E-mailová adresa od vašeho poskytovatele přihlášení není platná. Zkuste prosím jiný účet."

#: lib/tymeslot/auth/auth_actions.ex
#, elixir-autogen, elixir-format
msgid "A server error occurred. Please try again"
msgstr "Došlo k chybě serveru. Zkuste to prosím znovu"

#: lib/tymeslot/auth/registration.ex
#, elixir-autogen, elixir-format
msgid "Account created but profile creation failed: %{reason}"
msgstr "Účet byl vytvořen, ale profil se nepodařilo vytvořit: %{reason}"

#: lib/tymeslot/auth/registration.ex
#, elixir-autogen, elixir-format
msgid "Account created but verification failed: %{reason}"
msgstr "Účet byl vytvořen, ale ověření se nezdařilo: %{reason}"

#: lib/tymeslot/auth/auth_actions.ex
#, elixir-autogen, elixir-format
msgid "Invalid input format"
msgstr "Neplatný formát vstupu"

#: lib/tymeslot/auth/auth_actions.ex
#, elixir-autogen, elixir-format
msgid "Invalid input provided"
msgstr "Neplatná vstupní data"

#: lib/tymeslot/auth/auth_actions.ex
#, elixir-autogen, elixir-format
msgid "Invalid or expired token"
msgstr "Token je neplatný nebo jeho platnost vypršela"

#: lib/tymeslot/auth/auth_actions.ex
#, elixir-autogen, elixir-format
msgid "Invalid password"
msgstr "Nesprávné heslo"

#: lib/tymeslot/auth/auth_actions.ex
#, elixir-autogen, elixir-format
