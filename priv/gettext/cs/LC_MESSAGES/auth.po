#, elixir-autogen, elixir-format
msgid "This email is already registered. Please use a different email or sign in."
msgstr "Tento e-mail je již zaregistrován. Použijte prosím jiný e-mail nebo se přihlaste."

#: lib/tymeslot/auth/auth_actions.ex
#, elixir-autogen, elixir-format
msgid "This link has expired. Please request a new one"
msgstr "Platnost odkazu vypršela. Požádejte prosím o nový"

#: lib/tymeslot/auth/auth_actions.ex
#, elixir-autogen, elixir-format
msgid "Your password has been reset successfully. Please log in with your new password."
msgstr "Vaše heslo bylo úspěšně obnoveno. Přihlaste se prosím novým heslem."
