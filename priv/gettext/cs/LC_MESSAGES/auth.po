msgstr "Přihlašování heslem je momentálně vypnuté."

#: lib/tymeslot/auth/registration.ex
#, elixir-autogen, elixir-format
msgid "Please correct the following errors: %{errors}"
msgstr "Opravte prosím tyto chyby: %{errors}"

#: lib/tymeslot/auth/auth_actions.ex
#, elixir-autogen, elixir-format
