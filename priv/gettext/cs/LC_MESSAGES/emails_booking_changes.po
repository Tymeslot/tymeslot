msgstr "Poslali jsme %{name} e-mail s novým časem konce a aktualizovanou položkou kalendáře."

#: lib/tymeslot/emails/templates/external_booking_change.ex
#, elixir-autogen, elixir-format
msgid "We emailed the guest the new end time, with an updated calendar entry."
msgid_plural "We emailed %{count} guests the new end time, with an updated calendar entry."
msgstr[0] "Poslali jsme hostovi e-mail s novým časem konce a aktualizovanou položkou kalendáře."
msgstr[1] "Poslali jsme %{count} hostům e-mail s novým časem konce a aktualizovanou položkou kalendáře."
msgstr[2] "Poslali jsme %{count} hostům e-mail s novým časem konce a aktualizovanou položkou kalendáře."

#: lib/tymeslot/emails/templates/appointment_cancellation.ex
#, elixir-autogen, elixir-format
