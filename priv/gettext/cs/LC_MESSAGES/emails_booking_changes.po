msgstr[0] "Poslali jsme %{count} účastníkovi e-mail s novým časem konce a aktualizovanou položkou kalendáře."
msgstr[1] "Poslali jsme %{count} účastníkům e-mail s novým časem konce a aktualizovanou položkou kalendáře."
msgstr[2] "Poslali jsme %{count} účastníkům e-mail s novým časem konce a aktualizovanou položkou kalendáře."

#: lib/tymeslot/emails/templates/external_booking_change.ex
