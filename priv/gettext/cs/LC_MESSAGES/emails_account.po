msgstr "U vašeho účtu Tymeslot byla vyžádána změna e-mailové adresy na %{new_email}."

#: lib/tymeslot/emails/templates/email_change_verification.ex
#, elixir-autogen, elixir-format
msgid "You asked to change the email address on your Tymeslot account. Confirm the new address below to finish the switch."
msgstr "U vašeho účtu Tymeslot byla vyžádána změna e-mailové adresy. Změnu dokončíte potvrzením nové adresy níže."

#: lib/tymeslot/emails/templates/email_change_confirmed.ex
#, elixir-autogen, elixir-format
msgid "You may need to sign in again on other devices"
msgstr "Na dalších zařízeních se možná budete muset přihlásit znovu"

#: lib/tymeslot/emails/templates/no_password_to_reset.ex
#, elixir-autogen, elixir-format
msgid "You sign in with %{provider}."
msgstr "Přihlašujete se přes %{provider}."

#: lib/tymeslot/emails/templates/social_signup_confirmation.ex
#, elixir-autogen, elixir-format
msgid "You're signing up for Tymeslot with %{provider}. Confirm this email address to create your account and sign in."
msgstr "Registrujete se do Tymeslotu přes %{provider}. Potvrďte tuto e-mailovou adresu, abyste si vytvořili účet a přihlásili se."

#: lib/tymeslot/emails/templates/email_change_confirmed.ex
#, elixir-autogen, elixir-format
msgid "Your Tymeslot account email address has been successfully changed."
msgstr "E-mailová adresa u vašeho účtu Tymeslot byla úspěšně změněna."

#: lib/tymeslot/emails/templates/email_change_confirmed.ex
#, elixir-autogen, elixir-format
msgid "Your Tymeslot account email address has been successfully changed. This confirmation is being sent to your previous address so you know the switch happened."
msgstr "E-mailová adresa u vašeho účtu Tymeslot byla úspěšně změněna. Toto potvrzení posíláme i na vaši předchozí adresu jako informaci o provedené změně."

#: lib/tymeslot/emails/templates/no_password_to_reset.ex
#, elixir-autogen, elixir-format
msgid "Your Tymeslot account has no password to reset."
msgstr "Váš účet Tymeslot nemá žádné heslo k obnovení."

#: lib/tymeslot/emails/templates/email_change_confirmed.ex
#, elixir-autogen, elixir-format
msgid "Your Tymeslot email address has been changed."
msgstr "E-mailová adresa u vašeho účtu Tymeslot byla změněna."

#: lib/tymeslot/emails/templates/email_change_confirmed.ex
#, elixir-autogen, elixir-format
msgid "Your account is now using the new address."
msgstr "Váš účet nyní používá novou adresu."

#: lib/tymeslot/emails/templates/email_change_notification.ex
#, elixir-autogen, elixir-format
msgid "Your current email remains active until the change is confirmed"
msgstr "Vaše stávající adresa zůstává aktivní, dokud změnu nepotvrdíte"

#: lib/tymeslot/emails/templates/email_change_confirmed.ex
#, elixir-autogen, elixir-format
msgid "Your meetings and settings remain unchanged"
msgstr "Vaše schůzky a nastavení zůstávají beze změny"
