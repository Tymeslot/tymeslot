msgstr "Neznámá proměnná šablony. Podporována je pouze {{meeting_id}}"

#: lib/tymeslot/integrations/video/input_validation.ex
#, elixir-autogen, elixir-format
msgid "Unknown video provider"
msgstr "Neznámý poskytovatel videa"

#: lib/tymeslot/integrations/video/providers/jitsi_provider.ex
#, elixir-autogen, elixir-format
msgid "Use an https:// server URL when token authentication is configured, so the tokens in meeting links are not sent unencrypted."
msgstr "Pokud je nastavené ověřování tokenem, použijte adresu serveru s https://, aby se tokeny v odkazech na schůzky neposílaly nešifrovaně."

#: lib/tymeslot/integrations/video/providers/nextcloud_talk_provider.ex
#, elixir-autogen, elixir-format
msgid "Use an https:// server URL. Nextcloud receives your app password with every request."
msgstr "Použijte adresu serveru s https://. Server Nextcloud dostává vaše heslo pro aplikaci s každým požadavkem."

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use curly brackets: {{meeting_id}} not ((meeting_id))"
msgstr "Použijte složené závorky: {{meeting_id}}, nikoli ((meeting_id))"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use curly brackets: {{meeting_id}} not <meeting_id>"
msgstr "Použijte složené závorky: {{meeting_id}}, nikoli <meeting_id>"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use curly brackets: {{meeting_id}} not [[meeting_id]]"
msgstr "Použijte složené závorky: {{meeting_id}}, nikoli [[meeting_id]]"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use double curly brackets: {{meeting_id}}"
msgstr "Použijte dvojité složené závorky: {{meeting_id}}"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use double curly brackets: {{meeting_id}} not {meeting_id}"
msgstr "Použijte dvojité složené závorky: {{meeting_id}}, nikoli {meeting_id}"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use lowercase: {{meeting_id}} not {{MEETING_ID}} or {{Meeting_Id}}"
msgstr "Používejte malá písmena: {{meeting_id}}, nikoli {{MEETING_ID}} nebo {{Meeting_Id}}"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use underscore not hyphen: {{meeting_id}} not {{meeting-id}}"
msgstr "Použijte podtržítko, ne pomlčku: {{meeting_id}}, nikoli {{meeting-id}}"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Variable name should be: {{meeting_id}}"
msgstr "Název proměnné má být: {{meeting_id}}"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Write the template variable exactly as {{meeting_id}}"
msgstr "Zapište proměnnou šablony přesně jako {{meeting_id}}"

#: lib/tymeslot/integrations/video/input_validation.ex
#, elixir-autogen, elixir-format
msgid "Write {{meeting_id}} with plain brackets: percent-encoded ones are never replaced"
msgstr "Zapište {{meeting_id}} s obyčejnými složenými závorkami: procentově zakódované se nikdy nenahrazují"

#: lib/tymeslot/integrations/video/provider_config.ex
