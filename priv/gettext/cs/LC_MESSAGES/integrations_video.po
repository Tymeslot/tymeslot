#, elixir-autogen, elixir-format
msgid "This Nextcloud Talk is too old. Tymeslot needs Talk 21.1 or later."
msgstr "Tato verze Nextcloud Talk je příliš stará. Tymeslot vyžaduje Talk 21.1 nebo novější."

#: lib/tymeslot/integrations/video/room_creation_error.ex
#, elixir-autogen, elixir-format
msgid "This Nextcloud user may not use Talk. In the Talk administration settings on Nextcloud, add the user to a group that may use Talk, or connect a user who may."
msgstr "Tento uživatel Nextcloudu nesmí používat Talk. V nastavení správy Talku v Nextcloudu přidejte uživatele do skupiny, která smí Talk používat, nebo připojte uživatele, který to smí."

#: lib/tymeslot/integrations/video/providers/link_room.ex
#, elixir-autogen, elixir-format
msgid "URL redirects too many times"
msgstr "URL adresa přesměrovává příliš mnohokrát"

#: lib/tymeslot/integrations/video/providers/link_room.ex
#, elixir-autogen, elixir-format
msgid "URL resolves to a private or loopback address"
msgstr "URL odkazuje na privátní adresu nebo adresu zpětné smyčky"

#: lib/tymeslot/integrations/video/providers/link_room.ex
#, elixir-autogen, elixir-format
