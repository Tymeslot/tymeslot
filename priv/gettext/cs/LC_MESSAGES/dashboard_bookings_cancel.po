#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "%{count} participant paid for this session (%{amount} still held)."
msgid_plural "%{count} participants paid for this session (%{amount} still held)."
msgstr[0] "Za toto setkání zaplatil %{count} účastník (u vás stále zůstává %{amount})."
msgstr[1] "Za toto setkání zaplatili %{count} účastníci (u vás stále zůstává %{amount})."
msgstr[2] "Za toto setkání zaplatilo %{count} účastníků (u vás stále zůstává %{amount})."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "A refund of %{amount} is already being processed."
msgstr "Vrácení %{amount} se už zpracovává."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Are you sure you want to cancel the meeting with %{name} scheduled for %{when}?"
msgstr "Opravdu chcete zrušit schůzku s účastníkem %{name} naplánovanou na %{when}?"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Are you sure you want to cancel this group meeting with %{count} participant scheduled for %{when}?"
msgid_plural "Are you sure you want to cancel this group meeting with %{count} participants scheduled for %{when}?"
msgstr[0] "Opravdu chcete zrušit tuto skupinovou schůzku s %{count} účastníkem naplánovanou na %{when}?"
msgstr[1] "Opravdu chcete zrušit tuto skupinovou schůzku s %{count} účastníky naplánovanou na %{when}?"
msgstr[2] "Opravdu chcete zrušit tuto skupinovou schůzku s %{count} účastníky naplánovanou na %{when}?"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Are you sure you want to cancel “%{title}” scheduled for %{when}? Every guest is told."
msgstr "Opravdu chcete zrušit „%{title}“ naplánovanou na %{when}? Všichni hosté dostanou zprávu."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel Meeting"
msgstr "Zrušit schůzku"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel meeting"
msgstr "Zrušit schůzku"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel without refund."
msgstr "Zrušit bez vrácení platby."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Cancelled without a refund: the booking was not paid."
msgstr "Zrušeno bez vrácení platby, protože rezervace nebyla zaplacena."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Cancelled without a refund: the payment is older than the 60-day refund window. You can refund it from Stripe."
msgstr "Zrušeno bez vrácení platby, protože platba je starší než 60denní lhůta pro vrácení. Vrátit ji můžete ve Stripe."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Cancelled without a refund: the payment is under dispute. Settle the dispute in Stripe first."
msgstr "Zrušeno bez vrácení platby, protože k platbě probíhá spor. Nejprve ho vyřešte ve Stripe."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Cancelled without a refund: the payment's refundable balance changed meanwhile. Check it on the payments page."
msgstr "Zrušeno bez vrácení platby, protože se mezitím změnil vratný zůstatek platby. Zkontrolujte ho v sekci Platby."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancelling won't refund %{count} participant (%{amount}): their payment is older than the 60-day refund window. You can refund it from Stripe."
msgid_plural "Cancelling won't refund %{count} participants (%{amount}): their payments are older than the 60-day refund window. You can refund them from Stripe."
msgstr[0] "Zrušením se %{count} účastníkovi (%{amount}) platba nevrátí, protože je starší než 60denní lhůta pro vrácení. Vrátit ji můžete ve Stripe."
msgstr[1] "Zrušením se %{count} účastníkům (%{amount}) platby nevrátí, protože jsou starší než 60denní lhůta pro vrácení. Vrátit je můžete ve Stripe."
msgstr[2] "Zrušením se %{count} účastníkům (%{amount}) platby nevrátí, protože jsou starší než 60denní lhůta pro vrácení. Vrátit je můžete ve Stripe."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancelling won't refund the attendee: the booking was not paid."
msgstr "Zrušením se účastníkovi nic nevrátí, protože rezervace nebyla zaplacena."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancelling won't refund the attendee: the payment is older than the 60-day refund window. You can refund it from Stripe."
msgstr "Zrušením se účastníkovi platba nevrátí, protože je starší než 60denní lhůta pro vrácení. Vrátit ji můžete ve Stripe."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancelling won't refund the attendee: the payment is under dispute. Settle the dispute in Stripe first."
msgstr "Zrušením se účastníkovi platba nevrátí, protože k ní probíhá spor. Nejprve ho vyřešte ve Stripe."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancelling..."
msgstr "Rušení…"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Confirm cancellation"
msgstr "Potvrdit zrušení"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Don't refund anyone."
msgstr "Nikomu platbu nevracet."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Each participant gets back what they paid, and an email once their refund is issued."
msgstr "Každý účastník dostane zpět, co zaplatil, a po vrácení platby také e-mail."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Each participant's payment stays with you until you refund it from Payments."
msgstr "Platba každého účastníka zůstane u vás, dokud ji nevrátíte v sekci Platby."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Enter a valid partial refund amount."
msgstr "Zadejte platnou částku částečného vrácení platby."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Failed to cancel meeting. Please try again."
msgstr "Schůzku se nepodařilo zrušit. Zkuste to prosím znovu."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Full refund."
msgstr "Plné vrácení platby."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "I understand the attendee will not receive a refund."
msgstr "Beru na vědomí, že účastníkovi nebude vrácena platba."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "I understand the participants get nothing back unless I refund them later from Payments."
msgstr "Beru na vědomí, že účastníci nedostanou nic zpět, pokud jim platby později nevrátím v sekci Platby."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Keep Meeting"
msgstr "Ponechat schůzku"

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Meeting cancelled and refund issued."
msgstr "Schůzka byla zrušena a platba byla vrácena."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Meeting cancelled successfully"
msgstr "Schůzka byla zrušena."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Meeting cancelled, but Stripe declined the refund. Check the payment in your Stripe dashboard."
msgstr "Schůzka byla zrušena, ale Stripe vrácení platby odmítl. Zkontrolujte platbu na nástěnce Stripe."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Meeting cancelled. The refund is being processed and the attendee will be emailed when it goes through."
msgstr "Schůzka byla zrušena. Vrácení platby se zpracovává a po jeho dokončení dostane účastník e-mail."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "No refund can be made: the booking was not paid."
msgstr "Vrácení platby není možné, protože rezervace nebyla zaplacena."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "No refund can be made: the payment is older than the 60-day refund window. You can refund it from Stripe."
msgstr "Platbu nelze vrátit, protože je starší než 60denní lhůta pro vrácení. Vrátit ji můžete ve Stripe."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "No refund can be made: the payment is under dispute. Settle the dispute in Stripe first."
msgstr "Platbu nelze vrátit, protože k ní probíhá spor. Nejprve ho vyřešte ve Stripe."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Partial amount"
msgstr "Částka k vrácení"

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Partial refund."
msgstr "Částečné vrácení platby."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Refund amount exceeds the remaining refundable balance."
msgstr "Částka k vrácení převyšuje zbývající vratný zůstatek."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Refund everyone in full."
msgstr "Vrátit všem platbu v plné výši."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Refund only part of the booking amount."
msgstr "Vrátí pouze část zaplacené částky."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Refund this session."
msgstr "Vrátit platbu za tento termín."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Refunds one session's share of the series payment (%{amount})."
msgstr "Vrátí podíl jednoho termínu na platbě za sérii (%{amount})."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "Refunds the remaining balance (%{amount})."
msgstr "Vrátí zbývající částku (%{amount})."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Session cancelled. Refunds are on their way."
msgstr "Setkání bylo zrušeno. Platby se právě vracejí."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "The attendee keeps no money. Use only if the attendee already agreed."
msgstr "Účastníkovi se nevrátí žádné peníze. Použijte pouze po předchozí dohodě s účastníkem."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "This action cannot be undone. Every participant will be notified of the cancellation."
msgstr "Tuto akci nelze vrátit zpět. Všichni účastníci budou o zrušení informováni."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "This action cannot be undone. The attendee will be notified of the cancellation."
msgstr "Tuto akci nelze vrátit zpět. Účastník obdrží oznámení o zrušení."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "This booking was already cancelled, so no refund was issued."
msgstr "Tato rezervace už byla zrušena, proto nebyla vrácena žádná platba."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "This booking was already cancelled."
msgstr "Tato rezervace už byla zrušena."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
#, elixir-autogen, elixir-format
msgid "This booking was paid. Choose how to handle the refund - the attendee always receives the full amount you refund."
msgstr "Tato rezervace byla zaplacena. Zvolte, jak naložit s vrácením platby – účastník vždy obdrží celou částku, kterou vrátíte."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Tick the acknowledgement to cancel without refunding the attendee."
msgstr "Chcete-li zrušit schůzku bez vrácení platby účastníkovi, zaškrtněte potvrzení."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Tick the acknowledgement to cancel without refunding the participants."
msgstr "Chcete-li setkání zrušit bez vrácení plateb účastníkům, zaškrtněte potvrzení."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "The payments for this meeting changed while this was open. Check them and choose again."
msgstr "Platby za tuto schůzku se změnily, zatímco bylo toto okno otevřené. Zkontrolujte je a vyberte znovu."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "Session cancelled. No payment could be refunded automatically: they are older than the 60-day refund window. You can refund them from Stripe."
msgstr "Setkání bylo zrušeno. Žádnou platbu nebylo možné vrátit automaticky, protože jsou starší než 60denní lhůta pro vrácení. Vrátit je můžete ve Stripe."
