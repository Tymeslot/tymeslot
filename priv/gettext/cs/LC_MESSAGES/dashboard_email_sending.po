#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "A test message is sent only to your current verified account email."
msgstr "Testovací zpráva se odešle pouze na aktuální ověřenou e-mailovou adresu vašeho účtu."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Check the email settings and try again."
msgstr "Zkontrolujte nastavení e-mailu a zkuste to znovu."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Choose a public SMTP hostname. Private and local mail servers are not supported."
msgstr "Zvolte veřejný název serveru SMTP. Soukromé a místní poštovní servery nejsou podporovány."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Credentials are saved securely. Leave the username and password blank to keep them."
msgstr "Přihlašovací údaje jsou bezpečně uložené. Pokud je chcete zachovat, ponechte uživatelské jméno a heslo prázdné."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP is disabled"
msgstr "Vlastní SMTP je vypnuté"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP is enabled"
msgstr "Vlastní SMTP je zapnuté"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Delete identity and credentials"
msgstr "Smazat identitu a přihlašovací údaje"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Delete saved identity"
msgstr "Smazat uloženou identitu"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Delete this SMTP identity?"
msgstr "Smazat tuto identitu SMTP?"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Email sending"
msgstr "Odesílání e-mailů"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Email sending settings are unavailable. Reload the page to continue."
msgstr "Nastavení odesílání e-mailů není k dispozici. Pro pokračování znovu načtěte stránku."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Email settings need attention"
msgstr "Nastavení e-mailu vyžaduje pozornost"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Email testing is temporarily unavailable. Try again shortly."
msgstr "Testování e-mailu dočasně není k dispozici. Zkuste to za chvíli znovu."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "From address"
msgstr "Adresa odesílatele"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "From display name"
msgstr "Zobrazované jméno odesílatele"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Implicit TLS (port 465)"
msgstr "Implicitní TLS (port 465)"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Keep identity"
msgstr "Zachovat identitu"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Required STARTTLS (port 587)"
msgstr "Povinné STARTTLS (port 587)"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP hostname"
msgstr "Název serveru SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP password or app password"
msgstr "Heslo SMTP nebo heslo aplikace"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP settings"
msgstr "Nastavení SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP username"
msgstr "Uživatelské jméno SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Connection security"
msgstr "Zabezpečení připojení"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Test and save"
msgstr "Otestovat a uložit"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Test and save your SMTP settings to activate this sending identity."
msgstr "Otestujte a uložte nastavení SMTP, abyste aktivovali tuto identitu odesílatele."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Test and save these settings before enabling them."
msgstr "Před zapnutím tato nastavení otestujte a uložte."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Testing SMTP settings"
msgstr "Testování nastavení SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Testing and saving…"
msgstr "Testování a ukládání…"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP hostname could not be resolved. Check it and try again."
msgstr "Název serveru SMTP se nepodařilo přeložit na adresu. Zkontrolujte ho a zkuste to znovu."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP operation could not be completed. Check the settings and try again."
msgstr "Operaci SMTP se nepodařilo dokončit. Zkontrolujte nastavení a zkuste to znovu."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server accepted the test and your sending identity is now active. Acceptance does not confirm inbox delivery."
msgstr "Server SMTP přijal testovací zprávu a vaše identita odesílatele je nyní aktivní. Přijetí nepotvrzuje doručení do schránky."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server did not respond in time. Try again shortly."
msgstr "Server SMTP neodpověděl včas. Zkuste to za chvíli znovu."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server refused the credentials. Check the username and password, or use an app password."
msgstr "Server SMTP odmítl přihlašovací údaje. Zkontrolujte uživatelské jméno a heslo nebo použijte heslo aplikace."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server timed out. It may have accepted the message; check before trying again."
msgstr "Vypršel časový limit serveru SMTP. Zprávu mohl přijmout. Před dalším pokusem to ověřte."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The required TLS connection failed. Check the SMTP hostname and connection security."
msgstr "Požadované připojení TLS se nezdařilo. Zkontrolujte název serveru SMTP a zabezpečení připojení."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "The saved SMTP identity and credentials were deleted."
msgstr "Uložená identita SMTP a přihlašovací údaje byly smazány."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The saved credentials could not be read. Enter them again and test the connection."
msgstr "Uložené přihlašovací údaje se nepodařilo přečíst. Zadejte je znovu a otestujte připojení."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "The server is being tested. Existing email settings stay unchanged if the test fails."
msgstr "Probíhá testování serveru. Pokud test selže, současné nastavení e-mailu zůstane beze změny."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many SMTP tests or connections. Wait a few minutes and try again."
msgstr "Příliš mnoho testů nebo připojení SMTP. Počkejte několik minut a zkuste to znovu."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Use a public SMTP server with authenticated TLS. Your provider must authorize the From address and manage SPF, DKIM, and DMARC for its domain."
msgstr "Použijte veřejný server SMTP s ověřováním a šifrováním TLS. Váš poskytovatel musí povolit adresu odesílatele a spravovat SPF, DKIM a DMARC pro její doménu."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Use custom sending email"
msgstr "Používat vlastní e-mailovou adresu pro odesílání"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Verify your account email before testing or enabling custom SMTP."
msgstr "Před testováním nebo zapnutím vlastního SMTP ověřte e-mailovou adresu svého účtu."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Your SMTP identity sends booking confirmations, reminders, cancellations, rescheduling, approvals, and guest/group notices. Account and security emails use the platform sender."
msgstr "Vaše identita SMTP odesílá potvrzení rezervací, připomínky, oznámení o zrušení, přesunutí a schválení i oznámení pro hosty a skupiny. E-maily týkající se účtu a zabezpečení používají odesílatele platformy."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Your current sending identity has not changed. Review the error and test again."
msgstr "Vaše současná identita odesílatele se nezměnila. Zkontrolujte chybu a test zopakujte."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Your email settings changed. Review the current settings and try again."
msgstr "Nastavení e-mailu se změnilo. Zkontrolujte současné nastavení a zkuste to znovu."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP remains selected. Failed scheduling emails are retried without switching to the platform sender."
msgstr "Vlastní SMTP zůstává vybráno. Neúspěšné e-maily týkající se plánování se zkoušejí odeslat znovu bez přepnutí na odesílatele platformy."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Poll emails, dashboard calendar invitations, updates and cancellations, and booking refund notices also use your SMTP identity. Integration health, dispute and payout notices use the platform sender."
msgstr "Vaši SMTP identitu používají také e-maily k hlasování, pozvánky, aktualizace a zrušení událostí z kalendáře na nástěnce a oznámení o vrácení plateb za rezervace. Oznámení o stavu integrací, sporech a výplatách používají odesílatele platformy."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Scheduling emails currently use the platform sender."
msgstr "E-maily týkající se plánování nyní používají odesílatele platformy."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "Scheduling emails now use the platform sender."
msgstr "E-maily týkající se plánování nově používají odesílatele platformy."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Scheduling emails use this SMTP identity."
msgstr "E-maily týkající se plánování používají tuto SMTP identitu."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "This removes the saved credentials. Scheduling emails will use the platform sender."
msgstr "Tímto odstraníte uložené přihlašovací údaje. E-maily týkající se plánování budou používat odesílatele platformy."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "SMTP connection healthy. Settings saved and active."
msgstr "Připojení SMTP je v pořádku. Nastavení je uloženo a aktivní."
