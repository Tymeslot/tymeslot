#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Attendee email is required"
msgstr "E-mailová adresa účastníka je povinná"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Attendee name is required"
msgstr "Jméno účastníka je povinné"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Booking requires at least %{hours} hours in advance"
msgstr "Rezervaci je nutné vytvořit s předstihem alespoň %{hours} hodin"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Booking time must be in the future"
msgstr "Čas rezervace musí být v budoucnosti"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel a completed meeting"
msgstr "Dokončenou schůzku nelze zrušit"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel a meeting that has already occurred"
msgstr "Schůzku, která už proběhla, nelze zrušit"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel a meeting that has already started"
msgstr "Schůzku, která už začala, nelze zrušit"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel an expired meeting"
msgstr "Schůzku s vypršenou platností nelze zrušit"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot request a reschedule while the booking awaits approval"
msgstr "Dokud rezervace čeká na schválení, nelze požádat o přesunutí"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a cancelled meeting"
msgstr "Zrušenou schůzku nelze přesunout"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a completed meeting"
msgstr "Dokončenou schůzku nelze přesunout"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a meeting that has already occurred"
msgstr "Schůzku, která už proběhla, nelze přesunout"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a meeting that has already started"
msgstr "Schůzku, která už začala, nelze přesunout"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule an expired meeting"
msgstr "Schůzku s vypršenou platností nelze přesunout"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "End time must be after start time"
msgstr "Čas ukončení musí být pozdější než čas začátku"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to create appointment. Please try again."
msgstr "Schůzku se nepodařilo vytvořit. Zkuste to prosím znovu."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to create meeting"
msgstr "Schůzku se nepodařilo vytvořit"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to process booking. Please try again."
msgstr "Rezervaci se nepodařilo zpracovat. Zkuste to prosím znovu."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to save meeting to database"
msgstr "Schůzku se nepodařilo uložit do databáze."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Host could not be found. Please refresh and try again."
msgstr "Hostitele se nepodařilo najít. Obnovte prosím stránku a zkuste to znovu."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Invalid date/time"
msgstr "Neplatné datum nebo čas"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Invalid meeting duration selected"
msgstr "Vybrána neplatná délka schůzky"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Organiser is required for booking"
msgstr "Bez organizátora nelze rezervaci vytvořit."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Payments are not available for this booking. Please contact the host."
msgstr "Pro tuto rezervaci nejsou platby k dispozici. Obraťte se prosím na hostitele."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please fill in all required fields before submitting."
msgstr "Před odesláním prosím vyplňte všechna povinná pole."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a date"
msgstr "Vyberte prosím datum"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a date and time"
msgstr "Vyberte prosím datum a čas"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a meeting duration"
msgstr "Vyberte prosím délku schůzky"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a time"
msgstr "Vyberte prosím čas"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "The guest email must differ from your own address"
msgstr "E-mailová adresa hosta se musí lišit od vaší vlastní"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "The host is no longer accepting bookings for this period. Please pick a different day."
msgstr "Hostitel už na toto období rezervace nepřijímá. Vyberte prosím jiný den."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This booking has already been cancelled or moved."
msgstr "Tato rezervace už byla zrušena nebo přesunuta."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This is a group booking, so each participant moves their own spot from their confirmation email."
msgstr "Toto je skupinová rezervace: každý účastník si přesouvá vlastní místo z potvrzovacího e-mailu."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This is your current time. Pick a different time to move your spot."
msgstr "Toto je váš současný termín. Pro přesunutí místa vyberte jiný čas."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting could not be found. Please refresh and try again."
msgstr "Tuto schůzku se nepodařilo najít. Obnovte prosím stránku a zkuste to znovu."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type is no longer available. Please go back and select another."
msgstr "Tento typ schůzky už není k dispozici. Vraťte se prosím zpět a vyberte jiný."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type is no longer available. Please refresh the page."
msgstr "Tento typ schůzky už není k dispozici. Obnovte prosím stránku."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This spot can no longer be moved. Cancel it and book a new time instead, or contact the host."
msgstr "Toto místo už nelze přesunout. Zrušte ho a zarezervujte si nový čas, nebo kontaktujte hostitele."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This time slot is no longer available. Please select a different time."
msgstr "Tento termín už není k dispozici. Vyberte prosím jiný čas."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Title is required"
msgstr "Název je povinný"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "We couldn't check the host's calendar right now. Please try again in a few minutes."
msgstr "Kalendář hostitele se nám teď nepodařilo ověřit. Zkuste to prosím znovu za pár minut."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "We couldn't start the payment process. Please try again."
msgstr "Platbu se nepodařilo zahájit. Zkuste to prosím znovu."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "You already have a spot at this time. Check your email for your booking confirmation."
msgstr "V tomto čase už máte místo. Zkontrolujte e-mail s potvrzením rezervace."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "You cannot book more than %{days} days in advance"
msgstr "Rezervaci nelze vytvořit s předstihem více než %{days} dnů"
