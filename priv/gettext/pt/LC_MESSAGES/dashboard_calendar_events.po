#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Failed to delete event"
msgstr "Não foi possível excluir o evento"

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Meeting created and invitation sent"
msgstr "Reunião criada e convite enviado"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The recurrence end date must be on or after the event start."
msgstr "A data de término da recorrência precisa ser igual ou posterior à data de início do evento."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many edits. Please wait a moment."
msgstr "Muitas edições. Aguarde um momento."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many moves. Please wait a moment."
msgstr "Muitos movimentos. Aguarde um momento."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "You don't have permission to modify this event"
msgstr "Você não tem permissão para alterar este evento"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Delete failed - queued to retry on next sync"
msgstr "A exclusão falhou; nova tentativa na próxima sincronização"

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Failed to update event - changes reverted"
msgstr "Não foi possível atualizar o evento; as alterações foram desfeitas"

#: lib/tymeslot/calendar_grid/event_creation.ex
#, elixir-autogen, elixir-format
msgid "Google Calendar saved the event but didn't return a Meet link — please try again or add it manually."
msgstr "O Google Calendar salvou o evento, mas não devolveu um link do Meet. Tente de novo ou adicione o link manualmente."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Guest name is required"
msgstr "O nome do convidado é obrigatório"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Meeting with %{name}"
msgstr "Reunião com %{name}"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This calendar is read-only. Events on it can't be changed from Tymeslot."
msgstr "Este calendário é somente leitura. Os eventos dele não podem ser alterados pelo Tymeslot."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Could not change the video link - changes reverted"
msgstr "Não foi possível trocar o link de vídeo; as alterações foram desfeitas"

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Could not move the event. It is still on its original calendar."
msgstr "Não foi possível mover o evento. Ele continua no calendário original."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar, but the original could not be removed. Please delete it from its original calendar."
msgstr "Evento copiado para o novo calendário, mas não foi possível remover o original. Exclua-o do calendário original."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar. The original will be removed on the next sync."
msgstr "Evento copiado para o novo calendário. O original vai ser removido na próxima sincronização."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event moved to the new calendar."
msgstr "Evento movido para o novo calendário."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "The video provider did not return a meeting link, so the video link was not changed."
msgstr "O provedor de vídeo não devolveu um link de reunião, então o link de vídeo não foi alterado."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Video link removed."
msgstr "Link de vídeo removido."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Video room created."
msgstr "Sala de vídeo criada."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Your calendar could not be reached. The change is saved and will sync on the next attempt."
msgstr "Não foi possível acessar seu calendário. A mudança está salva e vai ser sincronizada na próxima tentativa."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar, but the move did not finish. Please check its original calendar and delete the original if it is still there."
msgstr "Evento copiado para o novo calendário, mas a transferência não terminou. Confira o calendário original e exclua o evento original se ele ainda estiver lá."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event is a booking, so its video link belongs to the booking. Reschedule or cancel the booking to change it."
msgstr "Este evento é um agendamento, então o link de vídeo pertence ao agendamento. Remarque ou cancele o agendamento para mudá-lo."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Google Calendar added Google Meet to the event but has not returned its link yet. Choose Google Meet again to fetch it."
msgstr "O Google Calendar adicionou o Google Meet ao evento, mas ainda não devolveu o link. Escolha o Google Meet de novo para buscá-lo."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Recurring Exchange events cannot be deleted here yet. Please delete this one in your calendar app."
msgstr "Ainda não é possível excluir aqui eventos recorrentes do Exchange. Exclua este no seu app de calendário."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event could not be deleted here. Please delete it in your calendar app."
msgstr "Não foi possível excluir este evento aqui. Exclua-o no seu app de calendário."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Events of a repeating series cannot be switched between all-day and timed here. Please make this change in your calendar app."
msgstr "Aqui não é possível trocar os eventos de uma série entre dia todo e com horário. Faça essa mudança no seu app de calendário."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "That change cannot be made to the events you chose. A repeat rule can only be changed for all events, or this and following events, and cannot be removed here."
msgstr "Não é possível fazer essa mudança nos eventos que você escolheu. A regra de repetição só pode ser mudada para todos os eventos, ou para este e os seguintes, e não pode ser removida aqui."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was updated, but a change you made while it was saving was not applied. Please make it again."
msgid_plural "The series was updated, but %{count} changes you made while it was saving were not applied. Please make them again."
msgstr[0] "A série foi atualizada, mas uma alteração que você fez enquanto ela era salva não foi aplicada. Refaça essa alteração."
msgstr[1] "A série foi atualizada, mas %{count} alterações que você fez enquanto ela era salva não foram aplicadas. Refaça essas alterações."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This event could not be matched to its series. Refresh your calendars and try again."
msgstr "Não foi possível associar este evento à série dele. Atualize seus calendários e tente novamente."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series repeats on fixed days, such as the second Monday of the month, so it cannot be moved like this. Please make this change in your calendar app."
msgstr "Esta série se repete em dias fixos, como a segunda segunda-feira do mês, então não pode ser movida assim. Faça essa mudança no seu app de calendário."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series' repeat rule cannot be split here. Please make this change in your calendar app."
msgstr "Aqui não é possível dividir a regra de repetição desta série. Faça essa mudança no seu app de calendário."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "A Teams meeting on the series is not carried over."
msgstr "Uma reunião do Teams na série não é transferida."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "A recurring event can only be moved to a calendar of the same kind of account: Google to Google, Outlook to Outlook, or CalDAV to CalDAV."
msgstr "Um evento recorrente só pode ser movido para um calendário do mesmo tipo de conta: Google para Google, Outlook para Outlook ou CalDAV para CalDAV."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Could not move the series. It is still on its original calendar."
msgstr "Não foi possível mover a série. Ela continua no calendário original."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Events in the series that were changed on their own go back to the series' usual pattern."
msgstr "Os eventos da série que foram alterados individualmente voltam ao padrão habitual da série."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Events in the series that were changed or cancelled on their own go back to the series' usual pattern."
msgstr "Os eventos da série que foram alterados ou cancelados individualmente voltam ao padrão habitual da série."

#: lib/tymeslot_web/components/calendar/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Guests are sent a cancellation for the original series and an invitation to the moved one."
msgstr "Os convidados recebem um cancelamento da série original e um convite para a série movida."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Recurring events on this calendar cannot be moved to another calendar. Only single events can be moved."
msgstr "Os eventos recorrentes deste calendário não podem ser movidos para outro calendário. Só eventos avulsos podem ser movidos."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "That calendar cannot be written to. Please choose another calendar."
msgstr "Não é possível gravar nesse calendário. Escolha outro calendário."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series is already on that calendar."
msgstr "A série já está nesse calendário."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was copied to %{calendar}, but the original series could not be removed. Please delete it from its original calendar."
msgstr "A série foi copiada para %{calendar}, mas não foi possível remover a série original. Exclua-a do calendário original."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was moved to %{calendar}."
msgstr "A série foi movida para %{calendar}."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was moved, but a change you made while it was moving was not applied. Please make it again."
msgid_plural "The series was moved, but %{count} changes you made while it was moving were not applied. Please make them again."
msgstr[0] "A série foi movida, mas uma alteração que você fez enquanto ela era movida não foi aplicada. Refaça essa alteração."
msgstr[1] "A série foi movida, mas %{count} alterações que você fez enquanto ela era movida não foram aplicadas. Refaça essas alterações."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "A change to this series is still saving. Please make this change once it has saved."
msgstr "Uma alteração nesta série ainda está sendo salva. Faça esta alteração depois que ela for salva."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Delete failed - queued to retry on next sync. Attendees have not been notified."
msgstr "A exclusão falhou; nova tentativa na próxima sincronização. Os participantes não foram avisados."

#: lib/tymeslot_web/live/dashboard/calendar/panel_group_event.ex
#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Too many new meetings. Please wait a moment."
msgstr "Muitas reuniões novas. Aguarde um momento."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Someone else organises this meeting, so Tymeslot can't move or split a series you were only invited to."
msgstr "Outra pessoa organiza esta reunião, então o Tymeslot não pode mover nem dividir a série: você só recebeu o convite."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This is a group booking. Move it, cancel it or change who attends from the meeting instead."
msgstr "Este é um agendamento em grupo. Para movê-lo, cancelá-lo ou mudar quem participa, use a própria reunião."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "You already have a meeting at this time. Please choose a different time."
msgstr "Você já tem uma reunião marcada nesse horário. Escolha outro."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "This repeat pattern can't be saved to Outlook."
msgstr "Este padrão de repetição não pode ser salvo no Outlook."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Outlook can't skip the months that don't have this series' day, and would move those events to the month's last day. Please start the series on the 28th or earlier, or save it to another calendar."
msgstr ""
"O Outlook não consegue pular os meses que não têm o dia desta série e moveria esses eventos para o último dia do mês. Inicie a série no dia 28 ou antes, ou salve-a em outro calendário."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series changed while you were editing it, and nothing is left of it from this event on. Nothing was saved."
msgstr "Esta série mudou enquanto você a editava e, a partir deste evento, não resta mais nada dela. Nada foi salvo."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This series changed while you were editing it, so the events left in it can no longer be counted. Nothing was saved. Refresh the calendar and try again."
msgstr "Esta série mudou enquanto você a editava, então não é mais possível contar os eventos restantes. Nada foi salvo. Atualize o calendário e tente novamente."

#: lib/tymeslot_web/live/dashboard/calendar/panel_guests.ex
#, elixir-autogen, elixir-format
msgid "Attendee added, but their invitation could not be sent."
msgstr "Participante adicionado, mas não foi possível enviar o convite."

#: lib/tymeslot_web/live/dashboard/calendar/panel_guests.ex
#, elixir-autogen, elixir-format
msgid "Attendee removed, but they could not be notified."
msgstr "Participante removido, mas não foi possível avisá-lo."

