#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "1 event could not be imported."
msgid_plural "%{count} events could not be imported."
msgstr[0] "1 evento não pôde ser importado."
msgstr[1] "%{count} eventos não puderam ser importados."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "1 event repeats in a way Outlook can't store, so it was not imported."
msgid_plural "%{count} events repeat in a way Outlook can't store, so they were not imported."
msgstr[0] "1 evento se repete de uma forma que o Outlook não consegue salvar, então não foi importado."
msgstr[1] "%{count} eventos se repetem de uma forma que o Outlook não consegue salvar, então não foram importados."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats on a day some months don't have, which Outlook would move to the month's last day."
msgid_plural "%{count} of them repeat on a day some months don't have, which Outlook would move to the month's last day."
msgstr[0] ""
"1 deles se repete em um dia que alguns meses não têm, e o Outlook o moveria para o último dia do mês."
msgstr[1] ""
"%{count} deles se repetem em um dia que alguns meses não têm, e o Outlook os moveria para o último dia do mês."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats."
msgid_plural "%{count} of them repeat."
msgstr[0] "1 deles se repete."
msgstr[1] "%{count} deles se repetem."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "An import is still running. Please wait for it to finish before importing another file."
msgstr "Uma importação ainda está em andamento. Aguarde a conclusão antes de importar outro arquivo."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel"
msgstr "Cancelar"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Choose or drop an .ics file"
msgstr "Escolha ou arraste um arquivo .ics"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Close"
msgstr "Fechar"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Connect a calendar Tymeslot can write to before importing events."
msgstr "Conecte um calendário em que o Tymeslot possa gravar antes de importar eventos."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Copy the events of an .ics file into one of your calendars."
msgstr "Copie os eventos de um arquivo .ics para um dos seus calendários."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Exported from Google Calendar, Outlook, Apple Calendar or any other calendar app."
msgstr "Exportado do Google Calendar, do Outlook, do Calendário da Apple ou de qualquer outro app de calendário."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Found 1 event."
msgid_plural "Found %{count} events."
msgstr[0] "1 evento encontrado."
msgstr[1] "%{count} eventos encontrados."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Guests are not imported, and nobody is sent an invitation."
msgstr "Os convidados não são importados, e ninguém recebe convite."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Import"
msgstr "Importar"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Import events"
msgstr "Importar eventos"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Import into"
msgstr "Importar para"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Imported 1 event."
msgid_plural "Imported %{count} events."
msgstr[0] "1 evento importado."
msgstr[1] "%{count} eventos importados."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Importing %{done} of %{total} events..."
msgstr "Importando %{done} de %{total} eventos…"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Invalid calendar selected"
msgstr "O calendário selecionado é inválido"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Only .ics calendar files can be imported."
msgstr "Só é possível importar arquivos de calendário .ics."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Outlook could not take the skipped dates of 1 recurring event, so it may show extra occurrences."
msgid_plural "Outlook could not take the skipped dates of %{count} recurring events, so they may show extra occurrences."
msgstr[0] "O Outlook não aceitou as datas puladas de 1 evento recorrente, então ele pode mostrar ocorrências a mais."
msgstr[1] "O Outlook não aceitou as datas puladas de %{count} eventos recorrentes, então eles podem mostrar ocorrências a mais."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Reading the file..."
msgstr "Lendo o arquivo…"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The file could not be uploaded. Please try again."
msgstr "Não foi possível enviar o arquivo. Tente novamente."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The file is too large. Files up to %{size} MB can be imported."
msgstr "O arquivo é grande demais. É possível importar arquivos de até %{size} MB."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import could not be finished. Some of its events may already be in your calendar."
msgstr "Não foi possível concluir a importação. Alguns dos eventos podem já estar no seu calendário."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because the calendar could not be written to."
msgstr "A importação parou porque não foi possível gravar no calendário."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar is not responding. Please try again later."
msgstr "A importação parou porque seu calendário não está respondendo. Tente novamente mais tarde."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar needs to be reconnected."
msgstr "A importação parou porque seu calendário precisa ser reconectado."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "This file contains more than %{count} events. Please split it into smaller files."
msgstr "Este arquivo tem mais de %{count} eventos. Divida-o em arquivos menores."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "This file contains no events to import."
msgstr "Este arquivo não tem eventos para importar."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "This file could not be read as a calendar. Please choose an .ics file."
msgstr "Não foi possível ler este arquivo como um calendário. Escolha um arquivo .ics."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Too many imports. Please wait a while before importing another file."
msgstr "Importações demais. Aguarde um pouco antes de importar outro arquivo."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "You can close this window; the import carries on."
msgstr "Você pode fechar esta janela; a importação continua."
