#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking confirmed"
msgstr "Agendamento confirmado"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking not accepted"
msgstr "Agendamento não aceito"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking request expired"
msgstr "Pedido de agendamento expirado"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Confirming your payment…"
msgstr "Confirmando seu pagamento…"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "If there's no answer by %{by_deadline}, the request lapses and you're refunded automatically."
msgstr "Se não houver resposta até %{by_deadline}, o pedido expira e o reembolso é feito automaticamente."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "If there's no answer by %{by_deadline}, the request lapses."
msgstr "Se não houver resposta até %{by_deadline}, o pedido expira."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Nobody responded to this request in time, so it has lapsed."
msgstr "Ninguém respondeu a este pedido a tempo, então ele expirou."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Nobody responded to this request in time, so it has lapsed. Your payment is being refunded."
msgstr "Ninguém respondeu a este pedido a tempo, então ele expirou. Seu pagamento está sendo reembolsado."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment cancelled"
msgstr "Pagamento cancelado"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment not completed"
msgstr "Pagamento não concluído"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment received"
msgstr "Pagamento recebido"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Please wait while we confirm your booking."
msgstr "Espere um instante enquanto confirmamos seu agendamento."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Return to booking"
msgstr "Voltar ao agendamento"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thank you, your booking is confirmed for %{for_date}."
msgstr "Obrigado, seu agendamento está confirmado para %{for_date}."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thanks, your payment went through. Your booking is not confirmed yet though:"
msgstr "Obrigado, seu pagamento foi aprovado. Mas seu agendamento ainda não está confirmado:"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking has been cancelled, so it won't be going ahead."
msgstr "Este agendamento foi cancelado, então ele não vai acontecer."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking wasn't accepted, so it won't be going ahead."
msgstr "Este agendamento não foi aceito, então ele não vai acontecer."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking wasn't accepted, so it won't be going ahead. Your payment is being refunded."
msgstr "Este agendamento não foi aceito, então ele não vai acontecer. Seu pagamento está sendo reembolsado."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. You can return and try again at any time."
msgstr "Seu agendamento não está confirmado. Você pode voltar e tentar de novo quando quiser."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Paid: %{amount}"
msgstr "Pago: %{amount}"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. Your invitation stays reserved for it until the unfinished checkout expires, and a link to book again will appear here as soon as it does."
msgstr "Seu agendamento não está confirmado. Seu convite fica reservado para ele até o pagamento não concluído expirar; assim que isso acontecer, um link para agendar de novo vai aparecer aqui."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. To try again, open the invitation link you were sent."
msgstr "A sua reserva não está confirmada. Para tentar novamente, abra o link de convite que recebeu."

#: lib/tymeslot/meeting_payments/checkout_sessions.ex
#, elixir-autogen, elixir-format
msgid "%{name}, %{count} session"
msgid_plural "%{name}, %{count} sessions"
msgstr[0] "%{name}, %{count} sessão"
msgstr[1] "%{name}, %{count} sessões"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thank you, your %{count} session is confirmed, the first on %{on_date}."
msgid_plural "Thank you, your %{count} sessions are confirmed, the first on %{on_date}."
msgstr[0] "Obrigado, sua %{count} sessão está confirmada, a primeira em %{on_date}."
msgstr[1] "Obrigado, suas %{count} sessões estão confirmadas, a primeira em %{on_date}."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "The payment wasn't completed in time, so the seat held for you was released. You can return and book again."
msgid_plural "The payment wasn't completed in time, so the seats held for you were released. You can return and book again."
msgstr[0] "O pagamento não foi concluído a tempo, então a vaga reservada para você foi liberada. Você pode voltar e agendar de novo."
msgstr[1] "O pagamento não foi concluído a tempo, então as vagas reservadas para você foram liberadas. Você pode voltar e agendar de novo."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your payment arrived after the seat held for you was released, and the session had no room left. Your payment is being refunded."
msgid_plural "Your payment arrived after the seats held for you were released, and the session had no room left. Your payment is being refunded."
msgstr[0] "Seu pagamento chegou depois que a vaga reservada para você foi liberada, e não restavam mais vagas na sessão. Seu pagamento está sendo reembolsado."
msgstr[1] "Seu pagamento chegou depois que as vagas reservadas para você foram liberadas, e não restavam mais vagas na sessão. Seu pagamento está sendo reembolsado."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your seat was released"
msgid_plural "Your seats were released"
msgstr[0] "Sua vaga foi liberada"
msgstr[1] "Suas vagas foram liberadas"
