#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Bookers book several sessions in one go, with one confirmation."
msgstr "Quem agenda marca várias sessões de uma vez, com uma única confirmação."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Bookers can also book a single session"
msgstr "Quem agenda também pode agendar uma única sessão"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Bookers pay %{price} × the number of sessions upfront."
msgstr "Quem agenda paga %{price} × o número de sessões antecipadamente."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Bookers pick each session from your available times."
msgstr "Quem agenda escolhe cada sessão entre os seus horários disponíveis."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Each session in a series takes one seat."
msgstr "Cada sessão de uma série ocupa uma vaga."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Every day"
msgid_plural "Every %{count} days"
msgstr[0] "Todos os dias"
msgstr[1] "A cada %{count} dias"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Every month"
msgid_plural "Every %{count} months"
msgstr[0] "Todo mês"
msgstr[1] "A cada %{count} meses"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Every series has %{count} session."
msgid_plural "Every series has %{count} sessions."
msgstr[0] "Cada série tem %{count} sessão."
msgstr[1] "Cada série tem %{count} sessões."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Every series has the same number of sessions, like a course."
msgstr "Todas as séries têm o mesmo número de sessões, como um curso."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Every session at the same time, for example every Thursday at 17:00."
msgstr "Todas as sessões no mesmo horário, por exemplo toda quinta-feira às 17:00."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Every week"
msgid_plural "Every %{count} weeks"
msgstr[0] "Toda semana"
msgstr[1] "A cada %{count} semanas"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Fixed number"
msgstr "Número fixo"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "From"
msgstr "De"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "From %{min} to %{max} sessions, as the booker chooses."
msgstr "De %{min} a %{max} sessões, conforme quem agenda escolher."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "How often"
msgstr "Com que frequência"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "How the sessions are timed"
msgstr "Como as sessões são programadas"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Let people book a series"
msgstr "Permitir agendar uma série"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Number of sessions"
msgstr "Número de sessões"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "On the same weekday of the month, for example the second Thursday."
msgstr "No mesmo dia da semana do mês, por exemplo na segunda quinta-feira."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Repeats"
msgstr "Repete"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Same time, repeating"
msgstr "Mesmo horário, repetido"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Series"
msgstr "Série"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Series booking is paused: this meeting type books single sessions until you upgrade."
msgstr "O agendamento de séries está pausado: este tipo de reunião só agenda sessões avulsas até você fazer upgrade."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Sessions at different times"
msgstr "Sessões em horários diferentes"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "To"
msgstr "Até"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/scheduling_rules_section.ex
#, elixir-autogen, elixir-format
msgid "With series booking on, this applies to the first session only."
msgstr "Com o agendamento de séries ativado, isso vale só para a primeira sessão."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_section.ex
#, elixir-autogen, elixir-format
msgid "Your booking window (%{days} days) applies to the first session only. Later sessions can be booked up to 12 months ahead."
msgstr "Seu limite de antecedência (%{days} dias) vale só para a primeira sessão. As sessões seguintes podem ser agendadas com até 12 meses de antecedência."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_handlers.ex
#, elixir-autogen, elixir-format
msgid "Your limit of %{limit} bookings per month is lower than the %{needed} sessions a series can book in one month, so some series won't fit."
msgstr "Seu limite de %{limit} agendamentos por mês é menor que as %{needed} sessões que uma série pode agendar em um mês, então algumas séries não vão caber."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/series_handlers.ex
#, elixir-autogen, elixir-format
msgid "Your limit of %{limit} bookings per week is lower than the %{needed} sessions a series can book in one week, so some series won't fit."
msgstr "Seu limite de %{limit} agendamentos por semana é menor que as %{needed} sessões que uma série pode agendar em uma semana, então algumas séries não vão caber."

