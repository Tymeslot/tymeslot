msgstr "Não é possível pedir o reagendamento enquanto a marcação aguarda aprovação"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a cancelled meeting"
msgstr "Não é possível reagendar uma reunião cancelada"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a completed meeting"
msgstr "Não é possível reagendar uma reunião concluída"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a meeting that has already occurred"
msgstr "Não é possível reagendar uma reunião que já aconteceu"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a meeting that has already started"
msgstr "Não é possível reagendar uma reunião que já começou"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule an expired meeting"
msgstr "Não é possível reagendar uma reunião expirada"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "End time must be after start time"
msgstr "O horário de término tem de ser depois do de início"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to create appointment. Please try again."
msgstr "Não foi possível criar a reunião. Tente novamente."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to create meeting"
msgstr "Não foi possível criar a reunião"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to process booking. Please try again."
msgstr "Não foi possível processar a marcação. Tente novamente."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to save meeting to database"
msgstr "Não foi possível guardar a reunião na base de dados"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Host could not be found. Please refresh and try again."
msgstr "Não foi possível encontrar o anfitrião. Atualize a página e tente novamente."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Invalid date/time"
msgstr "Data/hora inválida"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Invalid meeting duration selected"
msgstr "A duração de reunião escolhida é inválida"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Organiser is required for booking"
msgstr "É preciso um organizador para marcar"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Payments are not available for this booking. Please contact the host."
msgstr "Os pagamentos não estão disponíveis nesta marcação. Contacte o anfitrião."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please fill in all required fields before submitting."
msgstr "Preencha todos os campos obrigatórios antes de enviar."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a date"
msgstr "Escolha uma data"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a date and time"
msgstr "Escolha uma data e um horário"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a meeting duration"
msgstr "Escolha a duração da reunião"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a time"
msgstr "Escolha um horário"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "The guest email must differ from your own address"
msgstr "O email do convidado tem de ser diferente do seu"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "The host is no longer accepting bookings for this period. Please pick a different day."
msgstr "O anfitrião já não está a aceitar marcações neste período. Escolha outro dia."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This booking has already been cancelled or moved."
msgstr "Esta marcação já foi cancelada ou reagendado."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This is a group booking, so each participant moves their own spot from their confirmation email."
msgstr "Este é uma marcação em grupo, por isso cada participante reagenda a própria vaga pelo seu email de confirmação."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This is your current time. Pick a different time to move your spot."
msgstr "Este é o seu horário atual. Escolha outro horário para reagendar a sua vaga."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting could not be found. Please refresh and try again."
msgstr "Não foi possível encontrar esta reunião. Atualize a página e tente novamente."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type is no longer available. Please go back and select another."
msgstr "Este tipo de reunião já não está disponível. Volte e escolha outro."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type is no longer available. Please refresh the page."
msgstr "Este tipo de reunião já não está disponível. Atualize a página."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This spot can no longer be moved. Cancel it and book a new time instead, or contact the host."
msgstr "Esta vaga já não pode ser reagendada. Cancele-a e marque um novo horário, ou contacte o anfitrião."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This time slot is no longer available. Please select a different time."
msgstr "Este horário já não está disponível. Escolha outro."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Title is required"
msgstr "O título é obrigatório"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "We couldn't check the host's calendar right now. Please try again in a few minutes."
msgstr "Não foi possível verificar o calendário do anfitrião agora. Tente novamente em alguns minutos."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "We couldn't start the payment process. Please try again."
msgstr "Não foi possível iniciar o pagamento. Tente novamente."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "You already have a spot at this time. Check your email for your booking confirmation."
msgstr "Já tem uma vaga neste horário. Consulte o seu email para ver a confirmação da marcação."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "You cannot book more than %{days} days in advance"
msgstr "Não pode marcar com mais de %{days} dias de antecedência"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "The reminders for this meeting are not valid"
msgstr "Os lembretes desta reunião não são válidos"
