msgstr[0] "Seu pedido de %{count} sessão expirou"
msgstr[1] "Seu pedido de %{count} sessões expirou"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Your request for %{count} session was declined"
msgid_plural "Your request for %{count} sessions was declined"
msgstr[0] "Seu pedido de %{count} sessão foi recusado"
msgstr[1] "Seu pedido de %{count} sessões foi recusado"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Your request for %{count} session was sent"
msgid_plural "Your request for %{count} sessions was sent"
msgstr[0] "Seu pedido de %{count} sessão foi enviado"
msgstr[1] "Seu pedido de %{count} sessões foi enviado"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Reminder: %{attendee} requests %{count} session"
msgid_plural "Reminder: %{attendee} requests %{count} sessions"
msgstr[0] "Lembrete: %{attendee} solicita %{count} sessão"
msgstr[1] "Lembrete: %{attendee} solicita %{count} sessões"

