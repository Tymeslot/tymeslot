#, elixir-autogen, elixir-format
msgid "%{name}, your request to %{organizer_name} has been sent."
msgstr "%{name}, o seu pedido para %{organizer_name} foi enviado."

#: lib/tymeslot_web/themes/shared/components/approval_notice.ex
#, elixir-autogen, elixir-format
msgid "%{organizer} confirms each booking personally, so submitting this sends a request rather than booking the time outright. You'll pay now to hold the slot; if %{organizer} declines or doesn't answer in time, you're refunded in full."
msgstr "%{organizer} confirma cada agendamento pessoalmente, então enviar isto manda um pedido, em vez de agendar o horário direto. Você paga agora para reservar o horário; se %{organizer} recusar ou não responder a tempo, você é reembolsado por inteiro."

#: lib/tymeslot_web/themes/quill/scheduling/components/confirmation_component.ex
#: lib/tymeslot_web/themes/rhythm/scheduling/components/confirmation_component.ex
#, elixir-autogen, elixir-format
msgid "Add tentative hold to calendar"
msgstr "Adicionar reserva provisória ao calendário"

#: lib/tymeslot_web/themes/quill/scheduling/components/confirmation_component.ex
#: lib/tymeslot_web/themes/rhythm/scheduling/components/confirmation_component.ex
#, elixir-autogen, elixir-format
msgid "Changed your mind? Your request email has a link to withdraw it."
msgstr "Mudou de ideia? O e-mail do seu pedido tem um link para retirá-lo."

#: lib/tymeslot_web/themes/shared/booking_labels.ex
#, elixir-autogen, elixir-format
msgid "Request new time"
msgstr "Pedir outro horário"

#: lib/tymeslot_web/themes/shared/booking_text.ex
#, elixir-autogen, elixir-format
msgid "Hi there!"
msgstr "Olá!"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule an expired meeting"
msgstr "Não dá para remarcar uma reunião expirada"

#: lib/tymeslot_web/live/meeting_request_live.ex
#, elixir-autogen, elixir-format
msgid "That time has since been booked by somebody else, so this request can no longer be approved."
msgstr "Esse horário já foi agendado por outra pessoa desde então, então este pedido não pode mais ser aprovado."

#: lib/tymeslot_web/themes/quill/scheduling/components/schedule/panels.ex
#: lib/tymeslot_web/themes/rhythm/scheduling/components/schedule_component.ex
#, elixir-autogen, elixir-format
msgid "Search timezones"
msgstr "Buscar fusos horários"

#: lib/tymeslot_web/live/meeting_request_live.ex
#, elixir-autogen, elixir-format
msgid "This request has changed since this page was opened, so it can no longer be answered here. Open the most recent request email to answer it."
msgstr "Este pedido mudou desde que esta página foi aberta, então ele não pode mais ser respondido aqui. Abra o e-mail de pedido mais recente para responder."

#: lib/tymeslot_web/themes/shared/components/preview_notice.ex
#, elixir-autogen, elixir-format
msgid "Preview mode: bookings made here are simulated. Nothing is saved or sent."
msgstr "Modo de prévia: os agendamentos feitos aqui são simulados. Nada é salvo nem enviado."
