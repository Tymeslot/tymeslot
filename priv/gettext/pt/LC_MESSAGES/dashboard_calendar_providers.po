#, elixir-autogen, elixir-format
msgid "Subscribe to a published calendar feed"
msgstr "Assine um feed de calendário publicado"

#: lib/tymeslot/integrations/calendar/providers/provider_config.ex
#, elixir-autogen, elixir-format
msgid "Subscribe to a published calendar feed, read-only"
msgstr "Assine um feed de calendário publicado, somente leitura"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "Subscribing..."
msgstr "Assinando…"

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "That URL did not return a calendar feed. Make sure it points at an .ics file."
msgstr "Essa URL não devolveu um feed de calendário. Confirme que ela aponta para um arquivo .ics."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "That URL points at a blocked address and cannot be reached."
msgstr "Essa URL aponta para um endereço bloqueado e não pode ser alcançada."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "That calendar feed is too large to process."
msgstr "Esse feed de calendário é grande demais para processar."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed URL returned 404. Check that the link is complete and still published."
msgstr "A URL do feed de calendário devolveu 404. Confira se o link está completo e ainda publicado."

#: lib/tymeslot/workers/sync_ics_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed came back empty, but the cache still holds previously synced events. Keeping the cache in place and retrying rather than emptying your diary."
msgstr "O feed de calendário voltou vazio, mas o cache ainda tem eventos sincronizados antes. Vamos manter o cache e tentar de novo, em vez de esvaziar sua agenda."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed redirected too many times."
msgstr "O feed de calendário redirecionou vezes demais."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed rejected the link. It may have been revoked or reset."
msgstr "O feed de calendário recusou o link. Ele pode ter sido revogado ou reiniciado."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed returned HTTP %{status}."
msgstr "O feed de calendário devolveu HTTP %{status}."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "This calendar stays read-only: it blocks the times you're already busy, and bookings are never written to it. Choose another calendar as your booking destination."
msgstr "Este calendário fica somente leitura: ele bloqueia os horários em que você já tem compromisso, e os agendamentos nunca são escritos nele. Escolha outro calendário como destino dos agendamentos."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
