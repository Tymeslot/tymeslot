msgid "Could not reach the calendar feed. Check the URL and try again."
msgstr "Não foi possível alcançar o feed de calendário. Confira a URL e tente novamente."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "Enter the calendar feed URL."
msgstr "Digite a URL do feed de calendário."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
