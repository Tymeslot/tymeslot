msgstr "Retorno do Slack inválido. Tente novamente."

#: lib/tymeslot_web/controllers/slack_oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Slack callback did not match your session. Please retry."
msgstr "O retorno do Slack não bateu com a sua sessão. Tente de novo."

#: lib/tymeslot_web/controllers/slack_oauth_controller.ex
#, elixir-autogen, elixir-format
