msgid "Template variable cannot be used in URL fragment (#). Fragments are not sent to the server, so all meetings would use the same room. Use the template in the path instead: https://example.com/{{meeting_id}}"
msgstr "Zmiennej szablonu nie można użyć we fragmencie adresu URL (#). Fragmenty nie są wysyłane do serwera, więc wszystkie spotkania korzystałyby z tego samego pokoju. Użyj szablonu w ścieżce: https://example.com/{{meeting_id}}"

#: lib/tymeslot/integrations/shared/reauth_handling.ex
#, elixir-autogen, elixir-format
msgid "The provider rejected the stored credentials for this integration. Please reconnect the integration."
msgstr "Dostawca odrzucił zapisane dane logowania tej integracji. Połącz integrację ponownie."

#: lib/tymeslot/integrations/video/providers/custom_provider.ex
#, elixir-autogen, elixir-format
msgid "URL resolves to a private or loopback address"
msgstr "Adres URL wskazuje na adres prywatny lub pętli zwrotnej"

#: lib/tymeslot/integrations/video/providers/custom_provider.ex
#, elixir-autogen, elixir-format
msgid "URL responded with HTTP %{status}"
msgstr "Adres URL odpowiedział kodem HTTP %{status}"

#: lib/tymeslot/integrations/video/providers/mirotalk_provider.ex
#, elixir-autogen, elixir-format
msgid "Unexpected response (status %{status}) - Please verify your configuration"
msgstr "Nieoczekiwana odpowiedź (status %{status}) – sprawdź swoją konfigurację"

#: lib/tymeslot/integrations/video/input_validation.ex
#, elixir-autogen, elixir-format
msgid "Unknown video provider"
msgstr "Nieznany dostawca wideo"

#: lib/tymeslot/integrations/shared/oauth/account_match.ex
#, elixir-autogen, elixir-format
msgid "You authenticated with a different account than the one linked to this integration. Please use the correct account."
msgstr "Uwierzytelnienie nastąpiło na innym koncie niż powiązane z tą integracją. Użyj właściwego konta."

#: lib/tymeslot/integrations/video/providers/zoom_provider/reauth.ex
#, elixir-autogen, elixir-format
msgid "Zoom access was revoked. Please reconnect your Zoom account."
msgstr "Dostęp do Zoom został cofnięty. Podłącz ponownie swoje konto Zoom."

#: lib/tymeslot/integrations/video/providers/zoom_provider.ex
#, elixir-autogen, elixir-format
msgid "Zoom token refresh failed after 401. Please reconnect your Zoom account."
msgstr "Odświeżenie tokena Zoom nie powiodło się po błędzie 401. Podłącz ponownie swoje konto Zoom."

#: lib/tymeslot_web/helpers/integration_providers.ex
#, elixir-autogen, elixir-format
msgid "✓ Custom provider configured - %{message}"
msgstr "✓ Skonfigurowano własnego dostawcę – %{message}"

#: lib/tymeslot_web/helpers/integration_providers.ex
#, elixir-autogen, elixir-format
msgid "✓ Google Meet connection verified - %{message}"
msgstr "✓ Zweryfikowano połączenie z Google Meet – %{message}"

#: lib/tymeslot_web/helpers/integration_providers.ex
#, elixir-autogen, elixir-format
msgid "✓ Microsoft Teams connection verified - %{message}"
msgstr "✓ Zweryfikowano połączenie z Microsoft Teams – %{message}"

#: lib/tymeslot_web/helpers/integration_providers.ex
#, elixir-autogen, elixir-format
msgid "✓ MiroTalk connection verified - %{message}"
msgstr "✓ Zweryfikowano połączenie z MiroTalk – %{message}"

#: lib/tymeslot/integrations/shared/reauth_handling.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed rejected the stored link. It was probably revoked or reset — subscribe again with a fresh URL."
msgstr "Kanał kalendarza odrzucił zapisany link. Prawdopodobnie został unieważniony lub zresetowany — subskrybuj ponownie z nowym adresem URL."

#: lib/tymeslot_web/components/dashboard/integrations/shared/delete_integration_modal.ex
#, elixir-autogen, elixir-format
msgid "%{count} upcoming booking still uses this integration. Its meeting room keeps working unless you delete it here."
msgid_plural "%{count} upcoming bookings still use this integration. Their meeting rooms keep working unless you delete them here."
msgstr[0] "%{count} nadchodząca rezerwacja nadal korzysta z tej integracji. Jej pokój spotkań będzie działać, o ile go tutaj nie usuniesz."
msgstr[1] "%{count} nadchodzące rezerwacje nadal korzystają z tej integracji. Ich pokoje spotkań będą działać, o ile ich tutaj nie usuniesz."
msgstr[2] "%{count} nadchodzących rezerwacji nadal korzysta z tej integracji. Ich pokoje spotkań będą działać, o ile ich tutaj nie usuniesz."

#: lib/tymeslot_web/components/dashboard/integrations/shared/delete_integration_modal.ex
#, elixir-autogen, elixir-format
msgid "Also delete their meeting rooms. Attendees who already have the join link will find it no longer works."
msgstr "Usuń także ich pokoje spotkań. Link do dołączenia, który mają już uczestnicy, przestanie działać."

#: lib/tymeslot/integrations/video/providers/custom_provider.ex
#, elixir-autogen, elixir-format
msgid "URL redirects too many times"
msgstr "Adres URL przekierowuje zbyt wiele razy"

#: lib/tymeslot/integrations/video/providers/zoom_provider/scopes.ex
#, elixir-autogen, elixir-format
msgid "Zoom is missing the permission needed to cancel meetings. Please reconnect your Zoom account."
msgstr "Zoom nie ma uprawnienia potrzebnego do odwoływania spotkań. Podłącz ponownie swoje konto Zoom."

#: lib/tymeslot/integrations/video/providers/zoom_provider/scopes.ex
#, elixir-autogen, elixir-format
msgid "Zoom is missing the permission needed to create meetings. Please reconnect your Zoom account."
msgstr "Zoom nie ma uprawnienia potrzebnego do tworzenia spotkań. Podłącz ponownie swoje konto Zoom."

#: lib/tymeslot/integrations/video/providers/zoom_provider/scopes.ex
#, elixir-autogen, elixir-format
msgid "Zoom is missing the permission needed to reschedule meetings. Please reconnect your Zoom account."
msgstr "Zoom nie ma uprawnienia potrzebnego do zmiany terminu spotkań. Podłącz ponownie swoje konto Zoom."

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Write the template variable exactly as {{meeting_id}}"
msgstr "Zmienną szablonu zapisz dokładnie jako {{meeting_id}}"

#: lib/tymeslot_web/components/dashboard/integrations/shared/ui_components.ex
#, elixir-autogen, elixir-format
msgid "Enter a full address starting with https://, for example https://cloud.example.com"
msgstr "Podaj pełny adres zaczynający się od https://, na przykład https://cloud.example.com"

#: lib/tymeslot/integrations/video/input_validation.ex
#, elixir-autogen, elixir-format
msgid "Enter a full address starting with https://, for example https://meet.example.com"
msgstr "Podaj pełny adres zaczynający się od https://, na przykład https://meet.example.com"

#: lib/tymeslot/integrations/video/input_validation.ex
#, elixir-autogen, elixir-format
msgid "Write {{meeting_id}} with plain brackets: percent-encoded ones are never replaced"
msgstr "Zapisz {{meeting_id}} zwykłymi nawiasami: zakodowane procentowo nigdy nie są podmieniane"
