#, elixir-autogen, elixir-format
msgid "All events"
msgstr "Wszystkie wydarzenia"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "This and following events"
msgstr "To i kolejne wydarzenia"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "This event"
msgstr "To wydarzenie"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "Change a repeating event"
msgstr "Zmień wydarzenie cykliczne"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "Delete a repeating event"
msgstr "Usuń wydarzenie cykliczne"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "Only “This event” can be undone."
msgstr "Cofnąć można tylko opcję „To wydarzenie”."

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” repeats. Should the new pattern apply to this and the following events, or to all of them?"
msgstr ""
"Wydarzenie „%{title}” się powtarza. Czy nowy wzorzec ma dotyczyć tego i "
"kolejnych wydarzeń, czy wszystkich?"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” repeats. Which events should be deleted?"
msgstr "Wydarzenie „%{title}” się powtarza. Które wydarzenia usunąć?"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” repeats. Which events should change?"
msgstr "Wydarzenie „%{title}” się powtarza. Które wydarzenia zmienić?"

#: lib/tymeslot_web/live/dashboard/calendar/series_scope_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” repeats. Which events should your changes apply to? Your answer holds until you close the details."
msgstr ""
"Wydarzenie „%{title}” się powtarza. Których wydarzeń mają dotyczyć zmiany? "
"Wybór obowiązuje do zamknięcia szczegółów."
