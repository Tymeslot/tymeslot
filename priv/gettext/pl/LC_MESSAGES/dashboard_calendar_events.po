#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_execution.ex
#, elixir-autogen, elixir-format
msgid "Create failed - queued to retry on next sync"
msgstr "Tworzenie nie powiodło się – ponowimy próbę przy następnej synchronizacji"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/event_delete.ex
#, elixir-autogen, elixir-format
msgid "Delete failed - queued to retry on next sync"
msgstr "Usuwanie nie powiodło się – ponowimy próbę przy następnej synchronizacji"

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "Failed to update event - changes reverted"
msgstr "Nie udało się zaktualizować wydarzenia – cofnięto zmiany"

#: lib/tymeslot/calendar_grid/event_creation.ex
#, elixir-autogen, elixir-format
msgid "Google Calendar saved the event but didn't return a Meet link — please try again or add it manually."
msgstr "Google Calendar zapisał wydarzenie, ale nie zwrócił linku do Google Meet – spróbuj ponownie lub dodaj go ręcznie."

#: lib/tymeslot/calendar_grid/event_creation.ex
#, elixir-autogen, elixir-format
msgid "Your calendar needs to be reconnected. Please reconnect it from the Integrations page."
msgstr "Kalendarz trzeba połączyć ponownie. Zrób to na stronie Integracje."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_execution.ex
#, elixir-autogen, elixir-format
msgid "A valid guest email is required"
msgstr "Wymagany jest prawidłowy adres e-mail gościa"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_execution.ex
#, elixir-autogen, elixir-format
msgid "Guest name is required"
msgstr "Imię i nazwisko gościa jest wymagane"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_execution.ex
#, elixir-autogen, elixir-format
msgid "Meeting with %{name}"
msgstr "Spotkanie – %{name}"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_execution.ex
#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_form_state.ex
#, elixir-autogen, elixir-format
msgid "You cannot add yourself as a guest. Use a different email address."
msgstr "Nie możesz dodać siebie jako gościa. Użyj innego adresu e-mail."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/shared.ex
#, elixir-autogen, elixir-format
msgid "This calendar is read-only. Events on it can't be changed from Tymeslot."
msgstr "Ten kalendarz jest tylko do odczytu. Jego wydarzeń nie można zmieniać z poziomu Tymeslot."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "Could not change the video link - changes reverted"
msgstr "Nie udało się zmienić linku do spotkania wideo – cofnięto zmiany"

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "Could not move the event. It is still on its original calendar."
msgstr "Nie udało się przenieść wydarzenia. Nadal znajduje się w pierwotnym kalendarzu."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar, but the original could not be removed. Please delete it from its original calendar."
msgstr "Wydarzenie skopiowano do nowego kalendarza, ale nie udało się usunąć oryginału. Usuń je z pierwotnego kalendarza."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar. The original will be removed on the next sync."
msgstr "Wydarzenie skopiowano do nowego kalendarza. Oryginał zostanie usunięty przy następnej synchronizacji."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "Event moved to the new calendar."
msgstr "Przeniesiono wydarzenie do nowego kalendarza."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "The video provider did not return a meeting link, so the video link was not changed."
msgstr "Dostawca wideo nie zwrócił linku do spotkania, więc link do spotkania wideo nie został zmieniony."

#: lib/tymeslot_web/live/dashboard/calendar_grid/edit_workflow.ex
#, elixir-autogen, elixir-format
msgid "Video link removed."
msgstr "Usunięto link do spotkania wideo."

#: lib/tymeslot_web/live/dashboard/calendar_grid/edit_workflow.ex
#, elixir-autogen, elixir-format
msgid "Video room created."
msgstr "Utworzono pokój wideo."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "Your calendar could not be reached. The change is saved and will sync on the next attempt."
msgstr "Nie udało się połączyć z kalendarzem. Zmiana została zapisana i zostanie zsynchronizowana przy następnej próbie."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "Event copied to the new calendar, but the move did not finish. Please check its original calendar and delete the original if it is still there."
msgstr "Wydarzenie skopiowano do nowego kalendarza, ale przenoszenie nie zostało dokończone. Sprawdź pierwotny kalendarz i usuń oryginał, jeśli nadal tam jest."

#: lib/tymeslot_web/live/dashboard/calendar_grid/edit_workflow.ex
#, elixir-autogen, elixir-format
msgid "This event is a booking, so its video link belongs to the booking. Reschedule or cancel the booking to change it."
msgstr "To wydarzenie jest rezerwacją, więc jego link wideo należy do rezerwacji. Aby go zmienić, zmień termin rezerwacji lub ją odwołaj."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "Google Calendar added Google Meet to the event but has not returned its link yet. Choose Google Meet again to fetch it."
msgstr "Google Calendar dodał Google Meet do wydarzenia, ale nie zwrócił jeszcze linku. Wybierz ponownie Google Meet, aby go pobrać."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/event_delete.ex
#, elixir-autogen, elixir-format
msgid "Recurring Exchange events cannot be deleted here yet. Please delete this one in your calendar app."
msgstr "Cyklicznych wydarzeń Exchange nie można jeszcze tutaj usuwać. Usuń to wydarzenie w aplikacji kalendarza."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/event_delete.ex
#, elixir-autogen, elixir-format
msgid "Recurring event deleted."
msgstr "Usunięto wydarzenie cykliczne."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/event_delete.ex
#, elixir-autogen, elixir-format
msgid "Recurring event deleted. Attendees have been notified."
msgstr "Usunięto wydarzenie cykliczne. Uczestnicy zostali powiadomieni."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/event_delete.ex
#, elixir-autogen, elixir-format
msgid "This event could not be deleted here. Please delete it in your calendar app."
msgstr "Nie udało się tutaj usunąć tego wydarzenia. Usuń je w aplikacji kalendarza."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "Events of a repeating series cannot be switched between all-day and timed here. Please make this change in your calendar app."
msgstr "Wydarzeń z serii cyklicznej nie można tutaj przełączać między całodniowymi a o określonej godzinie. Wprowadź tę zmianę w aplikacji kalendarza."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/recurrence_edit.ex
#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "That change cannot be made to the events you chose. A repeat rule can only be changed for all events, or this and following events, and cannot be removed here."
msgstr "Tej zmiany nie można wprowadzić w wybranych wydarzeniach. Regułę powtarzania można zmienić tylko dla wszystkich wydarzeń albo dla tego i kolejnych wydarzeń, a usunąć jej tutaj nie można."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/event_recurrence.ex
#, elixir-autogen, elixir-format
msgid "That choice is not available for this event, so nothing was changed."
msgstr "Ta opcja nie jest dostępna dla tego wydarzenia, więc niczego nie zmieniono."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_writes.ex
#, elixir-autogen, elixir-format
msgid "The series was updated, but a change you made while it was saving was not applied. Please make it again."
msgid_plural "The series was updated, but %{count} changes you made while it was saving were not applied. Please make them again."
msgstr[0] "Seria została zaktualizowana, ale zmiana wprowadzona podczas zapisywania nie została zastosowana. Wprowadź ją ponownie."
msgstr[1] "Seria została zaktualizowana, ale %{count} zmiany wprowadzone podczas zapisywania nie zostały zastosowane. Wprowadź je ponownie."
msgstr[2] "Seria została zaktualizowana, ale %{count} zmian wprowadzonych podczas zapisywania nie zostało zastosowanych. Wprowadź je ponownie."

#: lib/tymeslot_web/live/dashboard/calendar_grid/edit_workflow.ex
#, elixir-autogen, elixir-format
msgid "This event could not be matched to its series. Refresh your calendars and try again."
msgstr "Nie udało się dopasować tego wydarzenia do jego serii. Odśwież kalendarze i spróbuj ponownie."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "This series repeats on fixed days, such as the second Monday of the month, so it cannot be moved like this. Please make this change in your calendar app."
msgstr "Ta seria powtarza się w określone dni, np. w drugi poniedziałek miesiąca, więc nie można jej przenieść w ten sposób. Wprowadź tę zmianę w aplikacji kalendarza."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "This series' repeat rule cannot be split here. Please make this change in your calendar app."
msgstr "Reguły powtarzania tej serii nie można tutaj podzielić. Wprowadź tę zmianę w aplikacji kalendarza."

#: lib/tymeslot_web/live/dashboard/calendar_grid/series_notes.ex
#, elixir-autogen, elixir-format
msgid "A Teams meeting on the series is not carried over."
msgstr "Spotkanie Teams przypisane do serii nie zostanie przeniesione."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/series_move.ex
#, elixir-autogen, elixir-format
msgid "A change to this series is still saving. Please move the series once it has saved."
msgstr "Zmiana tej serii jest jeszcze zapisywana. Przenieś serię, gdy zapisywanie się zakończy."

#: lib/tymeslot_web/live/dashboard/calendar_grid/edit_workflow.ex
#, elixir-autogen, elixir-format
msgid "A recurring event can only be moved to a calendar of the same kind of account: Google to Google, Outlook to Outlook, or CalDAV to CalDAV."
msgstr "Wydarzenie cykliczne można przenieść tylko do kalendarza na koncie tego samego rodzaju: z Google do Google, z Outlook do Outlook lub z CalDAV do CalDAV."

#: lib/tymeslot_web/live/dashboard/calendar_grid/edit_workflow.ex
#, elixir-autogen, elixir-format
msgid "Could not move the series. It is still on its original calendar."
msgstr "Nie udało się przenieść serii. Nadal znajduje się w pierwotnym kalendarzu."

#: lib/tymeslot_web/live/dashboard/calendar_grid/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Events in the series that were changed on their own go back to the series' usual pattern."
msgstr "Wydarzenia z serii, które zmieniono osobno, wracają do zwykłego wzorca serii."

#: lib/tymeslot_web/live/dashboard/calendar_grid/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Events in the series that were changed or cancelled on their own go back to the series' usual pattern."
msgstr "Wydarzenia z serii, które zmieniono lub odwołano osobno, wracają do zwykłego wzorca serii."

#: lib/tymeslot_web/live/dashboard/calendar_grid/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Guests are sent a cancellation for the original series and an invitation to the moved one."
msgstr "Goście otrzymują odwołanie pierwotnej serii i zaproszenie do przeniesionej."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/series_move.ex
#, elixir-autogen, elixir-format
msgid "Moving the series to %{calendar}..."
msgstr "Przenoszenie serii do kalendarza %{calendar}…"

#: lib/tymeslot_web/live/dashboard/calendar_grid/edit_workflow.ex
#, elixir-autogen, elixir-format
msgid "Recurring events on this calendar cannot be moved to another calendar. Only single events can be moved."
msgstr "Wydarzeń cyklicznych z tego kalendarza nie można przenosić do innego kalendarza. Przenosić można tylko pojedyncze wydarzenia."

#: lib/tymeslot_web/live/dashboard/calendar_grid/edit_workflow.ex
#, elixir-autogen, elixir-format
msgid "That calendar cannot be written to. Please choose another calendar."
msgstr "W tym kalendarzu nie można zapisywać. Wybierz inny kalendarz."

#: lib/tymeslot_web/live/dashboard/calendar_grid/edit_workflow.ex
#, elixir-autogen, elixir-format
msgid "The series is already on that calendar."
msgstr "Seria jest już w tym kalendarzu."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was copied to %{calendar}, but the original series could not be removed. Please delete it from its original calendar."
msgstr "Serię skopiowano do kalendarza %{calendar}, ale nie udało się usunąć pierwotnej serii. Usuń ją z pierwotnego kalendarza."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "The series was moved to %{calendar}."
msgstr "Przeniesiono serię do kalendarza %{calendar}."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_writes.ex
#, elixir-autogen, elixir-format
msgid "The series was moved, but a change you made while it was moving was not applied. Please make it again."
msgid_plural "The series was moved, but %{count} changes you made while it was moving were not applied. Please make them again."
msgstr[0] "Seria została przeniesiona, ale zmiana wprowadzona podczas przenoszenia nie została zastosowana. Wprowadź ją ponownie."
msgstr[1] "Seria została przeniesiona, ale %{count} zmiany wprowadzone podczas przenoszenia nie zostały zastosowane. Wprowadź je ponownie."
msgstr[2] "Seria została przeniesiona, ale %{count} zmian wprowadzonych podczas przenoszenia nie zostało zastosowanych. Wprowadź je ponownie."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/event_recurrence.ex
#, elixir-autogen, elixir-format
msgid "A change to this series is still saving. Please make this change once it has saved."
msgstr "Zmiana tej serii jest jeszcze zapisywana. Wprowadź tę zmianę, gdy zapisywanie się zakończy."

#: lib/tymeslot_web/live/dashboard/calendar_grid/series_notes.ex
#, elixir-autogen, elixir-format
msgid "Later events that were changed or cancelled on their own keep that only on dates the new pattern still includes."
msgstr "Późniejsze wydarzenia, które zmieniono lub odwołano osobno, zachowują tę zmianę tylko w dniach, które nadal obejmuje nowy wzorzec."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/event_delete.ex
#, elixir-autogen, elixir-format
msgid "Delete failed - queued to retry on next sync. Attendees have not been notified."
msgstr "Usuwanie nie powiodło się – ponowimy próbę przy następnej synchronizacji. Uczestnicy nie zostali powiadomieni."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/event_delete.ex
#, elixir-autogen, elixir-format
msgid "Event deleted, but the attendees could not be notified."
msgstr "Usunięto wydarzenie, ale nie udało się powiadomić uczestników."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/attendee_management.ex
#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_form_state.ex
#, elixir-autogen, elixir-format
msgid "%{email} is already invited."
msgstr "Osoba o adresie %{email} jest już zaproszona."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_form_state.ex
#, elixir-autogen, elixir-format
msgid "%{email} is already the main guest."
msgstr "Osoba o adresie %{email} jest już głównym gościem."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/attendee_management.ex
#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_form_state.ex
#, elixir-autogen, elixir-format
msgid "%{email} is not a valid email address."
msgstr "%{email} nie jest prawidłowym adresem e-mail."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_form_state.ex
#, elixir-autogen, elixir-format
msgid "No more guests can be added to this meeting."
msgstr "Do tego spotkania nie można dodać więcej gości."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_execution.ex
#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Too many new meetings. Please wait a moment."
msgstr "Zbyt wiele nowych spotkań. Odczekaj chwilę."

#: lib/tymeslot_web/live/dashboard/calendar_grid/edit_workflow.ex
#, elixir-autogen, elixir-format
msgid "Someone else organises this meeting, so Tymeslot can't move or split a series you were only invited to."
msgstr "To spotkanie organizuje ktoś inny, więc Tymeslot nie może przenieść ani podzielić serii, do której zostałeś tylko zaproszony."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/shared.ex
#, elixir-autogen, elixir-format
msgid "This is a group booking. Move it, cancel it or change who attends from the meeting instead."
msgstr "To rezerwacja grupowa. Przenieś ją, anuluj lub zmień uczestników ze spotkania."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "You already have a meeting at this time. Please choose a different time."
msgstr "Masz już spotkanie o tej porze. Wybierz inną godzinę."

#: lib/tymeslot_web/live/dashboard/calendar_grid/edit_workflow.ex
#, elixir-autogen, elixir-format
msgid "This repeat pattern can't be saved to Outlook."
msgstr "Tego schematu powtarzania nie można zapisać w kalendarzu Outlook."

#: lib/tymeslot_web/live/dashboard/calendar_grid/edit_workflow.ex
#, elixir-autogen, elixir-format
msgid "Outlook can't skip the months that don't have this series' day, and would move those events to the month's last day. Please start the series on the 28th or earlier, or save it to another calendar."
msgstr ""
"Outlook nie potrafi pomijać miesięcy, które nie mają dnia tej serii, i przeniósłby te wydarzenia na ostatni dzień miesiąca. Rozpocznij serię najpóźniej 28. dnia miesiąca lub zapisz ją w innym kalendarzu."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "This series changed while you were editing it, and nothing is left of it from this event on. Nothing was saved."
msgstr "Ta seria zmieniła się w trakcie edycji i od tego wydarzenia nic z niej nie pozostało. Niczego nie zapisano."

#: lib/tymeslot_web/live/dashboard/calendar_grid/write_outcome_messages.ex
#, elixir-autogen, elixir-format
msgid "This series changed while you were editing it, so the events left in it can no longer be counted. Nothing was saved. Refresh the calendar and try again."
msgstr "Ta seria zmieniła się w trakcie edycji, więc nie można już policzyć pozostałych wydarzeń. Niczego nie zapisano. Odśwież kalendarz i spróbuj ponownie."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/attendee_management.ex
#, elixir-autogen, elixir-format
msgid "Attendee added. They were not invited, as you don't organise this event."
msgstr "Uczestnik dodany. Nie wysłano zaproszenia, ponieważ nie jesteś organizatorem tego wydarzenia."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/attendee_management.ex
#, elixir-autogen, elixir-format
msgid "Attendee removed. They were not notified, as you don't organise this event."
msgstr "Uczestnik usunięty. Nie wysłano powiadomienia, ponieważ nie jesteś organizatorem tego wydarzenia."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/attendee_management.ex
#, elixir-autogen, elixir-format
msgid "Attendee added, but their invitation could not be sent."
msgstr "Uczestnik dodany, ale nie udało się wysłać zaproszenia."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/attendee_management.ex
#, elixir-autogen, elixir-format
msgid "Attendee removed, but they could not be notified."
msgstr "Uczestnik usunięty, ale nie udało się go powiadomić."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/attendee_management.ex
#, elixir-autogen, elixir-format
msgid "Attendee added. They will be invited once the change has synced to your calendar."
msgstr "Uczestnik dodany. Zaproszenie zostanie wysłane po zsynchronizowaniu zmiany z kalendarzem."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/attendee_management.ex
#, elixir-autogen, elixir-format
msgid "Attendee removed. They will be notified once the change has synced to your calendar."
msgstr "Uczestnik usunięty. Powiadomienie zostanie wysłane po zsynchronizowaniu zmiany z kalendarzem."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_execution.ex
#, elixir-autogen, elixir-format
msgid "Add a title. A meeting without a main participant is known by its title."
msgstr "Dodaj tytuł. Spotkanie bez głównego uczestnika rozpoznaje się po tytule."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/create_execution.ex
#, elixir-autogen, elixir-format
msgid "Invite at least one guest."
msgstr "Zaproś co najmniej jednego gościa."
