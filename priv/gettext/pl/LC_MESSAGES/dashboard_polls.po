#, elixir-autogen, elixir-format
msgid "Remove from the poll"
msgstr "Usuń z ankiety"

#: lib/tymeslot_web/live/dashboard/polls/poll_editor.ex
#, elixir-autogen, elixir-format
msgid "Removed from the poll"
msgstr "Usunięto z ankiety"

#: lib/tymeslot_web/live/dashboard/polls/poll_reminders.ex
#, elixir-autogen, elixir-format
msgid "Sent before the voting deadline to everyone who has not voted yet. A poll without a deadline sends none."
msgstr "Wysyłane przed końcem głosowania do wszystkich, którzy jeszcze nie zagłosowali. Ankieta bez terminu końcowego ich nie wysyła."

#: lib/tymeslot_web/live/dashboard/polls/poll_editor.ex
#, elixir-autogen, elixir-format
msgid "The deadline must be in the future"
msgstr "Termin końcowy musi być w przyszłości"

#: lib/tymeslot_web/live/dashboard/polls/delete_poll_modal.ex
#, elixir-autogen, elixir-format
msgid "The meeting it scheduled stays in your calendar."
msgstr "Ustalone dzięki niej spotkanie pozostaje w kalendarzu."

#: lib/tymeslot_web/live/dashboard/polls/poll_editor.ex
#, elixir-autogen, elixir-format
msgid "The poll already has this time"
msgstr "Ankieta ma już ten termin"

#: lib/tymeslot_web/live/dashboard/polls/poll_editor.ex
#, elixir-autogen, elixir-format
msgid "invited"
msgstr "zaproszenie wysłane"

#: lib/tymeslot_web/live/dashboard/polls/poll_editor.ex
#, elixir-autogen, elixir-format
msgid "not voted yet"
msgstr "jeszcze nie głosowano"

#: lib/tymeslot_web/live/dashboard/polls/poll_editor.ex
#, elixir-autogen, elixir-format
msgid "voted"
msgstr "głos oddany"

#: lib/tymeslot_web/live/dashboard/polls/delete_poll_modal.ex
#, elixir-autogen, elixir-format
msgid "“%{title}” will be removed with its times and everyone's responses. This cannot be undone."
msgstr "Ankieta „%{title}” zostanie usunięta wraz z terminami i wszystkimi odpowiedziami. Tej operacji nie można cofnąć."

#: lib/tymeslot_web/live/dashboard/polls/poll_editor.ex
#, elixir-autogen, elixir-format
msgid "Its calendar and video provider are used for the meeting when you confirm a time. The poll's times and title stay as they are."
msgstr "Jego kalendarz i usługa wideo zostaną użyte dla spotkania po zatwierdzeniu terminu. Terminy i tytuł ankiety pozostają bez zmian."

#: lib/tymeslot_web/live/dashboard/polls/poll_editor.ex
#, elixir-autogen, elixir-format
msgid "%{count} person who asked for a voting link but hasn't voted with it yet will be removed."
msgid_plural "%{count} people who asked for a voting link but haven't voted with it yet will be removed."
msgstr[0] "%{count} osoba, która poprosiła o link do głosowania, ale jeszcze nim nie zagłosowała, zostanie usunięta."
msgstr[1] "%{count} osoby, które poprosiły o link do głosowania, ale jeszcze nim nie zagłosowały, zostaną usunięte."
msgstr[2] "%{count} osób, które poprosiły o link do głosowania, ale jeszcze nim nie zagłosowały, zostanie usuniętych."

#: lib/tymeslot_web/live/dashboard/polls/poll_access.ex
#, elixir-autogen, elixir-format
msgid "Anyone with the link"
msgstr "Każdy, kto ma link"

#: lib/tymeslot_web/live/dashboard/polls/poll_access.ex
#, elixir-autogen, elixir-format
msgid "Anyone you share the poll's link with can ask for a personal voting link by email."
msgstr "Każdy, komu udostępnisz link do ankiety, może poprosić o osobisty link do głosowania wysłany e-mailem."

#: lib/tymeslot_web/live/dashboard/polls/poll_form.ex
#, elixir-autogen, elixir-format
msgid "Nobody can vote until you invite someone. You can also invite people after creating the poll."
msgstr "Nikt nie zagłosuje, dopóki kogoś nie zaprosisz. Osoby możesz zaprosić także po utworzeniu ankiety."

#: lib/tymeslot_web/live/dashboard/polls/poll_access.ex
#, elixir-autogen, elixir-format
msgid "Only invited people"
msgstr "Tylko zaproszeni"

#: lib/tymeslot_web/live/dashboard/polls/poll_access.ex
#, elixir-autogen, elixir-format
msgid "Only people I invite"
msgstr "Tylko osoby, które zaproszę"

#: lib/tymeslot_web/live/dashboard/polls/poll_access.ex
#, elixir-autogen, elixir-format
msgid "Only the people you invite by email can vote. Anyone else who opens the link is told the poll is by invitation."
msgstr "Głosować mogą tylko osoby, które zaprosisz e-mailem. Pozostałe osoby, które otworzą link, zobaczą informację, że ankieta jest tylko dla zaproszonych."

#: lib/tymeslot_web/live/dashboard/polls/poll_access.ex
#, elixir-autogen, elixir-format
msgid "Who can vote"
msgstr "Kto może głosować"
