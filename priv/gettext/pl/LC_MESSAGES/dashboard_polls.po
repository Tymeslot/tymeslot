msgstr[0] "%{count} osoba, która poprosiła o link do głosowania, ale jeszcze nim nie zagłosowała, zostanie usunięta."
msgstr[1] "%{count} osoby, które poprosiły o link do głosowania, ale jeszcze nim nie zagłosowały, zostaną usunięte."
msgstr[2] "%{count} osób, które poprosiły o link do głosowania, ale jeszcze nim nie zagłosowały, zostanie usuniętych."

#: lib/tymeslot_web/live/dashboard/polls/poll_access.ex
