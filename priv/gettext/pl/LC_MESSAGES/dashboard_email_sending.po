#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "A test message is sent only to your current verified account email."
msgstr "Wiadomość testowa zostanie wysłana tylko na aktualny potwierdzony adres e-mail konta."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Booking emails currently use the platform sender."
msgstr "E-maile dotyczące rezerwacji korzystają obecnie z nadawcy platformy."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "Booking emails now use the platform sender."
msgstr "E-maile dotyczące rezerwacji korzystają teraz z nadawcy platformy."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Booking emails use this SMTP identity."
msgstr "E-maile dotyczące rezerwacji korzystają z tej konfiguracji nadawcy SMTP."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Check the email settings and try again."
msgstr "Sprawdź ustawienia poczty i spróbuj ponownie."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Choose a public SMTP hostname. Private and local mail servers are not supported."
msgstr "Wybierz publiczną nazwę hosta SMTP. Prywatne i lokalne serwery pocztowe nie są obsługiwane."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Credentials are saved securely. Leave the username and password blank to keep them."
msgstr "Dane logowania są bezpiecznie zapisane. Aby je zachować, pozostaw nazwę użytkownika i hasło puste."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP is disabled"
msgstr "Własna konfiguracja SMTP jest wyłączona"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP is enabled"
msgstr "Własna konfiguracja SMTP jest włączona"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP is enabled for booking emails."
msgstr "Własna konfiguracja SMTP jest włączona dla e-maili dotyczących rezerwacji."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Custom SMTP remains selected. Failed booking emails are retried without switching to the platform sender."
msgstr "Własna konfiguracja SMTP pozostaje wybrana. Nieudane wysyłki e-maili dotyczących rezerwacji są ponawiane bez przełączania na nadawcę platformy."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Delete identity and credentials"
msgstr "Usuń konfigurację i dane logowania"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Delete saved identity"
msgstr "Usuń zapisaną konfigurację nadawcy"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Delete this SMTP identity?"
msgstr "Usunąć tę konfigurację nadawcy SMTP?"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Email sending"
msgstr "Wysyłanie e-maili"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Email sending settings are unavailable. Reload the page to continue."
msgstr "Ustawienia wysyłania e-maili są niedostępne. Odśwież stronę, aby kontynuować."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Email settings need attention"
msgstr "Ustawienia poczty wymagają uwagi"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Email testing is temporarily unavailable. Try again shortly."
msgstr "Testy poczty są tymczasowo niedostępne. Spróbuj ponownie za chwilę."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Enable tested identity"
msgstr "Włącz przetestowaną konfigurację nadawcy"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "From address"
msgstr "Adres nadawcy"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "From display name"
msgstr "Nazwa wyświetlana nadawcy"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Implicit TLS (port 465)"
msgstr "Niejawny TLS (port 465)"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Keep identity"
msgstr "Zachowaj konfigurację nadawcy"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Polls, calendar invitations from the dashboard, and payment notices still use the platform sender."
msgstr "Ankiety, zaproszenia kalendarzowe z panelu i powiadomienia o płatnościach nadal korzystają z nadawcy platformy."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Refresh status"
msgstr "Odśwież stan"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Required STARTTLS (port 587)"
msgstr "Wymagany STARTTLS (port 587)"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP hostname"
msgstr "Nazwa hosta SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP password or app password"
msgstr "Hasło SMTP lub hasło aplikacji"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP port"
msgstr "Port SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP settings"
msgstr "Ustawienia SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "SMTP username"
msgstr "Nazwa użytkownika SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "TLS mode"
msgstr "Tryb TLS"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Test and save"
msgstr "Przetestuj i zapisz"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Test and save these settings before enabling them."
msgstr "Przetestuj i zapisz te ustawienia przed ich włączeniem."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Testing SMTP settings"
msgstr "Testowanie ustawień SMTP"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Testing and saving…"
msgstr "Testowanie i zapisywanie…"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP hostname could not be resolved. Check it and try again."
msgstr "Nie udało się rozpoznać nazwy hosta SMTP. Sprawdź ją i spróbuj ponownie."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP operation could not be completed. Check the settings and try again."
msgstr "Nie udało się zakończyć operacji SMTP. Sprawdź ustawienia i spróbuj ponownie."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server accepted the test and the settings were saved. Acceptance does not confirm inbox delivery."
msgstr "Serwer SMTP zaakceptował wiadomość testową i zapisano ustawienia. Akceptacja nie potwierdza dostarczenia do skrzynki odbiorczej."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server did not respond in time. Try again shortly."
msgstr "Serwer SMTP nie odpowiedział na czas. Spróbuj ponownie za chwilę."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server refused the credentials. Check the username and password, or use an app password."
msgstr "Serwer SMTP odrzucił dane logowania. Sprawdź nazwę użytkownika i hasło albo użyj hasła aplikacji."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The SMTP server timed out. It may have accepted the message; check before trying again."
msgstr "Upłynął czas oczekiwania na serwer SMTP. Wiadomość mogła zostać zaakceptowana; sprawdź to przed kolejną próbą."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The required TLS connection failed. Check the SMTP host, port, and TLS mode."
msgstr "Wymagane połączenie TLS nie powiodło się. Sprawdź host SMTP, port i tryb TLS."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending_component.ex
#, elixir-autogen, elixir-format
msgid "The saved SMTP identity and credentials were deleted."
msgstr "Usunięto zapisaną konfigurację nadawcy SMTP i dane logowania."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The saved credentials could not be read. Enter them again and test the connection."
msgstr "Nie udało się odczytać zapisanych danych logowania. Wpisz je ponownie i przetestuj połączenie."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "The server is being tested. Existing email settings stay unchanged if the test fails."
msgstr "Trwa testowanie serwera. Jeśli test się nie powiedzie, dotychczasowe ustawienia poczty pozostaną bez zmian."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "This removes the saved credentials. Booking emails will use the platform sender."
msgstr "Spowoduje to usunięcie zapisanych danych logowania. E-maile dotyczące rezerwacji będą korzystać z nadawcy platformy."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many SMTP tests or connections. Wait a few minutes and try again."
msgstr "Zbyt wiele testów lub połączeń SMTP. Poczekaj kilka minut i spróbuj ponownie."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Use a public SMTP server with authenticated TLS. Your provider must authorize the From address and manage SPF, DKIM, and DMARC for its domain."
msgstr "Użyj publicznego serwera SMTP z uwierzytelnianiem i szyfrowaniem TLS. Dostawca musi zezwalać na używanie adresu nadawcy oraz obsługiwać SPF, DKIM i DMARC dla jego domeny."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Use platform sender"
msgstr "Użyj nadawcy platformy"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Using platform sender"
msgstr "Używany jest nadawca platformy"

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Verify your account email before testing or enabling custom SMTP."
msgstr "Potwierdź adres e-mail konta przed testowaniem lub włączeniem własnej konfiguracji SMTP."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Your SMTP identity sends booking confirmations, reminders, cancellations, rescheduling, approvals, and guest/group notices. Account and security emails use the platform sender."
msgstr "Konfiguracja nadawcy SMTP służy do wysyłania potwierdzeń rezerwacji, przypomnień, anulowań, zmian terminów, zatwierdzeń oraz powiadomień dla gości i grup. E-maile dotyczące konta i bezpieczeństwa korzystają z nadawcy platformy."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/view.ex
#, elixir-autogen, elixir-format
msgid "Your current sending identity has not changed. Review the error and test again."
msgstr "Obecna konfiguracja nadawcy nie uległa zmianie. Sprawdź błąd i ponów test."

#: lib/tymeslot_web/live/dashboard/profile_settings/email_sending/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Your email settings changed. Review the current settings and try again."
msgstr "Ustawienia poczty uległy zmianie. Sprawdź aktualne ustawienia i spróbuj ponownie."
