#, elixir-autogen, elixir-format
msgid "The server URL cannot contain a query string (?) or a fragment (#). Enter only the address of the server."
msgstr "Adres URL serwera nie może zawierać ciągu zapytania (?) ani fragmentu (#). Wpisz tylko adres serwera."

#: lib/tymeslot/integrations/video/providers/link_room.ex
#, elixir-autogen, elixir-format
msgid "The server URL cannot contain spaces. Enter only the address of the server."
msgstr "Adres URL serwera nie może zawierać spacji. Wpisz tylko adres serwera."

#: lib/tymeslot/integrations/video/providers/nextcloud_talk_provider.ex
#, elixir-autogen, elixir-format
msgid "The server did not answer like a Nextcloud server. Check the address."
msgstr "Serwer nie odpowiedział jak serwer Nextcloud. Sprawdź adres."

#: lib/tymeslot/integrations/video/providers/nextcloud_talk_provider.ex
#, elixir-autogen, elixir-format
msgid "The server redirected the request. Enter the address your browser ends up on when you open Nextcloud, starting with https://."
msgstr "Serwer przekierował żądanie. Wpisz adres zaczynający się od https://, na który trafia przeglądarka po otwarciu Nextcloud."

#: lib/tymeslot/integrations/video/providers/nextcloud_talk_provider.ex
#, elixir-autogen, elixir-format
msgid "This Nextcloud Talk is too old. Tymeslot needs Talk 21.1 or later."
msgstr "Ta wersja Nextcloud Talk jest za stara. Tymeslot wymaga Talk 21.1 lub nowszego."

#: lib/tymeslot/integrations/video/room_creation_error.ex
#, elixir-autogen, elixir-format
msgid "This Nextcloud user may not use Talk. In the Talk administration settings on Nextcloud, add the user to a group that may use Talk, or connect a user who may."
msgstr "Ten użytkownik Nextcloud nie może korzystać z Talk. W ustawieniach administracyjnych Talk w Nextcloud dodaj użytkownika do grupy, która może korzystać z Talk, albo podłącz użytkownika, który ma do tego uprawnienia."

#: lib/tymeslot/integrations/video/providers/link_room.ex
#, elixir-autogen, elixir-format
msgid "URL redirects too many times"
msgstr "Adres URL przekierowuje zbyt wiele razy"

#: lib/tymeslot/integrations/video/providers/link_room.ex
#, elixir-autogen, elixir-format
msgid "URL resolves to a private or loopback address"
msgstr "Adres URL wskazuje na adres prywatny lub pętli zwrotnej"

#: lib/tymeslot/integrations/video/providers/link_room.ex
#, elixir-autogen, elixir-format
msgid "URL responded with HTTP %{status}"
msgstr "Adres URL odpowiedział kodem HTTP %{status}"

#: lib/tymeslot/integrations/video/providers/mirotalk_provider.ex
#, elixir-autogen, elixir-format
msgid "Unexpected response (status %{status}) - Please verify your configuration"
msgstr "Nieoczekiwana odpowiedź (status %{status}) – sprawdź konfigurację"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Unknown template variable. Only {{meeting_id}} is supported"
msgstr "Nieznana zmienna szablonu. Obsługiwana jest tylko {{meeting_id}}"

#: lib/tymeslot/integrations/video/input_validation.ex
#, elixir-autogen, elixir-format
msgid "Unknown video provider"
msgstr "Nieznany dostawca wideo"

#: lib/tymeslot/integrations/video/providers/jitsi_provider.ex
#, elixir-autogen, elixir-format
msgid "Use an https:// server URL when token authentication is configured, so the tokens in meeting links are not sent unencrypted."
msgstr "Gdy skonfigurowano uwierzytelnianie tokenem, użyj adresu URL serwera zaczynającego się od https://, aby tokeny w linkach do spotkań nie były przesyłane bez szyfrowania."

#: lib/tymeslot/integrations/video/providers/nextcloud_talk_provider.ex
#, elixir-autogen, elixir-format
msgid "Use an https:// server URL. Nextcloud receives your app password with every request."
msgstr "Użyj adresu URL serwera zaczynającego się od https://. Nextcloud otrzymuje hasło aplikacji przy każdym żądaniu."

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use curly brackets: {{meeting_id}} not ((meeting_id))"
msgstr "Użyj nawiasów klamrowych: {{meeting_id}}, a nie ((meeting_id))"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use curly brackets: {{meeting_id}} not <meeting_id>"
msgstr "Użyj nawiasów klamrowych: {{meeting_id}}, a nie <meeting_id>"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use curly brackets: {{meeting_id}} not [[meeting_id]]"
msgstr "Użyj nawiasów klamrowych: {{meeting_id}}, a nie [[meeting_id]]"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use double curly brackets: {{meeting_id}}"
msgstr "Użyj podwójnych nawiasów klamrowych: {{meeting_id}}"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use double curly brackets: {{meeting_id}} not {meeting_id}"
msgstr "Użyj podwójnych nawiasów klamrowych: {{meeting_id}}, a nie {meeting_id}"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use lowercase: {{meeting_id}} not {{MEETING_ID}} or {{Meeting_Id}}"
msgstr "Użyj małych liter: {{meeting_id}}, a nie {{MEETING_ID}} lub {{Meeting_Id}}"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Use underscore not hyphen: {{meeting_id}} not {{meeting-id}}"
msgstr "Użyj podkreślnika zamiast myślnika: {{meeting_id}}, a nie {{meeting-id}}"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Variable name should be: {{meeting_id}}"
msgstr "Nazwa zmiennej powinna brzmieć: {{meeting_id}}"

#: lib/tymeslot/integrations/video/template_syntax.ex
#, elixir-autogen, elixir-format
msgid "Write the template variable exactly as {{meeting_id}}"
msgstr "Zmienną szablonu zapisz dokładnie jako {{meeting_id}}"

#: lib/tymeslot/integrations/video/input_validation.ex
#, elixir-autogen, elixir-format
msgid "Write {{meeting_id}} with plain brackets: percent-encoded ones are never replaced"
msgstr "Zapisz {{meeting_id}} zwykłymi nawiasami: zakodowane procentowo nigdy nie są podmieniane"

#: lib/tymeslot/integrations/video/provider_config.ex
#, elixir-autogen, elixir-format
msgid "Your own Jitsi Meet server"
msgstr "Własny serwer Jitsi Meet"

#: lib/tymeslot/integrations/video/providers/zoom_provider/reauth.ex
#, elixir-autogen, elixir-format
msgid "Zoom access was revoked. Please reconnect your Zoom account."
msgstr "Dostęp do Zoom został cofnięty. Połącz ponownie konto Zoom."

#: lib/tymeslot/integrations/video/providers/zoom_provider.ex
#, elixir-autogen, elixir-format
msgid "Zoom connected successfully!"
msgstr "Podłączono Zoom!"

#: lib/tymeslot/integrations/video/providers/zoom_provider/scopes.ex
#, elixir-autogen, elixir-format
msgid "Zoom is missing the permission needed to cancel meetings. Please reconnect your Zoom account."
msgstr "Zoom nie ma uprawnienia potrzebnego do odwoływania spotkań. Połącz ponownie konto Zoom."

#: lib/tymeslot/integrations/video/providers/zoom_provider/scopes.ex
#, elixir-autogen, elixir-format
msgid "Zoom is missing the permission needed to create meetings. Please reconnect your Zoom account."
msgstr "Zoom nie ma uprawnienia potrzebnego do tworzenia spotkań. Połącz ponownie konto Zoom."

#: lib/tymeslot/integrations/video/providers/zoom_provider/scopes.ex
#, elixir-autogen, elixir-format
msgid "Zoom is missing the permission needed to reschedule meetings. Please reconnect your Zoom account."
msgstr "Zoom nie ma uprawnienia potrzebnego do zmiany terminu spotkań. Połącz ponownie konto Zoom."

#: lib/tymeslot/integrations/video/providers/zoom_provider.ex
#, elixir-autogen, elixir-format
msgid "Zoom token refresh failed after 401. Please reconnect your Zoom account."
msgstr "Odświeżenie tokena Zoom nie powiodło się po błędzie 401. Połącz ponownie konto Zoom."
