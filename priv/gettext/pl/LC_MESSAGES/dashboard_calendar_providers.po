msgstr "Nie znaleziono punktu końcowego EWS. Zwykle kończy się na /EWS/Exchange.asmx."

#: lib/tymeslot/integrations/calendar/exchange/provider.ex
#, elixir-autogen, elixir-format
msgid "Exchange connection successful"
msgstr "Połączono z Exchange"

#: lib/tymeslot/workers/sync_exchange_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "Exchange reported no busy time at all, but the cache still holds some. Keeping it in place and retrying rather than treating your diary as free."
msgstr "Exchange nie zgłosił żadnych zajętych terminów, ale w pamięci podręcznej nadal takie są. Zachowujemy ją i ponawiamy próbę, zamiast uznawać Twój kalendarz za wolny."

#: lib/tymeslot/workers/sync_exchange_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "Exchange returned no calendar events, but the cache still holds some. Keeping them in place and retrying rather than emptying your calendar view."
msgstr "Exchange nie zwrócił żadnych wydarzeń kalendarza, ale w pamięci podręcznej nadal takie są. Zachowujemy je i ponawiamy próbę, zamiast opróżniać widok kalendarza."

#: lib/tymeslot/workers/sync_exchange_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "The Exchange server answered the free/busy request with nothing Tymeslot could read. Retrying rather than treating your diary as free."
msgstr "Serwer Exchange odpowiedział na zapytanie o zajętość czymś, czego Tymeslot nie potrafi odczytać. Ponawiamy próbę, zamiast uznawać Twój kalendarz za wolny."

#: lib/tymeslot/workers/sync_exchange_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "The Exchange server rejected the request."
msgstr "Serwer Exchange odrzucił żądanie."

#: lib/tymeslot/workers/sync_exchange_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "The Exchange server rejected the stored credentials. Please reconnect the integration."
msgstr "Serwer Exchange odrzucił zapisane dane logowania. Podłącz integrację ponownie."

#: lib/tymeslot/workers/sync_exchange_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "Tymeslot needs the mailbox's email address to read its free/busy time. Please reconnect the integration and provide it."
msgstr "Tymeslot potrzebuje adresu e-mail skrzynki, aby odczytać jej zajętość. Podłącz integrację ponownie i podaj ten adres."

#: lib/tymeslot/integrations/calendar/shared/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Connected to %{url} and your credentials were accepted, but no calendar collection was found. Enter the full URL of your calendar collection, as shown in your calendar server's settings."
msgstr "Połączono z %{url}, a dane logowania zostały przyjęte, ale nie znaleziono żadnej kolekcji kalendarzy. Podaj pełny adres kolekcji kalendarzy, tak jak widnieje w ustawieniach Twojego serwera kalendarza."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "The calendar server answered this address but does not accept calendar requests there. Please check the server URL."
msgstr "Serwer kalendarza odpowiedział pod tym adresem, ale nie przyjmuje tam żądań kalendarza. Sprawdź adres serwera."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/exchange_config.ex
