#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Attendee email is required"
msgstr "Adres e-mail uczestnika jest wymagany"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Attendee name is required"
msgstr "Imię i nazwisko uczestnika są wymagane"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Booking requires at least %{hours} hours in advance"
msgstr "Rezerwacja wymaga co najmniej %{hours} godz. wyprzedzenia"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Booking time must be in the future"
msgstr "Termin rezerwacji musi być w przyszłości"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel a completed meeting"
msgstr "Nie można odwołać zakończonego spotkania"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel a meeting that has already occurred"
msgstr "Nie można odwołać spotkania, które już się odbyło"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel a meeting that has already started"
msgstr "Nie można odwołać spotkania, które już się rozpoczęło"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel an expired meeting"
msgstr "Nie można odwołać spotkania, którego rezerwacja wygasła"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot request a reschedule while the booking awaits approval"
msgstr "Nie można poprosić o zmianę terminu, dopóki rezerwacja czeka na zatwierdzenie"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a cancelled meeting"
msgstr "Nie można zmienić terminu odwołanego spotkania"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a completed meeting"
msgstr "Nie można zmienić terminu zakończonego spotkania"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a meeting that has already occurred"
msgstr "Nie można zmienić terminu spotkania, które już się odbyło"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a meeting that has already started"
msgstr "Nie można zmienić terminu spotkania, które już się rozpoczęło"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule an expired meeting"
msgstr "Nie można zmienić terminu spotkania, którego prośba o rezerwację wygasła"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "End time must be after start time"
msgstr "Godzina zakończenia musi być późniejsza niż godzina rozpoczęcia"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to create appointment. Please try again."
msgstr "Nie udało się utworzyć spotkania. Spróbuj ponownie."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to create meeting"
msgstr "Nie udało się utworzyć spotkania"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to process booking. Please try again."
msgstr "Nie udało się przetworzyć rezerwacji. Spróbuj ponownie."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to save meeting to database"
msgstr "Nie udało się zapisać spotkania w bazie danych"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Host could not be found. Please refresh and try again."
msgstr "Nie znaleziono organizatora. Odśwież stronę i spróbuj ponownie."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Invalid date/time"
msgstr "Nieprawidłowa data lub godzina"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Invalid meeting duration selected"
msgstr "Wybrano nieprawidłowy czas trwania spotkania"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Organiser is required for booking"
msgstr "Do rezerwacji wymagany jest organizator"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Payments are not available for this booking. Please contact the host."
msgstr "Płatności nie są dostępne dla tej rezerwacji. Skontaktuj się z organizatorem."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please fill in all required fields before submitting."
msgstr "Wypełnij wszystkie wymagane pola przed wysłaniem."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a date"
msgstr "Wybierz datę"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a date and time"
msgstr "Wybierz datę i godzinę"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a meeting duration"
msgstr "Wybierz czas trwania spotkania"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a time"
msgstr "Wybierz godzinę"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "The guest email must differ from your own address"
msgstr "Adres e-mail gościa musi być inny niż twój"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "The host is no longer accepting bookings for this period. Please pick a different day."
msgstr "Organizator nie przyjmuje już rezerwacji na ten okres. Wybierz inny dzień."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This booking has already been cancelled or moved."
msgstr "Ta rezerwacja została już odwołana lub przeniesiona."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This is a group booking, so each participant moves their own spot from their confirmation email."
msgstr "To rezerwacja grupowa, więc każdy uczestnik samodzielnie przenosi swoje miejsce za pomocą e-maila z potwierdzeniem."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This is your current time. Pick a different time to move your spot."
msgstr "To jest Twój obecny termin. Wybierz inny termin, aby przenieść swoje miejsce."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting could not be found. Please refresh and try again."
msgstr "Nie znaleziono tego spotkania. Odśwież stronę i spróbuj ponownie."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type is no longer available. Please go back and select another."
msgstr "Ten typ spotkania nie jest już dostępny. Wróć i wybierz inny."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type is no longer available. Please refresh the page."
msgstr "Ten typ spotkania nie jest już dostępny. Odśwież stronę."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This spot can no longer be moved. Cancel it and book a new time instead, or contact the host."
msgstr "Tego miejsca nie można już przenieść. Anuluj je i zarezerwuj nowy termin albo skontaktuj się z gospodarzem."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This time slot is no longer available. Please select a different time."
msgstr "Ten termin nie jest już dostępny. Wybierz inny."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Title is required"
msgstr "Tytuł jest wymagany"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "We couldn't check the host's calendar right now. Please try again in a few minutes."
msgstr "Nie udało się teraz sprawdzić kalendarza organizatora. Spróbuj ponownie za kilka minut."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "We couldn't start the payment process. Please try again."
msgstr "Nie udało się rozpocząć płatności. Spróbuj ponownie."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "You already have a spot at this time. Check your email for your booking confirmation."
msgstr "Masz już zarezerwowane miejsce w tym terminie. Potwierdzenie rezerwacji znajdziesz w skrzynce e-mail."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "You cannot book more than %{days} days in advance"
msgstr "Nie możesz rezerwować więcej niż %{days} dn. naprzód"
