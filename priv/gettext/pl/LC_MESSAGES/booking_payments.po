#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking cancelled"
msgstr "Rezerwacja odwołana"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking confirmed"
msgstr "Rezerwacja potwierdzona"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking not accepted"
msgstr "Rezerwacja nieprzyjęta"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking request expired"
msgstr "Prośba o rezerwację wygasła"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Confirming your payment…"
msgstr "Potwierdzamy płatność…"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "If there's no answer by %{by_deadline}, the request lapses and you're refunded automatically."
msgstr "Czas na odpowiedź mija: %{by_deadline}. Jeśli do tego czasu nikt nie odpowie, prośba wygaśnie, a pieniądze wrócą do ciebie automatycznie."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "If there's no answer by %{by_deadline}, the request lapses."
msgstr "Czas na odpowiedź mija: %{by_deadline}. Jeśli do tego czasu nikt nie odpowie, prośba wygaśnie."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Nobody responded to this request in time, so it has lapsed."
msgstr "Nikt nie odpowiedział na tę prośbę na czas, więc wygasła."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Nobody responded to this request in time, so it has lapsed. Your payment is being refunded."
msgstr "Nikt nie odpowiedział na tę prośbę na czas, więc wygasła. Zwrot płatności jest w toku."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment cancelled"
msgstr "Płatność anulowana"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment not completed"
msgstr "Płatność niedokończona"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment received"
msgstr "Płatność otrzymana"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Please wait while we confirm your booking."
msgstr "Poczekaj chwilę, potwierdzamy rezerwację."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Return to booking"
msgstr "Wróć do rezerwacji"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thank you, your booking is confirmed for %{for_date}."
msgstr "Dziękujemy, rezerwacja została potwierdzona: %{for_date}."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thanks, your payment went through. Your booking is not confirmed yet though:"
msgstr "Dziękujemy, płatność się powiodła. Rezerwacja nie jest jednak jeszcze potwierdzona:"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking has been cancelled, so it won't be going ahead."
msgstr "Ta rezerwacja została odwołana, więc spotkanie się nie odbędzie."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking wasn't accepted, so it won't be going ahead."
msgstr "Ta rezerwacja nie została przyjęta, więc spotkanie się nie odbędzie."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking wasn't accepted, so it won't be going ahead. Your payment is being refunded."
msgstr "Ta rezerwacja nie została przyjęta, więc spotkanie się nie odbędzie. Zwrot płatności jest w toku."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. You can return and try again at any time."
msgstr "Rezerwacja nie została potwierdzona. Możesz wrócić i spróbować ponownie w dowolnej chwili."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Paid: %{amount}"
msgstr "Opłacono: %{amount}"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. Your invitation stays reserved for it until the unfinished checkout expires, and a link to book again will appear here as soon as it does."
msgstr "Rezerwacja nie została potwierdzona. Zaproszenie pozostaje zarezerwowane dla niej, dopóki niedokończona płatność nie wygaśnie. Gdy to nastąpi, pojawi się tu link do ponownej rezerwacji."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. To try again, open the invitation link you were sent."
msgstr "Twoja rezerwacja nie została potwierdzona. Aby spróbować ponownie, otwórz otrzymany link z zaproszeniem."

#: lib/tymeslot/meeting_payments/checkout_sessions.ex
#, elixir-autogen, elixir-format
msgid "%{name}, %{count} session"
msgid_plural "%{name}, %{count} sessions"
msgstr[0] "%{name}, %{count} sesja"
msgstr[1] "%{name}, %{count} sesje"
msgstr[2] "%{name}, %{count} sesji"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thank you, your %{count} session is confirmed, the first on %{on_date}."
msgid_plural "Thank you, your %{count} sessions are confirmed, the first on %{on_date}."
msgstr[0] "Dziękujemy, %{count} sesja została potwierdzona, pierwsza: %{on_date}."
msgstr[1] "Dziękujemy, %{count} sesje zostały potwierdzone, pierwsza: %{on_date}."
msgstr[2] "Dziękujemy, %{count} sesji zostało potwierdzonych, pierwsza: %{on_date}."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "The payment wasn't completed in time, so the seat held for you was released. You can return and book again."
msgid_plural "The payment wasn't completed in time, so the seats held for you were released. You can return and book again."
msgstr[0] "Płatność nie została zrealizowana na czas, więc zarezerwowane dla ciebie miejsce zostało zwolnione. Możesz wrócić i zarezerwować termin ponownie."
msgstr[1] "Płatność nie została zrealizowana na czas, więc zarezerwowane dla ciebie miejsca zostały zwolnione. Możesz wrócić i zarezerwować termin ponownie."
msgstr[2] "Płatność nie została zrealizowana na czas, więc zarezerwowane dla ciebie miejsca zostały zwolnione. Możesz wrócić i zarezerwować termin ponownie."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your payment arrived after the seat held for you was released, and the session had no room left. Your payment is being refunded."
msgid_plural "Your payment arrived after the seats held for you were released, and the session had no room left. Your payment is being refunded."
msgstr[0] "Płatność dotarła po zwolnieniu zarezerwowanego dla ciebie miejsca, a sesja była już pełna. Zwrot płatności jest w toku."
msgstr[1] "Płatność dotarła po zwolnieniu zarezerwowanych dla ciebie miejsc, a sesja była już pełna. Zwrot płatności jest w toku."
msgstr[2] "Płatność dotarła po zwolnieniu zarezerwowanych dla ciebie miejsc, a sesja była już pełna. Zwrot płatności jest w toku."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your seat was released"
msgid_plural "Your seats were released"
msgstr[0] "Twoje miejsce zostało zwolnione"
msgstr[1] "Twoje miejsca zostały zwolnione"
msgstr[2] "Twoje miejsca zostały zwolnione"
