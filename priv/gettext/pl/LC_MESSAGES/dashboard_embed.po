#: lib/tymeslot_web/live/dashboard/embed_settings/helpers.ex
#, elixir-autogen, elixir-format
msgid "Schedule a meeting"
msgstr "Zarezerwuj spotkanie"

#: lib/tymeslot_web/live/dashboard/embed_settings/security_section.ex
#, elixir-autogen, elixir-format
msgid "%{action} to block all embedding (default)"
msgstr "%{action}, aby zablokować osadzanie wszędzie (domyślnie)"

#: lib/tymeslot_web/live/dashboard/embed_settings/security_section.ex
#, elixir-autogen, elixir-format
msgid "%{action} to enable and restrict embedding to only those sites"
msgstr "%{action}, aby włączyć osadzanie i ograniczyć je tylko do tych witryn"

#: lib/tymeslot_web/live/dashboard/embed_settings/security_section.ex
#, elixir-autogen, elixir-format
msgid "Adding %{domain} automatically allows %{www_domain} too (and vice versa)"
msgstr "Dodanie %{domain} automatycznie dopuszcza też %{www_domain} (i odwrotnie)"

#: lib/tymeslot_web/live/dashboard/embed_settings/security_section.ex
#, elixir-autogen, elixir-format
msgid "Enter a domain and press enter to add it. Don't include %{scheme} or paths."
msgstr "Wpisz domenę i naciśnij Enter, aby ją dodać. Nie podawaj %{scheme} ani ścieżek."

#: lib/tymeslot_web/live/dashboard/embed_settings/security_section.ex
#, elixir-autogen, elixir-format
msgid "For security, %{emphasis} to only specific domains you trust. This prevents your booking page from appearing on unauthorized websites."
msgstr "Ze względów bezpieczeństwa %{emphasis} tylko do wybranych domen, którym ufasz. Dzięki temu Twoja strona rezerwacji nie pojawi się na nieuprawnionych witrynach."

#: lib/tymeslot_web/live/dashboard/embed_settings/options_grid.ex
#, elixir-autogen, elixir-format
msgid "Need help? See the %{guide} for step-by-step instructions, platform tips, and customization options."
msgstr "Potrzebujesz pomocy? Instrukcje krok po kroku, wskazówki dla poszczególnych platform i opcje dostosowania znajdziesz tutaj: %{guide}."

#: lib/tymeslot_web/live/dashboard/embed_settings/security_section.ex
#, elixir-autogen, elixir-format
msgid "Use %{wildcard} to allow all subdomains"
msgstr "Użyj %{wildcard}, aby dopuścić wszystkie subdomeny"

#: lib/tymeslot_web/live/dashboard/embed_settings/options_grid.ex
#, elixir-autogen, elixir-format
msgid "A floating button stays visible as visitors scroll - like a chat widget, but for booking."
msgstr "Pływający przycisk jest widoczny przez cały czas przewijania – jak widget czatu, tylko do rezerwacji."

#: lib/tymeslot_web/live/dashboard/embed_settings/options_grid.ex
#, elixir-autogen, elixir-format
msgid "Auto - visitor's browser"
msgstr "Automatycznie – przeglądarka odwiedzającego"

#: lib/tymeslot_web/live/dashboard/embed_settings/options_grid.ex
#, elixir-autogen, elixir-format
msgid "Column - wide canvas, fills the container (recommended)"
msgstr "Kolumna – szeroki obszar, wypełnia kontener (zalecane)"

#: lib/tymeslot_web/live/dashboard/embed_settings/options_grid.ex
#, elixir-autogen, elixir-format
msgid "Column adapts to any container width. Default centres the booker - useful when you want a self-contained card inside a wide page."
msgstr "Kolumna dopasowuje się do dowolnej szerokości kontenera. Układ domyślny wyśrodkowuje formularz rezerwacji – przydaje się, gdy chcesz mieć zwartą kartę wewnątrz szerokiej strony."

#: lib/tymeslot_web/live/dashboard/embed_settings/options_grid.ex
#, elixir-autogen, elixir-format
msgid "Default - centred with a ~640px cap (standalone-style)"
msgstr "Domyślnie – wyśrodkowane z limitem ok. 640px (jak strona samodzielna)"

#: lib/tymeslot_web/live/dashboard/embed_settings/options_grid.ex
#, elixir-autogen, elixir-format
msgid "Install the official Tymeslot plugin to embed your booking page with a block or shortcode - no code."
msgstr "Zainstaluj oficjalną wtyczkę Tymeslot, aby osadzić stronę rezerwacji blokiem lub shortcode'em – bez kodu."

#: lib/tymeslot_web/live/dashboard/embed_settings/options_grid.ex
#, elixir-autogen, elixir-format
msgid "Updates every snippet below. Defaults work for most embeds - adjust when your site needs them."
msgstr "Aktualizuje wszystkie fragmenty kodu poniżej. Wartości domyślne sprawdzają się w większości osadzeń – zmień je, jeśli Twoja witryna tego wymaga."

#: lib/tymeslot_web/live/dashboard/embed_settings/live_preview.ex
#, elixir-autogen, elixir-format
msgid "Booking Preview"
msgstr "Podgląd rezerwacji"

#: lib/tymeslot_web/live/dashboard/embed_settings/live_preview.ex
#, elixir-autogen, elixir-format
msgid "Booking widget is still loading. Please try again in a second."
msgstr "Widget rezerwacji jeszcze się wczytuje. Spróbuj ponownie za chwilę."

#: lib/tymeslot_web/live/dashboard/embed_settings/live_preview.ex
#, elixir-autogen, elixir-format
msgid "Click to test the booking modal"
msgstr "Kliknij, aby przetestować okno rezerwacji"

#: lib/tymeslot_web/live/dashboard/embed_settings/live_preview.ex
#, elixir-autogen, elixir-format
msgid "Preview only: this link opens in test mode and stops working after an hour. Copy the link to share from the Embed Options tab."
msgstr "Tylko podgląd: ten link otwiera się w trybie testowym i przestaje działać po godzinie. Link do udostępniania skopiujesz w zakładce Opcje osadzania."

#: lib/tymeslot_web/live/dashboard/embed_settings/live_preview.ex
#, elixir-autogen, elixir-format
msgid "The preview is disabled because your booking link is currently deactivated."
msgstr "Podgląd jest wyłączony, bo Twój link do rezerwacji jest obecnie nieaktywny."
