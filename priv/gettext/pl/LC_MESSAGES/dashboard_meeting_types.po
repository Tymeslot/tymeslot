#: lib/tymeslot_web/live/dashboard/meeting_settings/components/scheduling_settings.ex
#: lib/tymeslot_web/live/dashboard/meeting_settings/scheduling_settings_component.ex
#, elixir-autogen, elixir-format
msgid "Booking Limits"
msgstr "Limity rezerwacji"

#: lib/tymeslot_web/live/dashboard/meeting_settings/scheduling_settings_component.ex
#, elixir-autogen, elixir-format
msgid "Booking limit must be between 1 and 500"
msgstr "Limit rezerwacji musi mieścić się w przedziale od 1 do 500"

#: lib/tymeslot_web/live/dashboard/meeting_settings/scheduling_settings_component.ex
#, elixir-autogen, elixir-format
