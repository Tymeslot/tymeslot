#, elixir-autogen, elixir-format
msgid "Booking limit updated to %{limit} bookings"
msgstr "Limit rezerwacji zmieniony na %{limit}"

#: lib/tymeslot_web/live/dashboard/meeting_settings/components/scheduling_settings.ex
#, elixir-autogen, elixir-format
msgid "Maximum number of bookings you accept across all meeting types. Days at their cap disappear from your booking page. Leave a field empty for no limit."
msgstr "Maksymalna liczba rezerwacji, jakie przyjmujesz łącznie we wszystkich typach spotkań. Dni, które osiągną limit, znikają ze strony rezerwacji. Zostaw pole puste, aby nie ustawiać limitu."

#: lib/tymeslot_web/live/dashboard/meeting_settings/components/scheduling_settings.ex
#, elixir-autogen, elixir-format
msgid "No limit"
msgstr "Bez limitu"

#: lib/tymeslot_web/live/dashboard/meeting_settings/components/scheduling_settings.ex
#, elixir-autogen, elixir-format
msgid "Per day"
msgstr "Dziennie"

#: lib/tymeslot_web/live/dashboard/meeting_settings/components/scheduling_settings.ex
#, elixir-autogen, elixir-format
msgid "Per month"
msgstr "Miesięcznie"

#: lib/tymeslot_web/live/dashboard/meeting_settings/components/scheduling_settings.ex
#, elixir-autogen, elixir-format
msgid "Per week"
msgstr "Tygodniowo"

