#, elixir-autogen, elixir-format
msgid "The calendar this meeting type books into is no longer on the connected account. Edit it and choose another calendar."
msgstr "Kalendarza, w którym ten typ spotkania rezerwuje terminy, nie ma już na podłączonym koncie. Edytuj go i wybierz inny kalendarz."

#: lib/tymeslot_web/live/dashboard/meeting_settings/card.ex
#, elixir-autogen, elixir-format
msgid "This meeting type books into a calendar you can no longer write to. Edit it and choose another calendar."
msgstr "Ten typ spotkania rezerwuje terminy w kalendarzu, do którego nie masz już prawa zapisu. Edytuj go i wybierz inny kalendarz."
