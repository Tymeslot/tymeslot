msgstr "Nie można zmienić terminu wygasłego spotkania"

#: lib/tymeslot_web/live/meeting_request_live.ex
#, elixir-autogen, elixir-format
msgid "That time has since been booked by somebody else, so this request can no longer be approved."
msgstr "Ten termin zajął już ktoś inny, więc tej prośby nie można już zatwierdzić."

#: lib/tymeslot_web/themes/quill/scheduling/components/schedule/panels.ex
