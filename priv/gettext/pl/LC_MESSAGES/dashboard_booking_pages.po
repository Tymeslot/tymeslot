#: lib/tymeslot/booking_pages/access.ex
#, elixir-autogen, elixir-format
msgid "This booking page is read-only on your current plan. Upgrade to change it."
msgstr "Ta strona rezerwacji jest w twoim obecnym planie tylko do odczytu. Przejdź na wyższy plan, aby ją zmienić."

#: lib/tymeslot_web/components/dashboard/booking_pages/delete_page_modal.ex
#, elixir-autogen, elixir-format
msgid "This meeting type is listed only on this page and will be unlisted everywhere, bookable only by its direct link:"
msgid_plural "These meeting types are listed only on this page and will be unlisted everywhere, bookable only by their direct links:"
msgstr[0] "Ten typ spotkania jest wyświetlany tylko na tej stronie i zostanie ukryty wszędzie; będzie można go zarezerwować tylko przez bezpośredni link:"
msgstr[1] "Te typy spotkań są wyświetlane tylko na tej stronie i zostaną ukryte wszędzie; będzie można je zarezerwować tylko przez ich bezpośrednie linki:"
msgstr[2] "Te typy spotkań są wyświetlane tylko na tej stronie i zostaną ukryte wszędzie; będzie można je zarezerwować tylko przez ich bezpośrednie linki:"

#: lib/tymeslot_web/live/dashboard/theme_settings/page_settings_component.ex
#, elixir-autogen, elixir-format
msgid "This page is a draft: visitors cannot open it yet. It goes live once it lists a meeting type that can be booked. Until then, only you can see it through Live Preview."
msgstr "Ta strona jest wersją roboczą: odwiedzający nie mogą jeszcze jej otworzyć. Zostanie opublikowana, gdy znajdzie się na niej typ spotkania, który można zarezerwować. Do tego czasu widzisz ją tylko ty, w podglądzie na żywo."

#: lib/tymeslot_web/live/dashboard/theme_settings_component.ex
#, elixir-autogen, elixir-format
msgid "This page is read-only on your current plan. It stays published and bookable, and you can still delete it. To change it, upgrade your plan."
msgstr "Ta strona jest w twoim obecnym planie tylko do odczytu. Pozostaje opublikowana i można na niej rezerwować, a nadal możesz ją usunąć. Aby ją zmienić, przejdź na wyższy plan."

#: lib/tymeslot_web/live/dashboard/theme_settings/page_settings_component.ex
#, elixir-autogen, elixir-format
msgid "You can change the address at any time: the old one keeps leading to this page."
msgstr "Adres możesz zmienić w dowolnym momencie: stary nadal będzie prowadzić do tej strony."

#: lib/tymeslot_web/live/dashboard/theme_settings/pages_component.ex
#, elixir-autogen, elixir-format
msgid "Your main page is included in every plan. Extra booking pages need an upgraded plan."
msgstr "Strona główna jest w każdym planie. Dodatkowe strony rezerwacji wymagają wyższego planu."

#: lib/tymeslot_web/components/dashboard/booking_pages/new_page_modal.ex
#: lib/tymeslot_web/live/dashboard/theme_settings/page_settings_component.ex
#, elixir-autogen, elixir-format
msgid "For you only: it labels the page in your dashboard."
msgstr "Widzisz ją tylko ty: pod tą nazwą strona widnieje w panelu."
