#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "If need be"
msgstr "W razie potrzeby"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "No"
msgstr "Nie"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "One of the selected times is no longer available. Please refresh and try again."
msgstr "Jeden z wybranych terminów nie jest już dostępny. Odśwież stronę i spróbuj ponownie."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "One of your responses wasn't recognised. Please refresh and try again."
msgstr "Jednej z odpowiedzi nie udało się rozpoznać. Odśwież stronę i spróbuj ponownie."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please check your name and email, then try again."
msgstr "Sprawdź imię i adres e-mail, a potem spróbuj ponownie."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Save my responses"
msgstr "Zapisz moje odpowiedzi"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Scheduled for %{time}"
msgstr "Ustalony termin: %{time}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Security verification failed. Please try again."
msgstr "Weryfikacja zabezpieczeń nie powiodła się. Spróbuj ponownie."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Security verification is currently unavailable. This may be caused by JavaScript being disabled, browser privacy extensions (Privacy Badger, uBlock Origin, etc.), or network security policies. Please adjust your settings or contact support if the problem persists."
msgstr "Weryfikacja zabezpieczeń jest w tej chwili niedostępna. Przyczyną może być wyłączony JavaScript, rozszerzenia chroniące prywatność (Privacy Badger, uBlock Origin itp.) lub zasady bezpieczeństwa sieci. Zmień ustawienia lub skontaktuj się z pomocą techniczną, jeśli problem się powtarza."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This poll has been cancelled and is no longer accepting responses."
msgstr "Ta ankieta została odwołana i nie przyjmuje już odpowiedzi."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This poll has been scheduled."
msgstr "Termin z tej ankiety został już ustalony."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "This poll has reached its participant limit."
msgstr "Ta ankieta osiągnęła limit uczestników."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Times shown in %{timezone}"
msgstr "Godziny w strefie %{timezone}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Too many attempts. Please wait a moment and try again."
msgstr "Zbyt wiele prób. Odczekaj chwilę i spróbuj ponownie."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting as %{name}"
msgstr "Głosujesz jako %{name}"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting closes %{deadline}"
msgstr "Koniec głosowania: %{deadline}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Voting has closed for this poll."
msgstr "Głosowanie w tej ankiecie zostało zakończone."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting has closed. Here are the final responses."
msgstr "Głosowanie zakończone. Oto ostateczne odpowiedzi."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Yes"
msgstr "Tak"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Your email"
msgstr "Twój adres e-mail"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Your name"
msgstr "Twoje imię i nazwisko"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Your responses have been saved."
msgstr "Odpowiedzi zostały zapisane."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Email me my voting link"
msgstr "Wyślij mi link do głosowania"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Enter your name and email and we'll send you a personal link to vote with. Voted before? Enter the same email to get your link again."
msgstr "Podaj imię i adres e-mail, a wyślemy ci osobisty link do głosowania. Ten adres był już użyty? Podaj go ponownie, aby otrzymać link jeszcze raz."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Nothing there after a few minutes? Check your spam folder."
msgstr "Po kilku minutach nadal nic nie ma? Sprawdź folder ze spamem."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please open the personal voting link we emailed you to vote."
msgstr "Aby zagłosować, otwórz osobisty link do głosowania wysłany e-mailem."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Save your responses to confirm your email address. They count from then on."
msgstr "Zapisz odpowiedzi, aby potwierdzić adres e-mail. Od tej chwili będą liczone."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Thanks, your responses count now. We've emailed you a copy with your personal link."
msgstr "Dziękujemy, odpowiedzi są teraz liczone. Wysłaliśmy e-mailem kopię z osobistym linkiem."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This is your personal link. Please don't share it: anyone who has it can change your responses."
msgstr "To jest osobisty link. Nie udostępniaj go: każdy, kto go ma, może zmienić odpowiedzi."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "This poll is receiving a lot of requests right now. Please try again later."
msgstr "Ta ankieta otrzymuje teraz bardzo dużo zgłoszeń. Spróbuj ponownie później."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "This voting link is no longer valid. Please ask for a new one on the poll's page."
msgstr "Ten link do głosowania jest już nieważny. Poproś o nowy na stronie ankiety."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please enter your name, then save your responses again."
msgstr "Podaj imię, a potem zapisz odpowiedzi jeszcze raz."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "New"
msgstr "Nowy"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This address is already on the poll, and its voting link was sent a few minutes ago. Please check that inbox, including the spam folder."
msgstr "Ten adres jest już dodany do ankiety, a link do głosowania został na niego wysłany kilka minut temu. Sprawdź tę skrzynkę, także folder ze spamem."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This address is already on the poll; we've sent its voting link again."
msgstr "Ten adres jest już dodany do ankiety; wysłaliśmy na niego link do głosowania jeszcze raz."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "We've sent a personal voting link to the address you entered. Open it to vote; your responses count once you save them there."
msgstr "Na podany adres wysłaliśmy osobisty link do głosowania. Otwórz go, aby zagłosować; odpowiedzi zostaną uwzględnione, gdy je tam zapiszesz."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "You're voting with your personal link."
msgstr "Głosujesz przez swój osobisty link."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please enter your email address."
msgstr "Podaj adres e-mail."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please enter your name."
msgstr "Podaj imię i nazwisko."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This poll is by invitation only. Use the personal link from your email to vote."
msgstr "Ta ankieta jest tylko dla zaproszonych osób. Aby zagłosować, użyj osobistego linku z e-maila."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Too many emails to this address recently; try again later."
msgstr "Na ten adres wysłano ostatnio zbyt wiele e-maili. Spróbuj ponownie później."
