#, elixir-autogen, elixir-format
msgid "The meeting with %{organizer} that %{booker} invited you to has been cancelled."
msgstr "Spotkanie, na które zaprasza cię %{booker} (organizator: %{organizer}), zostało odwołane."

#: lib/tymeslot/emails/templates/external_booking_change.ex
#, elixir-autogen, elixir-format
msgid "Their guest was emailed too."
msgid_plural "Their %{count} guests were emailed too."
msgstr[0] "Gość również otrzymał wiadomość e-mail."
msgstr[1] "%{count} goście również otrzymali wiadomość e-mail."
msgstr[2] "%{count} gości również otrzymało wiadomość e-mail."

#: lib/tymeslot/emails/templates/external_booking_change.ex
#, elixir-autogen, elixir-format
msgid "This group meeting was <strong>rescheduled in your external calendar</strong>. Tymeslot still shows the original time above, and its participants still expect it. To keep the original time, move the event back in your calendar. To change it, send the participants a reschedule request from your dashboard, or cancel the meeting there so every participant is notified."
msgstr "To spotkanie grupowe zostało <strong>przeniesione w zewnętrznym kalendarzu</strong>. Tymeslot wciąż pokazuje powyżej pierwotny termin, a uczestnicy nadal na niego liczą. Aby zachować pierwotny termin, przenieś wydarzenie z powrotem w swoim kalendarzu. Aby go zmienić, wyślij uczestnikom prośbę o zmianę terminu z panelu lub odwołaj tam spotkanie, aby każdy uczestnik został powiadomiony."

#: lib/tymeslot/emails/templates/external_booking_change.ex
#, elixir-autogen, elixir-format
msgid "This meeting was <strong>removed from your external calendar</strong> but is still active in Tymeslot. If the meeting is no longer happening, please cancel it in Tymeslot so the attendee is notified and the time slot is freed up."
msgstr "To spotkanie zostało <strong>usunięte z zewnętrznego kalendarza</strong>, ale w Tymeslot jest nadal aktywne. Jeśli spotkanie się nie odbędzie, odwołaj je w Tymeslot – uczestnik dostanie powiadomienie, a termin znów będzie wolny."

#: lib/tymeslot/emails/templates/external_booking_change.ex
#, elixir-autogen, elixir-format
msgid "This notification was triggered automatically when a change was detected in your external calendar."
msgstr "To powiadomienie zostało wysłane automatycznie po wykryciu zmiany w zewnętrznym kalendarzu."

#: lib/tymeslot/emails/templates/appointment_cancellation.ex
