#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Cancel this date? %{count} person is booked and will be told."
msgid_plural "Cancel this date? %{count} people are booked and will be told."
msgstr[0] "Odwołać ten termin? Zapisana jest %{count} osoba – dostanie powiadomienie."
msgstr[1] "Odwołać ten termin? Zapisane są %{count} osoby – dostaną powiadomienie."
msgstr[2] "Odwołać ten termin? Zapisanych jest %{count} osób – dostaną powiadomienie."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Create the meeting type to plan its dates."
msgstr "Utwórz typ spotkania, aby zaplanować jego terminy."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Date"
msgstr "Data"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Edit this date"
msgstr "Edytuj ten termin"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/session_handlers.ex
#, elixir-autogen, elixir-format
msgid "Enter the date and time of the session."
msgstr "Podaj datę i godzinę sesji."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/offered_time_handlers.ex
#, elixir-autogen, elixir-format
msgid "Enter the date and time to offer."
msgstr "Podaj datę i godzinę, którą chcesz zaoferować."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Instead of times from the availability schedule, bookers choose from dates you set. With group bookings, each date is a session on your calendar at once. Without them, each is a time one person can book, as long as your calendar is free then."
msgstr "Zamiast godzin z harmonogramu dostępności osoby rezerwujące wybierają spośród ustalonych przez ciebie terminów. Przy rezerwacjach grupowych każdy termin to sesja, która od razu trafia do kalendarza. Bez nich każdy termin może zarezerwować jedna osoba, o ile masz wtedy wolny kalendarz."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Keep it"
msgstr "Zostaw"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Leave the registration close empty to take sign-ups until the start. A time already past closes registration now."
msgstr "Pozostaw koniec zapisów pusty, aby przyjmować zapisy do początku. Godzina, która już minęła, od razu zamyka zapisy."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Moving the date emails the %{count} person booked on it the new time."
msgid_plural "Moving the date emails the %{count} people booked on it the new time."
msgstr[0] "Po przesunięciu terminu %{count} zapisana osoba dostanie e-mail z nową godziną."
msgstr[1] "Po przesunięciu terminu %{count} zapisane osoby dostaną e-mail z nową godziną."
msgstr[2] "Po przesunięciu terminu %{count} zapisanych osób dostanie e-mail z nową godziną."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "No dates planned yet."
msgstr "Nie zaplanowano jeszcze terminów."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "No times offered yet."
msgstr "Nie oferujesz jeszcze żadnych terminów."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Offer fixed dates only"
msgstr "Oferuj tylko stałe terminy"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Registration closes"
msgstr "Koniec zapisów"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Registration closes (optional)"
msgstr "Koniec zapisów (opcjonalnie)"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/session_handlers.ex
#, elixir-autogen, elixir-format
msgid "Registration has to close in the future, and no later than the session starts."
msgstr "Koniec zapisów musi przypadać w przyszłości i nie później niż początek sesji."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Remove this time"
msgstr "Usuń ten termin"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Save"
msgstr "Zapisz"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/session_handlers.ex
#, elixir-autogen, elixir-format
msgid "The date could not be planned. Please try again."
msgstr "Nie udało się zaplanować terminu. Spróbuj ponownie."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/session_handlers.ex
#, elixir-autogen, elixir-format
msgid "The date has to lie in the future."
msgstr "Termin musi przypadać w przyszłości."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/offered_time_handlers.ex
#, elixir-autogen, elixir-format
msgid "The time could not be added. Please try again."
msgstr "Nie udało się dodać terminu. Spróbuj ponownie."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/offered_time_handlers.ex
#, elixir-autogen, elixir-format
msgid "The time has to lie in the future."
msgstr "Termin musi przypadać w przyszłości."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/session_handlers.ex
#, elixir-autogen, elixir-format
msgid "This date has already started."
msgstr "Ten termin już się rozpoczął."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Time"
msgstr "Godzina"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Times are in your time zone, %{timezone}."
msgstr "Godziny w strefie czasowej: %{timezone}."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Times are in your time zone, %{timezone}. A booked time stops being offered, and is offered again if that booking is cancelled."
msgstr "Godziny w strefie czasowej: %{timezone}. Zarezerwowany termin przestaje być oferowany i wraca do oferty, jeśli ta rezerwacja zostanie odwołana."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/session_handlers.ex
#, elixir-autogen, elixir-format
msgid "Turn on fixed dates and group bookings first."
msgstr "Najpierw włącz stałe terminy i rezerwacje grupowe."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/offered_time_handlers.ex
#, elixir-autogen, elixir-format
msgid "Turn on fixed dates, without group bookings, to offer times."
msgstr "Włącz stałe terminy bez rezerwacji grupowych, aby móc oferować konkretne godziny."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/session_handlers.ex
#, elixir-autogen, elixir-format
msgid "You already have a booking at that time."
msgstr "O tej godzinie masz już rezerwację."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/offered_time_handlers.ex
#, elixir-autogen, elixir-format
msgid "You already offer that time."
msgstr "Ten termin już oferujesz."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "registration closed"
msgstr "zapisy zamknięte"

