msgstr[0] "Wysłano %{count} minutę temu"
msgstr[1] "Wysłano %{count} minuty temu"
msgstr[2] "Wysłano %{count} minut temu"

#: lib/tymeslot_web/live/account_live/components.ex
#, elixir-autogen, elixir-format
