#, elixir-autogen, elixir-format
msgid "Your upcoming bookings will be deleted from Tymeslot. Your guests will not be notified."
msgstr "Nadchodzące rezerwacje zostaną usunięte z Tymeslot. Goście nie zostaną o tym powiadomieni."

#: lib/tymeslot_web/live/account_live/danger_zone.ex
#, elixir-autogen, elixir-format
msgid "If you delete your account, it is frozen for %{count} day, then deleted. Sign in during that time to restore it."
msgid_plural "If you delete your account, it is frozen for %{count} days, then deleted. Sign in during that time to restore it."
msgstr[0] "Jeśli usuniesz konto, zostanie ono zamrożone na %{count} dzień, po czym zostanie usunięte. Zaloguj się w tym czasie, aby je przywrócić."
msgstr[1] "Jeśli usuniesz konto, zostanie ono zamrożone na %{count} dni, po czym zostanie usunięte. Zaloguj się w tym czasie, aby je przywrócić."
msgstr[2] "Jeśli usuniesz konto, zostanie ono zamrożone na %{count} dni, po czym zostanie usunięte. Zaloguj się w tym czasie, aby je przywrócić."

#: lib/tymeslot_web/live/account_live/components.ex
#, elixir-autogen, elixir-format
msgid "Sent %{count} day ago"
msgid_plural "Sent %{count} days ago"
msgstr[0] "Wysłano %{count} dzień temu"
msgstr[1] "Wysłano %{count} dni temu"
msgstr[2] "Wysłano %{count} dni temu"

#: lib/tymeslot_web/live/account_live/components.ex
#, elixir-autogen, elixir-format
msgid "Sent %{count} hour ago"
msgid_plural "Sent %{count} hours ago"
msgstr[0] "Wysłano %{count} godzinę temu"
msgstr[1] "Wysłano %{count} godziny temu"
