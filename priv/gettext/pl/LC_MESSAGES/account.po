#, elixir-autogen, elixir-format
msgid "Type your email address to confirm"
msgstr "Aby potwierdzić, wpisz swój adres e-mail"

#: lib/tymeslot_web/live/account_live/delete_account_modal.ex
#, elixir-autogen, elixir-format
msgid "Until then it is frozen and your booking page is offline. Sign in before that date to restore it."
msgstr "Do tego czasu konto jest zamrożone, a strona rezerwacji jest offline. Zaloguj się przed tą datą, aby je przywrócić."

#: lib/tymeslot_web/live/account_live/danger_zone.ex
#, elixir-autogen, elixir-format
msgid "Upcoming bookings are deleted from Tymeslot and your guests are not notified."
msgstr "Nadchodzące rezerwacje są usuwane z Tymeslot, a goście nie są o tym powiadamiani."

#: lib/tymeslot_web/live/account_live/delete_account_modal.ex
#, elixir-autogen, elixir-format
msgid "Why are you leaving? (optional)"
msgstr "Dlaczego odchodzisz? (opcjonalnie)"

#: lib/tymeslot_web/live/account_live/delete_account_modal.ex
#, elixir-autogen, elixir-format
msgid "Your account and everything in it will be deleted immediately. This cannot be undone."
msgstr "Konto wraz z całą zawartością zostanie natychmiast usunięte. Tej operacji nie można cofnąć."

#: lib/tymeslot_web/live/account_live/handlers.ex
#, elixir-autogen, elixir-format
msgid "Your account has been deleted."
msgstr "Konto zostało usunięte."

