msgstr "Liczba uczestników na termin: od %{min} do %{max}."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_bookings_section.ex
#, elixir-autogen, elixir-format
msgid "Group bookings"
msgstr "Rezerwacje grupowe"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_bookings_section.ex
#, elixir-autogen, elixir-format
msgid "Let multiple people book the same time slot"
msgstr "Pozwól kilku osobom zarezerwować ten sam termin"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_bookings_section.ex
#, elixir-autogen, elixir-format
msgid "Participant limit"
msgstr "Limit uczestników"

#: lib/tymeslot/meeting_types/input_validation.ex
#, elixir-autogen, elixir-format
msgid "Participant limit cannot exceed %{max}"
msgstr "Limit uczestników nie może przekraczać %{max}"

#: lib/tymeslot/meeting_types/input_validation.ex
#, elixir-autogen, elixir-format
msgid "Participant limit must be a valid number"
msgstr "Limit uczestników musi być prawidłową liczbą"

#: lib/tymeslot/meeting_types/input_validation.ex
#, elixir-autogen, elixir-format
msgid "Participant limit must be at least %{min}"
msgstr "Limit uczestników musi wynosić co najmniej %{min}"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/payments_section.ex
#, elixir-autogen, elixir-format
msgid "Turn off group bookings to require payment."
msgstr "Wyłącz rezerwacje grupowe, aby wymagać płatności."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_bookings_section.ex
#, elixir-autogen, elixir-format
msgid "Turn off payments to enable group bookings."
msgstr "Wyłącz płatności, aby włączyć rezerwacje grupowe."

#: lib/tymeslot_web/helpers/context_errors.ex
#, elixir-autogen, elixir-format
msgid "Group bookings are not included in your current plan."
msgstr "Rezerwacje grupowe nie są dostępne w Twoim obecnym planie."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_rules.ex
#, elixir-autogen, elixir-format
msgid "Group bookings cannot ask each booker for their phone number. Edit the location to publish a number for them to call instead."
msgstr "Rezerwacje grupowe nie mogą prosić każdej rezerwującej osoby o numer telefonu. Edytuj lokalizację i zamiast tego podaj numer, pod który mogą zadzwonić."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_rules.ex
#, elixir-autogen, elixir-format
msgid "Group bookings need a single video provider. Edit the location so it uses just one."
msgstr "Rezerwacje grupowe wymagają jednego dostawcy wideo. Edytuj lokalizację, aby korzystała tylko z jednego."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_rules.ex
#, elixir-autogen, elixir-format
msgid "Group bookings need exactly one location, so everyone in a slot meets in the same place. Remove the other locations to enable them."
msgstr "Rezerwacje grupowe wymagają dokładnie jednej lokalizacji, aby wszyscy w danym terminie spotkali się w tym samym miejscu. Usuń pozostałe lokalizacje, aby je włączyć."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_bookings_section.ex
#, elixir-autogen, elixir-format
msgid "Turn off approval to enable group bookings."
msgstr "Wyłącz zatwierdzanie, aby włączyć rezerwacje grupowe."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/approval_section.ex
#, elixir-autogen, elixir-format
msgid "Turn off group bookings to require approval."
msgstr "Wyłącz rezerwacje grupowe, aby wymagać zatwierdzania."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_bookings_section.ex
#, elixir-autogen, elixir-format
msgid "Each slot stays open until the participant limit is reached, and everyone booked into it meets together."
msgstr "Każdy termin pozostaje otwarty, dopóki nie zostanie osiągnięty limit uczestników, a wszyscy, którzy go zarezerwowali, spotykają się razem."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_rules.ex
#, elixir-autogen, elixir-format
msgid "Group bookings cannot ask each booker for their phone number. Turn this off and publish a number for them to call instead."
msgstr "Rezerwacje grupowe nie mogą prosić każdej rezerwującej osoby o numer telefonu. Wyłącz tę opcję i zamiast tego podaj numer, pod który mogą zadzwonić."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_rules.ex
#, elixir-autogen, elixir-format
msgid "Group bookings meet in one place. Keep just one saved location."
msgstr "Rezerwacje grupowe odbywają się w jednym miejscu. Zostaw tylko jedną zapisaną lokalizację."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_rules.ex
#, elixir-autogen, elixir-format
msgid "Group bookings need a single saved location. Edit the location so it names just one."
msgstr "Rezerwacje grupowe wymagają jednej zapisanej lokalizacji. Edytuj lokalizację, aby wskazywała tylko jedną."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_rules.ex
#, elixir-autogen, elixir-format
msgid "Group bookings need a single video provider. Keep just one."
msgstr "Rezerwacje grupowe wymagają jednego dostawcy wideo. Zostaw tylko jednego."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_rules.ex
#, elixir-autogen, elixir-format
msgid "Group bookings need exactly one location. Change the existing location instead of adding another."
msgstr "Rezerwacje grupowe wymagają dokładnie jednej lokalizacji. Zmień istniejącą lokalizację zamiast dodawać kolejną."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_rules.ex
#, elixir-autogen, elixir-format
msgid "Group bookings need the address up front. Choose one saved location."
msgstr "Rezerwacje grupowe wymagają adresu z góry. Wybierz jedną zapisaną lokalizację."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/group_rules.ex
#, elixir-autogen, elixir-format
msgid "Group bookings need the address up front. Edit the location and choose a saved location."
msgstr "Rezerwacje grupowe wymagają adresu z góry. Edytuj lokalizację i wybierz zapisaną lokalizację."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/slot_interval_field.ex
#, elixir-autogen, elixir-format
msgid "%{time} (+%{count} day)"
msgid_plural "%{time} (+%{count} days)"
msgstr[0] "%{time} (+%{count} dzień)"
msgstr[1] "%{time} (+%{count} dni)"
msgstr[2] "%{time} (+%{count} dni)"

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/payments_section.ex
#, elixir-autogen, elixir-format
msgid "Your Stripe account's currency, %{currency}, is not supported for meeting payments. Choose a supported currency on the %{payments_link} page to charge for this meeting type."
msgstr "Waluta konta Stripe (%{currency}) nie jest obsługiwana w płatnościach za spotkania. Wybierz obsługiwaną walutę na stronie %{payments_link}, aby pobierać opłaty za ten typ spotkania."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/payments_section.ex
#, elixir-autogen, elixir-format
msgid "Prices can no longer be set in your Stripe account's currency, %{currency}. Choose a supported currency on the %{payments_link} page to change what this meeting type charges."
msgstr "W walucie konta Stripe (%{currency}) nie można już ustawiać cen. Wybierz obsługiwaną walutę na stronie %{payments_link}, aby zmienić cenę tego typu spotkania."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/payments_section.ex
#, elixir-autogen, elixir-format
msgid "The current price is %{amount}. Switching to a supported currency clears it, as it clears every paid meeting type's price."
msgstr "Obecna cena to %{amount}. Po przejściu na obsługiwaną walutę zostanie usunięta, tak jak ceny wszystkich płatnych typów spotkań."

#: lib/tymeslot_web/helpers/context_errors.ex
#, elixir-autogen, elixir-format
msgid "The calendar this meeting type books into is no longer available. Reload the page and try again."
msgstr "Kalendarz, do którego trafiają rezerwacje tego typu spotkania, jest już niedostępny. Odśwież stronę i spróbuj ponownie."

