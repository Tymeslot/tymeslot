msgid "Resend email"
msgstr "Wyślij e-mail ponownie"

#: lib/tymeslot_web/themes/shared/components/verification_notice.ex
#, elixir-autogen, elixir-format
msgid "Sending…"
msgstr "Wysyłanie…"

#: lib/tymeslot_web/themes/shared/components/verification_notice.ex
#, elixir-autogen, elixir-format
msgid "Sent"
msgstr "Wysłano"

#: lib/tymeslot_web/themes/shared/components/verification_notice.ex
#, elixir-autogen, elixir-format
msgid "Sent again. It can take a minute to arrive."
msgstr "Wysłano ponownie. Wiadomość może dotrzeć dopiero za minutę."

#: lib/tymeslot_web/themes/shared/components/verification_notice.ex
#, elixir-autogen, elixir-format
msgid "The email could not be sent. Please try again."
msgstr "Nie udało się wysłać e-maila. Spróbuj ponownie."

#: lib/tymeslot_web/themes/shared/components/verification_notice.ex
#, elixir-autogen, elixir-format
msgid "The time was released because the booking was not confirmed in time. Please book again."
msgstr "Termin został zwolniony, bo rezerwacja nie została potwierdzona na czas. Zarezerwuj ponownie."

#: lib/tymeslot_web/themes/shared/components/verification_notice.ex
#, elixir-autogen, elixir-format
msgid "This booking is no longer waiting for your confirmation, so there is nothing to resend."
msgstr "Ta rezerwacja nie czeka już na twoje potwierdzenie, więc nie ma czego wysyłać ponownie."

#: lib/tymeslot_web/themes/shared/components/verification_notice.ex
#, elixir-autogen, elixir-format
msgid "Too many attempts. Try again in a moment."
msgstr "Zbyt wiele prób. Spróbuj ponownie za chwilę."

#: lib/tymeslot_web/themes/shared/components/verification_notice.ex
#, elixir-autogen, elixir-format
msgid "We cannot send the email again. If it has not arrived, check your spam folder."
msgstr "Nie możemy ponownie wysłać e-maila. Jeśli nie dotarł, sprawdź folder ze spamem."

#: lib/tymeslot_web/themes/shared/confirmation_text.ex
#, elixir-autogen, elixir-format
msgid "We have sent a link to %{email}. Click it by %{by_deadline} to confirm your booking. Until then the time is held for you."
msgstr "Wysłaliśmy link na adres %{email}. Kliknij go do %{by_deadline}, aby potwierdzić rezerwację. Do tego czasu trzymamy dla ciebie ten termin."

#: lib/tymeslot_web/themes/shared/components/verification_notice.ex
#, elixir-autogen, elixir-format
msgid "The organiser is changing this meeting's time, so the email cannot be sent again for now. You can try again while your place is held."
msgstr "Organizator zmienia termin tego spotkania, więc na razie nie można ponownie wysłać e-maila. Możesz spróbować ponownie, dopóki trzymamy dla ciebie miejsce."

#: lib/tymeslot_web/themes/shared/confirmation_text.ex
#, elixir-autogen, elixir-format
msgid "We have sent a link to %{email}. Click it by %{by_deadline} to confirm your booking. Until then your place is held for you."
msgstr "Wysłaliśmy link na adres %{email}. Kliknij go do %{by_deadline}, aby potwierdzić rezerwację. Do tego czasu trzymamy dla ciebie miejsce."

#: lib/tymeslot_web/themes/shared/components/verification_notice.ex
#, elixir-autogen, elixir-format
msgid "Your place was released because the booking was not confirmed in time. Please book again."
msgstr "Twoje miejsce zostało zwolnione, bo rezerwacja nie została potwierdzona na czas. Zarezerwuj ponownie."
