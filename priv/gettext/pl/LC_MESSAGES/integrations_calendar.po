msgstr "Nie znaleziono serwera Zimbra. Sprawdź adres serwera."

#: lib/tymeslot/integrations/calendar/shared/error_messages.ex
#, elixir-autogen, elixir-format
msgid "calendar provider"
msgstr "dostawca kalendarza"

#: lib/tymeslot/integrations/calendar/shared/error_messages.ex
#, elixir-autogen, elixir-format
msgid "iCloud requires an app-specific password. Generate one at appleid.apple.com under Sign-In and Security → App-Specific Passwords, and use it instead of your Apple ID password"
msgstr "iCloud wymaga hasła dla aplikacji. Wygeneruj je na appleid.apple.com w sekcji Logowanie i bezpieczeństwo → Hasła dla aplikacji i użyj go zamiast hasła do Apple ID"

#: lib/tymeslot/integrations/calendar/mailbox_org/provider.ex
#, elixir-autogen, elixir-format
msgid "mailbox.org CalDAV endpoint not found. Confirm the server URL is https://dav.mailbox.org"
msgstr "Nie znaleziono punktu końcowego CalDAV mailbox.org. Upewnij się, że adres serwera to https://dav.mailbox.org"

#: lib/tymeslot/integrations/calendar/caldav/family.ex
#, elixir-autogen, elixir-format
msgid "mailbox.org always uses this CalDAV server, so the address cannot be changed"
msgstr "mailbox.org zawsze korzysta z tego serwera CalDAV, dlatego adresu nie można zmienić"

#: lib/tymeslot/integrations/calendar/mailbox_org/provider.ex
#, elixir-autogen, elixir-format
