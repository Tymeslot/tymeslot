msgid "Self-hosted Nextcloud calendar sync"
msgstr "Synchronizacja kalendarza z własnym serwerem Nextcloud"

#: lib/tymeslot/integrations/calendar/credential_fields.ex
#, elixir-autogen, elixir-format
msgid "Server URL must be text"
msgstr "Adres serwera musi być tekstem"

#: lib/tymeslot/integrations/calendar/credential_fields.ex
#, elixir-autogen, elixir-format
msgid "Some calendar paths have invalid format. Use full URLs (https://...) or paths (/calendar/)"
msgstr "Niektóre ścieżki kalendarzy mają nieprawidłowy format. Użyj pełnych adresów (https://…) lub ścieżek (/calendar/)"

#: lib/tymeslot/integrations/calendar/providers/provider_config/metadata.ex
#, elixir-autogen, elixir-format
msgid "Subscribe to a published calendar feed, read-only"
msgstr "Subskrybuj opublikowany kanał kalendarza, tylko do odczytu"

#: lib/tymeslot/integrations/calendar/providers/provider_config/metadata.ex
#, elixir-autogen, elixir-format
msgid "Sync calendars from your Apple iCloud account"
msgstr "Synchronizuj kalendarze z konta Apple iCloud"

#: lib/tymeslot/integrations/calendar/providers/provider_config/metadata.ex
#, elixir-autogen, elixir-format
msgid "Sync calendars from your mailbox.org account"
msgstr "Synchronizuj kalendarze z konta mailbox.org"

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "That URL did not return a calendar feed. Make sure it points at an .ics file."
msgstr "Ten adres nie zwrócił kanału kalendarza. Upewnij się, że prowadzi do pliku .ics."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "That URL points at a blocked address and cannot be reached."
msgstr "Ten adres wskazuje na zablokowaną lokalizację i jest nieosiągalny."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "That calendar feed is too large to process."
msgstr "Ten kanał kalendarza jest zbyt duży, aby go przetworzyć."

#: lib/tymeslot/workers/sync_exchange_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "The Exchange server answered the free/busy request with nothing Tymeslot could read. Retrying rather than treating your diary as free."
msgstr "Serwer Exchange odpowiedział na zapytanie o zajętość czymś, czego Tymeslot nie potrafi odczytać. Ponawiamy próbę, zamiast uznawać kalendarz za wolny."

#: lib/tymeslot/workers/sync_exchange_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "The Exchange server rejected the request."
msgstr "Serwer Exchange odrzucił żądanie."

#: lib/tymeslot/workers/sync_exchange_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "The Exchange server rejected the stored credentials. Please reconnect the integration."
msgstr "Serwer Exchange odrzucił zapisane dane logowania. Połącz integrację ponownie."

#: lib/tymeslot/workers/renew_webhook_channels_worker.ex
#: lib/tymeslot/workers/sync_google_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "The booking calendar no longer exists on Google. Please reconnect the integration and choose a different calendar."
msgstr "Kalendarz rezerwacji już nie istnieje w Google. Połącz integrację ponownie i wybierz inny kalendarz."

#: lib/tymeslot/workers/renew_webhook_channels_worker.ex
#, elixir-autogen, elixir-format
msgid "The booking calendar no longer exists on Outlook. Please reconnect the integration and choose a different calendar."
msgstr "Kalendarz rezerwacji już nie istnieje w Outlooku. Połącz integrację ponownie i wybierz inny kalendarz."

#: lib/tymeslot/workers/sync_caldav_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "The booking calendar no longer exists on the CalDAV server. Please reconnect the integration and select a different calendar."
msgstr "Kalendarz rezerwacji już nie istnieje na serwerze CalDAV. Połącz integrację ponownie i wybierz inny kalendarz."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed URL returned 404. Check that the link is complete and still published."
msgstr "Adres kanału kalendarza zwrócił błąd 404. Sprawdź, czy link jest pełny i nadal opublikowany."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed came back empty, but the cache still holds previously synced events. Keeping the cache in place and retrying rather than emptying your diary."
msgstr "Kanał kalendarza zwrócił pusty wynik, ale w pamięci podręcznej nadal są wcześniej zsynchronizowane wydarzenia. Zachowujemy pamięć podręczną i ponawiamy próbę, zamiast opróżniać kalendarz."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed redirected too many times."
msgstr "Kanał kalendarza przekierowywał zbyt wiele razy."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed rejected the link. It may have been revoked or reset."
msgstr "Kanał kalendarza odrzucił ten link. Mógł zostać unieważniony lub zresetowany."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed returned HTTP %{status}."
msgstr "Kanał kalendarza zwrócił HTTP %{status}."

#: lib/tymeslot/integrations/calendar/ics/feed.ex
#, elixir-autogen, elixir-format
msgid "The calendar feed returned an error."
msgstr "Kanał kalendarza zwrócił błąd."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "The calendar server answered this address but does not accept calendar requests there. Please check the server URL."
msgstr "Serwer kalendarza odpowiedział pod tym adresem, ale nie przyjmuje tam żądań kalendarza. Sprawdź adres serwera."

#: lib/tymeslot/integrations/calendar/shared/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The calendar server at %{url} listed more items than Tymeslot can process at once. If this address points at a single calendar, enter your account's server address instead, and Tymeslot will find your calendars there."
msgstr "Serwer kalendarza pod adresem %{url} zwrócił listę z większą liczbą elementów, niż Tymeslot może przetworzyć naraz. Jeśli ten adres wskazuje pojedynczy kalendarz, podaj zamiast niego adres serwera swojego konta, a Tymeslot znajdzie na nim twoje kalendarze."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "The calendar server did not respond. Tymeslot will retry automatically."
msgstr "Serwer kalendarza nie odpowiedział. Tymeslot spróbuje ponownie automatycznie."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "The calendar server is rate-limiting Tymeslot. Tymeslot will retry automatically."
msgstr "Serwer kalendarza ogranicza liczbę żądań z Tymeslot. Tymeslot spróbuje ponownie automatycznie."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "The calendar server refused access to this calendar."
msgstr "Serwer kalendarza odmówił dostępu do tego kalendarza."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "The calendar server refused the request."
msgstr "Serwer kalendarza odrzucił żądanie."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "The calendar server rejected the stored credentials. Please reconnect the calendar."
msgstr "Serwer kalendarza odrzucił zapisane dane logowania. Połącz kalendarz ponownie."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "The calendar server reported an error. Tymeslot will retry automatically."
msgstr "Serwer kalendarza zgłosił błąd. Tymeslot spróbuje ponownie automatycznie."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "The calendar server returned a response Tymeslot could not understand."
msgstr "Serwer kalendarza zwrócił odpowiedź, której Tymeslot nie rozpoznał."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#: lib/tymeslot/integrations/calendar/shared/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The calendar server returned more data than Tymeslot can process at once."
msgstr "Serwer kalendarza zwrócił więcej danych, niż Tymeslot może przetworzyć naraz."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "The calendar server took too long to respond. Tymeslot will retry automatically."
msgstr "Serwer kalendarza odpowiadał zbyt długo. Tymeslot spróbuje ponownie automatycznie."

#: lib/tymeslot/integrations/calendar/shared/error_handler.ex
#, elixir-autogen, elixir-format
msgid "The calendar service encountered an error. Please try again later."
msgstr "W usłudze kalendarza wystąpił błąd. Spróbuj ponownie później."

#: lib/tymeslot/integrations/calendar/shared/error_handler.ex
#, elixir-autogen, elixir-format
msgid "The calendar service is temporarily unavailable. Please try again later."
msgstr "Usługa kalendarza jest chwilowo niedostępna. Spróbuj ponownie później."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "The event changed on the calendar server since Tymeslot last synced it."
msgstr "Wydarzenie zmieniło się na serwerze kalendarza od ostatniej synchronizacji przez Tymeslot."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "The event no longer exists on the calendar server."
msgstr "Wydarzenie już nie istnieje na serwerze kalendarza."

#: lib/tymeslot/integrations/calendar/shared/error_handler.ex
#, elixir-autogen, elixir-format
msgid "The request timed out. Please try again."
msgstr "Upłynął limit czasu żądania. Spróbuj ponownie."

#: lib/tymeslot/integrations/calendar/shared/error_messages.ex
#, elixir-autogen, elixir-format
msgid "The server's TLS certificate was rejected. If it is self-signed or issued by an internal certificate authority, turn off certificate verification."
msgstr "Certyfikat TLS serwera został odrzucony. Jeśli jest podpisany samodzielnie lub wystawiony przez wewnętrzny urząd certyfikacji, wyłącz weryfikację certyfikatu."

#: lib/tymeslot/workers/sync_google_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "This Google account doesn't have Google Calendar enabled. Turn on Google Calendar for the account (a Google Workspace administrator may need to do this), or connect a different Google account."
msgstr "To konto Google nie ma włączonego Google Calendar. Włącz Google Calendar dla tego konta (może to wymagać administratora Google Workspace) albo podłącz inne konto Google."

#: lib/tymeslot/integrations/calendar/caldav/offline_queue.ex
#, elixir-autogen, elixir-format
msgid "This change is missing the event's start or end time, so it could not be sent to the calendar server."
msgstr "W tej zmianie brakuje godziny początku lub końca wydarzenia, więc nie udało się jej wysłać na serwer kalendarza."

#: lib/tymeslot/integrations/calendar/caldav/offline_queue.ex
#, elixir-autogen, elixir-format
msgid "This change was made to one occurrence of a repeating event, and the calendar server would have applied it to every occurrence, so it was not sent."
msgstr "Ta zmiana dotyczyła jednego wystąpienia wydarzenia cyklicznego, a serwer kalendarza zastosowałby ją do wszystkich wystąpień, więc nie została wysłana."

#: lib/tymeslot/integrations/calendar/shared/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Too many requests to %{provider}. Please wait a moment and try again"
msgstr "Zbyt wiele żądań (%{provider}). Odczekaj chwilę i spróbuj ponownie"

#: lib/tymeslot/integrations/calendar/shared/error_handler.ex
#, elixir-autogen, elixir-format
msgid "Too many requests. Please wait a moment and try again."
msgstr "Zbyt wiele żądań. Odczekaj chwilę i spróbuj ponownie."

#: lib/tymeslot/integrations/calendar/shared/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Try using an app password instead of your regular password. You can create one in Nextcloud's security settings"
msgstr "Spróbuj użyć hasła aplikacji zamiast zwykłego hasła. Utworzysz je w ustawieniach zabezpieczeń Nextcloud"

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "Tymeslot could not complete the request against the calendar server."
msgstr "Tymeslot nie zdołał wykonać żądania na serwerze kalendarza."

#: lib/tymeslot/integrations/calendar/caldav/errors.ex
#, elixir-autogen, elixir-format
msgid "Tymeslot could not reach the calendar server. Tymeslot will retry automatically."
msgstr "Tymeslot nie może połączyć się z serwerem kalendarza. Tymeslot spróbuje ponownie automatycznie."

#: lib/tymeslot/integrations/calendar/auth/jobs/token_refresh_job.ex
#, elixir-autogen, elixir-format
msgid "Tymeslot could not renew its access to this calendar. It will try again shortly."
msgstr "Tymeslot nie mógł odnowić dostępu do tego kalendarza. Spróbuje ponownie za chwilę."

#: lib/tymeslot/integrations/calendar/caldav/offline_queue.ex
#, elixir-autogen, elixir-format
msgid "Tymeslot could not send this change to the calendar server."
msgstr "Tymeslot nie zdołał wysłać tej zmiany na serwer kalendarza."

#: lib/tymeslot/workers/sync_exchange_calendar_worker.ex
#, elixir-autogen, elixir-format
msgid "Tymeslot needs the mailbox's email address to read its free/busy time. Please reconnect the integration and provide it."
msgstr "Tymeslot potrzebuje adresu e-mail skrzynki, aby odczytać jej zajętość. Połącz integrację ponownie i podaj ten adres."

#: lib/tymeslot/integrations/calendar/shared/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Unable to connect to %{provider}. Please check your network connection and server URL"
msgstr "Nie udało się połączyć (%{provider}). Sprawdź połączenie sieciowe i adres serwera"

#: lib/tymeslot/integrations/calendar/shared/error_handler.ex
#, elixir-autogen, elixir-format
msgid "Unable to connect to the calendar service. Please check the URL and try again."
msgstr "Nie udało się połączyć z usługą kalendarza. Sprawdź adres i spróbuj ponownie."

#: lib/tymeslot/integrations/calendar/display_helpers.ex
#, elixir-autogen, elixir-format
msgid "Unable to reach calendar service. Check your internet connection."
msgstr "Brak połączenia z usługą kalendarza. Sprawdź połączenie z internetem."

#: lib/tymeslot/integrations/calendar/providers/provider_config/metadata.ex
#, elixir-autogen, elixir-format
msgid "Universal CalDAV server support"
msgstr "Uniwersalna obsługa serwerów CalDAV"

