#: lib/tymeslot/integrations/calendar/shared/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Verify the Radicale URL including port if needed (e.g., https://radicale.example.com:5232)"
msgstr "Sprawdź adres Radicale wraz z portem, jeśli jest potrzebny (np. https://radicale.example.com:5232)"

#: lib/tymeslot/integrations/calendar/shared/error_messages.ex
#, elixir-autogen, elixir-format
msgid "Verify the URL format: https://your-domain.com (Nextcloud path will be added automatically)"
msgstr "Sprawdź format adresu: https://your-domain.com (ścieżka Nextcloud zostanie dodana automatycznie)"

