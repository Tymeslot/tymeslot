#, elixir-autogen, elixir-format
msgid "Stripe account disconnected."
msgstr "Konto Stripe odłączone."

#: lib/tymeslot_web/live/dashboard/payments_settings_component.ex
#, elixir-autogen, elixir-format
msgid "Stripe has not yet captured a charge for this booking. Try again in a moment."
msgstr "Stripe nie pobrał jeszcze opłaty za tę rezerwację. Spróbuj ponownie za chwilę."

#: lib/tymeslot_web/live/dashboard/payments_settings/status_card.ex
#, elixir-autogen, elixir-format
msgid "Stripe is reviewing your account. Charges switch on automatically once approved."
msgstr "Stripe weryfikuje Twoje konto. Po zatwierdzeniu obciążenia włączą się automatycznie."

#: lib/tymeslot_web/live/dashboard/payments_settings/refund_modal.ex
#, elixir-autogen, elixir-format
msgid "The attendee receives the full amount you refund. Tymeslot's platform fee is reversed proportionally; Stripe processing fees on the original charge stay with you."
msgstr "Uczestnik otrzymuje pełną zwracaną kwotę. Prowizja platformy Tymeslot jest cofana proporcjonalnie; opłaty Stripe za obsługę pierwotnej płatności pozostają po Twojej stronie."

#: lib/tymeslot_web/live/dashboard/payments_settings_component.ex
#, elixir-autogen, elixir-format
msgid "This booking has not been paid yet, so it cannot be refunded."
msgstr "Ta rezerwacja nie została jeszcze opłacona, więc nie można wykonać zwrotu."

#: lib/tymeslot_web/live/dashboard/payments_settings_component.ex
#, elixir-autogen, elixir-format
msgid "This payment can no longer be refunded from Tymeslot. Refunds older than 60 days must be processed in your Stripe dashboard."
msgstr "Tej płatności nie można już zwrócić z poziomu Tymeslot. Zwroty starsze niż 60 dni trzeba wykonać w panelu Stripe."

#: lib/tymeslot_web/live/dashboard/payments_settings_component.ex
#, elixir-autogen, elixir-format
msgid "This payment has already been fully refunded."
msgstr "Ta płatność została już w całości zwrócona."

#: lib/tymeslot_web/live/dashboard/payments_settings_component.ex
#, elixir-autogen, elixir-format
msgid "This payment is under dispute and must be handled in your Stripe dashboard."
msgstr "Ta płatność jest przedmiotem sporu i trzeba się nią zająć w panelu Stripe."

#: lib/tymeslot_web/live/dashboard/payments_settings/lifetime_stats.ex
#, elixir-autogen, elixir-format
msgid "Total received"
msgstr "Łącznie otrzymano"

#: lib/tymeslot_web/live/dashboard/payments_settings/disconnect_modal.ex
#, elixir-autogen, elixir-format
msgid "You have %{count} pending booking awaiting payment. Disconnecting will cancel it."
msgid_plural "You have %{count} pending bookings awaiting payment. Disconnecting will cancel them."
msgstr[0] "Masz %{count} rezerwację oczekującą na płatność. Odłączenie ją anuluje."
msgstr[1] "Masz %{count} rezerwacje oczekujące na płatność. Odłączenie je anuluje."
msgstr[2] "Masz %{count} rezerwacji oczekujących na płatność. Odłączenie je anuluje."

#: lib/tymeslot_web/live/dashboard/payments_settings/status_card.ex
#, elixir-autogen, elixir-format
msgid "You started connecting Stripe but haven't finished onboarding yet. Continue to start accepting payments."
msgstr "Podłączanie Stripe zostało rozpoczęte, ale konfiguracja nie jest dokończona. Dokończ ją, aby zacząć przyjmować płatności."

#: lib/tymeslot_web/live/dashboard/payments_settings/status_card.ex
#, elixir-autogen, elixir-format
msgid "Your Stripe account is disconnected. Reconnect to accept payments again."
msgstr "Twoje konto Stripe jest odłączone. Podłącz je ponownie, aby znów przyjmować płatności."

#: lib/tymeslot_web/live/dashboard/payments_settings/refund_modal.ex
#, elixir-autogen, elixir-format
msgid "Refund %{attendee} for %{meeting_type}."
msgstr "Zwrot dla %{attendee} za %{meeting_type}."

#: lib/tymeslot_web/live/dashboard/payments_settings/currency_selector.ex
#, elixir-autogen, elixir-format
msgid "Changing the currency will reset every paid event type to free - existing prices are recorded in the previous currency and would otherwise be charged at the new one."
msgstr "Zmiana waluty ustawi wszystkie płatne typy spotkań jako bezpłatne – dotychczasowe ceny są zapisane w poprzedniej walucie i inaczej zostałyby pobrane w nowej."

#: lib/tymeslot_web/live/dashboard/payments_settings/outstanding_refunds.ex
#, elixir-autogen, elixir-format
msgid "Cancelled"
msgstr "Anulowano"

#: lib/tymeslot_web/live/dashboard/payments_settings/outstanding_refunds.ex
#, elixir-autogen, elixir-format
msgid "Outstanding"
msgstr "Do zwrotu"

#: lib/tymeslot_web/live/dashboard/payments_settings/outstanding_refunds.ex
#, elixir-autogen, elixir-format
msgid "Refund in Stripe"
msgstr "Zwróć w Stripe"

#: lib/tymeslot_web/live/dashboard/payments_settings/outstanding_refunds.ex
#, elixir-autogen, elixir-format
msgid "Refunds outstanding"
msgstr "Zaległe zwroty"

#: lib/tymeslot_web/live/dashboard/payments_settings/outstanding_refunds.ex
#, elixir-autogen, elixir-format
msgid "These bookings were cancelled while you still held the attendee's money. Cancelling never refunds on its own."
msgstr "Te rezerwacje zostały anulowane, gdy pieniądze uczestnika wciąż były u Ciebie. Samo anulowanie nigdy nie wykonuje zwrotu."

#: lib/tymeslot_web/live/dashboard/payments_settings_component.ex
#, elixir-autogen, elixir-format
msgid "%{count} pending booking cancelled."
msgid_plural "%{count} pending bookings cancelled."
msgstr[0] "Anulowano %{count} oczekującą rezerwację."
msgstr[1] "Anulowano %{count} oczekujące rezerwacje."
msgstr[2] "Anulowano %{count} oczekujących rezerwacji."

#: lib/tymeslot_web/live/dashboard/payments_settings_component.ex
#, elixir-autogen, elixir-format
msgid "%{count} refund is still outstanding and must now be issued from your Stripe dashboard."
msgid_plural "%{count} refunds are still outstanding and must now be issued from your Stripe dashboard."
msgstr[0] "%{count} zwrot jest wciąż zaległy i trzeba go teraz wykonać w panelu Stripe."
msgstr[1] "%{count} zwroty są wciąż zaległe i trzeba je teraz wykonać w panelu Stripe."
msgstr[2] "%{count} zwrotów jest wciąż zaległych i trzeba je teraz wykonać w panelu Stripe."

#: lib/tymeslot_web/live/dashboard/payments_settings/outstanding_refunds.ex
#, elixir-autogen, elixir-format
msgid "Showing the %{shown} oldest of %{total} outstanding refunds."
msgstr "Pokazujemy %{shown} najstarszych z %{total} zaległych zwrotów."

#: lib/tymeslot_web/live/dashboard/payments_settings/disconnect_modal.ex
#, elixir-autogen, elixir-format
msgid "You still owe %{count} refund totalling %{total}. Disconnecting does not issue it, and afterwards you will have to refund it from your Stripe dashboard."
msgid_plural "You still owe %{count} refunds totalling %{total}. Disconnecting does not issue them, and afterwards you will have to refund them from your Stripe dashboard."
msgstr[0] "Masz wciąż do oddania %{count} zwrot na łączną kwotę %{total}. Odłączenie go nie wykona, a potem trzeba go będzie zwrócić w panelu Stripe."
msgstr[1] "Masz wciąż do oddania %{count} zwroty na łączną kwotę %{total}. Odłączenie ich nie wykona, a potem trzeba je będzie zwrócić w panelu Stripe."
msgstr[2] "Masz wciąż do oddania %{count} zwrotów na łączną kwotę %{total}. Odłączenie ich nie wykona, a potem trzeba je będzie zwrócić w panelu Stripe."

#: lib/tymeslot_web/live/dashboard/payments_settings/outstanding_refunds.ex
#, elixir-autogen, elixir-format
msgid "Your Stripe account is not connected, so these refunds have to be issued from your Stripe dashboard. The money is still owed."
msgstr "Twoje konto Stripe nie jest podłączone, więc te zwroty trzeba wykonać w panelu Stripe. Pieniądze wciąż są do oddania."
