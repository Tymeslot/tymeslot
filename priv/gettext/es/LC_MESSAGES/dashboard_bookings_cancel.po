msgstr "Esta reserva ya se canceló, así que no se emitió ningún reembolso."

#: lib/tymeslot_web/live/dashboard/bookings_management/cancellation.ex
#, elixir-autogen, elixir-format
msgid "This booking was already cancelled."
msgstr "Esta reserva ya se canceló."

#: lib/tymeslot_web/components/dashboard/meetings/cancel_meeting_modal.ex
