#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Continue to vote"
msgstr "Continuar para votar"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "If need be"
msgstr "Si hace falta"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "No"
msgstr "No"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "One of the selected times is no longer available. Please refresh and try again."
msgstr "Uno de los horarios elegidos ya no está disponible. Actualiza la página e inténtalo de nuevo."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "One of your responses wasn't recognised. Please refresh and try again."
msgstr "No se reconoció una de tus respuestas. Actualiza la página e inténtalo de nuevo."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please check your name and email, then try again."
msgstr "Revisa tu nombre y tu correo, y vuelve a intentarlo."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please register before voting."
msgstr "Regístrate antes de votar."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Save my responses"
msgstr "Guardar mis respuestas"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Scheduled for %{time}"
msgstr "Programada para %{time}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Security verification failed. Please try again."
msgstr "Falló la verificación de seguridad. Inténtalo de nuevo."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Security verification is currently unavailable. This may be caused by JavaScript being disabled, browser privacy extensions (Privacy Badger, uBlock Origin, etc.), or network security policies. Please adjust your settings or contact support if the problem persists."
msgstr "La verificación de seguridad no está disponible por ahora. Puede que JavaScript esté desactivado o que una extensión de privacidad la bloquee (por ejemplo, Privacy Badger o uBlock Origin). También pueden ser las reglas de seguridad de la red. Revisa tu configuración. Si el problema continúa, escribe al soporte."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This poll has been cancelled and is no longer accepting responses."
msgstr "Esta votación se canceló y ya no admite respuestas."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This poll has been scheduled."
msgstr "Esta votación ya tiene horario fijado."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "This poll has reached its participant limit."
msgstr "Esta votación alcanzó su límite de participantes."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Times shown in %{timezone}"
msgstr "Horarios en %{timezone}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Too many attempts. Please wait a moment and try again."
msgstr "Demasiados intentos. Espera un momento e inténtalo de nuevo."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting as %{name}"
msgstr "Votas como %{name}"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting closes %{deadline}"
msgstr "La votación cierra el %{deadline}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Voting has closed for this poll."
msgstr "Se cerró la votación."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting has closed. Here are the final responses."
msgstr "Se cerró la votación. Estas son las respuestas definitivas."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "We couldn't find your registration. Please register again."
msgstr "No encontramos tu registro. Vuelve a registrarte."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Yes"
msgstr "Sí"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "You're registered. Your responses are saved as you vote."
msgstr "Ya te registraste. Tus respuestas se guardan a medida que votas."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Your email"
msgstr "Tu correo electrónico"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Your name"
msgstr "Tu nombre"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Your responses have been saved."
msgstr "Se guardaron tus respuestas."
