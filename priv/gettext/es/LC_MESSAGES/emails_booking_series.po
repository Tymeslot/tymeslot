#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "%{attendee} requests %{count} session"
msgid_plural "%{attendee} requests %{count} sessions"
msgstr[0] "%{attendee} solicita %{count} sesión"
msgstr[1] "%{attendee} solicita %{count} sesiones"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Approve all sessions"
msgstr "Aprobar todas las sesiones"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Both buttons open the request for you to confirm. Your answer applies to every session, and nothing is decided until you choose there."
msgstr "Los dos botones abren la solicitud para que confirmes tu elección. Tu respuesta se aplica a todas las sesiones y no se decide nada hasta que elijas ahí."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Decline all sessions"
msgstr "Rechazar todas las sesiones"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Every session is held until you answer. If you haven't replied by %{by_deadline}, the request lapses and %{name} is told the times are free again."
msgstr "Todas las sesiones quedan reservadas hasta que respondas. Si no contestas antes del %{by_deadline}, la solicitud vence. Entonces avisamos a %{name} de que los horarios vuelven a estar libres."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Every session stays held for %{name} until you answer."
msgstr "Todas las sesiones quedan reservadas para %{name} hasta que respondas."

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, %{host} can't make the sessions below, so none of them is booked."
msgstr "Hola %{name}: %{host} no puede asistir a las siguientes sesiones, así que ninguna quedó reservada."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, %{host} has your request for the sessions below. They are held for you but not booked until %{host} approves them, and you'll hear either way by %{by_deadline}."
msgstr "Hola %{name}: %{host} recibió tu solicitud para las siguientes sesiones. Quedan apartadas para ti, pero no se reservan hasta que %{host} las apruebe. Sea cual sea la respuesta, la tendrás antes del %{by_deadline}."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, %{host} has your request for the sessions below. They are held for you but not booked until %{host} approves them."
msgstr "Hola %{name}: %{host} recibió tu solicitud para las siguientes sesiones. Quedan apartadas para ti, pero no se reservan hasta que %{host} las apruebe."

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Hi %{name}, your request wasn't answered in time, so the sessions below are no longer held for you."
msgstr "Hola %{name}: tu solicitud no se respondió a tiempo, así que las siguientes sesiones ya no están apartadas para ti."

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Needs your answer"
msgstr "Espera tu respuesta"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "No longer held"
msgstr "Ya no están apartadas"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "Not confirmed"
msgstr "Sin confirmar"

#: lib/tymeslot/emails/templates/series_request.ex
#, elixir-autogen, elixir-format
msgid "Request sent"
msgstr "Solicitud enviada"

#: lib/tymeslot/emails/templates/series_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "These times are available for booking again."
msgstr "Estos horarios vuelven a estar disponibles para reservar."

#: lib/tymeslot/emails/templates/series_request_outcome.ex
