#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot request a reschedule while the booking awaits approval"
msgstr "No se puede solicitar una reprogramación mientras la reserva espera aprobación"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a cancelled meeting"
msgstr "No se puede reprogramar una reunión cancelada"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a completed meeting"
msgstr "No se puede reprogramar una reunión que ya terminó"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a meeting that has already occurred"
msgstr "No se puede reprogramar una reunión que ya se realizó"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a meeting that has already started"
msgstr "No se puede reprogramar una reunión que ya empezó"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule an expired meeting"
msgstr "No se puede reprogramar una reunión vencida"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "End time must be after start time"
msgstr "El horario de fin tiene que ser posterior al de inicio"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to create appointment. Please try again."
msgstr "No se pudo crear el turno. Volvé a intentarlo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to create meeting"
msgstr "No se pudo crear la reunión"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to process booking. Please try again."
msgstr "No se pudo procesar la reserva. Volvé a intentarlo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to save meeting to database"
msgstr "No se pudo guardar la reunión en la base de datos"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Host could not be found. Please refresh and try again."
msgstr "No se encontró a quien organiza. Actualizá la página y volvé a intentarlo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Invalid date/time"
msgstr "Fecha u hora no válida"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Invalid meeting duration selected"
msgstr "La duración de reunión elegida no es válida"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Organiser is required for booking"
msgstr "Se necesita un organizador para reservar"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Payments are not available for this booking. Please contact the host."
msgstr "Los pagos no están disponibles para esta reserva. Comunicate con quien organiza."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please fill in all required fields before submitting."
msgstr "Completá todos los campos obligatorios antes de enviar."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a date"
msgstr "Elegí una fecha"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a date and time"
msgstr "Elegí una fecha y un horario"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a meeting duration"
msgstr "Elegí la duración de la reunión"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a time"
msgstr "Elegí un horario"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "The guest email must differ from your own address"
msgstr "El correo del invitado tiene que ser distinto del tuyo"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "The host is no longer accepting bookings for this period. Please pick a different day."
msgstr "Quien organiza ya no acepta reservas para este período. Elegí otro día."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This booking has already been cancelled or moved."
msgstr "Esta reserva ya se canceló o se cambió de horario."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This is a group booking, so each participant moves their own spot from their confirmation email."
msgstr "Es una reserva grupal, así que cada participante cambia el horario de su propio cupo desde su correo de confirmación."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This is your current time. Pick a different time to move your spot."
msgstr "Este es tu horario actual. Elegí otro horario para cambiar tu cupo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting could not be found. Please refresh and try again."
msgstr "No se encontró esta reunión. Actualizá la página y volvé a intentarlo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type is no longer available. Please go back and select another."
msgstr "Este tipo de reunión ya no está disponible. Volvé y elegí otro."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type is no longer available. Please refresh the page."
msgstr "Este tipo de reunión ya no está disponible. Actualizá la página."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This spot can no longer be moved. Cancel it and book a new time instead, or contact the host."
msgstr "Este cupo ya no se puede cambiar de horario. Cancelalo y reservá un nuevo horario, o comunicate con quien organiza."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This time slot is no longer available. Please select a different time."
msgstr "Este horario ya no está disponible. Elegí otro."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Title is required"
msgstr "El título es obligatorio"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "We couldn't check the host's calendar right now. Please try again in a few minutes."
msgstr "No pudimos revisar el calendario de quien organiza en este momento. Volvé a intentarlo en unos minutos."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "We couldn't start the payment process. Please try again."
msgstr "No pudimos iniciar el pago. Volvé a intentarlo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "You already have a spot at this time. Check your email for your booking confirmation."
msgstr "Ya tenés un cupo en este horario. Revisá tu correo para ver la confirmación de la reserva."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "You cannot book more than %{days} days in advance"
msgstr "No podés reservar con más de %{days} días de anticipación"
