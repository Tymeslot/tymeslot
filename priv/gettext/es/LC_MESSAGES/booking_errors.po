#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Attendee name is required"
msgstr "El nombre del participante es obligatorio"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Booking requires at least %{hours} hours in advance"
msgstr "La reserva requiere al menos %{hours} horas de anticipación"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Booking time must be in the future"
msgstr "El horario de la reserva tiene que ser futuro"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel a completed meeting"
msgstr "No se puede cancelar una reunión que ya terminó"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel a meeting that has already occurred"
msgstr "No se puede cancelar una reunión que ya se realizó"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel a meeting that has already started"
msgstr "No se puede cancelar una reunión que ya empezó"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
