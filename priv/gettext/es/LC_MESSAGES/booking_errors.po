#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Attendee email is required"
msgstr "El correo del asistente es obligatorio"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Attendee name is required"
msgstr "El nombre del asistente es obligatorio"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Booking requires at least %{hours} hours in advance"
msgstr "La reserva necesita al menos %{hours} horas de antelación"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Booking time must be in the future"
msgstr "El horario de la reserva tiene que estar en el futuro"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel a completed meeting"
msgstr "No se puede cancelar una reunión que ya terminó"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel a meeting that has already occurred"
msgstr "No se puede cancelar una reunión que ya tuvo lugar"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel a meeting that has already started"
msgstr "No se puede cancelar una reunión que ya empezó"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot cancel an expired meeting"
msgstr "No se puede cancelar una reunión expirada"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot request a reschedule while the booking awaits approval"
msgstr "No puedes pedir otro horario mientras la reserva espera aprobación"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a cancelled meeting"
msgstr "No se puede reprogramar una reunión cancelada"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a completed meeting"
msgstr "No se puede reprogramar una reunión que ya terminó"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a meeting that has already occurred"
msgstr "No se puede reprogramar una reunión que ya tuvo lugar"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule a meeting that has already started"
msgstr "No se puede reprogramar una reunión que ya empezó"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Cannot reschedule an expired meeting"
msgstr "No se puede reprogramar una reunión expirada"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "End time must be after start time"
msgstr "La hora de finalización tiene que ser posterior a la hora de inicio"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to create meeting"
msgstr "No se pudo crear la reunión"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to process booking. Please try again."
msgstr "No se pudo procesar la reserva. Inténtalo de nuevo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to save meeting to database"
msgstr "No se pudo guardar la reunión en la base de datos"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Host could not be found. Please refresh and try again."
msgstr "No se encontró al anfitrión. Actualiza la página e inténtalo de nuevo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Invalid date/time"
msgstr "Fecha u hora no válidas"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Invalid meeting duration selected"
msgstr "La duración de reunión elegida no es válida"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Organiser is required for booking"
msgstr "La reserva necesita un organizador"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Payments are not available for this booking. Please contact the host."
msgstr "Esta reserva no admite pagos. Ponte en contacto con el anfitrión."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please fill in all required fields before submitting."
msgstr "Completa todos los campos obligatorios antes de enviar."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a date"
msgstr "Elige una fecha"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a date and time"
msgstr "Elige fecha y hora"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a meeting duration"
msgstr "Elige la duración de la reunión"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please select a time"
msgstr "Elige un horario"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "The guest email must differ from your own address"
msgstr "El correo del invitado tiene que ser distinto del tuyo"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "The host is no longer accepting bookings for this period. Please pick a different day."
msgstr "El anfitrión ya no acepta reservas para este periodo. Elige otro día."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This booking has already been cancelled or moved."
msgstr "Esta reserva ya se canceló o se cambió de horario."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This is a group booking, so each participant moves their own spot from their confirmation email."
msgstr "Esta es una reserva de grupo, así que cada participante cambia su propio lugar desde su correo de confirmación."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This is your current time. Pick a different time to move your spot."
msgstr "Este es tu horario actual. Elige otro para cambiar tu lugar."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting could not be found. Please refresh and try again."
msgstr "No se encontró esta reunión. Actualiza la página e inténtalo de nuevo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type is no longer available. Please go back and select another."
msgstr "Este tipo de reunión ya no está disponible. Vuelve atrás y elige otro."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type is no longer available. Please refresh the page."
msgstr "Este tipo de reunión ya no está disponible. Actualiza la página."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This spot can no longer be moved. Cancel it and book a new time instead, or contact the host."
msgstr "Este lugar ya no se puede cambiar. Cancélalo y reserva otro horario, o ponte en contacto con el anfitrión."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This time slot is no longer available. Please select a different time."
msgstr "Este horario ya no está disponible. Elige otro."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Title is required"
msgstr "El título es obligatorio"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "We couldn't check the host's calendar right now. Please try again in a few minutes."
msgstr "No pudimos consultar el calendario del anfitrión en este momento. Inténtalo de nuevo en unos minutos."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "We couldn't start the payment process. Please try again."
msgstr "No pudimos iniciar el pago. Inténtalo de nuevo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "You already have a spot at this time. Check your email for your booking confirmation."
msgstr "Ya tienes un lugar a esta hora. Consulta tu correo para ver la confirmación de la reserva."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "You cannot book more than %{days} days in advance"
msgstr "No se puede reservar con más de %{days} días de antelación"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting was arranged by a poll, so only its host can move it. If the new time doesn't suit you, reply to your invitation."
msgstr "Esta reunión se acordó mediante una votación, así que solo el anfitrión puede cambiarla de horario. Si el nuevo horario no te conviene, responde a tu invitación."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "The reminders for this meeting are not valid"
msgstr "Los recordatorios de esta reunión no son válidos"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "A fixed date is moved from its meeting type, together with everyone booked on it"
msgstr "Una fecha fija se cambia desde su tipo de reunión, junto con todas las personas que la reservaron"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Failed to create meeting. Please try again."
msgstr "No se pudo crear la reunión. Inténtalo de nuevo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This booking page can't show times right now."
msgstr "Esta página de reservas no puede mostrar horarios en este momento."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This invitation link has already been used or is no longer valid. Please contact the host for a new one."
msgstr "Este enlace de invitación ya se ha usado o ya no es válido. Pide al anfitrión uno nuevo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type can be booked only with a personal invitation link."
msgstr "Este tipo de reunión solo se puede reservar con un enlace de invitación personal."

#: lib/tymeslot_web/live/scheduling/invitation_messages.ex
#, elixir-autogen, elixir-format
msgid "This invitation link has expired. Please contact the host for a new one."
msgstr "Este enlace de invitación ha caducado. Pide al anfitrión uno nuevo."

#: lib/tymeslot_web/live/scheduling/invitation_messages.ex
#, elixir-autogen, elixir-format
msgid "This invitation link is no longer valid. Please contact the host for a new one."
msgstr "Este enlace de invitación ya no es válido. Pide al anfitrión uno nuevo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This booking is not confirmed yet. Confirm it from the link in your email first."
msgstr "Esta reserva todavía no está confirmada. Primero confírmala desde el enlace de tu correo."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This booking is not confirmed yet. If you do not confirm it, it will be released on its own."
msgstr "Esta reserva todavía no está confirmada. Si no la confirmas, se liberará sola."

#: lib/tymeslot_web/live/scheduling/invitation_messages.ex
#, elixir-autogen, elixir-format
msgid "This invitation link has already been used to book an appointment. To change it, use the link in the email we sent you."
msgstr "Este enlace de invitación ya se ha usado para reservar una cita. Para cambiarla, usa el enlace del correo que te enviamos."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "A reschedule request is already waiting for an answer"
msgstr "Ya hay una solicitud de reprogramación esperando respuesta"

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Please choose a number of sessions this meeting type offers."
msgstr "Elige un número de sesiones que ofrezca este tipo de reunión."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Some of your sessions are no longer available. Please review them."
msgstr "Algunas de tus sesiones ya no están disponibles. Revísalas."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type is booked as a series. Please choose your sessions."
msgstr "Este tipo de reunión se reserva como serie. Elige tus sesiones."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Two of your sessions overlap. Please choose different times."
msgstr "Dos de tus sesiones se superponen. Elige otros horarios."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This meeting type can't be booked as a series at the moment."
msgstr "Este tipo de reunión no se puede reservar como serie en este momento."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This session is waiting for its series to be paid for. Until then the series can only be released as a whole."
msgstr "Esta sesión está esperando el pago de su serie. Hasta entonces, la serie solo se puede liberar completa."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "This session is part of a request that is waiting for the host's answer, so it can't be moved yet."
msgstr "Esta sesión forma parte de una solicitud que espera la respuesta del anfitrión, así que todavía no se puede cambiar de horario."

#: lib/tymeslot_web/live/scheduling/handlers/booking_error_message.ex
#, elixir-autogen, elixir-format
msgid "Guests can only be added to a single booking. Please remove your guests to book a series."
msgstr "Solo se pueden añadir invitados a una reserva individual. Quita a tus invitados para reservar una serie."
