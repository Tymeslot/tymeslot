#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Choose which calendars Tymeslot uses, and which of them block times on your booking page."
msgstr "Elegí qué calendarios usa Tymeslot y cuáles de ellos bloquean horarios en tu página de reservas."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Don't block"
msgstr "No bloquear"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Exchange reports busy times for your main calendar only."
msgstr "Exchange solo informa los horarios ocupados de tu calendario principal."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Exchange reports busy times for your whole mailbox from your main calendar, so this choice works whether or not the calendar is shown."
msgstr "Exchange informa los horarios ocupados de todo tu buzón a través de tu calendario principal, así que esta opción funciona se muestre o no el calendario."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Off"
msgstr "Desactivado"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "On"
msgstr "Activado"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Read-only"
msgstr "Solo lectura"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Shared with you as busy times only. Tymeslot can block these times but cannot show the events."
msgstr "Se compartió con vos solo como horarios ocupados. Tymeslot puede bloquear esos horarios, pero no puede mostrar los eventos."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Show and block"
msgstr "Mostrar y bloquear"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Show only"
msgstr "Solo mostrar"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "This calendar stays read-only: bookings are never written to it. Choose another calendar as your booking destination."
msgstr "Este calendario sigue siendo de solo lectura: las reservas nunca se escriben en él. Elegí otro calendario como destino de tus reservas."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/caldav_reconnect_modal.ex
#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Your booking calendar always blocks your availability."
msgstr "Tu calendario de reservas siempre bloquea tu disponibilidad."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "%{used} of %{count} calendar in use, %{blocking} blocking your availability"
msgid_plural "%{used} of %{count} calendars in use, %{blocking} blocking your availability"
msgstr[0] "%{used} de %{count} calendario en uso, %{blocking} bloquean tu disponibilidad"
msgstr[1] "%{used} de %{count} calendarios en uso, %{blocking} bloquean tu disponibilidad"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Busy times block"
msgstr "Bloquea horarios ocupados"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Busy times of %{calendar}"
msgstr "Horarios ocupados de %{calendar}"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Exchange reports busy times for your whole mailbox, and they block your booking page. Refresh this connection to list your main calendar and choose there whether they do."
msgstr "Exchange informa los horarios ocupados de todo tu buzón, y estos bloquean tu página de reservas. Actualizá esta conexión para que aparezca tu calendario principal y elegí ahí si los bloquean o no."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Show %{calendar} on your calendar"
msgstr "Mostrar %{calendar} en tu calendario"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "This folder's events are shown only; busy times come from your whole mailbox."
msgstr "Los eventos de esta carpeta solo se muestran; los horarios ocupados se toman de todo tu buzón."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Use of %{calendar}"
msgstr "Uso de %{calendar}"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Whole mailbox"
msgstr "Todo el buzón"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "Count every event as busy"
msgstr "Contar todos los eventos como ocupados"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/ics_url_config.ex
#, elixir-autogen, elixir-format
msgid "Holiday and school-holiday calendars mark their events as free, so they would block nothing. With this on, every event in the feed blocks the time, however it is marked."
msgstr "Los calendarios de feriados y de vacaciones escolares marcan sus eventos como libres, así que no bloquearían nada. Con esta opción activada, todos los eventos del feed bloquean el horario, sin importar cómo estén marcados."
