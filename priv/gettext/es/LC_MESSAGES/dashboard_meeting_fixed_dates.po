#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Times are in your time zone, %{timezone}."
msgstr "Los horarios están en tu zona horaria: %{timezone}."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Times are in your time zone, %{timezone}. A booked time stops being offered, and is offered again if that booking is cancelled."
msgstr "Los horarios están en tu zona horaria: %{timezone}. Un horario reservado deja de ofrecerse y vuelve a ofrecerse si se cancela esa reserva."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/session_handlers.ex
#, elixir-autogen, elixir-format
msgid "Turn on fixed dates and group bookings first."
msgstr "Primero activa las fechas fijas y las reservas de grupo."

