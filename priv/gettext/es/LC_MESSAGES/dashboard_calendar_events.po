msgstr "Ana García"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Books the slot, emails the guest an invitation, and adds it to your calendar."
msgstr "Se reserva la franja horaria y la reunión se agrega a tu calendario. Además, el invitado recibe una invitación por correo."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Guest name"
msgstr "Nombre del invitado"

#: lib/tymeslot_web/components/calendar/reminders_editor.ex
#, elixir-autogen, elixir-format
msgid "before the event"
msgstr "antes del evento"

#: lib/tymeslot_web/live/dashboard/calendar/panel_new_form.ex
#, elixir-autogen, elixir-format
msgid "An agenda, or anything to bring or prepare"
msgstr "El orden del día o lo que haya que traer o preparar"

#: lib/tymeslot_web/live/dashboard/calendar/panel_new_form.ex
#, elixir-autogen, elixir-format
msgid "Included in the invitation and on the calendar entry."
msgstr "Se incluye en la invitación y en la entrada del calendario."

#: lib/tymeslot_web/live/dashboard/calendar/panel_new_form.ex
#, elixir-autogen, elixir-format
msgid "Note to the guest"
msgstr "Nota para el invitado"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Language of the invitation"
msgstr "Idioma de la invitación"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "The language every email about this meeting is written in, for the guest and anyone else invited."
msgstr "El idioma de todos los correos sobre esta reunión, para el invitado y para cualquier otra persona invitada."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Add up to %{count} reminder email for this meeting. The guest and anyone else invited receive it."
msgid_plural "Add up to %{count} reminder emails for this meeting. The guest and anyone else invited receive it."
msgstr[0] "Agrega hasta %{count} correo de recordatorio para esta reunión. Lo reciben el invitado y las demás personas invitadas."
msgstr[1] "Agrega hasta %{count} correos de recordatorio para esta reunión. Los reciben el invitado y las demás personas invitadas."

#: lib/tymeslot_web/live/dashboard/calendar/undelivered_notice.ex
#, elixir-autogen, elixir-format
msgid "Dismiss"
msgstr "Ocultar"

#: lib/tymeslot_web/live/dashboard/calendar/undelivered_notice.ex
#, elixir-autogen, elixir-format
msgid "The latest update could not be emailed to this guest. Let them know another way."
msgid_plural "The latest update could not be emailed to these guests. Let them know another way."
msgstr[0] "No se pudo enviar por correo la última actualización a este invitado. Avísale por otro medio."
msgstr[1] "No se pudo enviar por correo la última actualización a estos invitados. Avísales por otro medio."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "Add a title. A meeting without a main participant is known by its title."
msgstr "Añade un título. Una reunión sin participante principal se reconoce por su título."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "An address, a room or a meeting point"
msgstr "Una dirección, una sala o un punto de encuentro"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Custom location"
msgstr "Lugar personalizado"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Custom location…"
msgstr "Lugar personalizado…"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Everyone is an equal guest who can accept or decline. Only you can move or cancel the meeting."
msgstr "Todos son invitados en igualdad de condiciones y pueden aceptar o rechazar. Solo tú puedes mover o cancelar la reunión."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Location (optional)"
msgstr "Lugar (opcional)"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Main participant"
msgstr "Participante principal"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "No location"
msgstr "Sin lugar"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Saved locations"
msgstr "Lugares guardados"

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "Shown on the calendar entry and in every invitation."
msgstr "Aparece en la entrada del calendario y en cada invitación."

#: lib/tymeslot_web/live/dashboard/calendar/creation.ex
#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "That location can no longer be used. Please choose another one."
msgstr "Ese lugar ya no se puede usar. Elige otro."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting_fields.ex
#, elixir-autogen, elixir-format
msgid "The main participant can move or cancel the meeting. Turn this off to invite everyone as an equal guest."
msgstr "El participante principal puede mover o cancelar la reunión. Desactívalo para invitar a todos como invitados en igualdad de condiciones."

#: lib/tymeslot_web/live/dashboard/calendar_event_handlers.ex
#, elixir-autogen, elixir-format
msgid "This time is no longer available. Please choose another time."
msgstr "Este horario ya no está disponible. Elige otro."

#: lib/tymeslot_web/live/dashboard/calendar/panel_meeting.ex
#, elixir-autogen, elixir-format
msgid "The place is too long for a meeting. Keep it under 500 characters."
msgstr "El lugar es demasiado largo para una reunión. Usa menos de 500 caracteres."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event deleted, but meeting cancellation failed. The attendee may not be notified."
msgstr "Se eliminó el evento, pero no se pudo cancelar la reunión. Puede que el asistente no reciba el aviso."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Event deleted, but the attendees could not be notified."
msgstr "Evento eliminado, pero no se pudo avisar a los asistentes."

#: lib/tymeslot_web/live/dashboard/calendar_edit_messages.ex
#, elixir-autogen, elixir-format
msgid "Syncing with your calendar. Open the event to change the whole series."
msgstr "Sincronizando con tu calendario. Abre el evento para cambiar toda la serie."
