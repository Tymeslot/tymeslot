#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats."
msgid_plural "%{number} of them repeat."
msgstr[0] "1 de ellos se repite."
msgstr[1] "%{number} de ellos se repiten."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel"
msgstr "Cancelar"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Choose or drop an .ics file"
msgstr "Elige o arrastra aquí un archivo .ics"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Close"
msgstr "Cerrar"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Connect a calendar Tymeslot can write to before importing events."
msgstr "Conecta un calendario en el que Tymeslot pueda escribir antes de importar eventos."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Copy the events of an .ics file into one of your calendars."
msgstr "Copia los eventos de un archivo .ics en uno de tus calendarios."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Exported from Google Calendar, Outlook, Apple Calendar or any other calendar app."
msgstr "Exportado desde Google Calendar, Outlook, Apple Calendar o cualquier otra aplicación de calendario."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Found 1 event."
msgid_plural "Found %{number} events."
msgstr[0] "Se encontró 1 evento."
msgstr[1] "Se encontraron %{number} eventos."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Guests are not imported, and nobody is sent an invitation."
msgstr "Los invitados no se importan y nadie recibe una invitación."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Import"
msgstr "Importar"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Import events"
msgstr "Importar eventos"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Import into"
msgstr "Importar en"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Reading the file..."
msgstr "Leyendo el archivo…"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "You can close this window; the import carries on."
msgstr "Puedes cerrar esta ventana; la importación continúa."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "1 event could not be imported."
msgid_plural "%{number} events could not be imported."
msgstr[0] "No se pudo importar 1 evento."
msgstr[1] "No se pudieron importar %{number} eventos."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "1 event repeats in a way Outlook can't store, so it was not imported."
msgid_plural "%{number} events repeat in a way Outlook can't store, so they were not imported."
msgstr[0] "1 evento se repite de una forma que Outlook no puede guardar, así que no se importó."
msgstr[1] "%{number} eventos se repiten de una forma que Outlook no puede guardar, así que no se importaron."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats on a day some months don't have, which Outlook would move to the month's last day."
msgid_plural "%{number} of them repeat on a day some months don't have, which Outlook would move to the month's last day."
msgstr[0] "1 de ellos se repite en un día que algunos meses no tienen; Outlook lo pasaría al último día del mes."
msgstr[1] "%{number} de ellos se repiten en un día que algunos meses no tienen; Outlook los pasaría al último día del mes."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "An import is still running. Please wait for it to finish before importing another file."
msgstr "Todavía hay una importación en curso. Espera a que termine antes de importar otro archivo."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Imported 1 event."
msgid_plural "Imported %{number} events."
msgstr[0] "Se importó 1 evento."
msgstr[1] "Se importaron %{number} eventos."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Invalid calendar selected"
msgstr "El calendario seleccionado no es válido"

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Only .ics calendar files can be imported."
msgstr "Solo se pueden importar archivos de calendario .ics."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Outlook could not take the skipped dates of 1 recurring event, so it may show extra occurrences."
msgid_plural "Outlook could not take the skipped dates of %{number} recurring events, so they may show extra occurrences."
msgstr[0] "Outlook no pudo aplicar las fechas omitidas de 1 evento periódico, por eso puede que muestre repeticiones adicionales."
msgstr[1] "Outlook no pudo aplicar las fechas omitidas de %{number} eventos periódicos, por eso puede que muestren repeticiones adicionales."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The file could not be uploaded. Please try again."
msgstr "No se pudo subir el archivo. Inténtalo de nuevo."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The import could not be finished. Some of its events may already be in your calendar."
msgstr "No se pudo terminar la importación. Puede que algunos eventos ya estén en tu calendario."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because the calendar could not be written to."
msgstr "La importación se detuvo porque no se pudo escribir en el calendario."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar is not responding. Please try again later."
msgstr "La importación se detuvo porque tu calendario no responde. Inténtalo más tarde."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar needs to be reconnected."
msgstr "La importación se detuvo porque debes volver a conectar tu calendario."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "This file contains no events to import."
msgstr "Este archivo no contiene eventos para importar."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "This file could not be read as a calendar. Please choose an .ics file."
msgstr "Este archivo no se pudo leer como calendario. Elige un archivo .ics."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Too many imports. Please wait a while before importing another file."
msgstr "Demasiadas importaciones. Espera un rato antes de importar otro archivo."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "%{from_date} onwards"
msgstr "A partir del %{from_date}"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "1 event"
msgid_plural "%{number} events"
msgstr[0] "1 evento"
msgstr[1] "%{number} eventos"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "1 event before %{before_date} is left out."
msgid_plural "%{number} events before %{before_date} are left out."
msgstr[0] "Queda fuera 1 evento anterior al %{before_date}."
msgstr[1] "Quedan fuera %{number} eventos anteriores al %{before_date}."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "1 event, more than %{max}"
msgid_plural "%{number} events, more than %{max}"
msgstr[0] "1 evento, más de los %{max} permitidos"
msgstr[1] "%{number} eventos, más de los %{max} permitidos"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Add a calendar subscription"
msgstr "Agregar una suscripción a calendario"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Continue"
msgstr "Continuar"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Even the events from today onwards are more than one import can copy. Export a shorter date range from your calendar app and import it in parts."
msgstr "Incluso los eventos a partir de hoy superan lo que puede copiar una sola importación. Exporta un intervalo de fechas más corto desde tu aplicación de calendario e impórtalo por partes."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Import events from"
msgstr "Importar eventos desde"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "No events from this date on"
msgstr "Ningún evento a partir de esta fecha"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Past events are rarely needed for scheduling, so you can leave them out. A repeating event counts once, however often it repeats."
msgstr "Los eventos pasados rara vez hacen falta para programar reuniones, así que puedes dejarlos fuera. Un evento periódico cuenta una sola vez, por muchas veces que se repita."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The file is too large. Files up to %{size} MB can be imported. Export a shorter date range from your calendar app and try again."
msgstr "El archivo es demasiado grande. Se pueden importar archivos de hasta %{size} MB. Exporta un intervalo de fechas más corto desde tu aplicación de calendario e inténtalo de nuevo."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "To keep a whole calendar, with no limit and in step with its changes, subscribe to it by URL instead."
msgstr "Para tener un calendario completo, sin límite y al día con sus cambios, suscríbete a él mediante su URL en lugar de importarlo."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "This file contains more than 1 event, too many to read. Export a shorter date range from your calendar app, or subscribe to the calendar by URL instead."
msgid_plural "This file contains more than %{number} events, too many to read. Export a shorter date range from your calendar app, or subscribe to the calendar by URL instead."
msgstr[0] "Este archivo contiene más de un evento, demasiados para poder leerlo. Exporta un intervalo de fechas más corto desde tu aplicación de calendario o, en su lugar, suscríbete al calendario mediante su URL."
msgstr[1] "Este archivo contiene más de %{number} eventos, demasiados para poder leerlo. Exporta un intervalo de fechas más corto desde tu aplicación de calendario o, en su lugar, suscríbete al calendario mediante su URL."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "This file holds 1 event, from %{from_date} to %{to_date}. One import can copy up to %{max}."
msgid_plural "This file holds %{number} events, from %{from_date} to %{to_date}. One import can copy up to %{max}."
msgstr[0] "Este archivo contiene un evento, del %{from_date} al %{to_date}. Cada importación puede copiar como máximo %{max}."
msgstr[1] "Este archivo contiene %{number} eventos, del %{from_date} al %{to_date}. Cada importación puede copiar como máximo %{max}."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Importing %{done} of 1 event..."
msgid_plural "Importing %{done} of %{number} events..."
msgstr[0] "Importando %{done} de 1 evento…"
msgstr[1] "Importando %{done} de %{number} eventos…"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "From each of these dates, this file holds either more events than one import can copy or none at all. Export a shorter date range from your calendar app and import it in parts."
msgstr "A partir de cada una de estas fechas, este archivo contiene más eventos de los que puede copiar una sola importación, o ninguno. Exporta un intervalo de fechas más corto desde tu aplicación de calendario e impórtalo por partes."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "None of the events in this file fall within these dates: they all ended before the earliest one. Export a shorter date range from your calendar app and import it in parts."
msgstr "Ninguno de los eventos de este archivo cae dentro de estas fechas: todos terminaron antes de la primera. Exporta un intervalo de fechas más corto desde tu aplicación de calendario e impórtalo por partes."
