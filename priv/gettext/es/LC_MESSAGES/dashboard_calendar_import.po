#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "1 event could not be imported."
msgid_plural "%{count} events could not be imported."
msgstr[0] "No se pudo importar 1 evento."
msgstr[1] "No se pudieron importar %{count} eventos."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "1 event repeats in a way Outlook can't store, so it was not imported."
msgid_plural "%{count} events repeat in a way Outlook can't store, so they were not imported."
msgstr[0] "1 evento se repite de una forma que Outlook no puede guardar, así que no se importó."
msgstr[1] "%{count} eventos se repiten de una forma que Outlook no puede guardar, así que no se importaron."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats on a day some months don't have, which Outlook would move to the month's last day."
msgid_plural "%{count} of them repeat on a day some months don't have, which Outlook would move to the month's last day."
msgstr[0] "1 de ellos se repite un día que algunos meses no tienen, y Outlook lo pasaría al último día del mes."
msgstr[1] "%{count} de ellos se repiten un día que algunos meses no tienen, y Outlook los pasaría al último día del mes."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats."
msgid_plural "%{count} of them repeat."
msgstr[0] "1 de ellos se repite."
msgstr[1] "%{count} de ellos se repiten."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "An import is still running. Please wait for it to finish before importing another file."
msgstr "Todavía hay una importación en curso. Esperá a que termine antes de importar otro archivo."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel"
msgstr "Cancelar"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Choose or drop an .ics file"
msgstr "Elegí o soltá un archivo .ics"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Close"
msgstr "Cerrar"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Connect a calendar Tymeslot can write to before importing events."
msgstr "Antes de importar eventos, conectá un calendario en el que Tymeslot pueda escribir."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Copy the events of an .ics file into one of your calendars."
msgstr "Copiá los eventos de un archivo .ics en uno de tus calendarios."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Exported from Google Calendar, Outlook, Apple Calendar or any other calendar app."
msgstr "Exportado desde Google Calendar, Outlook, Apple Calendar o cualquier otra app de calendario."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Found 1 event."
msgid_plural "Found %{count} events."
msgstr[0] "Se encontró 1 evento."
msgstr[1] "Se encontraron %{count} eventos."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Guests are not imported, and nobody is sent an invitation."
msgstr "Los invitados no se importan y no se le envía una invitación a nadie."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Import"
msgstr "Importar"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Import events"
msgstr "Importar eventos"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Import into"
msgstr "Importar en"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Imported 1 event."
msgid_plural "Imported %{count} events."
msgstr[0] "Se importó 1 evento."
msgstr[1] "Se importaron %{count} eventos."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Importing %{done} of %{total} events..."
msgstr "Importando %{done} de %{total} eventos…"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Invalid calendar selected"
msgstr "El calendario seleccionado no es válido"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Only .ics calendar files can be imported."
msgstr "Solo se pueden importar archivos de calendario .ics."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Outlook could not take the skipped dates of 1 recurring event, so it may show extra occurrences."
msgid_plural "Outlook could not take the skipped dates of %{count} recurring events, so they may show extra occurrences."
msgstr[0] "Outlook no pudo registrar las fechas omitidas de 1 evento recurrente, así que puede mostrar repeticiones de más."
msgstr[1] "Outlook no pudo registrar las fechas omitidas de %{count} eventos recurrentes, así que pueden mostrar repeticiones de más."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "Reading the file..."
msgstr "Leyendo el archivo…"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The file could not be uploaded. Please try again."
msgstr "No se pudo subir el archivo. Volvé a intentarlo."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The file is too large. Files up to %{size} MB can be imported."
msgstr "El archivo es demasiado grande. Se pueden importar archivos de hasta %{size} MB."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import could not be finished. Some of its events may already be in your calendar."
msgstr "No se pudo terminar la importación. Puede que algunos de sus eventos ya estén en tu calendario."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because the calendar could not be written to."
msgstr "La importación se detuvo porque no se pudo escribir en el calendario."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar is not responding. Please try again later."
msgstr "La importación se detuvo porque tu calendario no responde. Volvé a intentarlo más tarde."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar needs to be reconnected."
msgstr "La importación se detuvo porque tenés que volver a conectar tu calendario."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "This file contains more than %{count} events. Please split it into smaller files."
msgstr "Este archivo tiene más de %{count} eventos. Dividilo en archivos más chicos."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "This file contains no events to import."
msgstr "Este archivo no tiene eventos para importar."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "This file could not be read as a calendar. Please choose an .ics file."
msgstr "No se pudo leer este archivo como un calendario. Elegí un archivo .ics."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/ics_import.ex
#, elixir-autogen, elixir-format
msgid "Too many imports. Please wait a while before importing another file."
msgstr "Demasiadas importaciones. Esperá un rato antes de importar otro archivo."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/import_ics_modal.ex
#, elixir-autogen, elixir-format
msgid "You can close this window; the import carries on."
msgstr "Podés cerrar esta ventana; la importación sigue."
