#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Add a saved location or connect a video service to hold an event."
msgstr "Agrega un lugar guardado o conecta un servicio de videollamadas para poder realizar un evento."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Allow between %{min} and %{max} participants."
msgstr "Elige un límite de entre %{min} y %{max} participantes."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "An event lasts at least 5 minutes and at most 24 hours."
msgstr "Un evento dura como mínimo 5 minutos y como máximo 24 horas."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Choose a location"
msgstr "Elige un lugar"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Choose where the event takes place."
msgstr "Elige dónde se realiza el evento."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Creates a one-off event with its own booking link. People sign up until registration closes, and it is on your calendar at once."
msgstr "Esta opción crea un evento único con su propio enlace de reservas. Las personas pueden inscribirse hasta que se cierren las inscripciones, y el evento aparece en tu calendario de inmediato."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Description (optional)"
msgstr "Descripción (opcional)"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Event created. Its booking link: %{link}"
msgstr "Evento creado. Su enlace de reservas: %{link}"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Give the event a title."
msgstr "Ponle un título al evento."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/create_event_modal.ex
#, elixir-autogen, elixir-format
msgid "Group event"
msgstr "Evento de grupo"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Group events are not included in your plan."
msgstr "Los eventos de grupo no están incluidos en tu plan."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Location"
msgstr "Lugar"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/create_event_modal.ex
#, elixir-autogen, elixir-format
msgid "New Group Event"
msgstr "Nuevo evento de grupo"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Participant limit"
msgstr "Límite de participantes"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Registration closes (optional, %{timezone})"
msgstr "Cierre de inscripciones (opcional, %{timezone})"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
