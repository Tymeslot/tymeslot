#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking cancelled"
msgstr "Reserva cancelada"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking confirmed"
msgstr "Reserva confirmada"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking not accepted"
msgstr "Reserva no aceptada"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Booking request expired"
msgstr "La solicitud de reserva expiró"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Confirming your payment…"
msgstr "Confirmando el pago…"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "If there's no answer by %{deadline}, the request lapses and you're refunded automatically."
msgstr "Si no hay respuesta antes del %{deadline}, la solicitud expira y se te reembolsa el pago automáticamente."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "If there's no answer by %{deadline}, the request lapses."
msgstr "Si no hay respuesta antes del %{deadline}, la solicitud expira."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Nobody responded to this request in time, so it has lapsed."
msgstr "Nadie respondió a tiempo, así que la solicitud expiró."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Nobody responded to this request in time, so it has lapsed. Your payment is being refunded."
msgstr "Nadie respondió a tiempo, así que la solicitud expiró. Te estamos reembolsando el pago."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment cancelled"
msgstr "Pago cancelado"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment not completed"
msgstr "Pago no completado"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Payment received"
msgstr "Pago recibido"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Please wait while we confirm your booking."
msgstr "Espera mientras confirmamos tu reserva."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Return to booking"
msgstr "Volver a la reserva"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thank you, your booking is confirmed for %{date}."
msgstr "Gracias, tu reserva quedó confirmada para el %{date}."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Thanks, your payment went through. Your booking is not confirmed yet though:"
msgstr "Gracias, tu pago se completó. Pero tu reserva todavía no está confirmada:"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking has been cancelled, so it won't be going ahead."
msgstr "Esta reserva se canceló, así que no se llevará a cabo."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking wasn't accepted, so it won't be going ahead."
msgstr "Esta reserva no se aceptó, así que no se llevará a cabo."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "This booking wasn't accepted, so it won't be going ahead. Your payment is being refunded."
msgstr "Esta reserva no se aceptó, así que no se llevará a cabo. Te estamos reembolsando el pago."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. You can return and try again at any time."
msgstr "Tu reserva no está confirmada. Puedes volver e intentarlo cuando quieras."

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Paid: %{amount}"
msgstr "Pagado: %{amount}"

#: lib/tymeslot_web/themes/shared/payment_return_components.ex
#, elixir-autogen, elixir-format
msgid "Your booking is not confirmed. Your invitation stays reserved for it until the unfinished checkout expires, and a link to book again will appear here as soon as it does."
msgstr "Tu reserva no está confirmada. Tu invitación queda reservada para ella hasta que caduque el pago sin terminar; en cuanto caduque, aquí aparecerá un enlace para volver a reservar."
