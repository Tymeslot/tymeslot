#: lib/tymeslot/emails/templates/booking_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "%{organizer} wasn't able to take this booking, so the time is no longer held for you."
msgstr "%{organizer} no pudo aceptar esta reserva, así que el horario ya no está reservado para vos."

