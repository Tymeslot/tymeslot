msgstr "%{name} quiere cambiar su reserva confirmada a otro horario."

#: lib/tymeslot/emails/templates/booking_request_received.ex
#, elixir-autogen, elixir-format
msgid "%{organizer} confirms each booking personally, so this isn't final yet."
msgstr "%{organizer} debe revisar cada reserva antes de confirmarla. Por eso, aún no ha sido confirmada."

#: lib/tymeslot/emails/templates/booking_request_received.ex
#, elixir-autogen, elixir-format
msgid "%{organizer} confirms each change personally, so the new time isn't final yet."
msgstr "%{organizer} revisa cada cambio antes de confirmarlo. Por eso, el nuevo horario aún no es definitivo."

#: lib/tymeslot/emails/templates/booking_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "%{organizer} didn't get to your request in time, so the time has been released. You are welcome to pick another slot."
msgstr "%{organizer} no llegó a responder a tiempo, así que el horario quedó libre. Puedes elegir otro tiempo de horario cuando quieras."

#: lib/tymeslot/emails/templates/booking_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "%{organizer} didn't get to your reschedule request in time. Your previous time had already been given up for it, so your booking has been cancelled. The attached calendar file removes it from your calendar."
msgstr "%{organizer} no llegó a responder a tiempo a tu solicitud de reprogramación. Al pedir el cambio, tu horario anterior ya se había liberado, así que tu reserva quedó cancelada. El archivo de calendario adjunto la quita de tu calendario."

#: lib/tymeslot/emails/templates/booking_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "%{organizer} wasn't able to accept the new time. Your previous time had already been given up for it, so your booking has been cancelled. The attached calendar file removes it from your calendar."
msgstr "%{organizer} no pudo aceptar el nuevo horario. Al pedir el cambio, tu horario anterior ya se había liberado, así que tu reserva quedó cancelada. El archivo de calendario adjunto quita la reserva de tu calendario."

#: lib/tymeslot/emails/templates/booking_request_outcome.ex
#, elixir-autogen, elixir-format
msgid "%{organizer} wasn't able to take this booking, so the time is no longer held for you."
msgstr "%{organizer} no pudo aceptar esta reserva, así que el horario ya no queda apartado para ti."

#: lib/tymeslot/emails/templates/booking_request_received.ex
