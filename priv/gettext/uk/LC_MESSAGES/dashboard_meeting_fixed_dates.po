#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
#, elixir-autogen, elixir-format
msgid "Cancel the planned dates to turn this off."
msgstr "Скасуйте заплановані дати, щоб вимкнути це."

#: lib/tymeslot_web/live/dashboard/meeting_settings/meeting_type_form/fixed_dates_section.ex
