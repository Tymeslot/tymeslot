#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "%{provider} authentication failed - missing authorisation code or security token."
msgstr "Помилка автентифікації через %{provider}: відсутній код авторизації або токен безпеки."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "%{provider} authentication is not available"
msgstr "Автентифікація через %{provider} недоступна"

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "%{provider} authentication succeeded but session creation failed."
msgstr "Автентифікація через %{provider} пройшла успішно, але не вдалося створити сеанс."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "An error occurred during %{provider} authentication."
msgstr "Під час автентифікації через %{provider} сталася помилка."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Check your email: we've sent a link to finish signing up with %{provider}."
msgstr "Перевірте пошту: ми надіслали посилання, щоб завершити реєстрацію через %{provider}."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Create my account"
msgstr "Створити мій обліковий запис"

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "Failed to authenticate with %{provider}."
msgstr "Не вдалося пройти автентифікацію через %{provider}."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Failed to create session. Please try again."
msgstr "Не вдалося створити сеанс. Спробуйте ще раз."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Finish signing up"
msgstr "Завершення реєстрації"

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Missing OAuth provider information. Please try again."
msgstr "Відсутня інформація про провайдера OAuth. Спробуйте ще раз."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "OAuth authentication failed - missing provider."
msgstr "Помилка автентифікації OAuth: відсутній провайдер."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Please verify your email address before signing in. We could not send a new verification link; please try again later."
msgstr "Будь ласка, підтвердіть свою адресу електронної пошти перед входом. Не вдалося надіслати нове посилання для підтвердження; спробуйте пізніше."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Please verify your email address before signing in. We've sent you a new verification link."
msgstr "Будь ласка, підтвердіть свою адресу електронної пошти перед входом. Ми надіслали вам нове посилання для підтвердження."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Press the button below to confirm your email address and create your account."
msgstr "Натисніть кнопку нижче, щоб підтвердити адресу електронної пошти й створити обліковий запис."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "Security validation failed. Please try again."
msgstr "Помилка перевірки безпеки. Спробуйте ще раз."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Successfully signed in with %{provider}."
msgstr "Ви успішно увійшли через %{provider}."

#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "This %{provider} account already signs in to another Tymeslot account. Use a different one, or choose another way to sign in."
msgstr "Цей обліковий запис %{provider} уже використовується для входу в інший обліковий запис Tymeslot. Скористайтеся іншим або виберіть інший спосіб входу."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "This link is no longer valid. Please sign in to continue."
msgstr "Це посилання більше не дійсне. Увійдіть, щоб продовжити."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many OAuth attempts. Please try again later."
msgstr "Забагато спроб входу через OAuth. Спробуйте пізніше."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many authentication attempts. Please try again later."
msgstr "Забагато спроб автентифікації. Спробуйте пізніше."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many registration attempts. Please try again later."
msgstr "Забагато спроб реєстрації. Спробуйте пізніше."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Too many verification attempts. Please try again later."
msgstr "Забагато спроб підтвердження. Спробуйте пізніше."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Unsupported OAuth provider."
msgstr "Цей провайдер OAuth не підтримується."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Unsupported OAuth provider: %{provider}"
msgstr "Непідтримуваний провайдер OAuth: %{provider}"

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "We couldn't send the link to finish signing up just now. Please try again later."
msgstr "Зараз не вдалося надіслати посилання для завершення реєстрації. Спробуйте пізніше."

#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "Welcome to Tymeslot! You'll sign in with %{provider}."
msgstr "Ласкаво просимо до Tymeslot! Ви входитимете через %{provider}."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Welcome! You've successfully signed up with %{provider}."
msgstr "Вітаємо! Ви успішно зареєструвалися через %{provider}."

#: lib/tymeslot_web/controllers/auth/oauth_controller/invitation_response.ex
#, elixir-autogen, elixir-format
msgid "Your account is ready. Please sign in with %{provider} to continue."
msgstr "Ваш обліковий запис готовий. Щоб продовжити, увійдіть через %{provider}."

#: lib/tymeslot_web/controllers/auth/oauth_controller.ex
#, elixir-autogen, elixir-format
msgid "Your sign-up session has expired. Please sign in again."
msgstr "Термін дії сесії реєстрації минув. Будь ласка, увійдіть знову."
