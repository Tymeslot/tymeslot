#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "If need be"
msgstr "Якщо необхідно"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "No"
msgstr "Ні"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "One of the selected times is no longer available. Please refresh and try again."
msgstr "Один із вибраних варіантів часу більше недоступний. Оновіть сторінку та спробуйте ще раз."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "One of your responses wasn't recognised. Please refresh and try again."
msgstr "Одну з ваших відповідей не розпізнано. Оновіть сторінку та спробуйте ще раз."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please check your name and email, then try again."
msgstr "Перевірте своє ім'я та електронну пошту й спробуйте ще раз."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Save my responses"
msgstr "Зберегти мої відповіді"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Scheduled for %{time}"
msgstr "Заплановано на %{time}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Security verification failed. Please try again."
msgstr "Помилка перевірки безпеки. Спробуйте ще раз."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Security verification is currently unavailable. This may be caused by JavaScript being disabled, browser privacy extensions (Privacy Badger, uBlock Origin, etc.), or network security policies. Please adjust your settings or contact support if the problem persists."
msgstr "Перевірка безпеки наразі недоступна. Це може бути пов'язано з вимкненим JavaScript, розширеннями конфіденційності в браузері (Privacy Badger, uBlock Origin тощо) або політиками мережевої безпеки. Змініть налаштування або зверніться до служби підтримки, якщо проблема не зникне."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This poll has been cancelled and is no longer accepting responses."
msgstr "Це опитування скасовано, відповіді більше не приймаються."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This poll has been scheduled."
msgstr "Зустріч за результатами цього опитування вже заплановано."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "This poll has reached its participant limit."
msgstr "Це опитування досягло ліміту учасників."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Times shown in %{timezone}"
msgstr "Час указано в часовому поясі %{timezone}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Too many attempts. Please wait a moment and try again."
msgstr "Забагато спроб. Зачекайте трохи та спробуйте ще раз."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting as %{name}"
msgstr "Ви голосуєте як %{name}"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting closes %{deadline}"
msgstr "Голосування завершиться: %{deadline}"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Voting has closed for this poll."
msgstr "Голосування в цьому опитуванні завершено."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Voting has closed. Here are the final responses."
msgstr "Голосування завершено. Ось остаточні відповіді."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Yes"
msgstr "Так"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Your email"
msgstr "Ваша електронна пошта"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Your name"
msgstr "Ваше ім'я"

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Your responses have been saved."
msgstr "Ваші відповіді збережено."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Email me my voting link"
msgstr "Надіслати посилання для голосування"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Enter your name and email and we'll send you a personal link to vote with. Voted before? Enter the same email to get your link again."
msgstr "Введіть своє ім'я та електронну пошту, і ми надішлемо вам особисте посилання для голосування. Уже голосували? Введіть ту саму адресу, щоб отримати посилання ще раз."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Nothing there after a few minutes? Check your spam folder."
msgstr "Через кілька хвилин нічого немає? Перевірте папку «Спам»."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please open the personal voting link we emailed you to vote."
msgstr "Щоб проголосувати, відкрийте особисте посилання, яке ми надіслали вам електронною поштою."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "Save your responses to confirm your email address. They count from then on."
msgstr "Збережіть відповіді, щоб підтвердити свою електронну адресу. Відтоді вони враховуватимуться."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Thanks, your responses count now. We've emailed you a copy with your personal link."
msgstr "Дякуємо, ваші відповіді тепер враховано. Ми надіслали вам електронною поштою копію з особистим посиланням."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This is your personal link. Please don't share it: anyone who has it can change your responses."
msgstr "Це ваше особисте посилання. Не діліться ним: будь-хто, хто його має, може змінити ваші відповіді."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "This poll is receiving a lot of requests right now. Please try again later."
msgstr "Зараз це опитування отримує дуже багато запитів. Спробуйте пізніше."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "This voting link is no longer valid. Please ask for a new one on the poll's page."
msgstr "Це посилання для голосування більше недійсне. Попросіть нове на сторінці опитування."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please enter your name, then save your responses again."
msgstr "Введіть своє ім'я, а потім збережіть відповіді ще раз."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "New"
msgstr "Нове"

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This address is already on the poll, and its voting link was sent a few minutes ago. Please check that inbox, including the spam folder."
msgstr "Ця адреса вже додана до опитування, а посилання для голосування надіслали на неї кілька хвилин тому. Перевірте цю поштову скриньку, зокрема папку зі спамом."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "This address is already on the poll; we've sent its voting link again."
msgstr "Ця адреса вже додана до опитування; ми повторно надіслали на неї посилання для голосування."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "We've sent a personal voting link to the address you entered. Open it to vote; your responses count once you save them there."
msgstr "Ми надіслали особисте посилання для голосування на вказану адресу. Відкрийте його, щоб проголосувати; ваші відповіді буде враховано, щойно ви збережете їх там."

#: lib/tymeslot_web/themes/shared/poll_voting_components.ex
#, elixir-autogen, elixir-format
msgid "You're voting with your personal link."
msgstr "Ви голосуєте через своє особисте посилання."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please enter your email address."
msgstr "Введіть свою адресу електронної пошти."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "Please enter your name."
msgstr "Введіть своє ім'я."

#: lib/tymeslot_web/themes/core/poll_voting.ex
#, elixir-autogen, elixir-format
msgid "This poll is by invitation only. Please use the link from your invitation email."
msgstr ""
