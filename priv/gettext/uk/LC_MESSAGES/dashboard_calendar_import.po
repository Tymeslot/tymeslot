#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats."
msgid_plural "%{number} of them repeat."
msgstr[0] "%{number} із них повторюється."
msgstr[1] "%{number} із них повторюються."
msgstr[2] "%{number} із них повторюються."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Cancel"
msgstr "Скасувати"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Choose or drop an .ics file"
msgstr "Виберіть або перетягніть сюди файл .ics"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Close"
msgstr "Закрити"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Connect a calendar Tymeslot can write to before importing events."
msgstr "Перш ніж імпортувати події, підключіть календар, до якого Tymeslot може записувати."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Copy the events of an .ics file into one of your calendars."
msgstr "Скопіюйте події з файлу .ics в один зі своїх календарів."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Exported from Google Calendar, Outlook, Apple Calendar or any other calendar app."
msgstr "Експортовано з Google Calendar, Outlook, Apple Calendar або будь-якого іншого календарного застосунку."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Found 1 event."
msgid_plural "Found %{number} events."
msgstr[0] "Знайдено %{number} подію."
msgstr[1] "Знайдено %{number} події."
msgstr[2] "Знайдено %{number} подій."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Guests are not imported, and nobody is sent an invitation."
msgstr "Гості не імпортуються, і нікому не надсилається запрошення."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Import"
msgstr "Імпортувати"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Import events"
msgstr "Імпортувати події"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Import into"
msgstr "Імпортувати в"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Reading the file..."
msgstr "Читання файлу…"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "You can close this window; the import carries on."
msgstr "Ви можете закрити це вікно; імпорт триватиме."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "1 event could not be imported."
msgid_plural "%{number} events could not be imported."
msgstr[0] "Не вдалося імпортувати %{number} подію."
msgstr[1] "Не вдалося імпортувати %{number} події."
msgstr[2] "Не вдалося імпортувати %{number} подій."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "1 event repeats in a way Outlook can't store, so it was not imported."
msgid_plural "%{number} events repeat in a way Outlook can't store, so they were not imported."
msgstr[0] "%{number} подія повторюється так, що Outlook не може її зберегти, тому її не імпортовано."
msgstr[1] "%{number} події повторюються так, що Outlook не може їх зберегти, тому їх не імпортовано."
msgstr[2] "%{number} подій повторюються так, що Outlook не може їх зберегти, тому їх не імпортовано."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "1 of them repeats on a day some months don't have, which Outlook would move to the month's last day."
msgid_plural "%{number} of them repeat on a day some months don't have, which Outlook would move to the month's last day."
msgstr[0] ""
"%{number} із них повторюється в день, якого немає в деяких місяцях, тож Outlook перемістив би її на останній день місяця."
msgstr[1] ""
"%{number} із них повторюються в день, якого немає в деяких місяцях, тож Outlook перемістив би їх на останній день місяця."
msgstr[2] ""
"%{number} із них повторюються в день, якого немає в деяких місяцях, тож Outlook перемістив би їх на останній день місяця."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "An import is still running. Please wait for it to finish before importing another file."
msgstr "Імпорт ще триває. Зачекайте, доки він завершиться, перш ніж імпортувати інший файл."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Imported 1 event."
msgid_plural "Imported %{number} events."
msgstr[0] "Імпортовано %{number} подію."
msgstr[1] "Імпортовано %{number} події."
msgstr[2] "Імпортовано %{number} подій."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Invalid calendar selected"
msgstr "Вибрано некоректний календар"

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Only .ics calendar files can be imported."
msgstr "Можна імпортувати лише файли календаря .ics."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Outlook could not take the skipped dates of 1 recurring event, so it may show extra occurrences."
msgid_plural "Outlook could not take the skipped dates of %{number} recurring events, so they may show extra occurrences."
msgstr[0] "Outlook не зміг прийняти пропущені дати %{number} повторюваної події, тому може показувати зайві повторення."
msgstr[1] "Outlook не зміг прийняти пропущені дати %{number} повторюваних подій, тому може показувати зайві повторення."
msgstr[2] "Outlook не зміг прийняти пропущені дати %{number} повторюваних подій, тому може показувати зайві повторення."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The file could not be uploaded. Please try again."
msgstr "Не вдалося завантажити файл. Спробуйте ще раз."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The import could not be finished. Some of its events may already be in your calendar."
msgstr "Не вдалося завершити імпорт. Деякі його події вже можуть бути у вашому календарі."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because the calendar could not be written to."
msgstr "Імпорт зупинено, оскільки в календар не вдалося записувати."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar is not responding. Please try again later."
msgstr "Імпорт зупинено, бо ваш календар не відповідає. Спробуйте пізніше."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The import stopped because your calendar needs to be reconnected."
msgstr "Імпорт зупинено, оскільки ваш календар потрібно підключити повторно."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "This file contains no events to import."
msgstr "Цей файл не містить подій для імпорту."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "This file could not be read as a calendar. Please choose an .ics file."
msgstr "Не вдалося прочитати цей файл як календар. Виберіть файл .ics."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "Too many imports. Please wait a while before importing another file."
msgstr "Забагато імпортувань. Зачекайте трохи, перш ніж імпортувати інший файл."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "%{from_date} onwards"
msgstr "З %{from_date}"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "1 event"
msgid_plural "%{number} events"
msgstr[0] "%{number} подія"
msgstr[1] "%{number} події"
msgstr[2] "%{number} подій"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "1 event before %{before_date} is left out."
msgid_plural "%{number} events before %{before_date} are left out."
msgstr[0] "Буде пропущено %{number} подію до %{before_date}."
msgstr[1] "Буде пропущено %{number} події до %{before_date}."
msgstr[2] "Буде пропущено %{number} подій до %{before_date}."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "1 event, more than %{max}"
msgid_plural "%{number} events, more than %{max}"
msgstr[0] "%{number} подія, більше ніж %{max}"
msgstr[1] "%{number} події, більше ніж %{max}"
msgstr[2] "%{number} подій, більше ніж %{max}"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Add a calendar subscription"
msgstr "Додати підписку на календар"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Continue"
msgstr "Продовжити"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Even the events from today onwards are more than one import can copy. Export a shorter date range from your calendar app and import it in parts."
msgstr "Навіть подій від сьогодні більше, ніж можна скопіювати за один імпорт. Експортуйте зі свого календарного застосунку коротший діапазон дат та імпортуйте події частинами."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Import events from"
msgstr "З якої дати імпортувати події"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "No events from this date on"
msgstr "Від цієї дати подій немає"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Past events are rarely needed for scheduling, so you can leave them out. A repeating event counts once, however often it repeats."
msgstr "Минулі події рідко потрібні для планування, тож їх можна пропустити. Повторювана подія враховується один раз, хоч би як часто вона повторювалася."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "The file is too large. Files up to %{size} MB can be imported. Export a shorter date range from your calendar app and try again."
msgstr "Файл завеликий. Можна імпортувати файли до %{size} МБ. Експортуйте зі свого календарного застосунку коротший діапазон дат і спробуйте ще раз."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "To keep a whole calendar, with no limit and in step with its changes, subscribe to it by URL instead."
msgstr "Щоб мати весь календар без обмежень і завжди в актуальному стані, натомість підпишіться на нього за URL-адресою."

#: lib/tymeslot_web/live/dashboard/ics_import_flow.ex
#, elixir-autogen, elixir-format
msgid "This file contains more than 1 event, too many to read. Export a shorter date range from your calendar app, or subscribe to the calendar by URL instead."
msgid_plural "This file contains more than %{number} events, too many to read. Export a shorter date range from your calendar app, or subscribe to the calendar by URL instead."
msgstr[0] "Цей файл містить понад %{number} подію. Це забагато, тому файл не вдалося прочитати. Експортуйте зі свого календарного застосунку коротший діапазон дат або натомість підпишіться на календар за URL-адресою."
msgstr[1] "Цей файл містить понад %{number} події. Це забагато, тому файл не вдалося прочитати. Експортуйте зі свого календарного застосунку коротший діапазон дат або натомість підпишіться на календар за URL-адресою."
msgstr[2] "Цей файл містить понад %{number} подій. Це забагато, тому файл не вдалося прочитати. Експортуйте зі свого календарного застосунку коротший діапазон дат або натомість підпишіться на календар за URL-адресою."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "This file holds 1 event, from %{from_date} to %{to_date}. One import can copy up to %{max}."
msgid_plural "This file holds %{number} events, from %{from_date} to %{to_date}. One import can copy up to %{max}."
msgstr[0] "У цьому файлі %{number} подія за період з %{from_date} по %{to_date}. За один імпорт можна скопіювати щонайбільше %{max} із них."
msgstr[1] "У цьому файлі %{number} події за період з %{from_date} по %{to_date}. За один імпорт можна скопіювати щонайбільше %{max} із них."
msgstr[2] "У цьому файлі %{number} подій за період з %{from_date} по %{to_date}. За один імпорт можна скопіювати щонайбільше %{max} із них."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "Importing %{done} of 1 event..."
msgid_plural "Importing %{done} of %{number} events..."
msgstr[0] "Імпортування %{done} з %{number} події…"
msgstr[1] "Імпортування %{done} з %{number} подій…"
msgstr[2] "Імпортування %{done} з %{number} подій…"

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "From each of these dates, this file holds either more events than one import can copy or none at all. Export a shorter date range from your calendar app and import it in parts."
msgstr "Починаючи з будь-якої з цих дат, у цьому файлі або більше подій, ніж можна скопіювати за один імпорт, або жодної. Експортуйте зі свого календарного застосунку коротший діапазон дат та імпортуйте події частинами."

#: lib/tymeslot_web/live/dashboard/calendar/import_modal.ex
#, elixir-autogen, elixir-format
msgid "None of the events in this file fall within these dates: they all ended before the earliest one. Export a shorter date range from your calendar app and import it in parts."
msgstr "Жодна з подій у цьому файлі не припадає на ці дати: усі вони завершилися раніше за найранішу з цих дат. Експортуйте зі свого календарного застосунку коротший діапазон дат та імпортуйте події частинами."
