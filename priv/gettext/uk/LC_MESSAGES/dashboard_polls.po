msgstr "Опитування видалено"

#: lib/tymeslot_web/live/dashboard/polls/remove_participant_modal.ex
#, elixir-autogen, elixir-format
msgid "Remove %{name} and their responses from this poll? They are not told."
msgstr "Видалити %{name} разом із відповідями з цього опитування? Людина не отримає повідомлення."

#: lib/tymeslot_web/live/dashboard/polls/poll_participant_list.ex
#: lib/tymeslot_web/live/dashboard/polls/remove_participant_modal.ex
#, elixir-autogen, elixir-format
msgid "Remove from the poll"
msgstr "Видалити з опитування"

#: lib/tymeslot_web/live/dashboard/polls/poll_editor.ex
#: lib/tymeslot_web/live/dashboard/polls/poll_form.ex
#, elixir-autogen, elixir-format
msgid "The deadline must be in the future"
msgstr "Кінцевий термін має бути в майбутньому"

#: lib/tymeslot_web/live/dashboard/polls/delete_poll_modal.ex
#, elixir-autogen, elixir-format
