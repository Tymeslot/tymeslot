msgstr "Призначена за ним зустріч залишається у вашому календарі."

#: lib/tymeslot_web/live/dashboard/polls/poll_editor.ex
#, elixir-autogen, elixir-format
msgid "The poll already has this time"
msgstr "В опитуванні вже є цей час"

#: lib/tymeslot_web/live/dashboard/polls/poll_participant_list.ex
#, elixir-autogen, elixir-format
msgid "invited"
msgstr "запрошено"

#: lib/tymeslot_web/live/dashboard/polls/poll_participant_list.ex
#, elixir-autogen, elixir-format
