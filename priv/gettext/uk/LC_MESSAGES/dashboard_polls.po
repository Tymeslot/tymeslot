msgstr "Цей час уже почався."

#: lib/tymeslot_web/live/dashboard/polls/poll_form.ex
#, elixir-autogen, elixir-format
msgid "%{used} of %{count} time"
msgid_plural "%{used} of %{count} times"
msgstr[0] "%{used} із %{count} варіанта часу"
msgstr[1] "%{used} із %{count} варіантів часу"
msgstr[2] "%{used} із %{count} варіантів часу"

#: lib/tymeslot_web/live/dashboard/polls/poll_list.ex
#, elixir-autogen, elixir-format
