msgstr "Спершу вкажіть ім'я користувача у профілі: посилання в листах створюються на його основі."

#: lib/tymeslot_web/live/dashboard/polls/poll_list.ex
#, elixir-autogen, elixir-format
msgid "Voting closed"
msgstr "Голосування завершено"

#: lib/tymeslot_web/live/dashboard/polls/poll_results.ex
#, elixir-autogen, elixir-format
