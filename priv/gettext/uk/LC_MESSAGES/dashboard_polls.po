msgstr "Голосування завершилося: %{deadline}"

#: lib/tymeslot_web/live/dashboard/polls/poll_results.ex
#, elixir-autogen, elixir-format
msgid "Voting closes %{deadline}"
msgstr "Голосування завершується: %{deadline}"

#: lib/tymeslot_web/live/dashboard/polls/poll_results.ex
#, elixir-autogen, elixir-format
msgid "Voting has closed. Confirm a time, or move the deadline in Edit poll to let people keep voting."
msgstr "Голосування завершено. Підтвердьте час або перенесіть кінцевий термін у «Редагувати опитування», щоб люди могли голосувати далі."

#: lib/tymeslot_web/live/dashboard/polls/confirm_slot_modal.ex
#, elixir-autogen, elixir-format
