#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Add a saved location or connect a video service to hold an event."
msgstr "Додайте збережене місце або підключіть відеосервіс, щоб провести подію."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Allow between %{min} and %{max} participants."
msgstr "Дозвольте від %{min} до %{max} учасників."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "An event lasts at least 5 minutes and at most 24 hours."
msgstr "Подія триває щонайменше 5 хвилин і щонайбільше 24 години."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Choose a location"
msgstr "Оберіть місце"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Choose where the event takes place."
msgstr "Оберіть, де відбудеться подія."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Creates a one-off event with its own booking link. People sign up until registration closes, and it is on your calendar at once."
msgstr "Створює одноразову подію з власним посиланням для бронювання. Люди реєструються до закриття реєстрації, а подія одразу з’являється у вашому календарі."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Description (optional)"
msgstr "Опис (необов’язково)"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Event created. Its booking link: %{link}"
msgstr "Подію створено. Посилання для бронювання: %{link}"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Give the event a title."
msgstr "Дайте події назву."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/create_event_modal.ex
#, elixir-autogen, elixir-format
msgid "Group event"
msgstr "Групова подія"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Group events are not included in your plan."
msgstr "Групові події не входять до вашого плану."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Location"
msgstr "Місце"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/create_event_modal.ex
#, elixir-autogen, elixir-format
msgid "New Group Event"
msgstr "Нова групова подія"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Participant limit"
msgstr "Ліміт учасників"

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Registration closes (optional, %{timezone})"
msgstr "Закриття реєстрації (необов’язково, %{timezone})"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Registration has to close in the future, and no later than the event starts."
msgstr "Реєстрація має закритися в майбутньому і не пізніше початку події."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Saved locations"
msgstr "Збережені місця"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "The event could not be created. Please try again."
msgstr "Не вдалося створити подію. Спробуйте ще раз."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "The event has to start in the future."
msgstr "Подія має початися в майбутньому."

#: lib/tymeslot_web/live/dashboard/calendar_grid/modals/group_event_fields.ex
#, elixir-autogen, elixir-format
msgid "Video call"
msgstr "Відеодзвінок"

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "You already have a booking at that time."
msgstr "У вас уже є бронювання на цей час."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "An event lasts a multiple of %{step} minutes."
msgstr "Тривалість події кратна %{step} хвилинам."

#: lib/tymeslot_web/live/dashboard/calendar_grid/event_handlers/group_event_creation.ex
#, elixir-autogen, elixir-format
msgid "Connect a calendar first: people book the event on your booking page, which needs one."
msgstr "Спершу підключіть календар: подію бронюють на вашій сторінці бронювання, а їй він потрібен."
