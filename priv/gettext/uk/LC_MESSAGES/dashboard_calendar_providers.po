msgstr "Календар для бронювань"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Busy times only"
msgstr "Лише зайнятий час"

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Choose which calendars Tymeslot uses, and which of them block times on your booking page."
msgstr "Виберіть, які календарі використовує Tymeslot і які з них блокують час на вашій сторінці бронювання."

#: lib/tymeslot_web/components/dashboard/integrations/calendar/calendar_selection_modal.ex
#, elixir-autogen, elixir-format
msgid "Don't block"
msgstr "Не блокувати"

