msgstr "Залишити запит"

#: lib/tymeslot_web/themes/shared/components/series_page.ex
#, elixir-autogen, elixir-format
msgid "Keep my sessions"
msgstr "Залишити сесії"

#: lib/tymeslot_web/themes/shared/components/series_page.ex
#, elixir-autogen, elixir-format
msgid "No session of this series is left to come."
msgstr "У цій серії більше не залишилося майбутніх сесій."

#: lib/tymeslot_web/themes/core/series_management.ex
#, elixir-autogen, elixir-format
msgid "Nothing was left to cancel. The list shows where each session stands."
msgstr "Скасовувати вже не було чого. У списку видно стан кожної сесії."

#: lib/tymeslot_web/themes/shared/components/series_page.ex
#, elixir-autogen, elixir-format
msgid "Past"
msgstr "Минула"

#: lib/tymeslot_web/themes/core/series_management.ex
#, elixir-autogen, elixir-format
msgid "The sessions could not be cancelled. Please try again."
msgstr "Не вдалося скасувати сесії. Спробуйте ще раз."

#: lib/tymeslot_web/themes/core/series_management.ex
#, elixir-autogen, elixir-format
msgid "This series could not be found. Check the link in your email."
msgstr "Цю серію не знайдено. Перевірте посилання в листі."

#: lib/tymeslot_web/themes/shared/components/series_page.ex
#, elixir-autogen, elixir-format
msgid "Upcoming"
msgstr "Майбутня"

#: lib/tymeslot_web/themes/shared/components/series_page.ex
#, elixir-autogen, elixir-format
msgid "Withdraw request"
msgstr "Відкликати запит"

#: lib/tymeslot_web/themes/shared/components/series_page.ex
#, elixir-autogen, elixir-format
msgid "Withdraw your request for %{count} session? This can't be undone."
msgid_plural "Withdraw your request for %{count} sessions? This can't be undone."
msgstr[0] "Відкликати запит на %{count} сесію? Цю дію не можна відмінити."
msgstr[1] "Відкликати запит на %{count} сесії? Цю дію не можна відмінити."
msgstr[2] "Відкликати запит на %{count} сесій? Цю дію не можна відмінити."

#: lib/tymeslot_web/themes/shared/components/series_page.ex
#, elixir-autogen, elixir-format
msgid "Withdrawing…"
msgstr "Відкликання…"

#: lib/tymeslot_web/themes/shared/components/series_page.ex
#, elixir-autogen, elixir-format
msgid "Yes, withdraw it"
msgstr "Так, відкликати запит"

#: lib/tymeslot_web/themes/core/series_management.ex
#, elixir-autogen, elixir-format
msgid "Your remaining sessions are cancelled. We've emailed you."
msgstr "Решту сесій скасовано. Ми надіслали вам лист."

#: lib/tymeslot_web/themes/core/series_management.ex
#, elixir-autogen, elixir-format
msgid "Your request is withdrawn. We've emailed you."
msgstr "Запит відкликано. Ми надіслали вам лист."

#: lib/tymeslot_web/themes/shared/components/series_page.ex
#, elixir-autogen, elixir-format
msgid "Your sessions"
msgstr "Ваші сесії"

#: lib/tymeslot_web/themes/shared/components/series_page.ex
#, elixir-autogen, elixir-format
msgid "your host"
msgstr "ваш організатор"

#: lib/tymeslot_web/themes/shared/components/series_page.ex
#, elixir-autogen, elixir-format
msgid "Yes, cancel it"
msgid_plural "Yes, cancel them"
msgstr[0] "Так, скасувати сесію"
msgstr[1] "Так, скасувати сесії"
msgstr[2] "Так, скасувати сесії"

#: lib/tymeslot_web/themes/shared/components/series_page.ex
#, elixir-autogen, elixir-format
msgid "session %{position}, %{when}"
msgstr "сесія %{position}, %{when}"

#: lib/tymeslot_web/themes/core/series_management.ex
#, elixir-autogen, elixir-format
msgid "The host answered your request in the meantime, so nothing was withdrawn. The list shows where each session now stands."
msgstr "Тим часом організатор відповів на ваш запит, тож нічого не відкликано. У списку видно поточний стан кожної сесії."
