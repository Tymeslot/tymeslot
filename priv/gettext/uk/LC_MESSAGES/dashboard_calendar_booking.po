#, elixir-autogen, elixir-format
msgid "That meeting type can't be opened. Choose another one."
msgstr "Цей тип зустрічі не можна відкрити для бронювання. Виберіть інший."

#: lib/tymeslot_web/live/dashboard/calendar/block_time.ex
#, elixir-autogen, elixir-format
msgid "That time can't be blocked."
msgstr "Цей час не можна заблокувати."

