#, elixir-autogen, elixir-format
msgid "The time must end after it starts."
msgstr "Час завершення має бути пізнішим за час початку."

#: lib/tymeslot_web/live/dashboard/calendar/booking_preview.ex
#, elixir-autogen, elixir-format
