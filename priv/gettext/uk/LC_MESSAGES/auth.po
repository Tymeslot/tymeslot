#: lib/tymeslot/auth/error_formatter.ex
#, elixir-autogen, elixir-format
msgid "authentication"
msgstr "автентифікація"

#: lib/tymeslot/auth/error_formatter.ex
#, elixir-autogen, elixir-format
msgid "login"
msgstr "вхід"

#: lib/tymeslot/auth/email_change.ex
#, elixir-autogen, elixir-format
msgid "Email change request cancelled"
msgstr "Запит на зміну електронної адреси скасовано"

#: lib/tymeslot/auth/password_reset.ex
#, elixir-autogen, elixir-format
msgid "Password reset instructions have been sent to your email."
msgstr "Інструкції зі скидання пароля надіслано на вашу електронну адресу."

#: lib/tymeslot/auth/password_reset.ex
#, elixir-autogen, elixir-format
msgid "Token verified successfully."
msgstr "Токен успішно перевірено."

#: lib/tymeslot/auth/email_change.ex
#, elixir-autogen, elixir-format
msgid "Verification email sent to %{email}"
msgstr "Лист для підтвердження надіслано на %{email}"

#: lib/tymeslot/security/field_validators/password_validator.ex
#, elixir-autogen, elixir-format
msgid "Password confirmation does not match"
msgstr "Підтвердження пароля не збігається"

#: lib/tymeslot/security/field_validators/password_validator.ex
#, elixir-autogen, elixir-format
msgid "Password confirmation is required"
msgstr "Потрібно підтвердити пароль"

#: lib/tymeslot/security/field_validators/password_validator.ex
#, elixir-autogen, elixir-format
msgid "Password must be a text value"
msgstr "Пароль має бути текстом"

#: lib/tymeslot/security/field_validators/password_validator.ex
#, elixir-autogen, elixir-format
msgid "Password must be at least %{count} character long"
msgid_plural "Password must be at least %{count} characters long"
msgstr[0] "Пароль має містити щонайменше %{count} символ"
msgstr[1] "Пароль має містити щонайменше %{count} символи"
msgstr[2] "Пароль має містити щонайменше %{count} символів"

#: lib/tymeslot/security/field_validators/password_validator.ex
#, elixir-autogen, elixir-format
msgid "Password must be at most %{count} character long"
msgid_plural "Password must be at most %{count} characters long"
msgstr[0] "Пароль має містити щонайбільше %{count} символ"
msgstr[1] "Пароль має містити щонайбільше %{count} символи"
msgstr[2] "Пароль має містити щонайбільше %{count} символів"

#: lib/tymeslot/security/field_validators/password_validator.ex
#, elixir-autogen, elixir-format
msgid "Password must contain at least one lowercase letter"
msgstr "Пароль має містити щонайменше одну малу літеру"

#: lib/tymeslot/security/field_validators/password_validator.ex
#, elixir-autogen, elixir-format
msgid "Password must contain at least one number"
msgstr "Пароль має містити щонайменше одну цифру"

#: lib/tymeslot/security/field_validators/password_validator.ex
#, elixir-autogen, elixir-format
msgid "Password must contain at least one special character"
msgstr "Пароль має містити щонайменше один спеціальний символ"

#: lib/tymeslot/security/field_validators/password_validator.ex
#, elixir-autogen, elixir-format
msgid "Password must contain at least one uppercase letter"
msgstr "Пароль має містити щонайменше одну велику літеру"

#: lib/tymeslot/auth/registration.ex
#, elixir-autogen, elixir-format
msgid "Your account was created, but the verification email could not be sent yet. Please wait a few minutes, then use the resend link."
msgstr "Ваш обліковий запис створено, але лист для підтвердження ще не вдалося надіслати. Зачекайте кілька хвилин, а потім скористайтеся посиланням для повторного надсилання."

#: lib/tymeslot/auth/password_reset.ex
#, elixir-autogen, elixir-format
msgid "If an account exists with this email address, password reset instructions have been sent."
msgstr "Якщо обліковий запис із цією електронною адресою існує, інструкції зі скидання пароля вже надіслано."
