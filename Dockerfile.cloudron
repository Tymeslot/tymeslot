# syntax=docker/dockerfile:1
# --- Builder Stage ---
FROM hexpm/elixir:1.19.5-erlang-28.3.3-debian-bookworm-20260223-slim AS builder

# Build arguments and environment
ARG MIX_ENV=prod
ENV MIX_ENV=${MIX_ENV} \
    LANG=C.UTF-8 \
    DEPLOYMENT_TYPE=cloudron

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    nodejs \
    npm \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Hex + Rebar
RUN mix local.hex --force && \
    mix local.rebar --force

# Install dependencies (cached if mix.exs/mix.lock haven't changed)
COPY mix.exs mix.lock ./

RUN mix deps.get --only $MIX_ENV
# Compile dependencies (cached if mix.exs/mix.lock unchanged)
RUN mix deps.compile

# Copy source and compile. Wipe any locally-built assets first so the
# image build is hermetic — assets are always produced by mix assets.deploy below.
COPY . .
RUN rm -rf priv/static/assets/
RUN mix compile
RUN mix assets.setup
# Install node_modules for tailwind plugins (tailwindcss-animate) — the
# standalone tailwind binary bundles @tailwindcss/forms but not third-party
# plugins, so it resolves them from the assets dir's node_modules.
RUN npm ci --prefix assets
RUN mix assets.deploy

# Create the release, then copy runtime config into it.
# mix release does not automatically include config/runtime.exs in all setups;
# copying it explicitly ensures it is available at startup.
RUN mix release tymeslot --overwrite --path /opt/release && \
    mkdir -p /opt/release/config && \
    cp config/runtime.exs /opt/release/config/

# --- Runtime Stage ---
FROM cloudron/base:5.0.0 AS runtime

ENV LANG=C.UTF-8 \
    MIX_ENV=prod \
    PHX_SERVER=true \
    DOCKER_ENV=true \
    DEPLOYMENT_TYPE=cloudron \
    PORT=4000 \
    ELIXIR_ERL_OPTIONS="+fnu"

WORKDIR /app

# Copy the compiled release from the builder
COPY --from=builder /opt/release ./

# Create needed directories
RUN mkdir -p /data/logs /app/data/uploads && \
    chown -R cloudron:cloudron /data /app/data && \
    chmod -R 700 /data /app/data

# Copy your start script and ensure it's executable
COPY start.sh ./
RUN chmod +x start.sh

EXPOSE 4000

CMD ["./start.sh"]
