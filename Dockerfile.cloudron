# syntax=docker/dockerfile:1
# --- Builder Stage ---
FROM hexpm/elixir:1.20.3-erlang-28.5.0.5-debian-bookworm-20260803-slim AS builder

# Build arguments and environment
ARG MIX_ENV=prod
ENV MIX_ENV=${MIX_ENV} \
    NODE_ENV=production \
    LANG=C.UTF-8 \
    DEPLOYMENT_TYPE=cloudron

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    nodejs \
    npm \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Hex + Rebar
RUN mix local.hex --force && \
    mix local.rebar --force

# Install dependencies (cached if mix.exs/mix.lock haven't changed)
COPY mix.exs mix.lock ./
# config/ and priv/tz/ must precede deps.compile: `tz` reads :data_dir and
# :iana_version at dep-compile time and loads the vendored IANA release from
# priv/tz. Without them it would silently compile in its own bundled release
# instead, putting every timezone conversion on stale DST rules.
COPY config ./config
COPY priv/tz ./priv/tz

RUN mix deps.get --only $MIX_ENV
# Compile dependencies (cached if mix.exs/mix.lock/config/tz data unchanged)
RUN mix deps.compile

# Copy source and compile. Wipe any locally-built assets first so the
# image build is hermetic — assets are always produced by mix assets.deploy below.
COPY . .
RUN rm -rf priv/static/assets/
RUN mix compile
RUN mix assets.setup
# Install node_modules for the heroicons plugin — the standalone tailwind
# binary bundles @tailwindcss/forms but not the tailwindcss runtime that
# assets/heroicons.js needs via require("tailwindcss/plugin"), so it resolves
# them from the assets dir's node_modules.
RUN npm ci --prefix assets
RUN mix assets.deploy

# Create the release, then copy runtime config into it.
# mix release does not automatically include config/runtime.exs in all setups;
# copying it explicitly ensures it is available at startup.
RUN mix release tymeslot --overwrite --path /opt/release && \
    mkdir -p /opt/release/config && \
    cp config/runtime.exs /opt/release/config/

# --- Runtime Stage ---
FROM cloudron/base:5.1.0@sha256:1c0666c9abe9e2090d33686826d4e97769b799124573118d41e0d7485135748e AS runtime

ENV LANG=C.UTF-8 \
    MIX_ENV=prod \
    PHX_SERVER=true \
    DOCKER_ENV=true \
    DEPLOYMENT_TYPE=cloudron \
    PORT=4000 \
    ELIXIR_ERL_OPTIONS="+fnu"

WORKDIR /app

# Copy the compiled release from the builder
COPY --from=builder /opt/release ./

# Create needed directories
RUN mkdir -p /data/logs /app/data/uploads && \
    chown -R cloudron:cloudron /data /app/data && \
    chmod -R 700 /data /app/data

# Copy your start script and ensure it's executable
COPY start.sh ./
RUN chmod +x start.sh

EXPOSE 4000

CMD ["./start.sh"]
